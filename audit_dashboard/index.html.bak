  {key:'tp_remaining_pct',label:'To TP', default:true},
  {key:'age_hours',label:'Age', default:true},
  {key:'timestamp',label:'Time', default:true},
];
// Load saved column prefs or use defaults
function loadColPrefs() {
  try {
    const saved = localStorage.getItem('audit_active_cols');
    if (saved) return JSON.parse(saved);
  } catch(e) {}
  return null;
}
function saveColPrefs(visible) {
  try { localStorage.setItem('audit_active_cols', JSON.stringify(visible)); } catch(e) {}
}
function getVisibleCols() {
  const prefs = loadColPrefs();
  if (prefs) return allActiveCols.filter(c => prefs.includes(c.key));
  return allActiveCols.filter(c => c.default);
}
let activeCols = getVisibleCols();
const closedCols = [
  {key:'symbol',label:'Symbol'},{key:'direction',label:'Dir'},{key:'asset_class',label:'Asset'},
  {key:'source_system',label:'System'},{key:'strategy',label:'Strategy'},
  {key:'entry_price',label:'Entry'},{key:'pnl_pct',label:'PnL%'},
  {key:'exit_reason',label:'Exit Reason'},{key:'timestamp',label:'Time'},
];

// ── Top-level helper: system name → hyperlink (used by overview + agreement matrix) ──
function sysLink(name) {
  const url = sysLinks[name];
  const display = name.replace(/_/g, ' ');
  // Check if system is proven for special badge
  const nm = name.toLowerCase();
  let provenBadge = '';
  let tierInfo = '';
  for (const [k, v] of Object.entries(_TRUST_PROVEN_SYSTEMS)) {
    if (nm.includes(k)) { provenBadge = `<span style="color:#22c55e;font-size:9px;margin-left:3px" title="PROVEN: ${v.reason}">\u2605</span>`; tierInfo = 'PROVEN'; break; }
  }
  if (!provenBadge) {
    for (const [k, v] of Object.entries(_TRUST_PROBATION)) {
      if (nm.includes(k)) { provenBadge = `<span style="color:#f59e0b;font-size:9px;margin-left:3px" title="PROBATION: ${v.reason}">\u26a0</span>`; tierInfo = 'PROBATION'; break; }
    }
  }
  if (!provenBadge) {
    for (const [k, v] of Object.entries(_TRUST_DEMOTED)) {
      if (nm.includes(k)) { provenBadge = `<span style="color:#ef4444;font-size:9px;margin-left:3px" title="DEMOTED: ${v.reason}">\u2716</span>`; tierInfo = 'DEMOTED'; break; }
    }
  }
  // Add trade count bracket + hover breakdown
  const sys = (D.systems || []).find(s => s.name === name);
  let tradeInfo = '';
  if (sys) {
    const closed = sys.closed_picks || 0;
    const active = sys.active_picks || 0;
    const wr = sys.win_rate != null ? fmt(Math.min(100, sys.win_rate), 1) + '% WR' : '';
    const pf = sys.profit_factor != null ? 'PF ' + fmt(sys.profit_factor, 2) : '';
    const pnl = sys.total_pnl_pct != null ? fmtPct(sys.total_pnl_pct) + ' PnL' : '';
    const wins = sys.wins ?? Math.round(closed * (sys.win_rate || 0) / 100);
    const losses = closed - wins;
    const hoverText = [
      `${active} active / ${closed} closed`,
      `W:${wins} L:${losses}`,
      wr, pf, pnl,
      tierInfo ? `Tier: ${tierInfo}` : 'Tier: SANDBOX'
    ].filter(Boolean).join(' | ');
    const wrColor = (sys.win_rate || 0) >= 50 ? '#22c55e' : '#ef4444';
    tradeInfo = ` <span style="color:${wrColor};font-size:10px;opacity:0.8" title="${hoverText}">[${closed}t ${wr}]</span>`;
  }
  return (url ? `<a href="${url}" target="_blank" title="Open ${display} dashboard">${display}</a>` : display) + provenBadge + tradeInfo;
}

