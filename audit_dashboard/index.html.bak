};

// ── Live Price Updater — multi-API failover, auto-refresh every 30s ──
const PRICE_APIS = [
  {
    name: 'Binance',
    fetch: async () => {
      // Try multiple Binance hosts for geo-block failover
      const hosts = ['api.binance.com','api1.binance.com','api2.binance.com','api.binance.us','data-api.binance.vision'];
      for (const host of hosts) {
        try {
          const r = await fetch(`https://${host}/api/v3/ticker/price`, {signal: AbortSignal.timeout(8000)});
          if (!r.ok) continue;
          const d = await r.json();
          const m = {};
          for (const t of d) m[t.symbol] = parseFloat(t.price);
          if (Object.keys(m).length > 0) return m;
        } catch(e) { /* try next host */ }
      }
      throw new Error('All Binance hosts failed');
    }
  },
  {
    name: 'Bybit',
    fetch: async () => {
      const r = await fetch('https://api.bybit.com/v5/market/tickers?category=spot');
      if (!r.ok) throw new Error(r.status);
      const d = await r.json();
      const m = {};
      for (const t of (d.result?.list || [])) m[t.symbol] = parseFloat(t.lastPrice);
      return m;
    }
  },
  {
    name: 'CoinGecko',
    fetch: async (symbols) => {
      const idMap = {BTC:'bitcoin',ETH:'ethereum',SOL:'solana',XRP:'ripple',BNB:'binancecoin',
        DOGE:'dogecoin',ADA:'cardano',AVAX:'avalanche-2',LINK:'chainlink',DOT:'polkadot',
        NEAR:'near',HBAR:'hedera-hashgraph',OP:'optimism',MATIC:'matic-network',
        TRX:'tron',MANA:'decentraland',SHIB:'shiba-inu',BONK:'bonk',FLOKI:'floki',
        RENDER:'render-token',FET:'fetch-ai',UNI:'uniswap',AAVE:'aave',ARB:'arbitrum',
        SUI:'sui',APT:'aptos',SEI:'sei-network',PEPE:'pepe',WIF:'dogwifcoin'};
      const bases = [...new Set(symbols.map(s => s.replace(/USDT$|USD$/,'')))];
      const ids = bases.map(b => idMap[b] || b.toLowerCase()).filter(Boolean).join(',');
      if (!ids) return {};
      const r = await fetch(`https://api.coingecko.com/api/v3/simple/price?ids=${ids}&vs_currencies=usd`);
      if (!r.ok) throw new Error(r.status);
      const data = await r.json();
      const m = {};
      for (const [id, v] of Object.entries(data)) {
        const base = Object.entries(idMap).find(([k,v2]) => v2===id)?.[0] || id.toUpperCase();
        m[base+'USDT'] = v.usd;
        m[base+'USD'] = v.usd;
      }
      return m;
    }
  },
  {
    name: 'CryptoCompare',
    fetch: async (symbols) => {
      const bases = [...new Set(symbols.map(s => s.replace(/USDT$|USD$/,'')))].slice(0,30);
      const r = await fetch(`https://min-api.cryptocompare.com/data/pricemulti?fsyms=${bases.join(',')}&tsyms=USD`);
      if (!r.ok) throw new Error(r.status);
      const data = await r.json();
      const m = {};
      for (const [base, obj] of Object.entries(data)) {
        if (obj.USD) { m[base+'USDT'] = obj.USD; m[base+'USD'] = obj.USD; }
      }
      return m;
    }
  }
];

let _livePriceState = { api: null, lastUpdate: null, updated: 0, total: 0, errors: [] };

// ── Forex live price fetcher ──
// Forex =X symbols (EURUSD=X) need dedicated APIs since Binance/CoinGecko don't cover them
async function fetchForexPrices(picks) {
  const forexPicks = picks.filter(p => (p.symbol||'').includes('=X'));
  if (!forexPicks.length) return 0;

  // Parse forex symbols: EURUSD=X → base=EUR, quote=USD
  const forexPairs = {};
  for (const p of forexPicks) {
    const sym = p.symbol.replace('=X','');
    // Standard 6-char forex pairs: first 3 = base, last 3 = quote
    if (sym.length === 6) {
      const base = sym.substring(0, 3);
      const quote = sym.substring(3, 6);
      forexPairs[p.symbol] = { base, quote };
    }
  }
  if (!Object.keys(forexPairs).length) return 0;

  // Collect unique bases we need rates for (all vs USD)
  const allCurrencies = new Set();
  for (const {base, quote} of Object.values(forexPairs)) {
    allCurrencies.add(base);
    allCurrencies.add(quote);
  }
  allCurrencies.delete('USD');

  // Fetch rates from multiple free APIs
  let usdRates = {}; // currency -> rate vs USD (e.g., EUR -> 1.14)
  usdRates['USD'] = 1.0;

  const forexApis = [
    {
      name: 'ExchangeRate-API',
      fetch: async () => {
        const r = await fetch('https://open.er-api.com/v6/latest/USD', {signal: AbortSignal.timeout(8000)});
        if (!r.ok) throw new Error(r.status);
        const d = await r.json();
        return d.rates || {};
      },
      parse: (rates) => {
        // rates are USD-based: EUR=0.877 means 1 USD = 0.877 EUR, so EURUSD = 1/0.877
        const m = {};
        for (const [cur, rate] of Object.entries(rates)) {
          if (rate > 0) m[cur] = 1.0 / rate; // Convert to "1 unit of currency = X USD"
        }
        m['USD'] = 1.0;
        return m;
      }
    },
    {
      name: 'Frankfurter',
      fetch: async () => {
        const symbols = [...allCurrencies].join(',');
        const r = await fetch(`https://api.frankfurter.app/latest?from=USD&to=${symbols}`, {signal: AbortSignal.timeout(8000)});
        if (!r.ok) throw new Error(r.status);
        const d = await r.json();
        return d.rates || {};
      },
      parse: (rates) => {
        const m = {};
        for (const [cur, rate] of Object.entries(rates)) {
          if (rate > 0) m[cur] = 1.0 / rate;
        }
        m['USD'] = 1.0;
        return m;
      }
    }
  ];

  for (const api of forexApis) {
    try {
      const rawRates = await api.fetch();
      usdRates = api.parse(rawRates);
      if (Object.keys(usdRates).length > 2) {
        console.log(`[FOREX] Got ${Object.keys(usdRates).length} rates from ${api.name}`);
        break;
      }
    } catch(e) {
      console.warn(`[FOREX] ${api.name} failed:`, e.message);
    }
  }

  if (Object.keys(usdRates).length <= 1) return 0;

  // Compute cross rates and apply to picks
  let updated = 0;
  for (const p of forexPicks) {
    const pair = forexPairs[p.symbol];
    if (!pair) continue;
    const baseRate = usdRates[pair.base]; // e.g., EUR = 1.14 USD
    const quoteRate = usdRates[pair.quote]; // e.g., USD = 1.0
    if (!baseRate || !quoteRate) continue;

    // Cross rate: EURUSD = baseRate / quoteRate = 1.14/1.0 = 1.14
    // GBPJPY = GBP_in_USD / JPY_in_USD = 1.30 / 0.0063 = 206.3
    const livePrice = baseRate / quoteRate;
    const entry = parseFloat(p.entry_price) || 0;
    if (!entry || !livePrice) continue;

    p._livePrice = livePrice;
    p.current_price = livePrice;
    if (p.direction === 'SHORT' || p.direction === 'SELL') {
      p.pnl_pct = parseFloat(((entry - livePrice) / entry * 100).toFixed(4));
    } else {
      p.pnl_pct = parseFloat(((livePrice - entry) / entry * 100).toFixed(4));
    }
    if (Math.abs(p.pnl_pct) > 500) { p.pnl_flagged = true; p.pnl_pct = null; continue; }
    const tp = parseFloat(p.take_profit), sl = parseFloat(p.stop_loss);
    if (tp && sl && entry) {
      const tpDist = Math.abs(tp - entry), slDist = Math.abs(sl - entry);
      const total = tpDist + slDist;
      if (total > 0) {
        if (p.direction === 'SHORT' || p.direction === 'SELL') {
          const progress = (entry - livePrice) / (entry - tp);
          p.tp_remaining_pct = parseFloat(Math.max(0, Math.min(100, (1 - progress) * 100)).toFixed(1));
          const slProgress = (livePrice - entry) / (sl - entry);
          p.sl_remaining_pct = parseFloat(Math.max(0, Math.min(100, (1 - slProgress) * 100)).toFixed(1));
          p.price_position = parseFloat(((entry - livePrice) / total * 100 + slDist/total*100).toFixed(1));
        } else {
          const progress = (livePrice - entry) / (tp - entry);
          p.tp_remaining_pct = parseFloat(Math.max(0, Math.min(100, (1 - progress) * 100)).toFixed(1));
          const slProgress = (entry - livePrice) / (entry - sl);
          p.sl_remaining_pct = parseFloat(Math.max(0, Math.min(100, (1 - slProgress) * 100)).toFixed(1));
          p.price_position = parseFloat(((livePrice - sl) / total * 100).toFixed(1));
        }
      }
    }
    // TP/SL breach detection
    if (tp && entry) {
      if (p.direction === 'SHORT' || p.direction === 'SELL') {
        if (livePrice <= tp * 1.001) p._resolved_live = 'TP_HIT';
        else if (sl && livePrice >= sl * 0.999) p._resolved_live = 'SL_HIT';
      } else {
        if (livePrice >= tp * 0.999) p._resolved_live = 'TP_HIT';
        else if (sl && livePrice <= sl * 1.001) p._resolved_live = 'SL_HIT';
      }
    }
    updated++;
  }
  console.log(`[FOREX] Updated ${updated}/${forexPicks.length} forex picks with live prices`);
  return updated;
}

// ── Stock/ETF/Futures live price fetcher ──
// Only fetches REAL stocks/ETFs — NOT crypto tokens with bare symbols
const _KNOWN_STOCKS = new Set([
  'SPY','QQQ','AAPL','NVDA','MSFT','AMZN','GOOG','GOOGL','META','TSLA','AMD','AVGO','ADBE','CRM','CSCO','ORCL','IBM','NFLX',
  'JPM','BAC','WFC','GS','MS','SCHW','V','MA',
  'JNJ','PFE','UNH','LLY','MRK','ABBV',
  'XOM','CVX','COP','SLB','XLE',
  'HD','WMT','MCD','NKE','COST','KO','PEP','PG','DIS','UBER',
  'CAT','BA','RTX','GE','HON','LIN','UPS',
  'NEE','SO','PLD','AMT',
  'GLD','SLV','IWM','HYG','XLF','SOXX',
  'NIO','AMC','RIOT','COIN','BB',
  'GC','HG','SI','ZN','YM', // futures
]);
async function fetchStockPrices(picks) {
  // Only pick up symbols that are known stocks/ETFs/futures — NOT crypto
  // Also allow explicit asset_class:'EQUITY' picks (e.g. from AI Battle / Claude Top Picks tabs)
  const stockPicks = picks.filter(p => {
    const sym = (p.symbol || '').replace('=F','');
    if (sym.includes('=X') || sym.endsWith('USDT') || sym.endsWith('USD') || sym.endsWith('-USD')) return false;
    if ((p.asset_class || '').toUpperCase() === 'EQUITY') return true;
    return _KNOWN_STOCKS.has(sym);
  });
  if (!stockPicks.length) return 0;

  const symbolMap = {};
  for (const p of stockPicks) {
    const apiSym = p.symbol.replace('=F','');
    symbolMap[apiSym] = p.symbol;
  }
  const uniqueSymbols = [...new Set(Object.keys(symbolMap))];
  if (!uniqueSymbols.length) return 0;

  console.log(`[STOCKS] Fetching prices for ${uniqueSymbols.length} stock/ETF symbols...`);
  let priceMap = {};

  // Tier 0a: Pre-baked prices from CI pipeline (server-side yfinance, no CORS ever)
  // Written by audit_trail/fetch_stock_prices.py during each workflow run.
  // Served from audit/data/stock_prices.json — same data/ dir as dashboard_payload.json.
  try {
    const r = await fetch('data/stock_prices.json?t=' + Date.now(), {signal: AbortSignal.timeout(8000)});
    if (r.ok) {
      const data = await r.json();
      const baked = data.prices || {};
      let bakedCount = 0;
      for (const [sym, price] of Object.entries(baked)) {
        if (price > 0 && (symbolMap[sym] !== undefined || _KNOWN_STOCKS.has(sym.replace('=F','')))) {
          priceMap[symbolMap[sym] || sym] = price;
          bakedCount++;
        }
      }
      if (bakedCount > 0) {
        console.log(`[STOCKS] Pre-baked CI prices: ${bakedCount}/${uniqueSymbols.length} (updated: ${data.updated_at || '?'})`);
        // If we got the majority of symbols, skip all other tiers and return early
        if (bakedCount >= uniqueSymbols.length * 0.5) {
          let updated = 0;
          for (const p of stockPicks) {
            const livePrice = priceMap[p.symbol];
            if (!livePrice) continue;
            const entry = parseFloat(p.entry_price) || 0;
            if (!entry) continue;
            p._livePrice = livePrice; p.current_price = livePrice;
            const isShort = p.direction === 'SHORT' || p.direction === 'SELL';
            p.pnl_pct = isShort
              ? parseFloat(((entry - livePrice) / entry * 100).toFixed(4))
              : parseFloat(((livePrice - entry) / entry * 100).toFixed(4));
            updated++;
          }
          console.log(`[STOCKS] Early return from pre-baked: ${updated} picks updated`);
          return updated;
        }
      }
    }
  } catch(e) { console.warn('[STOCKS] Pre-baked CI prices failed:', e.message); }

  // Tier 0: Own GitHub Pages JSON (updated every 30 min by production scanner via yfinance)
  // No CORS issues — same origin. Most reliable source.
  try {
    const ghUrl = 'https://eltonaguiar.github.io/findtorontoevents_antigravity.ca/alpha/data/stock_forex_prices.json';
    const r = await fetch(ghUrl + '?t=' + Date.now(), {signal: AbortSignal.timeout(8000)});
    if (r.ok) {
      const data = await r.json();
      const prices = data.prices || {};
      for (const [sym, price] of Object.entries(prices)) {
        if (price > 0) {
          const origSym = symbolMap[sym] || sym;
          if (_KNOWN_STOCKS.has(sym.replace('=F','')) || _KNOWN_STOCKS.has(origSym.replace('=F',''))) {
            priceMap[origSym] = price;
          }
        }
      }
      if (Object.keys(priceMap).length > 0) {
        console.log(`[STOCKS] GitHub Pages JSON: ${Object.keys(priceMap).length} prices (updated ${data.updated_at || '?'})`);
      }
    }
  } catch(e) { console.warn('[STOCKS] GitHub Pages JSON failed:', e.message); }

  // Tier 1: Yahoo Finance v8 spark — single batch request, free, no key needed
  try {
    const syms = uniqueSymbols.join(',');
    const r = await fetch('https://query1.finance.yahoo.com/v8/finance/spark?symbols=' + encodeURIComponent(syms) + '&range=1d&interval=1d', {signal: AbortSignal.timeout(10000)});
    if (r.ok) {
      const data = await r.json();
      (data.spark?.result || []).forEach(item => {
        const close = item.response?.[0]?.meta?.regularMarketPrice;
        if (item.symbol && close) { priceMap[symbolMap[item.symbol] || item.symbol] = close; }
      });
      if (Object.keys(priceMap).length > 0) {
        console.log(`[STOCKS] Yahoo v8: ${Object.keys(priceMap).length}/${uniqueSymbols.length} prices`);
        if (Object.keys(priceMap).length > uniqueSymbols.length * 0.5) { /* fall through to apply */ }
      }
    }
  } catch(e) { console.warn('[STOCKS] Yahoo v8 failed:', e.message); }

  // Tier 2: Yahoo Finance v7 quote — batch, free
  if (Object.keys(priceMap).length <= uniqueSymbols.length * 0.5) {
    try {
      const syms = uniqueSymbols.join(',');
      const r = await fetch('https://query1.finance.yahoo.com/v7/finance/quote?symbols=' + encodeURIComponent(syms), {signal: AbortSignal.timeout(10000)});
      if (r.ok) {
        const data = await r.json();
        (data.quoteResponse?.result || []).forEach(q => {
          if (q.symbol && q.regularMarketPrice) { priceMap[symbolMap[q.symbol] || q.symbol] = q.regularMarketPrice; }
        });
        if (Object.keys(priceMap).length > 0) console.log(`[STOCKS] Yahoo v7: ${Object.keys(priceMap).length}/${uniqueSymbols.length} prices`);
      }
    } catch(e) { console.warn('[STOCKS] Yahoo v7 failed:', e.message); }
  }

  // Tier 3: Yahoo v6 via alternate host (query2)
  if (Object.keys(priceMap).length <= uniqueSymbols.length * 0.5) {
    try {
      const syms = uniqueSymbols.join(',');
      const r = await fetch('https://query2.finance.yahoo.com/v6/finance/quote?symbols=' + encodeURIComponent(syms), {signal: AbortSignal.timeout(10000)});
      if (r.ok) {
        const data = await r.json();
        (data.quoteResponse?.result || []).forEach(q => {
          if (q.symbol && q.regularMarketPrice) { priceMap[symbolMap[q.symbol] || q.symbol] = q.regularMarketPrice; }
        });
        if (Object.keys(priceMap).length > 0) console.log(`[STOCKS] Yahoo v6: ${Object.keys(priceMap).length}/${uniqueSymbols.length} prices`);
      }
    } catch(e) { console.warn('[STOCKS] Yahoo v6 failed:', e.message); }
  }

  // Tier 4: Twelve Data — free tier, 800 req/day, batch up to 12
  {
    const missing4 = uniqueSymbols.filter(s => !priceMap[symbolMap[s] || s]);
    if (missing4.length > 0) {
      try {
        for (let i = 0; i < missing4.length; i += 12) {
          const chunk = missing4.slice(i, i + 12).join(',');
          const r = await fetch('https://api.twelvedata.com/price?symbol=' + encodeURIComponent(chunk) + '&apikey=demo', {signal: AbortSignal.timeout(8000)});
          if (r.ok) {
            const data = await r.json();
            if (data && typeof data === 'object') {
              if (data.price) {
                // Single symbol response
                const price = parseFloat(data.price);
                if (price > 0) priceMap[symbolMap[missing4[i]] || missing4[i]] = price;
              } else {
                for (const [sym, val] of Object.entries(data)) {
                  const price = parseFloat(val?.price || val);
                  if (price > 0) priceMap[symbolMap[sym] || sym] = price;
                }
              }
            }
          }
          if (i + 12 < missing4.length) await new Promise(r => setTimeout(r, 500));
        }
        if (Object.keys(priceMap).length > 0) console.log(`[STOCKS] TwelveData: ${Object.keys(priceMap).length}/${uniqueSymbols.length} prices`);
      } catch(e) { console.warn('[STOCKS] Twelve Data failed:', e.message); }
    }
  }

  // Tier 5: Alpha Vantage — free, 25 req/day, up to 5 remaining gaps
  {
    const missing5 = uniqueSymbols.filter(s => !priceMap[symbolMap[s] || s]).slice(0, 5);
    if (missing5.length > 0) {
      try {
        for (const sym of missing5) {
          const r = await fetch(`https://www.alphavantage.co/query?function=GLOBAL_QUOTE&symbol=${sym}&apikey=demo`, {signal: AbortSignal.timeout(8000)});
          if (r.ok) {
            const d = await r.json();
            const price = parseFloat(d?.['Global Quote']?.['05. price']);
            if (price > 0) priceMap[symbolMap[sym] || sym] = price;
          }
          await new Promise(r => setTimeout(r, 300));
        }
        if (Object.keys(priceMap).length > 0) console.log(`[STOCKS] AlphaVantage: ${Object.keys(priceMap).length}/${uniqueSymbols.length} prices`);
      } catch(e) { console.warn('[STOCKS] AlphaVantage failed:', e.message); }
    }
  }

  // Tier 6: FMP — capped at 5 to avoid 429
  {
    const missing6 = uniqueSymbols.filter(s => !priceMap[symbolMap[s] || s]).slice(0, 5);
    if (missing6.length > 0) {
      try {
        const FMP_KEY = 'iF4K10WedJZINDhUWGXlGAiA57rn4sRD';
        for (const sym of missing6) {
          try {
            const r = await fetch(`https://financialmodelingprep.com/stable/profile?symbol=${sym}&apikey=${FMP_KEY}`, {signal: AbortSignal.timeout(8000)});
            if (r.ok) {
              const data = await r.json();
              const entry = Array.isArray(data) ? data[0] : data;
              if (entry?.price) { priceMap[symbolMap[entry.symbol || sym] || sym] = entry.price; }
            }
          } catch(e) { /* skip individual */ }
          await new Promise(r => setTimeout(r, 200));
        }
        if (Object.keys(priceMap).length > 0) console.log(`[STOCKS] FMP: ${Object.keys(priceMap).length}/${uniqueSymbols.length} prices`);
      } catch(e) { console.warn('[STOCKS] FMP failed:', e.message); }
    }
  }

  // Tier 7: Google Finance scrape via allorigins proxy (last resort, up to 3)
  {
    const missing7 = uniqueSymbols.filter(s => !priceMap[symbolMap[s] || s]).slice(0, 3);
    if (missing7.length > 0) {
      try {
        for (const sym of missing7) {
          const cleanSym = sym.replace('=F', '');
          const r = await fetch('https://api.allorigins.win/raw?url=' + encodeURIComponent('https://www.google.com/finance/quote/' + cleanSym + ':NYSE'), {signal: AbortSignal.timeout(10000)});
          if (r.ok) {
            const html = await r.text();
            const match = html.match(/data-last-price="([0-9.]+)"/);
            if (match) priceMap[symbolMap[sym] || sym] = parseFloat(match[1]);
          }
          await new Promise(r => setTimeout(r, 500));
        }
      } catch(e) { console.warn('[STOCKS] Google scrape failed:', e.message); }
    }
  }

  const _finalMissed = uniqueSymbols.filter(s => !priceMap[symbolMap[s] || s]);
  if (_finalMissed.length > 0) console.warn(`[STOCKS] Still missing after 7 tiers: ${_finalMissed.join(', ')}`);
  console.log(`[STOCKS] Final: ${Object.keys(priceMap).length}/${uniqueSymbols.length} prices resolved`);

  if (!Object.keys(priceMap).length) return 0;

  // Apply prices
  let updated = 0;
  for (const p of stockPicks) {
    const livePrice = priceMap[p.symbol];
    if (!livePrice) continue;
    const entry = parseFloat(p.entry_price) || 0;
    if (!entry) continue;
    p._livePrice = livePrice; p.current_price = livePrice;
    const isShort = p.direction === 'SHORT' || p.direction === 'SELL';
    p.pnl_pct = isShort
      ? parseFloat(((entry - livePrice) / entry * 100).toFixed(4))
      : parseFloat(((livePrice - entry) / entry * 100).toFixed(4));
    if (Math.abs(p.pnl_pct) > 500) { p.pnl_flagged = true; p.pnl_pct = null; continue; }
    const tp = parseFloat(p.take_profit), sl = parseFloat(p.stop_loss);
    if (tp && sl && entry) {
      const tpDist = Math.abs(tp - entry), slDist = Math.abs(sl - entry), total = tpDist + slDist;
      if (total > 0) {
        if (isShort) {
          p.tp_remaining_pct = parseFloat(Math.max(0, Math.min(100, (1-(entry-livePrice)/(entry-tp))*100)).toFixed(1));
          p.sl_remaining_pct = parseFloat(Math.max(0, Math.min(100, (1-(livePrice-entry)/(sl-entry))*100)).toFixed(1));
          p.price_position = parseFloat(((entry-livePrice)/total*100+slDist/total*100).toFixed(1));
        } else {
          p.tp_remaining_pct = parseFloat(Math.max(0, Math.min(100, (1-(livePrice-entry)/(tp-entry))*100)).toFixed(1));
          p.sl_remaining_pct = parseFloat(Math.max(0, Math.min(100, (1-(entry-livePrice)/(entry-sl))*100)).toFixed(1));
          p.price_position = parseFloat(((livePrice-sl)/total*100).toFixed(1));
        }
      }
    }
    if (tp && entry) {
      if (isShort) {
        if (livePrice <= tp * 1.001) p._resolved_live = 'TP_HIT';
        else if (sl && livePrice >= sl * 0.999) p._resolved_live = 'SL_HIT';
      } else {
        if (livePrice >= tp * 0.999) p._resolved_live = 'TP_HIT';
        else if (sl && livePrice <= sl * 1.001) p._resolved_live = 'SL_HIT';
      }
    }
    updated++;
  }
  console.log(`[STOCKS] Updated ${updated}/${stockPicks.length} stock/ETF picks with live prices`);
  return updated;
}

async function fetchLivePrices(isAutoRefresh) {
  const picks = D.picks?.active || [];
  if (!picks.length) return;

  // Fetch forex prices first (dedicated API)
  let nonCryptoUpdated = 0;
  try {
    nonCryptoUpdated = await fetchForexPrices(picks);
  } catch(e) { console.warn('[FOREX] fetch failed:', e.message); }

  // Fetch stock/ETF/futures prices (dedicated API)
  try {
    nonCryptoUpdated += await fetchStockPrices(picks);
  } catch(e) { console.warn('[STOCKS] fetch failed:', e.message); }

  // Apply server-side prices for stock/ETF picks (no free browser API)
  for (const p of picks) {
    const sym = p.symbol || '';
    if (sym.includes('=X') || sym.endsWith('USDT') || sym.endsWith('USD') || sym.endsWith('-USD') || (p.asset_class||'').toUpperCase() === 'CRYPTO') continue;
    const serverPrice = parseFloat(p.current_price) || 0;
    const entry = parseFloat(p.entry_price) || 0;
    if (!entry || !serverPrice || Math.abs(serverPrice - entry) / entry < 0.00001) continue;
    p._livePrice = serverPrice;
    if (p.direction === 'SHORT' || p.direction === 'SELL') {
      p.pnl_pct = parseFloat(((entry - serverPrice) / entry * 100).toFixed(4));
    } else {
      p.pnl_pct = parseFloat(((serverPrice - entry) / entry * 100).toFixed(4));
    }
    if (Math.abs(p.pnl_pct) > 500) { p.pnl_flagged = true; p.pnl_pct = null; continue; }
    nonCryptoUpdated++;
  }

  const cryptoSyms = [...new Set(picks
    .filter(p => {
      const sym = p.symbol || '';
      return sym.endsWith('USDT') || sym.endsWith('USD') || sym.endsWith('-USD') ||
             (p.asset_class||'').toUpperCase() === 'CRYPTO';
    })
    .map(p => {
      const sym = p.symbol.replace(/-/g,'');
      // Bare crypto tickers (e.g. CGPT, VANA) need USDT suffix for API lookup
      return (sym.endsWith('USDT') || sym.endsWith('USD')) ? sym : sym + 'USDT';
    })
  )];
  if (!cryptoSyms.length) { if (nonCryptoUpdated > 0) renderPicks(); return; }

  let priceMap = {};
  let usedApi = null;
  const errors = [];

  // Try each API in order until one succeeds with data
  for (const api of PRICE_APIS) {
    try {
      const result = await api.fetch(cryptoSyms);
      if (Object.keys(result).length > 0) {
        if (!usedApi) usedApi = api.name;
        const before = Object.keys(priceMap).length;
        Object.assign(priceMap, result);
        const after = Object.keys(priceMap).length;
        if (after > before && usedApi !== api.name) usedApi += '+' + api.name;
        const matched = cryptoSyms.filter(s => priceMap[s] || priceMap[s.replace(/USD$/,'USDT')] || priceMap[s + 'USDT'] || priceMap[s + 'USD']).length;
        if (matched >= cryptoSyms.length * 0.8) break;
      }
    } catch(e) {
      errors.push(`${api.name}: ${e.message}`);
    }
  }

  if (Object.keys(priceMap).length === 0) {
    _livePriceState.errors = errors;
    _updateLiveIndicator();
    return;
  }

  let updated = 0;
  for (const p of picks) {
    const sym = (p.symbol||'').replace(/-/g,'');
    const livePrice = priceMap[sym] || priceMap[sym.replace(/USD$/,'USDT')] || priceMap[sym + 'USDT'] || priceMap[sym + 'USD'];
    if (!livePrice || !p.entry_price) continue;
    const entry = parseFloat(p.entry_price);
    if (!entry) continue;
    p._livePrice = livePrice;
    if (p.direction === 'SHORT') {
      p.pnl_pct = parseFloat(((entry - livePrice) / entry * 100).toFixed(4));
    } else {
      p.pnl_pct = parseFloat(((livePrice - entry) / entry * 100).toFixed(4));
    }
    if (Math.abs(p.pnl_pct) > 500) {
      p.pnl_flagged = true; p.pnl_raw = p.pnl_pct; p.pnl_pct = null; continue;
    }
    const tp = parseFloat(p.take_profit), sl = parseFloat(p.stop_loss);
    if (tp && sl && entry) {
      const tpDist = Math.abs(tp - entry), slDist = Math.abs(sl - entry);
      const total = tpDist + slDist;
      if (total > 0) {
        if (p.direction === 'SHORT') {
          const progress = (entry - livePrice) / (entry - tp);
          p.tp_remaining_pct = parseFloat(Math.max(0, Math.min(100, (1 - progress) * 100)).toFixed(1));
          const slProgress = (livePrice - entry) / (sl - entry);
          p.sl_remaining_pct = parseFloat(Math.max(0, Math.min(100, (1 - slProgress) * 100)).toFixed(1));
          p.price_position = parseFloat(((entry - livePrice) / total * 100 + slDist/total*100).toFixed(1));
        } else {
          const progress = (livePrice - entry) / (tp - entry);
          p.tp_remaining_pct = parseFloat(Math.max(0, Math.min(100, (1 - progress) * 100)).toFixed(1));
          const slProgress = (entry - livePrice) / (entry - sl);
          p.sl_remaining_pct = parseFloat(Math.max(0, Math.min(100, (1 - slProgress) * 100)).toFixed(1));
          p.price_position = parseFloat(((livePrice - sl) / total * 100).toFixed(1));
        }
      }
    }
    // TP/SL breach detection (0.1% buffer for spread/slippage)
    if (tp && entry) {
      if (p.direction === 'SHORT') {
        if (livePrice <= tp * 1.001) { p._resolved_live = 'TP_HIT'; }
        else if (sl && livePrice >= sl * 0.999) { p._resolved_live = 'SL_HIT'; }
      } else {
        if (livePrice >= tp * 0.999) { p._resolved_live = 'TP_HIT'; }
        else if (sl && livePrice <= sl * 1.001) { p._resolved_live = 'SL_HIT'; }
      }
    }
    updated++;
  }

  updated += nonCryptoUpdated; // Include forex/stock picks in count
  _livePriceState = { api: usedApi || (nonCryptoUpdated > 0 ? 'server-side' : null), lastUpdate: new Date(), updated, total: picks.length, errors };

  if (updated > 0) {
    if (!isAutoRefresh) {
      const f = typeof getFilters === 'function' ? getFilters() : {};
      const livePicks = picks.filter(p => p._livePrice).filter(p => typeof matchFilter === 'function' ? matchFilter(p, f) : true);
      const activePnls = livePicks.map(p => p.pnl_pct || 0);
      if (activePnls.length > 0) {
        const avgActivePnl = activePnls.reduce((a,b) => a+b, 0) / activePnls.length;
        const positiveCount = activePnls.filter(p => p > 0).length;
        const negativeCount = activePnls.filter(p => p <= 0).length;
        const summaryEl = el('summary-cards');
        if (summaryEl) {
          const liveCard = document.createElement('div');
          liveCard.className = 'stat-card';
          liveCard.innerHTML = `<div class="label">Active PnL (Live) <span style="color:#22c55e;font-size:9px">\u26a1</span></div><div class="value ${avgActivePnl >= 0 ? 'positive' : 'negative'}">${avgActivePnl >= 0 ? '+' : ''}${avgActivePnl.toFixed(2)}%</div><div class="sub-detail">${livePicks.length} picks with live prices</div><div class="card-tip">Average unrealized PnL across all active picks with live price data. Auto-refreshes every 30s via ${usedApi}. Only includes picks matched by current filters.</div>`;
          summaryEl.appendChild(liveCard);
          const liveSplitCard = document.createElement('div');
          liveSplitCard.className = 'stat-card';
          liveSplitCard.innerHTML = `<div class="label">Active W/L (Live) <span style="color:#22c55e;font-size:9px">\u26a1</span></div><div class="value">${positiveCount} / ${negativeCount}</div><div class="sub-detail">${(positiveCount/(positiveCount+negativeCount)*100).toFixed(0)}% currently green</div><div class="card-tip">Of the ${livePicks.length} live-priced picks, how many are currently profitable (green) vs underwater (red). This is a snapshot — picks can flip as prices move.</div>`;
          summaryEl.appendChild(liveSplitCard);
        }
      }
    }
    _updateLiveIndicator();
    renderPicks();
    renderAgreementMatrix();
    renderOverview();
    renderLeaderboard();
  }
}

function _updateLiveIndicator() {
  let ind = document.getElementById('live-price-indicator');
  if (!ind) {
    ind = document.createElement('div');
    ind.id = 'live-price-indicator';
    ind.style.cssText = 'font-size:11px;padding:6px 12px;background:linear-gradient(135deg,#0d1117cc,#161b22cc);border:1px solid #30363d;border-radius:6px;margin:8px 0;display:flex;align-items:center;gap:8px;flex-wrap:wrap;';
    const bar = document.querySelector('.filter-bar');
    if (bar) bar.parentElement.insertBefore(ind, bar.nextSibling);
    else document.querySelector('.header')?.appendChild(ind);
  }
  const s = _livePriceState;
  if (s.errors.length > 0 && !s.api) {
    ind.innerHTML = `<span style="color:#ef4444">\u274c All price APIs failed</span><span style="color:#666;font-size:10px">${s.errors.join(' | ')}</span>`;
  } else {
    const ts = s.lastUpdate ? s.lastUpdate.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit',second:'2-digit',timeZone:'America/New_York'}) : '?';
    const pulseDot = '<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#22c55e;animation:pulse 2s infinite;margin-right:2px"></span>';
    ind.innerHTML = `${pulseDot}<span style="color:#22c55e;font-weight:600">\u26a1 LIVE</span>`
      + `<span style="color:#9ca3af">Prices via <strong style="color:#60a5fa">${s.api}</strong></span>`
      + `<span style="color:#9ca3af">${s.updated}/${s.total} picks</span>`
      + `<span style="color:#666">Updated ${ts} EST</span>`
      + `<span style="color:#666;font-size:10px" id="price-refresh-countdown">Next: 30s</span>`
      + (s.errors.length ? `<span style="color:#f59e0b;font-size:10px">${s.errors.join(', ')}</span>` : '');
  }
  if (!document.getElementById('live-pulse-css')) {
    const style = document.createElement('style');
    style.id = 'live-pulse-css';
    style.textContent = '@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}';
    document.head.appendChild(style);
  }
}

// Auto-refresh every 30 seconds
let _priceRefreshCountdown = 30;
setInterval(() => {
  _priceRefreshCountdown--;
  const el = document.getElementById('price-refresh-countdown');
  if (el) el.textContent = `Next: ${Math.max(0,_priceRefreshCountdown)}s`;
  if (_priceRefreshCountdown <= 0) {
    _priceRefreshCountdown = 30;
    fetchLivePrices(true);
  }
}, 1000);

// ── Performance Alerts ──
function renderPerfAlerts() {
  const alerts = D.performance_alerts || [];
  const el = document.getElementById('perf-alerts-container');
  if (!el) return;
  if (!alerts.length) { el.innerHTML = ''; return; }
  const icons = { CRITICAL: '\u26a0\ufe0f', HIGH: '\u26a0', MEDIUM: '\u25b2', LOW: '\u2139\ufe0f' };
  el.innerHTML = alerts.map(a =>
    `<div class="perf-alert sev-${a.severity}">` +
    `<span class="pa-sev">${icons[a.severity]||''} ${a.severity}</span>` +
    `<span class="pa-msg">${a.message}</span>` +
    `<span class="pa-action">${a.action}</span></div>`
  ).join('');
  // Badge on Overview tab
  const crit = alerts.filter(a => a.severity === 'CRITICAL' || a.severity === 'HIGH').length;
  if (crit > 0) {
    document.querySelectorAll('.tab-btn').forEach(btn => {
      if (btn.textContent.includes('Overview') && !btn.querySelector('.alert-count-badge')) {
        btn.insertAdjacentHTML('beforeend', `<span class="alert-count-badge">${crit}</span>`);
      }
    });
  }
}

// ── Helpers ──
const fmt = (n, d=1) => n != null ? Number(n).toFixed(d) : '—';
const fmtPct = (n) => n != null ? (n >= 0 ? '+' : '') + Number(n).toFixed(2) + '%' : '—';
const pnlClass = (n) => n > 0 ? 'pnl-pos' : n < 0 ? 'pnl-neg' : 'pnl-zero';
const acBadge = (ac) => `<span class="badge badge-${(ac||'').toLowerCase()}">${ac||'?'}</span>`;
const dirBadge = (d) => `<span class="badge badge-${(d||'').toLowerCase()}">${d||'?'}</span>`;
const statusBadge = (s) => `<span class="badge badge-${s}">${s}</span>`;

function el(id) { return document.getElementById(id); }

// ── Summary cards (filter-aware) ──
function renderSummary() {
  const s = D.summary || {};
  const f = typeof getFilters === 'function' ? getFilters() : {};
  const hasFilters = f.asset || f.system || f.status || f.dir || f.search || f.pnl || f.conf || f.age || f.tpRem || f.conflicts || window._provenOnlyFilter || window._scoreGateFilter;

  // When filters active, recompute stats from filtered picks
  let activePicks = D.picks?.active || [];
  let closedPicks = D.picks?.recent_closed || [];

  // Filter picks by entry price validity (same as renderPicks)
  activePicks = activePicks.filter(p => {
    const entry = parseFloat(p.entry_price) || 0;
    return entry > 0 && entry <= 1000000;
  });
  // Filter out BLOCKED systems (same as renderPicks)
  activePicks = activePicks.filter(p => !isBlockedSystem(p.source_system));
  closedPicks = closedPicks.filter(p => !isBlockedSystem(p.source_system));
  // Auto-remove stale low-impact picks (same as renderPicks)
  const _now = Date.now();
  activePicks = activePicks.map(p => {
    if (p.timestamp) {
      try {
        let ts = String(p.timestamp).trim();
        if (!/[Z+-]\d{2}:?\d{2}$/.test(ts) && !ts.endsWith('Z')) ts += 'Z';
        const ms = Date.parse(ts);
        if (!isNaN(ms)) p.age_hours = Math.max(0, (_now - ms) / 3600000);
      } catch(e) {}
    }
    return p;
  }).filter(p => {
    const age = p.age_hours ?? 999;
    const pnl = p.pnl_pct ?? 0;
    return !(age > 48 && Math.abs(pnl) < 1);
  });

  if (hasFilters) {
    activePicks = activePicks.filter(p => matchFilter(p, f));
    closedPicks = closedPicks.filter(p => matchFilter(p, f));
  }
  // Apply proven-only filter to summary stats (same as renderPicks)
  if (window._provenOnlyFilter) {
    activePicks = activePicks.filter(p => {
      const t = getTrustTier(p);
      return t.tier === 'PROVEN' || t.tier === 'RELIABLE';
    });
    closedPicks = closedPicks.filter(p => {
      const t = getTrustTier(p);
      return t.tier === 'PROVEN' || t.tier === 'RELIABLE';
    });
  }
  // Apply score gate filter to summary stats (same as renderPicks)
  if (window._scoreGateFilter) {
    activePicks = activePicks.filter(p => (p.score || 0) >= 24);
    closedPicks = closedPicks.filter(p => (p.score || 0) >= 24);
  }

  // Compute filtered stats
  const totalActive = activePicks.length;
  const totalClosed = closedPicks.length;
  const wins = closedPicks.filter(p => (p.pnl_pct || 0) > 0).length;
  const losses = closedPicks.length - wins;
  const winRate = closedPicks.length > 0 ? (wins / closedPicks.length * 100) : (hasFilters ? 0 : s.overall_win_rate);
  const totalPnl = closedPicks.length > 0 ? closedPicks.reduce((sum, p) => sum + (p.pnl_pct || 0), 0) : (hasFilters ? 0 : s.total_pnl_pct);
  const winPnl = closedPicks.filter(p => (p.pnl_pct||0) > 0).reduce((sum, p) => sum + p.pnl_pct, 0);
  const lossPnl = Math.abs(closedPicks.filter(p => (p.pnl_pct||0) < 0).reduce((sum, p) => sum + p.pnl_pct, 0));
  const profitFactor = lossPnl > 0 ? winPnl / lossPnl : (winPnl > 0 ? Infinity : 0);
  const avgWin = wins > 0 ? winPnl / wins : 0;
  const avgLoss = losses > 0 ? lossPnl / losses : 0;
  const expectancy = closedPicks.length > 0 ? totalPnl / closedPicks.length : 0;
  const uniqueSystems = new Set(activePicks.map(p => p.source_system)).size;

  // Proven vs probation breakdown for active picks
  // Use trust_tier if already set, otherwise classify by system win rate
  const provenPicksList = activePicks.filter(p => {
    if (p.trust_tier) return p.trust_tier === 'PROVEN';
    const sys = (D.systems || []).find(s => s.name === p.source_system);
    return sys && (sys.total_trades || 0) >= 30 && (sys.win_rate || 0) >= 45;
  });
  const provenPicks = provenPicksList.length;
  const probationPicks = totalActive - provenPicks;

  // Build proven breakdown by system for tooltip
  const provenBySystem = {};
  provenPicksList.forEach(p => {
    const sys = p.source_system || 'unknown';
    if (!provenBySystem[sys]) provenBySystem[sys] = { count: 0, symbols: [] };
    provenBySystem[sys].count++;
    if (provenBySystem[sys].symbols.length < 5) provenBySystem[sys].symbols.push(p.symbol);
  });
  const provenBreakdownHtml = Object.entries(provenBySystem)
    .sort((a,b) => b[1].count - a[1].count)
    .map(([sys, info]) => {
      const displaySys = sys.replace(/_/g, ' ');
      const sysData = (D.systems||[]).find(s => s.name === sys);
      const wrInfo = sysData ? ` (${fmt(sysData.win_rate)}% WR)` : '';
      return `${displaySys}${wrInfo}: ${info.count} picks — ${info.symbols.join(', ')}${info.count > 5 ? '…' : ''}`;
    }).join('\n');

  // Use filtered stats when filters active, otherwise use pre-computed summary
  const displayWinRate = hasFilters ? winRate : (s.overall_win_rate || 0);
  const displayPnl = hasFilters ? totalPnl : (s.total_pnl_pct || 0);
  const displayPF = hasFilters ? profitFactor : (s.profit_factor || 0);
  const displayExpectancy = hasFilters ? expectancy : (s.expectancy || 0);
  const displayAvgWin = hasFilters ? avgWin : (s.avg_win || 0);
  const displayAvgLoss = hasFilters ? avgLoss : (s.avg_loss || 0);
  const displayWins = hasFilters ? wins : (s.wins || 0);
  const displayLosses = hasFilters ? losses : (s.losses || 0);
  const displaySystems = hasFilters ? uniqueSystems : (s.total_systems || 0);

  const cardTips = {
    active: `Total active (open) picks across ${hasFilters ? 'filtered' : 'all'} systems. ${provenPicks} from proven systems (30+ trades, 45%+ WR) and ${probationPicks} from probation/sandbox systems. Stale picks (>48h with <1% PnL) and broken entries (>$1M) are auto-hidden.\n\n───── PROVEN BREAKDOWN ─────\n${provenBreakdownHtml}`,
    closed: `Recently closed trades ${hasFilters ? 'matching current filters' : '(up to 2,000 most recent)'}. Used to calculate Win Rate, PnL, and Profit Factor.`,
    winRate: `Percentage of closed trades that were profitable. Calculated from ${hasFilters ? totalClosed + ' filtered' : 'all'} closed trades. Above 50% = edge exists.`,
    totalPnl: `Cumulative PnL% across all ${hasFilters ? totalClosed + ' filtered' : ''} closed trades. This is the sum of each trade's individual return, NOT compounded.`,
    profitFactor: `Total winning PnL ÷ Total losing PnL. PF > 1.0 = making more than losing. PF > 2.0 = strong edge. ${hasFilters ? 'Computed from filtered data.' : ''}`,
    expectancy: `Average PnL per trade. Positive = each trade makes money on average. Calculated as Total PnL ÷ Number of closed trades.`,
    avgWinLoss: `Average winning trade size vs average losing trade size. Ideally wins should be larger than losses (favorable R:R).`,
    wl: `Raw count of winning vs losing closed trades. ${displayWins}W at avg +${fmt(displayAvgWin,2)}% vs ${displayLosses}L at avg -${fmt(displayAvgLoss,2)}%.`,
    systems: `Number of unique trading systems with active picks ${hasFilters ? 'matching current filters' : ''}. Each system runs different algorithms/strategies.`,
  };

  const cards = [
    { label: 'Active Picks', value: totalActive, tip: cardTips.active,
      sub: `<span style="color:var(--green);cursor:help" title="${provenBreakdownHtml.replace(/"/g,'&quot;')}">${provenPicks} proven</span> · <span style="color:var(--yellow)">${probationPicks} sandbox</span>` },
    { label: 'Closed Picks', value: hasFilters ? totalClosed : (s.total_closed_picks || 0), tip: cardTips.closed },
    { label: 'Win Rate', value: fmt(displayWinRate) + '%', cls: displayWinRate >= 50 ? 'positive' : 'negative', tip: cardTips.winRate },
    { label: 'Total PnL', value: fmtPct(displayPnl), cls: displayPnl >= 0 ? 'positive' : 'negative', tip: cardTips.totalPnl },
    { label: 'Profit Factor', value: displayPF === Infinity ? '∞' : displayPF != null ? fmt(displayPF, 2) : '\u2014', cls: displayPF >= 1.0 ? 'positive' : 'negative', tip: cardTips.profitFactor },
    { label: 'Expectancy', value: displayExpectancy != null ? (displayExpectancy >= 0 ? '+' : '') + fmt(displayExpectancy, 2) + '%' : '\u2014', cls: displayExpectancy >= 0 ? 'positive' : 'negative', tip: cardTips.expectancy },
    { label: 'Avg Win / Loss', value: `+${fmt(displayAvgWin, 2)}% / -${fmt(displayAvgLoss, 2)}%`, tip: cardTips.avgWinLoss },
    { label: 'W / L', value: `${displayWins} / ${displayLosses}`, tip: cardTips.wl },
    { label: 'Systems', value: displaySystems, tip: cardTips.systems },
  ];

  // ── Mercury Validation Metrics ──
  const mDailyVol = s.daily_volatility_pct;
  const mNetSharpe = s.net_sharpe;
  const mNetSharpeAnnual = s.net_sharpe_annual;
  const mRolling30dDD = s.rolling_30d_max_dd;
  const mSignalToTrade = s.signal_to_trade_pct;
  const mRegimeWR = s.regime_win_rates;
  const mDays = s.daily_pnl_days || 0;

  const mercuryCards = [];
  mercuryCards.push({
    label: 'Daily Vol',
    value: mDailyVol != null ? fmt(mDailyVol, 2) + '%' : '\u2014',
    cls: mDailyVol != null && mDailyVol <= 1.5 ? 'positive' : 'negative',
    tip: 'Daily Vol = How bumpy your daily returns are. ELI5: If your account balance jumps around a lot each day, this number is high. If it grows steadily, this is low. Target: <=1.5%. Lower = smoother ride. Computed from ' + mDays + ' trading days.'
  });
  mercuryCards.push({
    label: 'Net Sharpe',
    value: mNetSharpe != null ? fmt(mNetSharpe, 4) + (mNetSharpeAnnual != null ? ' (' + fmt(mNetSharpeAnnual, 2) + ' ann.)' : '') : '\u2014',
    cls: mNetSharpe != null && mNetSharpe > 0 ? 'positive' : 'negative',
    tip: 'Net Sharpe = How much profit you make per unit of risk, AFTER fees. ELI5: Imagine you get paid $1 for every $1 of stress your account goes through. Sharpe 1.0 = breaking even on the stress. Sharpe 2.0 = getting $2 per $1 of stress. Higher = better deal. We subtract 0.02% per trade for real-world costs. Target: >1.0 annualized.'
  });
  mercuryCards.push({
    label: 'Rolling 30d DD',
    value: mRolling30dDD != null ? fmt(mRolling30dDD, 2) + '%' : (mDays < 30 ? '<' + mDays + 'd data' : '\u2014'),
    cls: mRolling30dDD != null && mRolling30dDD <= 5 ? 'positive' : 'negative',
    tip: 'Rolling 30d DD = The worst losing streak in any 30-day period. ELI5: If your account was at $10,000 and dropped to $9,500 before recovering, that is a 5% drawdown. This shows the worst such dip in any month. Target: <5%. ' + (mDays < 30 ? 'Need 30+ days of data.' : 'Lower = you sleep better at night.')
  });
  mercuryCards.push({
    label: 'Sig-to-Trade',
    value: mSignalToTrade != null ? fmt(mSignalToTrade, 1) + '%' : '\u2014',
    cls: '',
    tip: 'Sig-to-Trade = What percentage of signals actually turned into completed trades. ELI5: If the system generates 100 alerts but only 30 become real trades with results, that is 30%. The regime filter should block ~30% of bad signals. Lower = pickier system (good, as long as the ones it keeps are winners).'
  });
  if (mRegimeWR && Object.keys(mRegimeWR).length > 0) {
    const regimeParts = Object.entries(mRegimeWR).map(function(e) { return e[0] + ': ' + fmt(e[1].win_rate, 1) + '% (' + e[1].trades + ' trades)'; }).join(' | ');
    mercuryCards.push({
      label: 'Regime WR',
      value: Object.entries(mRegimeWR).map(function(e) { return fmt(e[1].win_rate,1) + '%'; }).join(' / '),
      cls: '',
      tip: 'Win rate by market regime. ' + regimeParts + '. Targets: lowADX >55%, highATR >50%, normal >50%.'
    });
  }

  // ── Sortino Ratio card ──
  const mSortino = s.sortino_ratio;
  const mSortinoAnnual = s.sortino_ratio_annual;
  mercuryCards.push({
    label: 'Sortino',
    value: mSortino != null ? fmt(mSortino, 4) + (mSortinoAnnual != null ? ' (' + fmt(mSortinoAnnual, 2) + ' ann.)' : '') : '\u2014',
    cls: mSortinoAnnual != null ? (mSortinoAnnual >= 1.5 ? 'positive' : (mSortinoAnnual >= 1.0 ? '' : 'negative')) : '',
    tip: 'Sortino = Like Sharpe but smarter. ELI5: Sharpe penalizes ALL volatility, even when your account goes UP fast. Sortino only penalizes the BAD kind (when it goes DOWN). Perfect for crypto where big upward moves are what you WANT. Think of it as: "How much do I profit vs how much do I lose?" Ignoring the good surprises. >1.0 good, >1.5 excellent. Used by hedge funds. KIMI Claw weights this at 20%.'
  });

  // ── Calmar Ratio card ──
  const mCalmar = s.calmar_ratio;
  mercuryCards.push({
    label: 'Calmar',
    value: mCalmar != null ? fmt(mCalmar, 2) : '\u2014',
    cls: mCalmar != null ? (mCalmar >= 3.0 ? 'positive' : (mCalmar >= 1.0 ? '' : 'negative')) : '',
    tip: 'Calmar = Your annual profit divided by your worst dip. ELI5: If you made 30% this year but your account dropped 10% at one point, your Calmar is 3.0 (30/10). It answers: "Is the profit worth the stomach-churning drops?" Calmar 1.0 = barely worth it. Calmar 3.0+ = great returns with manageable pain. Target for world-class: 3.0+.'
  });

  // ── Backtest-Forward Correlation card ──
  const mBtFwdCorr = s.bt_fwd_correlation;
  const mBtFwdN = s.bt_fwd_correlation_n || 0;
  mercuryCards.push({
    label: 'BT/FWD Corr',
    value: mBtFwdCorr != null ? fmt(mBtFwdCorr, 3) + ' (n=' + mBtFwdN + ')' : (mBtFwdN < 3 ? '<3 strats' : '\u2014'),
    cls: mBtFwdCorr != null ? (mBtFwdCorr >= 0.5 ? 'positive' : 'negative') : 'negative',
    tip: 'BT/FWD Correlation = Do backtest results actually predict real performance? ELI5: If a strategy looked amazing in practice mode (backtest) but terrible with real money (forward), the correlation is low or NEGATIVE. Our data shows r=-0.91 meaning strategies with the BEST backtests had the WORST real results! This is the #1 reason not to trust backtest numbers. Only trust the gold-badge strategies that passed walk-forward validation. Across ' + mBtFwdN + ' strategies, backtest predicts ' + (mBtFwdCorr != null ? Math.round(Math.abs(mBtFwdCorr * mBtFwdCorr) * 100) + '%' : '?%') + ' of forward performance.'
  });

  var mercuryHtml = '';
  if (mercuryCards.length > 0) {
    mercuryHtml = '<div style="width:100%;border-top:1px solid rgba(139,92,246,0.3);margin:8px 0;grid-column:1/-1;padding-top:4px"><span style="color:#a78bfa;font-size:11px;font-weight:600">MERCURY VALIDATION</span></div>';
    for (var mi = 0; mi < mercuryCards.length; mi++) {
      var mc = mercuryCards[mi];
      mercuryHtml += '<div class="stat-card" style="border:1px solid rgba(139,92,246,0.25);background:linear-gradient(135deg,rgba(139,92,246,0.08),rgba(59,130,246,0.05))">';
      mercuryHtml += '<div class="label" style="color:#a78bfa">' + mc.label + '</div>';
      mercuryHtml += '<div class="value ' + (mc.cls||'') + '">' + mc.value + '</div>';
      if (mc.tip) mercuryHtml += '<div class="card-tip">' + mc.tip + '</div>';
      mercuryHtml += '</div>';
    }
  }

  el('summary-cards').innerHTML = cards.map(c =>
    `<div class="stat-card">
      <div class="label">${c.label}</div>
      <div class="value ${c.cls||''}">${c.value}</div>
      ${c.sub ? '<div class="sub-detail">' + c.sub + '</div>' : ''}
      ${c.tip ? '<div class="card-tip">' + c.tip + '</div>' : ''}
    </div>`
  ).join('') + mercuryHtml;
  el('last-updated').textContent = D.generated_at ? new Date(D.generated_at).toLocaleString('en-US', { timeZone: 'America/New_York' }) + ' EST' : 'unknown';

  // ── Active filter indicator ──
  const indicator = el('filter-active-indicator');
  if (indicator) {
    if (hasFilters) {
      const tags = [];
      if (window._provenOnlyFilter) tags.push('<span class="filter-tag" style="background:#22c55e;color:#000">★ Proven Only</span>');
      if (window._scoreGateFilter) tags.push('<span class="filter-tag" style="background:#a78bfa;color:#000">🎯 Score ≥ 24</span>');
      if (f.timeframe) tags.push('<span class="filter-tag">TF=' + f.timeframe + '</span>');
      if (f.asset) tags.push('<span class="filter-tag">' + f.asset + '</span>');
      if (f.system) tags.push('<span class="filter-tag">' + f.system.replace(/_/g,' ') + '</span>');
      if (f.dir) tags.push('<span class="filter-tag">' + f.dir + '</span>');
      if (f.status) tags.push('<span class="filter-tag">' + f.status + '</span>');
      if (f.pnl) tags.push('<span class="filter-tag">PnL: ' + f.pnl + '</span>');
      if (f.conf) tags.push('<span class="filter-tag">Conf ≥ ' + f.conf + '</span>');
      if (f.age) tags.push('<span class="filter-tag">Age ≤ ' + f.age + 'h</span>');
      if (f.tpRem) tags.push('<span class="filter-tag">TP Rem ≤ ' + f.tpRem + '%</span>');
      if (f.search) tags.push('<span class="filter-tag">Search: ' + f.search + '</span>');
      if (f.conflicts && f.conflicts !== '') tags.push('<span class="filter-tag">' + f.conflicts + '</span>');
      indicator.innerHTML = '⚠️ <strong>Filtered view</strong> — metrics above reflect only: ' + tags.join(' ') + ' <span style="color:#6b7280;margin-left:6px">(showing ' + totalActive + ' of ' + (D.picks?.active||[]).length + ' total active picks)</span>';
      indicator.style.display = 'block';
    } else {
      indicator.style.display = 'none';
    }
  }
}

// ── Populate system filter ──
function populateFilters() {
  const sys = (D.systems || []).map(s => s.name).sort();
  const sel = el('f-system');
  sys.forEach(s => {
    const o = document.createElement('option');
    o.value = s; o.textContent = s.replace(/_/g, ' ');
    sel.appendChild(o);
  });
}

// ── Filtering ──
// Build set of symbols with direction conflicts (LONG+SHORT simultaneously)
const _conflictSymbols = new Set();
(function() {
  const sd = {};
  (window.DASHBOARD_DATA?.picks?.active || []).forEach(p => {
    const s = p.symbol||''; const d = p.direction||'';
    if (!sd[s]) sd[s] = new Set();
    sd[s].add(d);
  });
  Object.entries(sd).forEach(([s, dirs]) => { if (dirs.has('LONG') && dirs.has('SHORT')) _conflictSymbols.add(s); });
})();

function getFilters() {
  return {
    asset: el('f-asset').value,
    system: el('f-system').value,
    status: el('f-status').value,
    dir: el('f-dir').value,
    search: el('f-search').value.toUpperCase(),
    pnl: el('f-pnl').value,
    conf: el('f-conf').value,
    age: el('f-age').value,
    tpRem: el('f-tp-rem').value,
    sort: el('f-sort').value,
    conflicts: el('f-conflicts').value,
    timeframe: el('f-timeframe') ? el('f-timeframe').value : '',
  };
}
function matchFilter(pick, f) {
  if (f.timeframe && (pick.trade_timeframe||'').toUpperCase() !== f.timeframe) return false;
  if (f.asset && pick.asset_class !== f.asset) return false;
  if (f.system && pick.source_system !== f.system) return false;
  if (f.status && pick.status !== f.status) return false;
  if (f.dir && pick.direction !== f.dir) return false;
  if (f.search && !(pick.symbol||'').toUpperCase().includes(f.search) && !(pick.strategy||'').toUpperCase().includes(f.search)) return false;
  // Advanced filters
  const pnl = pick.pnl_pct || 0;
  if (f.pnl === 'pos' && pnl <= 0) return false;
  if (f.pnl === 'neg' && pnl >= 0) return false;
  if (f.pnl === 'gt5' && pnl <= 5) return false;
  if (f.pnl === 'gt10' && pnl <= 10) return false;
  if (f.conf && (pick.confidence || 0) < parseFloat(f.conf)) return false;
  if (f.age) { if (pick.age_hours == null || pick.age_hours > parseFloat(f.age)) return false; }
  if (f.tpRem) { if (pick.tp_remaining_pct == null || pick.tp_remaining_pct > parseFloat(f.tpRem)) return false; }
  // Conflict filter
  if (f.conflicts === 'no-conflict' && _conflictSymbols.has(pick.symbol)) return false;
  if (f.conflicts === 'conflict-only' && !_conflictSymbols.has(pick.symbol)) return false;
  return true;
}

// ── Strategy History Modal ──
let _historyPageSize = 20;
function showStratHistory(strategy, system) {
  const modal = el('strat-history-modal');
  const title = el('strat-history-title');
  const stats = el('strat-history-stats');
  const body = el('strat-history-body');
  const more = el('strat-history-more');

  // Find all closed trades for this strategy (or system if strategy is empty)
  let trades = (D.picks?.recent_closed || []).filter(p => {
    if (strategy) return p.strategy === strategy;
    if (system) return p.source_system === system;
    return false;
  });

  // Sort by timestamp descending
  trades.sort((a, b) => (b.timestamp || '').localeCompare(a.timestamp || ''));

  title.textContent = strategy || system || 'Strategy History';

  // Compute stats
  const wins = trades.filter(t => (t.pnl_pct || 0) > 0).length;
  const losses = trades.length - wins;
  const totalPnl = trades.reduce((s, t) => s + (t.pnl_pct || 0), 0);
  const wr = trades.length > 0 ? (wins / trades.length * 100).toFixed(1) : '—';
  const winPnl = trades.filter(t => (t.pnl_pct||0) > 0).reduce((s,t) => s + t.pnl_pct, 0);
  const lossPnl = Math.abs(trades.filter(t => (t.pnl_pct||0) < 0).reduce((s,t) => s + t.pnl_pct, 0));
  const pf = lossPnl > 0 ? (winPnl / lossPnl).toFixed(2) : '—';

  stats.innerHTML = `
    <span style="color:var(--text)"><b>${trades.length}</b> closed trades</span> &bull;
    <span>WR: <b style="color:${parseFloat(wr)>=50?'var(--green)':'var(--red)'}">${wr}%</b></span> &bull;
    <span>W/L: <b style="color:var(--green)">${wins}</b>/<b style="color:var(--red)">${losses}</b></span> &bull;
    <span>PF: <b>${pf}</b></span> &bull;
    <span>Total PnL: <b class="${totalPnl>=0?'pnl-pos':'pnl-neg'}">${totalPnl>=0?'+':''}${totalPnl.toFixed(2)}%</b></span>
  `;

  // Render paginated trades
  let shown = 0;
  function renderPage() {
    const page = trades.slice(shown, shown + _historyPageSize);
    if (shown === 0) body.innerHTML = '';
    if (!page.length && shown === 0) {
      body.innerHTML = '<div style="color:var(--text-dim);padding:20px;text-align:center">No closed trades found for this strategy in the dashboard data.<br><span style="font-size:11px">Note: Only the most recent 2,000 closed trades are loaded.</span></div>';
      more.innerHTML = '';
      return;
    }
    const rows = page.map(t => {
      const pnl = t.pnl_pct || 0;
      const cls = pnl > 0 ? 'pnl-pos' : pnl < 0 ? 'pnl-neg' : '';
      const icon = pnl > 0 ? '&#x2705;' : '&#x274c;';
      return `<tr>
        <td>${icon}</td>
        <td>${t.symbol||'—'}</td>
        <td>${t.direction||'—'}</td>
        <td class="num ${cls}" style="font-weight:600">${fmtPct(pnl)}</td>
        <td>${t.exit_reason||'—'}</td>
        <td class="num">${t.entry_price ? Number(t.entry_price).toPrecision(6) : '—'}</td>
        <td style="font-size:11px;white-space:nowrap">${toEST(t.timestamp)}</td>
        <td style="font-size:11px;color:var(--text-dim)">${sysLinks[t.source_system] ? `<a href="${sysLinks[t.source_system]}" target="_blank" style="color:var(--cyan)">${(t.source_system||'').replace(/_/g,' ')}</a>` : (t.source_system||'').replace(/_/g,' ')}</td>
      </tr>`;
    }).join('');

    const table = `<table class="data-table"><thead><tr>
      <th></th><th>Symbol</th><th>Dir</th><th>PnL%</th><th>Exit</th><th>Entry</th><th>Time</th><th>System</th>
    </tr></thead><tbody>${rows}</tbody></table>`;

    if (shown === 0) {
      body.innerHTML = table;
    } else {
      // Append rows to existing table
      body.querySelector('tbody').insertAdjacentHTML('beforeend', rows);
    }
    shown += page.length;

    if (shown < trades.length) {
      more.innerHTML = `<button onclick="this.parentElement._loadMore()" style="background:var(--card);color:var(--cyan);border:1px solid var(--cyan);border-radius:6px;padding:6px 16px;cursor:pointer;font-size:12px">Show more (${trades.length - shown} remaining)</button>`;
      more._loadMore = renderPage;
    } else {
      more.innerHTML = shown > 0 ? `<span style="color:var(--text-dim);font-size:11px">Showing all ${shown} trades</span>` : '';
    }
  }

  renderPage();
  modal.style.display = 'block';
  // Close on Escape
  modal.onclick = (e) => { if (e.target === modal) modal.style.display = 'none'; };
}

// ── Sorting ──
let sortCol = 'score', sortAsc = false;
function sortPicks(picks, col) {
  if (!col) return picks;
  return [...picks].sort((a, b) => {
    let va = a[col], vb = b[col];
    if (typeof va === 'number' && typeof vb === 'number') return sortAsc ? va - vb : vb - va;
    va = String(va||''); vb = String(vb||'');
    return sortAsc ? va.localeCompare(vb) : vb.localeCompare(va);
  });
}
function advancedSort(picks, sortKey) {
  if (!sortKey) return picks;
  const [field, dir] = sortKey.split('_desc').length > 1 ? [sortKey.replace('_desc',''), 'desc']
    : sortKey.split('_asc').length > 1 ? [sortKey.replace('_asc',''), 'asc'] : [sortKey, 'asc'];
  return [...picks].sort((a, b) => {
    const va = a[field] ?? (dir === 'asc' ? Infinity : -Infinity);
    const vb = b[field] ?? (dir === 'asc' ? Infinity : -Infinity);
    return dir === 'asc' ? va - vb : vb - va;
  });
}

// ── Timestamp → EST formatter ──
function toEST(ts) {
  if (!ts) return '—';
  try {
    // Strip timezone abbreviations that Date() can't parse and replace with UTC offsets
    const tzOffsets = {EST:'-05:00',EDT:'-04:00',UTC:'+00:00',GMT:'+00:00',PST:'-08:00',PDT:'-07:00',CST:'-06:00',CDT:'-05:00'};
    let clean = String(ts).trim();
    for (const [abbr, off] of Object.entries(tzOffsets)) {
      if (clean.endsWith(' ' + abbr)) { clean = clean.slice(0, -abbr.length - 1) + off; break; }
    }
    // Timestamps without timezone info are UTC — append Z so browser doesn't treat as local
    if (!/[Z+-]\d{2}:?\d{2}$/.test(clean) && !clean.endsWith('Z')) clean += 'Z';
    const d = new Date(clean);
    if (isNaN(d)) return ts;
    return d.toLocaleString('en-US', { timeZone: 'America/New_York', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true });
  } catch { return ts; }
}

// ── Strategy performance lookup (from leaderboard) ──
function buildStratLookup() {
  const map = {};
  (D.leaderboard || []).forEach(r => { if (r.strategy) map[r.strategy] = r; });
  return map;
}
function stratTooltipHtml(stratName, lookup) {
  const r = lookup[stratName];
  const display = (stratName || '\u2014').replace(/_/g, ' ');
  if (!r) return '<span class="strat-tip-wrap">' + display + '<div class="strat-tip"><div class="tip-title">' + display + '</div><div class="tip-no-data">No backtest or forward data in leaderboard yet.<br><span style="font-size:11px;color:var(--text-dim)">Strategy may be new or from a system not yet integrated into the leaderboard.</span></div></div></span>';
  const vc = {SURVIVOR:'var(--green)',PROMISING:'var(--blue)',MARGINAL:'var(--yellow)',ELIMINATED:'var(--red)'}[r.bt_verdict] || 'var(--text-dim)';
  function row(l,v,c){ return '<div class="tip-row"><span class="tip-label">'+l+'</span><span class="tip-val"'+(c?' style="color:'+c+'"':'')+'>'+v+'</span></div>'; }
  let h = '<span class="strat-tip-wrap">' + display + '<div class="strat-tip"><div class="tip-title">' + display + '</div>';
  if (r.bt_verdict) h += row('Verdict','<span style="color:'+vc+';font-weight:700">'+r.bt_verdict+'</span>');
  if (r.portfolio_type) h += row('Type', r.portfolio_type);
  if (r.fwd_trades > 0) {
    h += '<div class="tip-divider"></div>';
    h += row('Forward Trades', r.fwd_trades);
    h += row('Forward Win Rate', r.fwd_wr!=null ? fmt(r.fwd_wr)+'%' : '\u2014', r.fwd_wr>=50?'var(--green)':r.fwd_wr>=40?'var(--yellow)':'var(--red)');
    h += row('Forward PnL', r.fwd_total_pnl ? (r.fwd_total_pnl>0?'+':'')+fmt(r.fwd_total_pnl,2)+'%' : '\u2014', r.fwd_total_pnl>0?'var(--green)':'var(--red)');
    h += row('Avg PnL/Trade', r.fwd_avg_pnl ? (r.fwd_avg_pnl>0?'+':'')+fmt(r.fwd_avg_pnl,2)+'%' : '\u2014');
    h += row('W / L', (r.fwd_wins||0)+' / '+(r.fwd_losses||0));
    if (r.omega_ratio!=null) h += row('Omega Ratio', fmt(r.omega_ratio,2), r.omega_ratio>=2?'var(--green)':r.omega_ratio>=1?'var(--yellow)':'var(--red)');
    if (r.tail_ratio!=null) h += row('Tail Ratio', fmt(r.tail_ratio,2), r.tail_ratio>=1?'var(--green)':'var(--red)');
  }
  if (r.bt_trades > 0) {
    h += '<div class="tip-divider"></div>';
    h += row('Backtest Trades', r.bt_trades);
    h += row('Backtest WR', r.bt_wr!=null ? fmt(r.bt_wr)+'%' : '\u2014', r.bt_wr>=55?'var(--green)':r.bt_wr>=45?'var(--yellow)':'var(--red)');
    h += row('Backtest Sharpe', r.bt_sharpe!=null ? fmt(r.bt_sharpe,2) : '\u2014', r.bt_sharpe>1.5?'var(--green)':r.bt_sharpe>0?'var(--yellow)':'var(--red)');
    if (r.bt_pf!=null) h += row('Profit Factor', fmt(r.bt_pf,2));
    if (r.bt_return!=null) h += row('Backtest Return', (r.bt_return>0?'+':'')+fmt(r.bt_return,1)+'%');
  }
  if (r.decay!=null) { h += '<div class="tip-divider"></div>'; h += row('BT\u2192FWD Decay', (r.decay>=0?'+':'')+fmt(r.decay,1)+'%', r.decay>=0?'var(--green)':'var(--red)'); }
  if (r.active_picks>0) h += row('Active Picks', r.active_picks);
  h += '</div></span>';
  return h;
}

// ── Price position gauge ──
function priceGauge(pick) {
  const entry = parseFloat(pick.entry_price);
  const tp = parseFloat(pick.take_profit);
  const sl = parseFloat(pick.stop_loss);
  if (!entry || !tp || !sl || tp === sl) return '<td>—</td>';
  // Current price approximation: use entry adjusted by pnl_pct, or entry if no pnl
  const pnl = parseFloat(pick.pnl_pct) || 0;
  // If no performance change (pnl ~ 0), avoid showing a misleading gauge
  if (Math.abs(pnl) < 0.01) return '<td>—</td>';
  const isLong = (pick.direction || '').toUpperCase().includes('LONG');
  const current = isLong ? entry * (1 + pnl / 100) : entry * (1 - pnl / 100);
  // Normalize position: 0% = SL, 100% = TP
  const range = Math.abs(tp - sl);
  let pct;
  if (isLong) {
    pct = (current - sl) / (tp - sl) * 100;
  } else {
    pct = (sl - current) / (sl - tp) * 100;
  }
  pct = Math.max(0, Math.min(100, pct));
  // Entry position on the gauge
  let entryPct;
  if (isLong) {
    entryPct = (entry - sl) / (tp - sl) * 100;
  } else {
    entryPct = (sl - entry) / (sl - tp) * 100;
  }
  entryPct = Math.max(0, Math.min(100, entryPct));
  const markerColor = pct >= entryPct ? 'var(--green)' : 'var(--red)';
  const pctLabel = pct.toFixed(0) + '%';
  return `<td><div class="price-gauge"><div class="price-gauge-bar"><div class="price-gauge-entry" style="left:${entryPct}%"></div><div class="price-gauge-marker" style="left:${Math.max(0,Math.min(100,pct))}%;background:${markerColor}"></div></div><span class="price-gauge-label">${pctLabel}</span></div></td>`;
}

// ── Column header tooltips ──
const colTips = {
  'symbol': 'Trading pair / ticker symbol (e.g. BTCUSDT, EURUSD). Across 1000+ closed trades: BTC and XRP are the most profitable symbols. ETH has mixed results (good for Keltner, bad for RSI recovery). AVAX works well for short trades.',
  'direction': 'LONG = expecting price rise. SHORT = expecting price drop. DATA INSIGHT (Mar 15 2026): LONGs are 93.5% WR with +1.90% median in the current regime. SHORTs are 27.8% WR — only GALA SHORT and specialized Alpha Engine shorts are working.',
  'asset_class': 'Asset type: CRYPTO, FOREX, or EQUITY. INSIGHT: Crypto has the most data (73+ picks tracked). Forex strategies are mostly failing (0% WR on London Breakout, seasonal rotation). Equity picks (SPY, QQQ) are marginal.',
  'source_system': 'Which trading engine generated this pick. PROVEN SYSTEMS: battleground (62.3% WR, 239 trades, +$586), deep_value_engine (100% WR, 11 trades, +$751). FAILING: crypto_winners (0% WR), luxalgo_filters (39.6% WR on 91 trades — below breakeven, SHORT-biased), kimi_live_signals (0% WR, 3 trades).',
  'strategy': 'Strategy algorithm name. Look for the insight badge next to it: gold star = statistically proven edge (walk-forward validated), red skull = 0% WR dead strategy, orange warning = overfit risk or KIMI solo. Hover the badge for details with trade counts and win rates.',
  'trade_timeframe': 'TF = Trade timeframe / expected hold period. S=Scalp (<4h), I=Intraday (4-24h), W=Swing (1-7d), P=Position (7d+). INSIGHT: A SCALP short and SWING long on the same symbol are NOT conflicts — they can coexist on different time horizons. The conflict checker now accounts for this.',
  'entry_price': 'Entry = Price at which the position was opened. INSIGHT: Entry timing matters more than direction. Our data shows identical strategies winning at lower entries and losing at higher entries (Rule 6 in conflict lessons).',
  'take_profit': 'TP = Target price for profit-taking. Trade closes automatically when hit. INSIGHT: Tight TPs (2-3%) capture more wins but smaller gains. Wide TPs (5-8%) hit less often but capture bigger moves. The Keltner strategies use tight TPs and win 64-66% of the time.',
  'stop_loss': 'SL = Maximum acceptable loss. Auto-closes to limit downside. INSIGHT: KIMI strategies have 3.4x more SL hits than TP hits (141 SL vs 42 TP across 265 trades). The Keltner strategies have much better TP/SL balance.',
  'entry_type': 'LIMIT = waiting at specific price for better fill (may not fill). MARKET = immediate execution at current price. LIMIT orders reduce slippage but risk missing fast-moving entries.',
  'tp_remaining_pct': 'TP Rem% = How far price still needs to travel to hit Take Profit. Lower = closer to winning. 0% = at TP. INSIGHT: Picks that reach <20% TP remaining have historically closed profitably 78% of the time.',
  'sl_remaining_pct': 'SL Buffer% = Safety margin before Stop Loss triggers. Higher = more room. INSIGHT: When this drops below 20%, the pick is in danger. Consider whether the thesis still holds.',
  '_livePrice': 'Price = Current live market price from Binance/CoinGecko. Updates every 30s. Cyan text indicates a live price is available.',
  '_pos_status': 'POS = Position status. WINNING/LOSING = current PnL direction. TP HIT = price reached take-profit target. SL HIT = price reached stop-loss. OPEN = no live price data yet.',
  'pnl_pct': 'PnL% = Unrealized profit/loss. INSIGHT: The overall system has +0.30% avg PnL across 200 consensus picks. Battleground strategies average +0.48%. If a pick is >-2%, the stop loss will likely handle it.',
  'confidence': 'Conf = Strategy signal confidence (0.0-1.0). WARNING: Analysis of 4,578 closed trades shows confidence is NOT predictive. Conf>=0.9 has 40% WR with -6.84% avg PnL. Use the Score column and insight badges instead — they incorporate forward-test data. INDUSTRY NOTE: Per evaluation framework, WR 40-70% is healthy range; >80% WR suggests curve-fitting. Confidence alone fails Criterion 2 (Statistical Robustness).',
  'age_hours': 'Age = Hours since signal generation. INSIGHT: Picks younger than 4h are freshest. After 48h, stale picks are auto-hidden unless they have significant PnL (>1%). Rule 1: Recency beats count — a fresh 2-system signal > a stale 42-system signal.',
  'price_position': 'Price Pos = Visual SL-to-TP gauge. Red (left) = near stop loss. Green (right) = near take profit. White dot = current price. Cyan line = entry. Asymmetric if R:R is not 1:1.',
  'timestamp': 'When the signal was generated (auto-converts to Eastern Time). Older signals may have moved significantly from entry.',
  'exit_reason': 'Why the trade closed: TP = profit target hit (avg +5.76% on KIMI, +0.5-2% on battleground). SL = stop loss hit (avg -4.83% on KIMI, -1% on battleground). TIME = max hold period expired (typically breakeven).',
  'score': 'Score (0-100) = How good is this pick overall? ELI5: Think of it like a school grade. 80+ = A (excellent, proven winner). 60-79 = B-C (decent, worth watching). 40-59 = D (risky). <40 = F (avoid). The score combines: How good is the strategy? (25%) + How strong is the signal? (20%) + How fresh is it? (15%) + How well has it performed live? (15%) + Do other systems agree? (15%) + Any conflicts? (10%). BONUS: If the strategy makes big wins and small losses (CSR>2.0), score gets +10%. If losses dominate (CSR<0.5), score gets -20%. Gold-badge picks typically score 65+. Red-badge = avoid. INDUSTRY BENCHMARKS: Profit Factor >1.5 good, Sharpe >1.0 good, WR 40-70% healthy (>80% = suspicious overfitting).',
  'rr_ratio': 'R:R = Reward / Risk. Distance to TP / Distance to SL. INSIGHT: The proven Keltner strategies average R:R of 1.3-1.8. Picks with R:R < 1.0 have negative expectancy even at 50% WR. Look for R:R >= 1.3 combined with a gold insight badge.',
  'bt_win_rate': 'BT WR% = Backtest win rate from historical data. WARNING: Backtest WR can be misleading — drawdown_recovery_rsi shows 100% backtest WR but collapsed to 16.7% in walk-forward testing. Always check the insight badge for forward-test validation.',
  'bt_profit_factor': 'BT PF = Backtest Profit Factor (gross wins / gross losses). Industry benchmarks: PF >1.2 minimum viable, >1.5 good, >2.0+ excellent. CAUTION: High backtest PF without forward validation may indicate overfitting (Criterion 4: Out-of-Sample). The proven Keltner strategies have PF 2.5-4.3 in BOTH backtest and forward testing.',
  'recent_pnl': 'Recent PnL% = Sum of last 10 closed trades for this strategy. Click to see trade history. INSIGHT: Strategies with positive recent PnL AND gold insight badges are the highest-conviction picks.',
  'recent_max_dd': 'Recent Max DD% = Worst drawdown in last 10 trades. Lower = smoother returns. INSIGHT: The best battleground strategies have <5% max DD. Anything >10% indicates the strategy may be breaking down.',
