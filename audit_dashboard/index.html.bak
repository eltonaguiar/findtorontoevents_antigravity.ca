      scoreBreakdown,
      trust ? trust.tier : '', trust ? (trust.reason || '') : '',
      fwdWR, fwdTrades,
      confluenceCount, consensusReasons,
      rawReason, fullAudit,
      stratDesc, sysDesc,
      p.asset_class || '',
      p.trade_timeframe || p.timeframe || '',
      p.entry_time || p.timestamp || '',
      p.exit_time || p.closed_at || ''
    ].map(csvEscape).join(',');
  });
  const dateStr = new Date().toISOString().slice(0,10);
  downloadCSV(`antigravity_closed_picks_${dateStr}.csv`, headers, rows);
});

// ── Column Settings gear icon ──
el('btn-col-settings').addEventListener('click', (e) => {
  e.stopPropagation();
  const panel = el('col-settings-panel');
  const isOpen = panel.style.display !== 'none';
  panel.style.display = isOpen ? 'none' : 'block';
  if (!isOpen) {
    const container = el('col-checkboxes');
    const currentKeys = new Set(activeCols.map(c => c.key));
    container.innerHTML = allActiveCols.map(c =>
      `<label style="display:block;padding:3px 0;font-size:12px;color:var(--text);cursor:pointer;">
        <input type="checkbox" data-col="${c.key}" ${currentKeys.has(c.key) ? 'checked' : ''} style="margin-right:6px;">
        ${c.label}
      </label>`
    ).join('');
  }
});
document.addEventListener('click', (e) => {
  const panel = el('col-settings-panel');
  if (panel.style.display !== 'none' && !panel.contains(e.target) && e.target.id !== 'btn-col-settings') {
    panel.style.display = 'none';
  }
});
el('col-apply').addEventListener('click', () => {
  const checked = [...el('col-checkboxes').querySelectorAll('input:checked')].map(i => i.dataset.col);
  if (checked.length === 0) return;
  saveColPrefs(checked);
  activeCols = allActiveCols.filter(c => checked.includes(c.key));
  el('col-settings-panel').style.display = 'none';
  renderPicks();
});
el('col-reset').addEventListener('click', () => {
  try { localStorage.removeItem('audit_active_cols'); } catch(e) {}
  activeCols = allActiveCols.filter(c => c.default);
  el('col-settings-panel').style.display = 'none';
  renderPicks();
});

// ── Full Refresh (trigger pipeline re-scan) ──
el('btn-full-refresh').addEventListener('click', () => {
  const btn = el('btn-full-refresh');
  if (btn.disabled) return;
  btn.disabled = true;
  btn.innerHTML = '🔄 Refreshing...';
  // Show ETA countdown
  let eta = 180; // ~3 min pipeline estimate
  const etaEl = document.createElement('span');
  etaEl.id = 'refresh-eta';
  etaEl.style.cssText = 'color:#f59e0b;font-size:12px;margin-left:8px;';
  etaEl.textContent = `ETA: ~${Math.ceil(eta/60)} min`;
  btn.parentElement.appendChild(etaEl);
  const countdown = setInterval(() => {
    eta -= 10;
    if (eta <= 0) {
      clearInterval(countdown);
      etaEl.textContent = 'Reloading...';
      setTimeout(() => location.reload(true), 2000);
    } else {
      etaEl.textContent = `ETA: ~${eta}s`;
    }
  }, 10000);
  // Trigger the GitHub Actions workflow dispatch for audit dashboard refresh
  fetch('https://api.github.com/repos/eltonaguiar/findtorontoevents_antigravity.ca/actions/workflows/audit-dashboard.yml/dispatches', {
    method: 'POST',
    headers: {'Accept': 'application/vnd.github+json'},
    body: JSON.stringify({ref: 'main'})
  }).catch(() => {
    // If direct dispatch fails (no auth), just reload after countdown
    etaEl.textContent = 'Pipeline runs every 15 min — reloading in 3 min...';
  });
});

// ── Refresh Picks (trigger momentum scanner) ──
if (el('btn-refresh-picks')) el('btn-refresh-picks').addEventListener('click', () => {
  const btn = el('btn-refresh-picks');
  if (btn.disabled) return;
  btn.disabled = true;
  btn.innerHTML = '&#9889; Scanning...';
  let eta = 150;
  const etaEl = document.createElement('span');
  etaEl.id = 'refresh-picks-eta';
  etaEl.style.cssText = 'color:#22d3ee;font-size:12px;margin-left:8px;';
  etaEl.textContent = 'ETA: ~' + Math.ceil(eta/60) + ' min';
  btn.parentElement.appendChild(etaEl);
  const countdown = setInterval(() => {
    eta -= 10;
    if (eta <= 0) {
      clearInterval(countdown);
      etaEl.textContent = 'Reloading...';
      setTimeout(() => location.reload(true), 2000);
    } else {
      etaEl.textContent = 'ETA: ~' + eta + 's';
    }
  }, 10000);
  fetch('https://api.github.com/repos/eltonaguiar/findtorontoevents_antigravity.ca/actions/workflows/momentum-scanner.yml/dispatches', {
    method: 'POST',
    headers: {'Accept': 'application/vnd.github+json'},
    body: JSON.stringify({ref: 'main'})
  }).catch(() => {
    etaEl.textContent = 'Scanner runs every 4h \u2014 reloading in 2.5 min...';
  });
});

// ── Permutations tab ──

// ── Trade Drill-Down Modal & Tooltip Helpers ──
function formatDateEST(ts) {
  if (!ts) return '—';
  try {
    const d = new Date(ts);
    if (isNaN(d.getTime())) return '—';
    return d.toLocaleString('en-US', {timeZone: 'America/New_York', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true}) + ' EST';
  } catch(e) { return '—'; }
}

function showTradeModal(title, trades) {
  const overlay = document.getElementById('trade-modal-overlay');
  const content = document.getElementById('trade-modal-content');
  if (!trades || !trades.length) {
    content.innerHTML = '<h3>' + title + '</h3><p style="color:var(--text-dim);">No trade data available.</p>';
    overlay.classList.add('active');
    return;
  }

  // Sort by PnL% descending
  const sorted = [...trades].sort((a, b) => (b.pnl_pct || 0) - (a.pnl_pct || 0));

  // Summary stats
  const total = sorted.length;
  const wins = sorted.filter(t => (t.pnl_pct || 0) > 0).length;
  const losses = sorted.filter(t => (t.pnl_pct || 0) < 0).length;
  const wr = total > 0 ? (wins / total * 100).toFixed(1) : '0.0';
  const avgPnl = total > 0 ? (sorted.reduce((s, t) => s + (t.pnl_pct || 0), 0) / total).toFixed(2) : '0.00';
  const totalPnl = sorted.reduce((s, t) => s + (t.pnl_pct || 0), 0).toFixed(2);

  // Collect unique systems
  const systems = [...new Set(sorted.map(t => t.source_system || 'unknown'))];

  let h = '<h3>' + title + '</h3>';

  // Stats bar
  h += '<div class="trade-modal-stats">';
  h += '<div class="trade-modal-stat"><div class="tm-label">Total Trades</div><div class="tm-value">' + total + '</div></div>';
  h += '<div class="trade-modal-stat"><div class="tm-label">Win Rate</div><div class="tm-value" style="color:' + (parseFloat(wr) >= 50 ? 'var(--green)' : 'var(--red)') + ';">' + wr + '%</div></div>';
  h += '<div class="trade-modal-stat"><div class="tm-label">Avg PnL</div><div class="tm-value" style="color:' + (parseFloat(avgPnl) >= 0 ? 'var(--green)' : 'var(--red)') + ';">' + (parseFloat(avgPnl) >= 0 ? '+' : '') + avgPnl + '%</div></div>';
  h += '<div class="trade-modal-stat"><div class="tm-label">Total PnL</div><div class="tm-value" style="color:' + (parseFloat(totalPnl) >= 0 ? 'var(--green)' : 'var(--red)') + ';">' + (parseFloat(totalPnl) >= 0 ? '+' : '') + totalPnl + '%</div></div>';
  h += '<div class="trade-modal-stat"><div class="tm-label">Won / Lost</div><div class="tm-value"><span style="color:var(--green);">' + wins + '</span> / <span style="color:var(--red);">' + losses + '</span></div></div>';
  h += '<div class="trade-modal-stat"><div class="tm-label">Systems</div><div class="tm-value" style="font-size:12px;color:var(--cyan);">' + systems.join(', ').replace(/_/g,' ') + '</div></div>';
  h += '</div>';

  // Trade table
  h += '<div style="overflow-x:auto;max-height:55vh;overflow-y:auto;">';
  h += '<table><thead><tr>';
  h += '<th>Symbol</th><th>Direction</th><th>Entry Price</th><th>Exit Price</th>';
  h += '<th>PnL%</th><th>System</th><th>Entry Date (EST)</th><th>Close Date (EST)</th><th>Status</th>';
  h += '</tr></thead><tbody>';

  for (const t of sorted) {
    const pnl = t.pnl_pct || 0;
    const pnlColor = pnl > 0 ? 'var(--green)' : pnl < 0 ? 'var(--red)' : 'var(--text-dim)';
    const statusLabel = pnl > 0 ? 'WON' : pnl < 0 ? 'LOST' : 'FLAT';
    const statusColor = pnl > 0 ? 'var(--green)' : pnl < 0 ? 'var(--red)' : 'var(--text-dim)';
    const sym = (t.symbol || '').replace(/-USD$/,'').replace(/USDT$/,'').toUpperCase();
    const dir = (t.direction || 'LONG').toUpperCase();
    const entryP = t.entry_price != null ? parseFloat(t.entry_price).toFixed(t.entry_price > 100 ? 2 : 6) : '—';
    const exitP = t.close_price != null ? parseFloat(t.close_price).toFixed(t.close_price > 100 ? 2 : 6) : (t.exit_price != null ? parseFloat(t.exit_price).toFixed(t.exit_price > 100 ? 2 : 6) : '—');
    const entryDate = formatDateEST(t.timestamp || t.entry_time || t.created_at);
    const closeDate = formatDateEST(t.closed_at || t.close_time || t.exit_time);
    const sys = (t.source_system || 'unknown').replace(/_/g, ' ');

    h += '<tr>';
    h += '<td style="font-weight:600;">' + sym + '</td>';
    h += '<td style="color:' + (dir === 'LONG' ? 'var(--green)' : 'var(--red)') + ';font-weight:600;">' + dir + '</td>';
    h += '<td style="font-variant-numeric:tabular-nums;">' + entryP + '</td>';
    h += '<td style="font-variant-numeric:tabular-nums;">' + exitP + '</td>';
    h += '<td style="color:' + pnlColor + ';font-weight:700;">' + (pnl >= 0 ? '+' : '') + pnl.toFixed(2) + '%</td>';
    h += '<td style="font-size:11px;color:var(--cyan);">' + sys + '</td>';
    h += '<td style="font-size:11px;">' + entryDate + '</td>';
    h += '<td style="font-size:11px;">' + closeDate + '</td>';
    h += '<td style="font-weight:600;color:' + statusColor + ';">' + statusLabel + '</td>';
    h += '</tr>';
  }
  h += '</tbody></table></div>';

  content.innerHTML = h;
  overlay.classList.add('active');
  document.body.style.overflow = 'hidden';
}

function closeTradeModal() {
  document.getElementById('trade-modal-overlay').classList.remove('active');
  document.body.style.overflow = '';
}

// Close modal on Escape key
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') closeTradeModal();
});

// ── Tooltip text builders for permutation tables ──
function buildHeatmapTooltip(sym, level, picks) {
  const filtered = picks.filter(p => {
    const ps = (p.symbol || '').replace(/-USD$/,'').replace(/USDT$/,'').replace(/-/g,'').toUpperCase();
    return ps === sym && (p.agreement_count || 1) === level;
  });
  if (!filtered.length) return '';
  const systems = [...new Set(filtered.map(p => (p.source_system || 'unknown').replace(/_/g, ' ')))];
  const wins = filtered.filter(p => (p.pnl_pct || 0) > 0).length;
  const losses = filtered.filter(p => (p.pnl_pct || 0) <= 0).length;
  // Avg time from entry to close
  let totalMs = 0, timeCount = 0;
  filtered.forEach(p => {
    const entry = new Date(p.timestamp || p.entry_time || p.created_at);
    const close = new Date(p.closed_at || p.close_time || p.exit_time);
    if (!isNaN(entry.getTime()) && !isNaN(close.getTime())) {
      totalMs += close.getTime() - entry.getTime();
      timeCount++;
    }
  });
  const avgHrs = timeCount > 0 ? (totalMs / timeCount / 3600000).toFixed(1) : '—';
  let tip = 'Systems: ' + systems.join(', ') + '\n';
  tip += 'Trades: ' + filtered.length + ' | Won: ' + wins + ' | Lost: ' + losses + '\n';
  tip += 'Avg Hold Time: ' + avgHrs + (avgHrs !== '—' ? 'h' : '') + '\n';
  tip += '---\n';
  filtered.slice(0, 8).forEach(p => {
    const s = (p.symbol || '').replace(/-USD$/,'').replace(/USDT$/,'').toUpperCase();
    const pnl = (p.pnl_pct || 0);
    const sys = (p.source_system || '?').replace(/_/g,' ');
    tip += s + ' ' + (p.direction||'LONG') + ' ' + (pnl >= 0 ? '+' : '') + pnl.toFixed(2) + '% [' + sys + '] ' + formatDateEST(p.timestamp) + '\n';
  });
  if (filtered.length > 8) tip += '... +' + (filtered.length - 8) + ' more (click to see all)';
  return tip;
}

function buildAgreeLevelTooltip(levelLabel, picks, min, max) {
  const filtered = picks.filter(p => (p.agreement_count || 1) >= min && (p.agreement_count || 1) <= max);
  if (!filtered.length) return '';
  const systems = [...new Set(filtered.map(p => (p.source_system || 'unknown').replace(/_/g, ' ')))];
  const sysCounts = {};
  filtered.forEach(p => {
    const s = (p.source_system || 'unknown').replace(/_/g, ' ');
    sysCounts[s] = (sysCounts[s] || 0) + 1;
  });
  const topSystems = Object.entries(sysCounts).sort((a, b) => b[1] - a[1]).slice(0, 5);
  let tip = levelLabel + ' — ' + filtered.length + ' trades\n';
  tip += 'Top systems: ' + topSystems.map(([s, c]) => s + ' (' + c + ')').join(', ') + '\n';
  tip += '---\nSample trades:\n';
  const samples = [...filtered].sort((a, b) => Math.abs(b.pnl_pct || 0) - Math.abs(a.pnl_pct || 0)).slice(0, 6);
  samples.forEach(p => {
    const s = (p.symbol || '').replace(/-USD$/,'').replace(/USDT$/,'').toUpperCase();
    const pnl = (p.pnl_pct || 0);
    tip += s + ' ' + (pnl >= 0 ? '+' : '') + pnl.toFixed(2) + '% [' + (p.source_system||'?').replace(/_/g,' ') + '] ' + formatDateEST(p.timestamp) + '\n';
  });
  if (filtered.length > 6) tip += '... click for all ' + filtered.length + ' trades';
  return tip;
}

function buildPairTooltip(pairName, pairPicks) {
  if (!pairPicks || !pairPicks.length) return '';
  const symbols = [...new Set(pairPicks.map(p => (p.symbol || '').replace(/-USD$/,'').replace(/USDT$/,'').replace(/-/g,'').toUpperCase()))];
  const sorted = [...pairPicks].sort((a, b) => (b.pnl_pct || 0) - (a.pnl_pct || 0));
  const best = sorted[0];
  const worst = sorted[sorted.length - 1];
  const dates = pairPicks.map(p => new Date(p.timestamp || p.created_at)).filter(d => !isNaN(d.getTime()));
  const minDate = dates.length ? formatDateEST(new Date(Math.min(...dates.map(d => d.getTime()))).toISOString()) : '—';
  const maxDate = dates.length ? formatDateEST(new Date(Math.max(...dates.map(d => d.getTime()))).toISOString()) : '—';

  let tip = pairName.replace(/_/g, ' ') + '\n';
  tip += 'Shared symbols: ' + symbols.join(', ') + '\n';
  tip += 'Date range: ' + minDate + ' — ' + maxDate + '\n';
  tip += '---\n';
  if (best) tip += 'Best trade: ' + (best.symbol||'').replace(/-USD$/,'').replace(/USDT$/,'').toUpperCase() + ' ' + (best.pnl_pct >= 0 ? '+' : '') + (best.pnl_pct||0).toFixed(2) + '%\n';
  if (worst) tip += 'Worst trade: ' + (worst.symbol||'').replace(/-USD$/,'').replace(/USDT$/,'').toUpperCase() + ' ' + (worst.pnl_pct >= 0 ? '+' : '') + (worst.pnl_pct||0).toFixed(2) + '%\n';
  tip += 'Click for full trade list';
  return tip;
}

function renderPermutations() {
  const sysPerm = D.cross_system_permutations || {};
  const stratPerm = D.cross_strategy_permutations || {};
  const sysPerms = sysPerm.permutations || [];
  const stratPerms = stratPerm.permutations || [];
  const sysSummary = sysPerm.summary || {};
  const stratSummary = stratPerm.summary || {};

  if (!sysPerms.length && !stratPerms.length) {
    el('tab-permutations').innerHTML = '<div class="empty-state">No permutation data available yet.</div>';
    return;
  }

  // Trust tier colors
  const tierColor = t => ({'Highly Trusted':'#22c55e','Trusted':'#3b82f6','Promising':'#f59e0b','Unproven':'#6b7280'}[t] || '#6b7280');
  const trustScoreColor = s => s >= 70 ? '#22c55e' : s >= 50 ? '#f59e0b' : s >= 30 ? '#fb923c' : '#ef4444';
  const tierBadge = t => '<span style="display:inline-block;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:600;color:#fff;background:'+tierColor(t)+'">'+t+'</span>';

  // ── Build Agreement Level Performance Analysis from closed picks ──
  function buildAgreementPerformance() {
    const closed = (D.picks?.recent_closed || []).slice();
    if (!closed.length) return '<div style="color:var(--text-dim);padding:12px;">No closed picks available for agreement analysis.</div>';

    // Compute agreement_count: how many systems flagged same symbol+direction within 24h window
    // First try to use existing agreement_count, otherwise compute it
    const hasAgreement = closed.some(p => (p.agreement_count || 0) > 0);
    if (!hasAgreement) {
      // Group by symbol+direction, then count overlaps within 24h
      const groups = {};
      closed.forEach(p => {
        const sym = (p.symbol || '').replace(/-USD$/,'').replace(/USDT$/,'').replace(/-/g,'').toUpperCase();
        const dir = (p.direction || 'LONG').toUpperCase();
        const key = sym + '|' + dir;
        if (!groups[key]) groups[key] = [];
        groups[key].push(p);
      });
      Object.values(groups).forEach(picks => {
        picks.forEach(p => {
          const ts = p.timestamp ? new Date(p.timestamp).getTime() : 0;
          const sys = p.source_system || '';
          let count = 0;
          const seenSystems = new Set([sys]);
          picks.forEach(q => {
            if (q === p) return;
            const qSys = q.source_system || '';
            if (seenSystems.has(qSys)) return;
            const qTs = q.timestamp ? new Date(q.timestamp).getTime() : 0;
            if (ts && qTs && Math.abs(ts - qTs) <= 86400000) {
              count++;
              seenSystems.add(qSys);
            } else if (!ts || !qTs) {
              count++;
              seenSystems.add(qSys);
            }
          });
          p.agreement_count = count + 1; // include self
        });
      });
    } else {
      closed.forEach(p => { p.agreement_count = p.agreement_count || 1; });
    }

    // Helper: calc stats for a set of picks
    function agreeStats(picks) {
      if (!picks.length) return { count: 0, wins: 0, winRate: 0, avgPnl: 0, totalPnl: 0, profitFactor: 0, bestSym: '-', worstSym: '-', bestPnl: 0, worstPnl: 0 };
      const wins = picks.filter(p => (p.pnl_pct || 0) > 0);
      const losses = picks.filter(p => (p.pnl_pct || 0) < 0);
      const totalPnl = picks.reduce((s, p) => s + (p.pnl_pct || 0), 0);
      const avgPnl = totalPnl / picks.length;
      const grossWin = wins.reduce((s, p) => s + (p.pnl_pct || 0), 0);
      const grossLoss = Math.abs(losses.reduce((s, p) => s + (p.pnl_pct || 0), 0));
      const pf = grossLoss > 0 ? grossWin / grossLoss : grossWin > 0 ? 999 : 0;
      // Best/worst symbol by avg pnl
      const symMap = {};
      picks.forEach(p => {
        const s = (p.symbol || '').replace(/-USD$/,'').replace(/USDT$/,'').toUpperCase();
        if (!symMap[s]) symMap[s] = { total: 0, pnl: 0 };
        symMap[s].total++;
        symMap[s].pnl += (p.pnl_pct || 0);
      });
      let bestSym = '-', worstSym = '-', bestAvg = -Infinity, worstAvg = Infinity;
      Object.entries(symMap).forEach(([sym, d]) => {
        const avg = d.pnl / d.total;
        if (d.total >= 2 && avg > bestAvg) { bestAvg = avg; bestSym = sym; }
        if (d.total >= 2 && avg < worstAvg) { worstAvg = avg; worstSym = sym; }
      });
      return { count: picks.length, wins: wins.length, winRate: wins.length / picks.length * 100, avgPnl, totalPnl, profitFactor: pf, bestSym, worstSym, bestPnl: bestAvg === -Infinity ? 0 : bestAvg, worstPnl: worstAvg === Infinity ? 0 : worstAvg };
    }

    const fmtP = (v, d) => (d === undefined ? 2 : d, v.toFixed(d === undefined ? 2 : d));
    const pnlCls = v => v > 0 ? 'pnl-pos' : v < 0 ? 'pnl-neg' : 'pnl-zero';

    // ── 1. Agreement Level Performance Table ──
    const levels = [
      { label: 'Solo (1 system)', min: 1, max: 1 },
      { label: '2 systems', min: 2, max: 2 },
      { label: '3 systems', min: 3, max: 3 },
      { label: '4 systems', min: 4, max: 4 },
      { label: '5+ systems', min: 5, max: 999 }
    ];
    const levelData = levels.map(l => {
      const picks = closed.filter(p => p.agreement_count >= l.min && p.agreement_count <= l.max);
      return { ...l, ...agreeStats(picks) };
    }).filter(l => l.count > 0);

    // Find best level by risk-adjusted: highest (WR * avgPnl) with min 3 trades
    let bestLevel = null, bestScore = -Infinity;
    levelData.forEach(l => {
      if (l.count >= 3) {
        const score = l.winRate * (l.avgPnl > 0 ? l.avgPnl : 0) + l.profitFactor * 10;
        if (score > bestScore) { bestScore = score; bestLevel = l.label; }
      }
    });

    let h = '<div style="margin-bottom:32px;border:1px solid var(--border);border-radius:12px;padding:20px;background:var(--card);">';
    h += '<h3 style="font-size:18px;color:#a78bfa;margin-bottom:4px;display:flex;align-items:center;gap:8px;">Agreement Level Performance <span style="font-size:12px;color:var(--text-dim);font-weight:400;">(Backtested on ' + closed.length + ' Closed Picks)</span></h3>';
    h += '<p style="font-size:12px;color:var(--text-dim);margin-bottom:16px;">If you traded based on cross-system agreement, which combination performs best?</p>';

    // Sort state for agreement tables
    let agreeSortKey = 'totalPnl';
    let agreeSortDir = -1;

    // Table
    h += '<div style="overflow-x:auto;margin-bottom:20px;"><table class="data-table" id="agree-level-table"><thead><tr style="border-bottom:2px solid var(--border);">';
    h += '<th style="padding:8px 10px;cursor:pointer;white-space:nowrap;" data-agree-sort="label">Agreement Level</th>';
    h += '<th class="num" style="cursor:pointer;" data-agree-sort="count"># Trades</th>';
    h += '<th class="num" style="cursor:pointer;" data-agree-sort="winRate">Win Rate</th>';
    h += '<th class="num" style="cursor:pointer;" data-agree-sort="avgPnl">Avg PnL%</th>';
    h += '<th class="num" style="cursor:pointer;" data-agree-sort="totalPnl">Total PnL%</th>';
    h += '<th class="num" style="cursor:pointer;" data-agree-sort="profitFactor">Profit Factor</th>';
    h += '<th style="cursor:pointer;" data-agree-sort="bestSym">Best Symbol</th>';
    h += '<th style="cursor:pointer;" data-agree-sort="worstSym">Worst Symbol</th>';
    h += '</tr></thead><tbody>';
    levelData.forEach(l => {
      const isBest = l.label === bestLevel;
      const rowBg = isBest ? 'rgba(167,139,250,0.15)' : l.totalPnl > 0 ? 'rgba(76,175,80,0.06)' : l.totalPnl < 0 ? 'rgba(244,67,54,0.06)' : '';
      const border = isBest ? 'border-left:3px solid #a78bfa;' : '';
      const lvlPicks = closed.filter(p => p.agreement_count >= l.min && p.agreement_count <= l.max);
      const tipText = buildAgreeLevelTooltip(l.label, closed, l.min, l.max).replace(/"/g, '&quot;');
      h += '<tr style="background:'+rowBg+';'+border+'cursor:pointer;" title="'+tipText+'" onclick="showTradeModal(\'Agreement: '+l.label.replace(/'/g,"\\'")+'\', window.__agreeLevelPicks_'+l.min+'_'+l.max+')">';
      h += '<td style="padding:8px 10px;font-weight:600;">'+l.label+(isBest ? ' <span style="color:#a78bfa;font-size:10px;">BEST</span>' : '')+'</td>';
      h += '<td class="num">'+l.count+'</td>';
      h += '<td class="num" style="color:'+(l.winRate >= 55 ? 'var(--green)' : l.winRate >= 45 ? 'var(--yellow)' : 'var(--red)')+';">'+l.winRate.toFixed(1)+'%</td>';
      h += '<td class="num '+pnlCls(l.avgPnl)+'">'+(l.avgPnl >= 0 ? '+' : '')+l.avgPnl.toFixed(2)+'%</td>';
      h += '<td class="num '+pnlCls(l.totalPnl)+'"><strong>'+(l.totalPnl >= 0 ? '+' : '')+l.totalPnl.toFixed(1)+'%</strong></td>';
      h += '<td class="num" style="color:'+(l.profitFactor >= 1.5 ? 'var(--green)' : l.profitFactor >= 1 ? 'var(--yellow)' : 'var(--red)')+';">'+(l.profitFactor >= 999 ? '&#8734;' : l.profitFactor.toFixed(2))+'</td>';
      h += '<td style="font-size:12px;color:var(--green);">'+l.bestSym+'</td>';
      h += '<td style="font-size:12px;color:var(--red);">'+l.worstSym+'</td>';
      h += '</tr>';
      // Store picks on window for onclick access
      window['__agreeLevelPicks_'+l.min+'_'+l.max] = lvlPicks;
    });
    h += '</tbody></table></div>';

    // ── 2. System Combination Analysis ──
    h += '<h4 style="font-size:15px;color:var(--cyan);margin-bottom:8px;">System Pair Performance</h4>';
    h += '<p style="font-size:12px;color:var(--text-dim);margin-bottom:12px;">For each pair of systems that traded the same symbol+direction: combined win rate and PnL.</p>';

    // Group closed picks by symbol+direction
    const symDirGroups = {};
    closed.forEach(p => {
      const sym = (p.symbol || '').replace(/-USD$/,'').replace(/USDT$/,'').replace(/-/g,'').toUpperCase();
      const dir = (p.direction || 'LONG').toUpperCase();
      const key = sym + '|' + dir;
      if (!symDirGroups[key]) symDirGroups[key] = [];
      symDirGroups[key].push(p);
    });

    // Find pairs
    const pairMap = {};
    Object.values(symDirGroups).forEach(picks => {
      // Get unique systems in this group
      const systemPicks = {};
      picks.forEach(p => {
        const sys = p.source_system || 'unknown';
        if (!systemPicks[sys]) systemPicks[sys] = [];
        systemPicks[sys].push(p);
      });
      const systems = Object.keys(systemPicks);
      // Generate pairs
      for (let i = 0; i < systems.length; i++) {
        for (let j = i + 1; j < systems.length; j++) {
          const pairKey = [systems[i], systems[j]].sort().join(' + ');
          if (!pairMap[pairKey]) pairMap[pairKey] = [];
          // Add all picks from both systems in this group
          pairMap[pairKey].push(...systemPicks[systems[i]], ...systemPicks[systems[j]]);
        }
      }
    });

    // Deduplicate picks in each pair (same pick could appear from multiple groups)
    Object.keys(pairMap).forEach(key => {
      const seen = new Set();
      pairMap[key] = pairMap[key].filter(p => {
        const id = (p.symbol||'') + '|' + (p.timestamp||'') + '|' + (p.source_system||'');
        if (seen.has(id)) return false;
        seen.add(id);
        return true;
      });
    });

    const pairEntries = Object.entries(pairMap).map(([name, picks]) => {
      const stats = agreeStats(picks);
      return { name, ...stats };
    }).filter(p => p.count >= 2);

    // Top 10 best
    const bestPairs = [...pairEntries].sort((a, b) => b.totalPnl - a.totalPnl).slice(0, 10);
    // Top 5 worst
    const worstPairs = [...pairEntries].sort((a, b) => a.totalPnl - b.totalPnl).slice(0, 5);

    if (bestPairs.length) {
      h += '<div style="display:flex;flex-wrap:wrap;gap:20px;margin-bottom:16px;">';
      // Best pairs table
      h += '<div style="flex:1;min-width:400px;"><h5 style="font-size:13px;color:var(--green);margin-bottom:6px;">Top 10 Best Performing System Pairs</h5>';
      h += '<div style="overflow-x:auto;"><table class="data-table" id="agree-best-pairs"><thead><tr>';
      h += '<th style="cursor:pointer;" data-pair-sort="name">System Pair</th>';
      h += '<th class="num" style="cursor:pointer;" data-pair-sort="count">Shared Picks</th>';
      h += '<th class="num" style="cursor:pointer;" data-pair-sort="winRate">Win Rate</th>';
      h += '<th class="num" style="cursor:pointer;" data-pair-sort="avgPnl">Avg PnL%</th>';
      h += '<th class="num" style="cursor:pointer;" data-pair-sort="totalPnl">Total PnL%</th>';
      h += '<th class="num" style="cursor:pointer;" data-pair-sort="profitFactor">PF</th>';
      h += '</tr></thead><tbody>';
      bestPairs.forEach((p, i) => {
        const rowBg = i === 0 ? 'rgba(167,139,250,0.12)' : p.totalPnl > 0 ? 'rgba(76,175,80,0.06)' : 'rgba(244,67,54,0.06)';
        const pairKey = '__bestPairPicks_' + i;
        window[pairKey] = pairMap[p.name] || [];
        const tipText = buildPairTooltip(p.name, pairMap[p.name] || []).replace(/"/g, '&quot;');
        h += '<tr style="background:'+rowBg+';cursor:pointer;" title="'+tipText+'" onclick="showTradeModal(\'System Pair: '+p.name.replace(/_/g,' ').replace(/'/g,"\\'")+'\', window.'+pairKey+')">';
        h += '<td style="padding:6px 10px;font-weight:600;font-size:12px;">'+p.name.replace(/_/g,' ')+(i === 0 ? ' <span style="color:#a78bfa;font-size:10px;">OPTIMAL</span>' : '')+'</td>';
        h += '<td class="num">'+p.count+'</td>';
        h += '<td class="num" style="color:'+(p.winRate >= 55 ? 'var(--green)' : p.winRate >= 45 ? 'var(--yellow)' : 'var(--red)')+';">'+p.winRate.toFixed(1)+'%</td>';
        h += '<td class="num '+pnlCls(p.avgPnl)+'">'+(p.avgPnl >= 0 ? '+' : '')+p.avgPnl.toFixed(2)+'%</td>';
        h += '<td class="num '+pnlCls(p.totalPnl)+'"><strong>'+(p.totalPnl >= 0 ? '+' : '')+p.totalPnl.toFixed(1)+'%</strong></td>';
        h += '<td class="num" style="color:'+(p.profitFactor >= 1.5 ? 'var(--green)' : p.profitFactor >= 1 ? 'var(--yellow)' : 'var(--red)')+';">'+(p.profitFactor >= 999 ? '&#8734;' : p.profitFactor.toFixed(2))+'</td>';
        h += '</tr>';
      });
      h += '</tbody></table></div></div>';

      // Worst pairs table
      if (worstPairs.length) {
        h += '<div style="flex:0 0 auto;min-width:350px;"><h5 style="font-size:13px;color:var(--red);margin-bottom:6px;">Top 5 Worst Performing System Pairs</h5>';
        h += '<div style="overflow-x:auto;"><table class="data-table"><thead><tr>';
        h += '<th>System Pair</th><th class="num">Shared</th><th class="num">Win Rate</th><th class="num">Total PnL%</th><th class="num">PF</th>';
        h += '</tr></thead><tbody>';
        worstPairs.forEach((p, i) => {
          const wpKey = '__worstPairPicks_' + i;
          window[wpKey] = pairMap[p.name] || [];
          const tipText = buildPairTooltip(p.name, pairMap[p.name] || []).replace(/"/g, '&quot;');
          h += '<tr style="background:rgba(244,67,54,0.06);cursor:pointer;" title="'+tipText+'" onclick="showTradeModal(\'System Pair: '+p.name.replace(/_/g,' ').replace(/'/g,"\\'")+'\', window.'+wpKey+')">';
          h += '<td style="padding:6px 10px;font-size:12px;">'+p.name.replace(/_/g,' ')+'</td>';
          h += '<td class="num">'+p.count+'</td>';
          h += '<td class="num" style="color:'+(p.winRate >= 50 ? 'var(--green)' : 'var(--red)')+';">'+p.winRate.toFixed(1)+'%</td>';
          h += '<td class="num '+pnlCls(p.totalPnl)+'">'+(p.totalPnl >= 0 ? '+' : '')+p.totalPnl.toFixed(1)+'%</td>';
          h += '<td class="num" style="color:'+(p.profitFactor >= 1 ? 'var(--green)' : 'var(--red)')+';">'+(p.profitFactor >= 999 ? '&#8734;' : p.profitFactor.toFixed(2))+'</td>';
          h += '</tr>';
        });
        h += '</tbody></table></div></div>';
      }
      h += '</div>';
    } else {
      h += '<div style="color:var(--text-dim);padding:8px;font-size:13px;">Not enough shared picks to analyze system pairs.</div>';
    }

    // ── 3. Per-Symbol Agreement Heatmap (from closed picks) ──
    h += '<h4 style="font-size:15px;color:var(--yellow);margin:20px 0 8px;">Per-Symbol Agreement Heatmap <span style="font-size:11px;color:#888;font-weight:normal;">(HISTORICAL — backtested on closed picks)</span></h4>';
    h += '<p style="font-size:12px;color:var(--text-dim);margin-bottom:12px;">Shows how past trades performed at each agreement level per symbol. Use this to decide whether to trade a NEW signal: e.g. if 3-system agreement on BTC historically wins 65% of the time, a new 3-system BTC signal is likely worth taking. <b>This is NOT live picks</b> — it\'s historical performance to guide your decisions. Only symbols with 3+ closed trades shown.</p>';

    const symAgreeMap = {};
    const agreeLvls = new Set();
    closed.forEach(p => {
      const sym = (p.symbol || '').replace(/-USD$/,'').replace(/USDT$/,'').replace(/-/g,'').toUpperCase();
      if (!sym) return;
      const agree = Math.min(p.agreement_count || 1, 5);
      agreeLvls.add(agree);
      if (!symAgreeMap[sym]) symAgreeMap[sym] = {};
      if (!symAgreeMap[sym][agree]) symAgreeMap[sym][agree] = { wins: 0, total: 0, pnl: 0 };
      symAgreeMap[sym][agree].total++;
      symAgreeMap[sym][agree].pnl += (p.pnl_pct || 0);
      if ((p.pnl_pct || 0) > 0) symAgreeMap[sym][agree].wins++;
    });

    const heatLevels = [...agreeLvls].sort((a, b) => a - b);
    const heatSymbols = Object.keys(symAgreeMap).filter(s => {
      const total = heatLevels.reduce((n, l) => n + (symAgreeMap[s][l]?.total || 0), 0);
      return total >= 3;
    }).sort((a, b) => {
      const aPnl = heatLevels.reduce((s, l) => s + (symAgreeMap[a][l]?.pnl || 0), 0);
      const bPnl = heatLevels.reduce((s, l) => s + (symAgreeMap[b][l]?.pnl || 0), 0);
      return bPnl - aPnl;
    });

    if (heatSymbols.length) {
      h += '<div style="overflow-x:auto;"><table class="data-table"><thead><tr>';
      h += '<th style="padding:6px 10px;">Symbol</th>';
      heatLevels.forEach(l => {
        h += '<th style="padding:6px 10px;text-align:center;">'+(l === 1 ? '1 (Solo)' : l >= 5 ? '5+' : l+'-Sys')+'</th>';
      });
      h += '<th style="padding:6px 10px;text-align:center;">Total PnL</th>';
      h += '</tr></thead><tbody>';

      // Store closed picks on window for heatmap onclick
      window.__heatmapClosed = closed;
      let heatCellIdx = 0;
      heatSymbols.forEach(sym => {
        let totalSymPnl = 0;
        h += '<tr style="border-bottom:1px solid var(--border);">';
        h += '<td style="padding:6px 10px;font-weight:600;">'+sym+'</td>';
        heatLevels.forEach(l => {
          const d = symAgreeMap[sym][l];
          if (!d || d.total === 0) {
            h += '<td style="padding:6px 10px;text-align:center;color:var(--text-dim);">&mdash;</td>';
          } else {
            totalSymPnl += d.pnl;
            const avgP = d.pnl / d.total;
            const bgR = avgP >= 0 ? '34,197,94' : '239,68,68';
            const alpha = Math.min(0.35, 0.1 + Math.abs(avgP) / 20 * 0.25);
            // Collect picks for this cell
            const cellPicks = closed.filter(p => {
              const ps = (p.symbol || '').replace(/-USD$/,'').replace(/USDT$/,'').replace(/-/g,'').toUpperCase();
              return ps === sym && Math.min(p.agreement_count || 1, 5) === l;
            });
            const cellKey = '__heatCell_' + heatCellIdx++;
            window[cellKey] = cellPicks;
            const tipText = buildHeatmapTooltip(sym, l, closed).replace(/"/g, '&quot;');
            h += '<td style="padding:6px 10px;text-align:center;background:rgba('+bgR+','+alpha.toFixed(2)+');cursor:pointer;" title="'+tipText+'" onclick="showTradeModal(\''+sym+' — '+(l >= 5 ? '5+' : l)+'-System Agreement\', window.'+cellKey+')"><span style="font-weight:600;color:'+(avgP >= 0 ? 'var(--green)' : 'var(--red)')+';">'+(avgP >= 0 ? '+' : '')+avgP.toFixed(2)+'%</span><br><span style="font-size:10px;color:var(--text-dim);">n='+d.total+' | '+(d.wins/d.total*100).toFixed(0)+'% WR</span></td>';
          }
        });
        totalSymPnl = heatLevels.reduce((s, l) => s + (symAgreeMap[sym][l]?.pnl || 0), 0);
        // Sym total row — onclick shows all trades for this symbol
        const symAllPicks = closed.filter(p => {
          const ps = (p.symbol || '').replace(/-USD$/,'').replace(/USDT$/,'').replace(/-/g,'').toUpperCase();
          return ps === sym;
        });
        const symKey = '__heatSym_' + sym;
        window[symKey] = symAllPicks;
        h += '<td class="num '+pnlCls(totalSymPnl)+'" style="padding:6px 10px;text-align:center;font-weight:600;cursor:pointer;" onclick="showTradeModal(\'All Trades: '+sym+'\', window.'+symKey+')">'+(totalSymPnl >= 0 ? '+' : '')+totalSymPnl.toFixed(1)+'%</td>';
        h += '</tr>';
      });
      h += '</tbody></table></div>';
    } else {
      h += '<div style="color:var(--text-dim);padding:8px;font-size:13px;">Insufficient data for per-symbol heatmap (need 3+ trades per symbol).</div>';
    }

    // ── 4. Verdict Box ──
    const bestLevelData = levelData.find(l => l.label === bestLevel);
    const optimalPair = bestPairs.length ? bestPairs[0] : null;
    h += '<div style="margin-top:20px;padding:16px 20px;background:linear-gradient(135deg,rgba(167,139,250,0.08),rgba(59,130,246,0.08));border:1px solid rgba(167,139,250,0.3);border-radius:10px;">';
    h += '<h4 style="font-size:14px;color:#a78bfa;margin-bottom:8px;">Verdict: Optimal Agreement Strategy</h4>';
    if (bestLevelData) {
      h += '<p style="font-size:13px;color:var(--text);line-height:1.6;">Based on <strong>'+closed.length+'</strong> closed picks, trading with <strong style="color:#a78bfa;">'+bestLevel+'</strong> agreement produces the best risk-adjusted returns: ';
      h += '<strong style="color:'+(bestLevelData.winRate >= 50 ? 'var(--green)' : 'var(--red)')+';">'+bestLevelData.winRate.toFixed(1)+'% WR</strong>, ';
      h += '<strong style="color:'+pnlCls(bestLevelData.avgPnl)+'">'+(bestLevelData.avgPnl >= 0 ? '+' : '')+bestLevelData.avgPnl.toFixed(2)+'% avg PnL</strong>, ';
      h += '<strong style="color:'+(bestLevelData.profitFactor >= 1 ? 'var(--green)' : 'var(--red)')+';">'+(bestLevelData.profitFactor >= 999 ? '&#8734;' : bestLevelData.profitFactor.toFixed(2))+' profit factor</strong>.';
      if (optimalPair) {
        h += ' The optimal system pair is <strong style="color:var(--cyan);">'+optimalPair.name.replace(/_/g,' ')+'</strong> ('+optimalPair.winRate.toFixed(1)+'% WR, '+(optimalPair.totalPnl >= 0 ? '+' : '')+optimalPair.totalPnl.toFixed(1)+'% total PnL).';
      }
      h += '</p>';
    } else {
      h += '<p style="font-size:13px;color:var(--text-dim);">Not enough data to determine optimal agreement level (need at least 3 trades per level).</p>';
    }
    h += '</div>';

    h += '</div>'; // close main container
    return h;
  }

  // Compute summary across all perms
  const allPerms = sysPerms.concat(stratPerms);
  const withTrades = allPerms.filter(p => p.total_trades > 0);
  const totalPortfolios = allPerms.length;
  const bestPerformer = withTrades.length ? withTrades.reduce((a,b) => a.trust_score > b.trust_score ? a : b) : null;
  const worstPerformer = withTrades.length ? withTrades.reduce((a,b) => a.trust_score < b.trust_score ? a : b) : null;
  const avgWR = withTrades.length ? (withTrades.reduce((s,p) => s + p.win_rate, 0) / withTrades.length).toFixed(1) : '0.0';

  // Sort state
  let sortKey = 'trust_score';
  let sortDir = -1; // descending

  function buildTable(perms, type) {
    const sorted = [...perms].sort((a, b) => {
      let av = a[sortKey] ?? 0, bv = b[sortKey] ?? 0;
      if (sortKey === 'active_picks_count') { av = Array.isArray(a.active_picks) ? a.active_picks.length : (a.active_picks||0); bv = Array.isArray(b.active_picks) ? b.active_picks.length : (b.active_picks||0); }
      if (typeof av === 'string') return av.localeCompare(bv) * sortDir;
      return ((av||0) - (bv||0)) * sortDir;
    });
    let html = '<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:13px;">';
    html += '<thead><tr style="border-bottom:2px solid var(--border);text-align:left;">';
    const cols = [
      {key:'name',label:'Name'},
      {key:'category',label:'Category'},
      {key:'min_agreement',label:'Agreement'},
      {key:'total_trades',label:'Trades'},
      {key:'win_rate',label:'Win Rate'},
      {key:'total_pnl',label:'Total PnL'},
      {key:'profit_factor',label:'PF'},
      {key:'avg_pnl',label:'Expectancy'},
      {key:'trust_score',label:'Trust Score'},
      {key:'trust_tier',label:'Tier'},
      {key:'active_picks_count',label:'Active'}
    ];
    for (const c of cols) {
      const arrow = sortKey === c.key ? (sortDir > 0 ? ' \\u25B2' : ' \\u25BC') : '';
      html += '<th style="padding:8px 10px;color:var(--text-dim);font-size:11px;text-transform:uppercase;cursor:pointer;white-space:nowrap;" data-sort-key="'+c.key+'" data-sort-type="'+type+'">'+c.label+arrow+'</th>';
    }
    html += '</tr></thead><tbody>';

    for (const p of sorted) {
      const tierBg = tierColor(p.trust_tier);
      const rowBg = p.total_trades > 0 ? 'rgba(' + (p.trust_tier === 'Highly Trusted' ? '34,197,94' : p.trust_tier === 'Trusted' ? '59,130,246' : p.trust_tier === 'Promising' ? '245,158,11' : '107,114,128') + ',0.06)' : 'transparent';
      const cat = type === 'strategy' ? (p.category || '—') : (p.systems?.length === 1 ? 'solo' : p.systems?.length === 2 ? 'pair' : p.systems?.length >= 3 ? (p.name.toLowerCase().includes('flex') ? 'flexible' : 'triplet') : '—');
      const catBadge = '<span style="display:inline-block;padding:1px 6px;border-radius:3px;font-size:10px;font-weight:600;background:var(--card-hover);color:var(--text-dim);text-transform:uppercase;">'+cat+'</span>';
      const wrColor = p.win_rate >= 60 ? 'var(--green)' : p.win_rate >= 45 ? 'var(--yellow)' : p.win_rate > 0 ? 'var(--red)' : 'var(--text-dim)';
      const pnlColor = p.total_pnl > 0 ? 'var(--green)' : p.total_pnl < 0 ? 'var(--red)' : 'var(--text-dim)';
      const expColor = (p.avg_pnl||0) >= 0 ? 'var(--green)' : 'var(--red)';
      const pfColor = (p.profit_factor||0) >= 1 ? 'var(--green)' : (p.profit_factor||0) > 0 ? 'var(--red)' : 'var(--text-dim)';
      const activeCount = Array.isArray(p.active_picks) ? p.active_picks.length : (p.active_picks || 0);
      html += '<tr style="border-bottom:1px solid var(--border);background:'+rowBg+';">';
      html += '<td style="padding:8px 10px;font-weight:600;white-space:nowrap;">'+p.name+'</td>';
      html += '<td style="padding:8px 10px;">'+catBadge+'</td>';
      html += '<td style="padding:8px 10px;text-align:center;"><span style="background:var(--card-hover);padding:2px 8px;border-radius:4px;font-weight:600;">'+p.min_agreement+'</span></td>';
      html += '<td style="padding:8px 10px;text-align:center;font-variant-numeric:tabular-nums;">'+p.total_trades+'</td>';
      html += '<td style="padding:8px 10px;text-align:center;color:'+wrColor+';font-weight:600;">'+fmt(p.win_rate)+'%</td>';
      html += '<td style="padding:8px 10px;text-align:right;color:'+pnlColor+';font-weight:600;font-variant-numeric:tabular-nums;">'+(p.total_pnl >= 0 ? '+' : '')+fmt(p.total_pnl,1)+'%</td>';
      html += '<td style="padding:8px 10px;text-align:center;color:'+pfColor+';">'+(p.profit_factor != null ? fmt(p.profit_factor,2) : '\u2014')+'</td>';
      html += '<td style="padding:8px 10px;text-align:center;color:'+expColor+';">'+(p.avg_pnl != null ? (p.avg_pnl >= 0 ? '+' : '') + fmt(p.avg_pnl,2) + '%' : '\u2014')+'</td>';
      html += '<td style="padding:8px 10px;text-align:center;"><span style="display:inline-block;min-width:36px;padding:3px 8px;border-radius:6px;font-weight:700;color:#fff;background:'+trustScoreColor(p.trust_score)+';">'+fmt(p.trust_score,0)+'</span></td>';
      html += '<td style="padding:8px 10px;">'+tierBadge(p.trust_tier)+'</td>';
      html += '<td style="padding:8px 10px;text-align:center;">'+activeCount+'</td>';
      html += '</tr>';
    }
    html += '</tbody></table></div>';
    return html;
  }

  // Build per-symbol heatmap from closed picks
  function buildSymbolHeatmap() {
    const symAgree = {};
    const agreeLevels = new Set();
    for (const p of sysPerms) {
      const agree = p.min_agreement;
      agreeLevels.add(agree);
      for (const pick of (p.closed_picks || [])) {
        const sym = (pick.symbol || '').replace(/-USD$/,'').replace(/USDT$/,'').replace(/-/g,'').toUpperCase();
        if (!sym) continue;
        if (!symAgree[sym]) symAgree[sym] = {};
        if (!symAgree[sym][agree]) symAgree[sym][agree] = {wins:0,total:0};
        symAgree[sym][agree].total++;
        if ((pick.pnl_pct || 0) > 0) symAgree[sym][agree].wins++;
      }
    }
    // Also include strategy perms
    for (const p of stratPerms) {
      const agree = p.min_agreement;
      agreeLevels.add(agree);
      for (const pick of (p.closed_picks || [])) {
        const sym = (pick.symbol || '').replace(/-USD$/,'').replace(/USDT$/,'').replace(/-/g,'').toUpperCase();
        if (!sym) continue;
        if (!symAgree[sym]) symAgree[sym] = {};
        if (!symAgree[sym][agree]) symAgree[sym][agree] = {wins:0,total:0};
        symAgree[sym][agree].total++;
        if ((pick.pnl_pct || 0) > 0) symAgree[sym][agree].wins++;
      }
    }

    const levels = [...agreeLevels].sort((a,b) => a - b);
    // Filter to symbols with at least 5 trades
    const symbols = Object.keys(symAgree).filter(s => {
      const total = levels.reduce((n, l) => n + (symAgree[s][l]?.total || 0), 0);
      return total >= 5;
    }).sort((a, b) => {
      // Sort by best WR at any level
      const bestA = Math.max(...levels.map(l => symAgree[a][l] ? symAgree[a][l].wins / symAgree[a][l].total * 100 : 0));
      const bestB = Math.max(...levels.map(l => symAgree[b][l] ? symAgree[b][l].wins / symAgree[b][l].total * 100 : 0));
      return bestB - bestA;
    });

    if (!symbols.length) return '<div style="color:var(--text-dim);padding:12px;">Insufficient data for per-symbol heatmap (need 5+ trades per symbol).</div>';

    let html = '<div style="overflow-x:auto;"><table style="width:100%;border-collapse:collapse;font-size:13px;">';
    html += '<thead><tr style="border-bottom:2px solid var(--border);"><th style="padding:8px 10px;text-align:left;color:var(--text-dim);font-size:11px;text-transform:uppercase;">Symbol</th>';
    for (const l of levels) {
      html += '<th style="padding:8px 10px;text-align:center;color:var(--text-dim);font-size:11px;">' + (l === 1 ? '1 (Solo)' : l + '-Sys') + '</th>';
    }
    html += '<th style="padding:8px 10px;text-align:center;color:var(--text-dim);font-size:11px;">Best Level</th>';
    html += '</tr></thead><tbody>';

    for (const sym of symbols) {
      let bestLevel = null, bestWR = -1;
      html += '<tr style="border-bottom:1px solid var(--border);">';
      html += '<td style="padding:6px 10px;font-weight:600;">' + sym + '</td>';
      for (const l of levels) {
        const d = symAgree[sym][l];
        if (!d || d.total === 0) {
          html += '<td style="padding:6px 10px;text-align:center;color:var(--text-dim);">&mdash;</td>';
        } else {
          const wr = d.wins / d.total * 100;
          if (wr > bestWR) { bestWR = wr; bestLevel = l; }
          // Heatmap color: green for high WR, red for low
          const r = wr >= 60 ? 34 : wr >= 45 ? 245 : 239;
          const g = wr >= 60 ? 197 : wr >= 45 ? 158 : 68;
          const b2 = wr >= 60 ? 94 : wr >= 45 ? 11 : 68;
          const alpha = Math.min(0.4, 0.15 + (d.total / 100) * 0.25);
          html += '<td style="padding:6px 10px;text-align:center;background:rgba('+r+','+g+','+b2+','+alpha.toFixed(2)+');"><span style="font-weight:600;color:'+(wr >= 60 ? 'var(--green)' : wr >= 45 ? 'var(--yellow)' : 'var(--red)')+';">'+wr.toFixed(1)+'%</span><br><span style="font-size:10px;color:var(--text-dim);">n='+d.total+'</span></td>';
        }
      }
      // Best level column
      if (bestLevel !== null) {
        html += '<td style="padding:6px 10px;text-align:center;"><span style="background:var(--card-hover);padding:2px 8px;border-radius:4px;font-weight:700;color:var(--cyan);">' + (bestLevel === 1 ? 'Solo' : bestLevel + '-Sys') + '</span></td>';
      } else {
        html += '<td style="padding:6px 10px;text-align:center;color:var(--text-dim);">&mdash;</td>';
      }
      html += '</tr>';
    }
    html += '</tbody></table></div>';
    return html;
  }

  // Main layout
  let html = '';

  // ── Agreement Level Performance Analysis (Backtested on Closed Picks) ──
  html += buildAgreementPerformance();

  // Summary cards
  html += '<div class="summary-row" style="margin-bottom:20px;">';
  html += '<div class="stat-card"><div class="label">Total Portfolios</div><div class="value">'+totalPortfolios+'</div></div>';
  html += '<div class="stat-card"><div class="label">With Trades</div><div class="value">'+withTrades.length+'</div></div>';
  html += '<div class="stat-card"><div class="label">Best Performer</div><div class="value" style="font-size:16px;color:'+tierColor(bestPerformer?.trust_tier)+'">'+(bestPerformer ? bestPerformer.name : '\u2014')+'</div><div style="font-size:12px;color:var(--text-dim);margin-top:2px;">'+(bestPerformer ? 'Trust: ' + fmt(bestPerformer.trust_score,0) + ' | WR: ' + fmt(bestPerformer.win_rate) + '%' : '')+'</div></div>';
  html += '<div class="stat-card"><div class="label">Worst Performer</div><div class="value" style="font-size:16px;color:'+tierColor(worstPerformer?.trust_tier)+'">'+(worstPerformer ? worstPerformer.name : '\u2014')+'</div><div style="font-size:12px;color:var(--text-dim);margin-top:2px;">'+(worstPerformer ? 'Trust: ' + fmt(worstPerformer.trust_score,0) + ' | WR: ' + fmt(worstPerformer.win_rate) + '%' : '')+'</div></div>';
  html += '<div class="stat-card"><div class="label">Avg Win Rate</div><div class="value '+(parseFloat(avgWR) >= 50 ? 'positive' : 'negative')+'">'+avgWR+'%</div></div>';
  html += '</div>';

  // System Permutations section
  html += '<div style="margin-bottom:24px;">';
  html += '<h3 style="font-size:16px;color:var(--cyan);margin-bottom:4px;display:flex;align-items:center;gap:8px;">System Permutations <span style="font-size:12px;color:var(--text-dim);font-weight:400;">' + sysPerms.length + ' portfolios | ' + (sysSummary.highly_trusted||0) + ' highly trusted, ' + (sysSummary.trusted||0) + ' trusted</span></h3>';
  html += '<div id="perm-sys-table">' + buildTable(sysPerms, 'system') + '</div>';
  html += '</div>';

  // Strategy Permutations section
  html += '<div style="margin-bottom:24px;">';
  html += '<h3 style="font-size:16px;color:var(--purple);margin-bottom:4px;display:flex;align-items:center;gap:8px;">Strategy Permutations <span style="font-size:12px;color:var(--text-dim);font-weight:400;">' + stratPerms.length + ' portfolios | ' + (stratSummary.highly_trusted||0) + ' highly trusted, ' + (stratSummary.trusted||0) + ' trusted</span></h3>';
  html += '<div id="perm-strat-table">' + buildTable(stratPerms, 'strategy') + '</div>';
  html += '</div>';

  // Per-Symbol Heatmap
  html += '<div style="margin-bottom:24px;">';
  html += '<h3 style="font-size:16px;color:var(--yellow);margin-bottom:8px;">Per-Symbol Performance by Agreement Level</h3>';
  html += '<p style="font-size:12px;color:var(--text-dim);margin-bottom:12px;">Which agreement level works best for each symbol? Cells show Win Rate with sample size. Only symbols with 5+ total trades shown.</p>';
  html += buildSymbolHeatmap();
  html += '</div>';

  el('tab-permutations').innerHTML = html;

  // Wire sort headers via event delegation
  el('tab-permutations').addEventListener('click', function(e) {
    const th = e.target.closest('th[data-sort-key]');
    if (!th) return;
    const key = th.dataset.sortKey;
    if (sortKey === key) { sortDir *= -1; } else { sortKey = key; sortDir = key === 'name' || key === 'trust_tier' || key === 'category' ? 1 : -1; }
    el('perm-sys-table').innerHTML = buildTable(sysPerms, 'system');
    el('perm-strat-table').innerHTML = buildTable(stratPerms, 'strategy');
  });
}

// ── Cross-System Agreement Matrix (v2 — deduped, ranked, with performance) ──
function renderAgreementMatrix() {
  // Expanded 2026-03-16: added ZRO, HYPE, XLM, ZEC, CAKE, PEPE, UNI, AAVE (top gainers + market cap gaps)
  const TRACKED_SYMBOLS = ['BTCUSDT','ETHUSDT','SOLUSDT','XRPUSDT','DOGEUSDT','BNBUSDT','ADAUSDT','AVAXUSDT','LINKUSDT','DOTUSDT','NEARUSDT','FILUSDT','RENDERUSDT','SUIUSDT','HBARUSDT','ZROUSDT','HYPEUSDT','XLMUSDT','ZECUSDT','CAKEUSDT','PEPEUSDT','UNIUSDT','AAVEUSDT'];
  const picks = D.picks?.active || [];
  const closedPicks = D.picks?.recent_closed || [];
  if (!picks.length) { el('agreement-matrix').style.display = 'none'; return; }

  function normSym(s) {
    s = (s||'').toUpperCase().replace(/-/g,'').replace(/\/.*$/,'');
    if (s.endsWith('USD') && !s.endsWith('USDT')) s += 'T';
    if (!s.endsWith('USDT') && !s.endsWith('USD')) s += 'USDT';
    return s;
  }
  function shortSym(s) { return s.replace(/USDT$/,''); }

  // ── Build closed-pick performance cache: system -> {wins, losses, totalPnl, last5} ──
  const perfCache = {};    // system-level
  const stratPerf = {};    // strategy-level
  for (const cp of closedPicks) {
    const sys = cp.source_system || '';
    const strat = cp.strategy || '';
    const status = (cp.status || cp.outcome || '').toUpperCase();
    const pnl = parseFloat(cp.pnl_pct || cp.realized_pnl_pct || 0) || 0;
    const isWin = pnl > 0 || ['WON','WIN','TP_HIT','CLOSED_TP'].includes(status);
    const isLoss = pnl < 0 || ['LOST','LOSS','SL_HIT','CLOSED_SL'].includes(status);

    // System-level perf
    if (sys) {
      if (!perfCache[sys]) perfCache[sys] = {wins:0,losses:0,totalPnl:0,trades:0,last5:[]};
      perfCache[sys].trades++;
      if (isWin) perfCache[sys].wins++;
      if (isLoss) perfCache[sys].losses++;
      perfCache[sys].totalPnl += pnl;
      perfCache[sys].last5.push({pnl, isWin, isLoss, sym: normSym(cp.symbol||''), strat});
    }
    // Strategy-level perf
    if (strat) {
      const sKey = sys + '::' + strat;
      if (!stratPerf[sKey]) stratPerf[sKey] = {wins:0,losses:0,totalPnl:0,trades:0,last5:[]};
      stratPerf[sKey].trades++;
      if (isWin) stratPerf[sKey].wins++;
      if (isLoss) stratPerf[sKey].losses++;
      stratPerf[sKey].totalPnl += pnl;
      stratPerf[sKey].last5.push({pnl, isWin, isLoss});
    }
  }
  // Keep only last 5 for each
  for (const k of Object.keys(perfCache)) perfCache[k].last5 = perfCache[k].last5.slice(-5);
  for (const k of Object.keys(stratPerf)) stratPerf[k].last5 = stratPerf[k].last5.slice(-5);

  // ── Helper: render mini performance bar ──
  function perfMiniBar(perf, sysName) {
    if (!perf || !perf.trades) {
      // No closed trades — check for active (unrealized) positions
      if (sysName) {
        const activePicks = (D.picks?.active || []).filter(p => p.source_system === sysName);
        if (activePicks.length) {
          let html = '<div style="margin-top:4px;border-top:1px solid var(--border);padding-top:4px;">';
          html += '<div style="font-size:10px;color:var(--text-dim);">No closed trades yet</div>';
          const withPnl = activePicks.filter(p => p.pnl_pct != null && p.pnl_pct !== 0 && Math.abs(p.pnl_pct) <= 500);
          if (withPnl.length) {
            const unrealizedPnl = withPnl.reduce((a, p) => a + (p.pnl_pct || 0), 0);
            const avgUnrealized = unrealizedPnl / withPnl.length;
            html += '<div style="font-size:10px;color:var(--text-dim);">Unrealized: <span style="color:' + (unrealizedPnl >= 0 ? 'var(--green)' : 'var(--red)') + '">' + (unrealizedPnl >= 0 ? '+' : '') + unrealizedPnl.toFixed(1) + '% total</span> (' + withPnl.length + ' open picks, avg ' + (avgUnrealized >= 0 ? '+' : '') + avgUnrealized.toFixed(1) + '% each)</div>';
          }
          html += '<div style="font-size:10px;color:var(--text-dim);">' + activePicks.length + ' active picks awaiting TP/SL resolution</div>';
          html += '</div>';
          return html;
        }
      }
      return '';
    }
    // Classify trades: wins, losses, and unresolved (closed but status not WIN/LOSS)
    const unresolved = perf.trades - perf.wins - perf.losses;
    const wr = (perf.wins + perf.losses) > 0 ? (perf.wins / (perf.wins + perf.losses) * 100).toFixed(0) : 'n/a';
    let html = '<div style="margin-top:4px;border-top:1px solid var(--border);padding-top:4px;">';
    // Closed trade stats
    html += '<div style="font-size:10px;color:var(--text-dim);margin-bottom:2px;">Closed: ' + perf.wins + 'W/' + perf.losses + 'L';
    if (unresolved > 0) html += '/' + unresolved + ' pending';
    html += ' (' + wr + '% WR) | Realized PnL: <span style="color:' + (perf.totalPnl >= 0 ? 'var(--green)' : 'var(--red)') + '">' + (perf.totalPnl >= 0 ? '+' : '') + perf.totalPnl.toFixed(1) + '%</span></div>';
    // Unrealized PnL from active picks
    if (sysName) {
      const activePicks = (D.picks?.active || []).filter(p => p.source_system === sysName);
      const withPnl = activePicks.filter(p => p.pnl_pct != null && p.pnl_pct !== 0 && Math.abs(p.pnl_pct) <= 500);
      if (withPnl.length) {
        const unrealizedPnl = withPnl.reduce((a, p) => a + (p.pnl_pct || 0), 0);
        html += '<div style="font-size:10px;color:var(--text-dim);">Unrealized: <span style="color:' + (unrealizedPnl >= 0 ? 'var(--green)' : 'var(--red)') + '">' + (unrealizedPnl >= 0 ? '+' : '') + unrealizedPnl.toFixed(1) + '%</span> (' + withPnl.length + ' open)</div>';
      }
    }
    // Last 5 closed trades
    if (perf.last5.length) {
      html += '<div style="font-size:10px;color:var(--text-dim);">Last ' + perf.last5.length + ' closed ($100 each): ';
      let cumPnl = 0;
      for (const t of perf.last5) cumPnl += t.pnl;
      const resultColor = cumPnl >= 0 ? 'var(--green)' : 'var(--red)';
      html += '<b style="color:' + resultColor + '">' + (cumPnl >= 0 ? '+' : '') + '$' + (cumPnl).toFixed(1) + ' total</b> ';
      for (const t of perf.last5) {
        const c = t.isWin ? 'perf-bar-win' : (t.isLoss ? 'perf-bar-loss' : 'perf-bar-pending');
        html += '<span class="perf-bar ' + c + '" style="width:' + Math.max(4, Math.min(16, Math.abs(t.pnl) * 2)) + 'px;" title="' + (t.pnl >= 0 ? '+' : '') + t.pnl.toFixed(1) + '% (closed)"></span>';
      }
      html += '</div>';
    }
    html += '</div>';
    return html;
  }

  // ── Weighted Composite Pick Score (per audit assessment) ──
  // composite = 0.6*ml_score + 0.3*confidence + 0.1*confluence_score
  // with risk-reward boost: *= (1 + min(rr/5, 0.2))
  // with forward-validation penalty: *= 0.9 if forward_trades < 5
  function computePickScore(p) {
    const conf = parseFloat(p.confidence) || 0;
    const ml = parseFloat(p.ml_score) || conf; // fallback to confidence if no ml_score
    const confl = parseFloat(p.confluence_score) || 0;
    let composite = 0.6 * ml + 0.3 * conf + 0.1 * confl;
    // Risk-reward boost (capped at 20%)
    const rr = parseFloat(p.risk_reward) || 0;
    if (rr > 0) composite *= (1 + Math.min(rr / 5, 0.2));
    // Forward-validation penalty
    const fwdTrades = parseInt(p.forward_trades) || 0;
    if (fwdTrades > 0 && fwdTrades < 5) composite *= 0.9;
    return Math.min(composite, 1.0);
  }

  // ── Build map: system -> symbol -> [{direction, strategy, entry, tp, sl, confidence, pickScore, ...}] ──
  const sysMap = {};
  let totalRawPicks = 0;
  for (const p of picks) {
    const sym = normSym(p.symbol);
    if (!TRACKED_SYMBOLS.includes(sym)) continue;
    const sys = p.source_system || 'unknown';
    const dir = (p.direction || '').toUpperCase();
    if (dir !== 'LONG' && dir !== 'SHORT') continue;
    if (!sysMap[sys]) sysMap[sys] = {};
    if (!sysMap[sys][sym]) sysMap[sys][sym] = [];
    sysMap[sys][sym].push({
      direction: dir,
      strategy: p.strategy || '?',
      entry: p.entry_price,
      tp: p.take_profit,
      sl: p.stop_loss,
      confidence: p.confidence,
      ml_score: p.ml_score,
      confluence_score: p.confluence_score,
      risk_reward: p.risk_reward,
      forward_wr: p.forward_wr,
      forward_trades: p.forward_trades,
      forward_validated: p.forward_validated,
      forward_pnl: p.forward_pnl,
      forward_status: p.forward_status,
      ensemble_only: p.ensemble_only,
      pickScore: computePickScore(p)
    });
    totalRawPicks++;
  }

  // ── Deduplication: for agreement counting, group systems and count unique groups ──
  function getGroupFor(sys) {
    for (const [group, members] of Object.entries(SYS_DEDUP_GROUPS)) {
      if (members.includes(sys)) return group;
    }
    return sys; // ungrouped = its own group
  }

  // Filter symbols to those with 2+ UNIQUE groups signaling
  const symGroupCount = {};
  for (const sym of TRACKED_SYMBOLS) {
    const groups = new Set();
    for (const sys of Object.keys(sysMap)) {
      if (sysMap[sys][sym] && sysMap[sys][sym].length > 0) groups.add(getGroupFor(sys));
    }
    symGroupCount[sym] = groups.size;
  }
  const activeSyms = TRACKED_SYMBOLS.filter(s => symGroupCount[s] >= 2);

  if (!activeSyms.length) { el('agreement-matrix').style.display = 'none'; return; }

  // ── Rank systems by CREDIBILITY SCORE: WR × log2(trades+1) × profitBoost ──
  // This rewards systems that have BOTH high WR and sufficient sample size.
  // A 62.7% WR on 227 trades >> a 100% WR on 2 trades.
  const systemScores = {};
  const systemMeta = {}; // extra metadata for display
  for (const sys of Object.keys(sysMap)) {
    const perf = perfCache[sys];
    const sysData = (D.systems||[]).find(s => s.name === sys);
    // Use the larger of perfCache (matrix closed) or D.systems (dashboard tracked)
    const trades = Math.max(perf?.trades || 0, sysData?.closed_picks || 0);
    const wins = Math.max(perf?.wins || 0, sysData?.wins || 0);
    const wr = trades > 0 ? wins / trades : 0;
    const totalPnl = perf?.totalPnl || sysData?.total_pnl_pct || 0;
    const pf = sysData?.profit_factor || (totalPnl > 0 ? 1.2 : 0.8);

    systemMeta[sys] = { trades, wins, wr, totalPnl, pf };

    if (trades >= 5) {
      // Credibility = WR × log2(trades+1) × profit factor boost
      const tradeWeight = Math.log2(trades + 1); // 5t=2.6, 30t=5, 100t=6.7, 227t=7.8
      const pfBoost = pf > 1.5 ? 1.2 : pf > 1.0 ? 1.0 : 0.7; // reward profitable, penalize losing
      systemScores[sys] = wr * tradeWeight * pfBoost;
    } else if (trades >= 1) {
      systemScores[sys] = -0.5; // has some data but insufficient — show below proven
    } else {
      systemScores[sys] = -1; // no closed trades at all
    }
  }

  // Sort: proven first (by credibility desc), insufficient next, zero-trade last
  const systems = Object.keys(sysMap).sort((a, b) => {
    const sa = systemScores[a], sb = systemScores[b];
    if (sa >= 0 && sb >= 0) return sb - sa;
    if (sa >= 0) return -1;
    if (sb >= 0) return 1;
    // Both unranked: sort by signal count
    const cntA = activeSyms.reduce((n, s) => n + (sysMap[a][s] ? 1 : 0), 0);
    const cntB = activeSyms.reduce((n, s) => n + (sysMap[b][s] ? 1 : 0), 0);
    return cntB - cntA;
  });

  // Assign rank numbers (only for systems with 5+ trades)
  let sysRank = 0;
  const sysRankMap = {};
  for (const sys of systems) {
    if (systemScores[sys] >= 0) {
      sysRank++;
      sysRankMap[sys] = sysRank;
    } else {
      sysRankMap[sys] = null;
    }
  }

  // Split into proven vs untracked for toggle
  const provenSystems = systems.filter(s => systemScores[s] >= 0);
  const lowDataSystems = systems.filter(s => systemScores[s] >= -0.5 && systemScores[s] < 0);
  const untrackedSystems = systems.filter(s => systemScores[s] < -0.5);

  // ── Compute DEDUPLICATED agreement row ──
  const agreeData = {};
  let dedupedSignals = 0;
  for (const sym of activeSyms) {
    const groupDirections = {}; // group -> Set of directions
    for (const sys of systems) {
      const entries = sysMap[sys][sym] || [];
      if (!entries.length) continue;
      const grp = getGroupFor(sys);
      if (!groupDirections[grp]) groupDirections[grp] = new Set();
      for (const e of entries) groupDirections[grp].add(e.direction);
    }
    let longs = 0, shorts = 0;
    for (const [grp, dirs] of Object.entries(groupDirections)) {
      if (dirs.has('LONG')) { longs++; dedupedSignals++; }
      if (dirs.has('SHORT')) { shorts++; dedupedSignals++; }
    }
    agreeData[sym] = { longs, shorts, groups: Object.keys(groupDirections).length };
  }

  // Show dedup info
  const dedupEl = document.getElementById('matrix-dedup-info');
  if (dedupEl && totalRawPicks !== dedupedSignals) {
    dedupEl.textContent = totalRawPicks + ' raw signals \u2192 ' + dedupedSignals + ' unique (deduped)';
  }

  // ── Build table ──
  let html = '<div style="margin-bottom:8px;display:flex;gap:12px;align-items:center;font-size:11px">';
  html += '<span style="color:#64748b">Showing <b style="color:#e2e8f0">' + provenSystems.length + '</b> proven systems (5+ trades)</span>';
  if (untrackedSystems.length > 0) {
    html += '<label style="color:#64748b;cursor:pointer;user-select:none"><input type="checkbox" id="show-untracked-sys" style="margin-right:4px" onchange="document.querySelectorAll(\'.matrix-untracked\').forEach(r=>r.style.display=this.checked?\'table-row\':\'none\')">Show ' + untrackedSystems.length + ' untracked (0 trades)</label>';
  }
  if (lowDataSystems.length > 0) {
    html += '<span style="color:#64748b">+ <b>' + lowDataSystems.length + '</b> low-data (<5 trades)</span>';
  }
  html += '</div>';
  html += '<table class="matrix-table"><thead><tr><th style="min-width:200px;">#&nbsp;&nbsp;System</th>';
  for (const sym of activeSyms) {
    html += '<th>' + shortSym(sym) + '</th>';
  }
  html += '</tr></thead><tbody>';

  // System rows — proven first, then low-data, then untracked (hidden by default)
  const orderedSystems = [...provenSystems, ...lowDataSystems, ...untrackedSystems];
  for (const sys of orderedSystems) {
    const displayName = sys.replace(/_/g, ' ');
    const rank = sysRankMap[sys];
    const rankHtml = rank != null
      ? '<span class="sys-rank' + (rank <= 3 ? ' sys-rank-top3' : '') + '">' + rank + '</span>'
      : '<span class="sys-rank">-</span>';

    // System description tooltip — auto-generate for unknown systems
    let desc = sysDescriptions[sys] || '';
    if (!desc) {
      // Auto-generate a basic description from system name + available data
      const sysData = (D.systems||[]).find(s => s.name === sys);
      const parts = [displayName + '.'];
      if (sysData) {
        if (sysData.win_rate != null) parts.push(fmt(sysData.win_rate) + '% WR');
        if (sysData.closed_picks != null) parts.push(sysData.closed_picks + ' closed trades');
        if (sysData.total_pnl_pct != null) parts.push(fmtPct(sysData.total_pnl_pct) + ' total PnL');
        if (sysData.profit_factor != null) parts.push('PF ' + fmt(sysData.profit_factor, 2));
      }
      const tierInfo = getTrustTier({source_system: sys, strategy: ''});
      parts.push('Tier: ' + tierInfo.tier + (tierInfo.reason ? ' — ' + tierInfo.reason : ''));
      desc = parts.join(' | ');
    }
    const descHtml = desc
      ? '<span class="sys-desc-tip">\u24D8<span class="sys-desc-popup"><b>' + displayName + '</b><br>' + desc + perfMiniBar(perfCache[sys], sys) + '</span></span>'
      : '';

    // Row styling based on credibility
    const meta = systemMeta[sys] || {};
    const isUntracked = systemScores[sys] < -0.5;
    const isLowData = systemScores[sys] >= -0.5 && systemScores[sys] < 0;
    const rowClass = isUntracked ? ' class="matrix-untracked" style="display:none;opacity:0.4"' : isLowData ? ' style="opacity:0.6"' : '';
    // WR badge removed — sysLink() already includes [trades WR] info
    html += '<tr' + rowClass + '><td title="' + sys + '">' + rankHtml + sysLink(sys) + descHtml + '</td>';

    for (const sym of activeSyms) {
      const entries = sysMap[sys][sym] || [];
      if (!entries.length) {
        html += '<td><span class="matrix-cell matrix-cell-dash">&mdash;</span></td>';
      } else {
        const hasLong = entries.some(e => e.direction === 'LONG');
        const hasShort = entries.some(e => e.direction === 'SHORT');
        let arrow = '', cellClass = '';
        if (hasLong && hasShort) {
          arrow = '<span class="matrix-cell-long">&blacktriangle;</span><span class="matrix-cell-short">&blacktriangledown;</span>';
        } else if (hasLong) {
          arrow = '&blacktriangle;';
          cellClass = 'matrix-cell-long';
        } else {
          arrow = '&blacktriangledown;';
          cellClass = 'matrix-cell-short';
        }

        // Build tooltip with strategy details + performance
        let tipHtml = '<div style="font-weight:700;color:var(--cyan);margin-bottom:4px;">' + shortSym(sym) + ' \u2014 ' + displayName + '</div>';
        for (const e of entries) {
          const dirColor = e.direction === 'LONG' ? 'var(--green)' : 'var(--red)';
          const sKey = sys + '::' + e.strategy;
          const sp = stratPerf[sKey];
          tipHtml += '<div style="border-top:1px solid var(--border);padding-top:4px;margin-top:4px;">';
          tipHtml += '<div><span style="color:' + dirColor + ';font-weight:600;">' + e.direction + '</span> \u2014 ' + (e.strategy || '?') + '</div>';

          // Strategy description from sysDescriptions if the strategy name matches a known system
          const stratDesc = sysDescriptions[e.strategy] || sysDescriptions[(e.strategy||'').toLowerCase().replace(/\s+/g,'_')] || '';
          if (stratDesc) {
            tipHtml += '<div style="font-size:10px;color:var(--text-dim);font-style:italic;margin:2px 0;">' + stratDesc + '</div>';
          }

          tipHtml += '<div style="display:flex;gap:12px;margin-top:2px;">';
          tipHtml += '<span>Entry: <b>' + (e.entry != null ? Number(e.entry).toLocaleString(undefined,{maximumFractionDigits:6}) : '?') + '</b></span>';
          tipHtml += '</div><div style="display:flex;gap:12px;">';
          tipHtml += '<span style="color:var(--green)">TP: ' + (e.tp != null ? Number(e.tp).toLocaleString(undefined,{maximumFractionDigits:6}) : '?') + '</span>';
          tipHtml += '<span style="color:var(--red)">SL: ' + (e.sl != null ? Number(e.sl).toLocaleString(undefined,{maximumFractionDigits:6}) : '?') + '</span>';
          tipHtml += '</div>';
          // Composite pick score + breakdown
          const scoreColor = e.pickScore >= 0.75 ? 'var(--green)' : (e.pickScore >= 0.5 ? 'var(--yellow)' : 'var(--red)');
          tipHtml += '<div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:3px;">';
          tipHtml += '<span>Score: <b style="color:' + scoreColor + '">' + (e.pickScore * 100).toFixed(0) + '%</b></span>';
          if (e.confidence != null) tipHtml += '<span>Conf: <b style="color:var(--yellow)">' + (e.confidence * 100).toFixed(0) + '%</b></span>';
          if (e.ml_score != null) tipHtml += '<span>ML: <b style="color:var(--purple)">' + (e.ml_score * 100).toFixed(0) + '%</b></span>';
          if (e.confluence_score != null && e.confluence_score > 0) tipHtml += '<span style="color:var(--cyan)">Confluence</span>';
          tipHtml += '</div>';
          // Risk-reward
          if (e.risk_reward != null && e.risk_reward > 0) {
            tipHtml += '<div style="font-size:10px;color:var(--text-dim);">R:R ' + Number(e.risk_reward).toFixed(1) + 'x</div>';
          }
          // Forward validation (universal — all picks now have this)
          if (e.forward_trades != null && e.forward_trades > 0) {
            const fwrColor = (e.forward_wr || 0) >= 50 ? 'var(--green)' : 'var(--red)';
            const fwdIcon = e.forward_validated ? '\u2705' : '\u26A0\uFE0F';
            tipHtml += '<div style="font-size:10px;color:var(--text-dim);">' + fwdIcon + ' Forward: ' + e.forward_trades + ' trades, <span style="color:' + fwrColor + '">' + (e.forward_wr || 0).toFixed(0) + '% WR</span>';
            if (e.forward_pnl != null) tipHtml += ' | PnL: <span style="color:' + (e.forward_pnl >= 0 ? 'var(--green)' : 'var(--red)') + '">' + (e.forward_pnl >= 0 ? '+' : '') + Number(e.forward_pnl).toFixed(1) + '%</span>';
            tipHtml += '</div>';
          } else {
            tipHtml += '<div style="font-size:10px;color:#666;">No forward data yet</div>';
          }
          if (e.ensemble_only) tipHtml += '<div style="font-size:10px;color:var(--purple);">Ensemble-only pick</div>';
          // Strategy-level track record
          if (sp && sp.trades >= 1) {
            const swr = (sp.wins / sp.trades * 100).toFixed(0);
            let last5sum = 0;
            for (const t of sp.last5) last5sum += t.pnl;
            tipHtml += '<div style="font-size:10px;margin-top:2px;color:var(--text-dim);">Strategy record: ' + sp.wins + 'W/' + sp.losses + 'L (' + swr + '%) | Last ' + sp.last5.length + ': <b style="color:' + (last5sum >= 0 ? 'var(--green)' : 'var(--red)') + '">' + (last5sum >= 0 ? '+' : '') + '$' + last5sum.toFixed(1) + '</b></div>';
          }
          tipHtml += '</div>';
        }
        // System-level track record at bottom of tooltip
        tipHtml += perfMiniBar(perfCache[sys], sys);

        html += '<td><div class="matrix-cell-wrap"><span class="matrix-cell ' + cellClass + '">' + arrow + '</span>';
        html += '<div class="matrix-tooltip">' + tipHtml + '</div></div></td>';
      }
    }
    html += '</tr>';
  }

  // AGREE row (uses deduplicated group counts)
  html += '<tr class="agree-row"><td style="font-weight:700;color:var(--cyan);text-transform:uppercase;font-size:11px;letter-spacing:0.5px;">Agree (deduped)</td>';
  for (const sym of activeSyms) {
    const a = agreeData[sym];
    const dominant = a.longs >= a.shorts ? a.longs : a.shorts;
    const dominantDir = a.longs >= a.shorts ? 'LONG' : 'SHORT';
    let cls = 'agree-weak';
    if (dominant >= 3) cls = dominantDir === 'LONG' ? 'agree-strong-long' : 'agree-strong-short';
    else if (dominant >= 2) cls = 'agree-moderate';
    const label = dominant + (dominantDir === 'LONG' ? ' L' : ' S');
    const detail = a.longs + ' unique groups Long / ' + a.shorts + ' unique groups Short (from ' + a.groups + ' groups)';
    html += '<td title="' + detail + '"><span class="' + cls + '">' + label + '</span></td>';
  }
  html += '</tr>';

  html += '</tbody></table>';

  el('matrix-body').innerHTML = html;
  el('matrix-timestamp').textContent = D.generated_at ? 'Data: ' + new Date(D.generated_at).toLocaleString('en-US', { timeZone: 'America/New_York' }) + ' EST' : '';
  el('agreement-matrix').style.display = 'block';
}

// ── Performance Analytics tab ──
function renderPerformance() {
  const closed = (D.picks?.recent_closed || []).slice();
  if (!closed.length) {
    el('tab-performance').innerHTML = '<div class="empty-state"><h2>No closed picks available</h2><p>Performance analytics require closed trade data.</p></div>';
    return;
  }

  // Score each closed pick using computeScore (handle missing fields gracefully)
  closed.forEach(p => {
    if (p._perfScored) return;
    // Defaults for fields that closed picks may lack
    p.strat_fwd_wr = p.strat_fwd_wr ?? 0;
    p.strat_fwd_pf = p.strat_fwd_pf ?? 0;
    p.strat_csr = p.strat_csr ?? null;
    p.strat_health = p.strat_health ?? 'unknown';
    p.confidence = p.confidence ?? 0;
    p.take_profit = p.take_profit ?? 0;
    p.stop_loss = p.stop_loss ?? 0;
    p.age_hours = p.age_hours ?? 24;
    p.agreement_count = p.agreement_count ?? 0;
    p.has_conflict = p.has_conflict ?? false;
    p.recent_pnl = p.recent_pnl ?? 0;
    p.recent_max_dd = p.recent_max_dd ?? 0;
    const result = computeScore(p);
    p._perfScore = result.score;
    p._perfScored = true;
  });

  // Helper: compute stats for a subset of picks
  function calcStats(picks) {
    if (!picks.length) return { count: 0, winRate: 0, avgPnl: 0, totalPnl: 0, profitFactor: 0, best: 0, worst: 0, avgHold: '-' };
    const wins = picks.filter(p => (p.pnl_pct || 0) > 0);
    const losses = picks.filter(p => (p.pnl_pct || 0) < 0);
    const totalPnl = picks.reduce((s, p) => s + (p.pnl_pct || 0), 0);
    const avgPnl = totalPnl / picks.length;
    const grossWin = wins.reduce((s, p) => s + (p.pnl_pct || 0), 0);
    const grossLoss = Math.abs(losses.reduce((s, p) => s + (p.pnl_pct || 0), 0));
    const profitFactor = grossLoss > 0 ? grossWin / grossLoss : grossWin > 0 ? 999 : 0;
    const best = Math.max(...picks.map(p => p.pnl_pct || 0));
    const worst = Math.min(...picks.map(p => p.pnl_pct || 0));
    // Avg hold time
    let avgHold = '-';
    const holdTimes = picks.filter(p => p.timestamp && p.close_time).map(p => {
      const open = new Date(p.timestamp).getTime();
      const close = new Date(p.close_time).getTime();
      return (close - open) / 3600000; // hours
    }).filter(h => h > 0 && isFinite(h));
    if (holdTimes.length) {
      const avgH = holdTimes.reduce((a, b) => a + b, 0) / holdTimes.length;
      avgHold = avgH < 1 ? Math.round(avgH * 60) + 'm' : avgH < 24 ? avgH.toFixed(1) + 'h' : (avgH / 24).toFixed(1) + 'd';
    }
    return { count: picks.length, winRate: picks.length ? (wins.length / picks.length * 100) : 0, avgPnl, totalPnl, profitFactor, best, worst, avgHold };
  }

  const pnlClass = v => v > 0 ? 'pnl-pos' : v < 0 ? 'pnl-neg' : 'pnl-zero';
  const fmt = (v, d=2) => v.toFixed(d);

  // ── SECTION 1: Score Threshold Analysis ──
  const thresholds = [80, 70, 60, 50, 40, 30, 20, 10, 0];
  const thresholdLabels = ['> 80', '> 70', '> 60', '> 50', '> 40', '> 30', '> 20', '> 10', 'All'];
  const tierData = thresholds.map((t, i) => {
    const picks = t > 0 ? closed.filter(p => (p._perfScore || 0) > t) : closed;
    return { label: thresholdLabels[i], threshold: t, ...calcStats(picks) };
  });

  let s1Html = '<div class="perf-section"><h3>Score Threshold Analysis</h3>';
  s1Html += '<p style="font-size:12px;color:var(--text-dim);margin-bottom:12px">If you only traded picks above score X, what would your results look like?</p>';
  s1Html += '<div style="overflow-x:auto"><table class="data-table" id="perf-threshold-table"><thead><tr>';
  s1Html += '<th data-col="label">Score</th><th data-col="count"># Trades</th><th data-col="winRate">Win Rate</th>';
  s1Html += '<th data-col="avgPnl">Avg PnL%</th><th data-col="totalPnl">Total PnL%</th><th data-col="profitFactor">Profit Factor</th>';
  s1Html += '<th data-col="best">Best Trade</th><th data-col="worst">Worst Trade</th><th>Avg Hold</th>';
  s1Html += '</tr></thead><tbody>';
  tierData.forEach(t => {
    const rowColor = t.totalPnl > 0 ? 'rgba(76,175,80,0.08)' : t.totalPnl < 0 ? 'rgba(244,67,54,0.08)' : '';
    s1Html += `<tr style="background:${rowColor}">`;
    s1Html += `<td><strong>${t.label}</strong></td>`;
    s1Html += `<td class="num">${t.count}</td>`;
    s1Html += `<td class="num ${t.winRate >= 50 ? 'pnl-pos' : 'pnl-neg'}">${fmt(t.winRate, 1)}%</td>`;
    s1Html += `<td class="num ${pnlClass(t.avgPnl)}">${fmt(t.avgPnl)}%</td>`;
    s1Html += `<td class="num ${pnlClass(t.totalPnl)}"><strong>${fmt(t.totalPnl)}%</strong></td>`;
    s1Html += `<td class="num" style="color:${t.profitFactor >= 1.5 ? 'var(--green)' : t.profitFactor >= 1 ? 'var(--yellow)' : 'var(--red)'}">${t.profitFactor >= 999 ? '∞' : fmt(t.profitFactor)}</td>`;
    s1Html += `<td class="num pnl-pos">${fmt(t.best)}%</td>`;
    s1Html += `<td class="num pnl-neg">${fmt(t.worst)}%</td>`;
    s1Html += `<td class="num">${t.avgHold}</td>`;
    s1Html += '</tr>';
  });
  s1Html += '</tbody></table></div>';

  // Bar chart for PnL by score tier
  const tierBands = [
    { label: '0-10', min: 0, max: 10 }, { label: '10-20', min: 10, max: 20 },
    { label: '20-30', min: 20, max: 30 }, { label: '30-40', min: 30, max: 40 },
    { label: '40-50', min: 40, max: 50 }, { label: '50-60', min: 50, max: 60 },
    { label: '60-70', min: 60, max: 70 }, { label: '70-80', min: 70, max: 80 },
    { label: '80-90', min: 80, max: 90 }, { label: '90-100', min: 90, max: 101 },
  ];
  const bandStats = tierBands.map(b => {
    const picks = closed.filter(p => (p._perfScore || 0) >= b.min && (p._perfScore || 0) < b.max);
    return { label: b.label, ...calcStats(picks) };
  });
  const maxAbsPnl = Math.max(1, ...bandStats.map(b => Math.abs(b.totalPnl)));
  s1Html += '<div style="margin-top:16px"><h4 style="font-size:13px;color:var(--text-dim);margin-bottom:8px">Total PnL% by Score Band</h4>';
  s1Html += '<div class="perf-bar-chart">';
  bandStats.forEach(b => {
    const h = Math.max(2, Math.abs(b.totalPnl) / maxAbsPnl * 160);
    const color = b.totalPnl >= 0 ? 'var(--green)' : 'var(--red)';
    s1Html += `<div class="perf-bar-wrap"><div class="perf-bar-val">${fmt(b.totalPnl, 1)}%</div><div class="perf-bar" style="height:${h}px;background:${color}" title="${b.label}: ${b.count} trades, ${fmt(b.totalPnl)}% PnL"></div><div class="perf-bar-label">${b.label}</div></div>`;
  });
  s1Html += '</div></div></div>';

  // ── SECTION 2: System Performance Breakdown ──
  const systemMap = {};
  closed.forEach(p => {
    const sys = p.source_system || 'unknown';
    if (!systemMap[sys]) systemMap[sys] = [];
    systemMap[sys].push(p);
  });
  let s2Html = '<div class="perf-section"><h3>System Performance Breakdown</h3>';
  s2Html += '<div style="overflow-x:auto"><table class="data-table" id="perf-system-table"><thead><tr>';
  s2Html += '<th data-col="name">System</th><th data-col="count"># Closed</th><th data-col="winRate">Win Rate</th>';
  s2Html += '<th data-col="totalPnl">Total PnL%</th><th data-col="profitFactor">Profit Factor</th>';
  s2Html += '<th data-col="expectancy">Expectancy</th><th>Best Strategy</th><th>Worst Strategy</th><th class="col-tip" data-tip="Trust Tier: ACTIVE = system is running and generating picks. MONITORING = system exists but not actively trading (sandbox/watching). PROVEN = forward-verified with 50+ trades. SANDBOX = unproven, needs more data. PROBATION = documented poor performance. DEMOTED = failed on specific assets.">Trust Tier</th>';
  s2Html += '</tr></thead><tbody>';
  const sysEntries = Object.entries(systemMap).map(([name, picks]) => {
    const stats = calcStats(picks);
    const expectancy = stats.count > 0 ? stats.totalPnl / stats.count : 0;
    // Best/worst strategy
    const stratMap = {};
    picks.forEach(p => {
      const s = p.strategy || 'unknown';
      if (!stratMap[s]) stratMap[s] = [];
      stratMap[s].push(p);
    });
    let bestStrat = '-', worstStrat = '-', bestPnl = -Infinity, worstPnl = Infinity;
    Object.entries(stratMap).forEach(([s, sp]) => {
      const tp = sp.reduce((a, p) => a + (p.pnl_pct || 0), 0);
      if (tp > bestPnl) { bestPnl = tp; bestStrat = s; }
      if (tp < worstPnl) { worstPnl = tp; worstStrat = s; }
    });
    // Trust tier from D.systems
    const sysInfo = (D.systems || []).find(s => s.name === name);
    const trustTier = sysInfo?.status === 'active' ? 'ACTIVE' : sysInfo?.status === 'retired' ? 'RETIRED' : sysInfo?.status || 'SANDBOX';
    return { name, ...stats, expectancy, bestStrat, worstStrat, trustTier };
  }).sort((a, b) => b.totalPnl - a.totalPnl);
  sysEntries.forEach(s => {
    const rowColor = s.totalPnl > 0 ? 'rgba(76,175,80,0.06)' : s.totalPnl < 0 ? 'rgba(244,67,54,0.06)' : '';
    s2Html += `<tr style="background:${rowColor}">`;
    s2Html += `<td><strong>${s.name.replace(/_/g, ' ')}</strong></td>`;
    s2Html += `<td class="num">${s.count}</td>`;
    s2Html += `<td class="num ${s.winRate >= 50 ? 'pnl-pos' : 'pnl-neg'}">${fmt(s.winRate, 1)}%</td>`;
    s2Html += `<td class="num ${pnlClass(s.totalPnl)}"><strong>${fmt(s.totalPnl)}%</strong></td>`;
    s2Html += `<td class="num" style="color:${s.profitFactor >= 1.5 ? 'var(--green)' : s.profitFactor >= 1 ? 'var(--yellow)' : 'var(--red)'}">${s.profitFactor >= 999 ? '∞' : fmt(s.profitFactor)}</td>`;
    s2Html += `<td class="num ${pnlClass(s.expectancy)}">${fmt(s.expectancy)}%</td>`;
    s2Html += `<td style="font-size:12px">${s.bestStrat.replace(/_/g, ' ')}</td>`;
    s2Html += `<td style="font-size:12px">${s.worstStrat.replace(/_/g, ' ')}</td>`;
    const tierBadge = s.trustTier === 'ACTIVE' ? 'badge-active' : s.trustTier === 'RETIRED' ? 'badge-retired' : 'badge-monitoring';
    const tierTip = s.trustTier === 'ACTIVE' ? 'System is live and generating picks with full weight' : s.trustTier === 'RETIRED' ? 'System has been shut down, no longer generating picks' : 'System exists but is not actively generating picks (needs more data or under evaluation)';
    s2Html += `<td><span class="badge ${tierBadge}" title="${tierTip}" style="cursor:help">${s.trustTier}</span></td>`;
    s2Html += '</tr>';
  });
  s2Html += '</tbody></table></div></div>';

  // ── SECTION 3: Strategy Performance Breakdown ──
  const strategyMap = {};
  closed.forEach(p => {
    const strat = p.strategy || 'unknown';
    if (!strategyMap[strat]) strategyMap[strat] = { picks: [], system: p.source_system || 'unknown' };
    strategyMap[strat].picks.push(p);
  });
  let s3Html = '<div class="perf-section"><h3>Strategy Performance Breakdown</h3>';
  s3Html += '<div style="overflow-x:auto"><table class="data-table" id="perf-strategy-table"><thead><tr>';
  s3Html += '<th data-col="name">Strategy</th><th data-col="system">System</th><th data-col="count"># Trades</th>';
  s3Html += '<th data-col="winRate">Win Rate</th><th data-col="avgPnl">Avg PnL%</th><th data-col="totalPnl">Total PnL%</th>';
  s3Html += '<th data-col="sharpe">Sharpe (est)</th><th data-col="lastDate">Last Trade</th>';
  s3Html += '</tr></thead><tbody>';
  const stratEntries = Object.entries(strategyMap).map(([name, data]) => {
    const stats = calcStats(data.picks);
    // Estimated Sharpe: mean / stdev of individual pnl_pct
    const pnls = data.picks.map(p => p.pnl_pct || 0);
    const mean = pnls.reduce((a, b) => a + b, 0) / pnls.length;
    const variance = pnls.reduce((a, v) => a + (v - mean) ** 2, 0) / pnls.length;
    const stdev = Math.sqrt(variance) || 1;
    const sharpe = mean / stdev;
    // Last trade date
    const dates = data.picks.map(p => p.close_time || p.timestamp || '').filter(Boolean).sort();
    const lastDate = dates.length ? dates[dates.length - 1].split('T')[0] : '-';
    return { name, system: data.system, ...stats, sharpe, lastDate };
  }).sort((a, b) => b.totalPnl - a.totalPnl);
  stratEntries.forEach(s => {
    const rowColor = s.totalPnl > 0 ? 'rgba(76,175,80,0.06)' : s.totalPnl < 0 ? 'rgba(244,67,54,0.06)' : '';
    s3Html += `<tr style="background:${rowColor}">`;
    s3Html += `<td><strong>${s.name.replace(/_/g, ' ')}</strong></td>`;
    s3Html += `<td style="font-size:12px">${s.system.replace(/_/g, ' ')}</td>`;
    s3Html += `<td class="num">${s.count}</td>`;
    s3Html += `<td class="num ${s.winRate >= 50 ? 'pnl-pos' : 'pnl-neg'}">${fmt(s.winRate, 1)}%</td>`;
    s3Html += `<td class="num ${pnlClass(s.avgPnl)}">${fmt(s.avgPnl)}%</td>`;
    s3Html += `<td class="num ${pnlClass(s.totalPnl)}"><strong>${fmt(s.totalPnl)}%</strong></td>`;
    s3Html += `<td class="num" style="color:${s.sharpe >= 1 ? 'var(--green)' : s.sharpe >= 0 ? 'var(--yellow)' : 'var(--red)'}">${fmt(s.sharpe)}</td>`;
    s3Html += `<td class="num" style="font-size:11px">${s.lastDate}</td>`;
    s3Html += '</tr>';
  });
  s3Html += '</tbody></table></div></div>';

  // ── SECTION 4: Performance Over Time ──
  const dailyMap = {};
  closed.forEach(p => {
    const date = (p.close_time || p.timestamp || '').split('T')[0];
    if (!date) return;
    if (!dailyMap[date]) dailyMap[date] = { pnl: 0, count: 0 };
    dailyMap[date].pnl += (p.pnl_pct || 0);
    dailyMap[date].count++;
  });
  const dailyEntries = Object.entries(dailyMap).sort((a, b) => a[0].localeCompare(b[0]));
  let s4Html = '<div class="perf-section"><h3>Performance Over Time</h3>';

  if (dailyEntries.length > 1) {
    // Summary stat cards
    let cumPnl = 0;
    let maxCum = -Infinity, minCum = Infinity;
    const cumData = dailyEntries.map(([date, d]) => {
      cumPnl += d.pnl;
      maxCum = Math.max(maxCum, cumPnl);
      minCum = Math.min(minCum, cumPnl);
      return { date, pnl: d.pnl, count: d.count, cum: cumPnl };
    });
    const totalDays = cumData.length;
    const profitDays = cumData.filter(d => d.pnl > 0).length;
    const lossDays = cumData.filter(d => d.pnl < 0).length;
    const maxDD = maxCum - minCum;

    s4Html += '<div class="perf-stat-cards">';
    s4Html += `<div class="perf-stat-card"><div class="psc-label">Trading Days</div><div class="psc-value">${totalDays}</div></div>`;
    s4Html += `<div class="perf-stat-card"><div class="psc-label">Profitable Days</div><div class="psc-value" style="color:var(--green)">${profitDays}</div></div>`;
    s4Html += `<div class="perf-stat-card"><div class="psc-label">Losing Days</div><div class="psc-value" style="color:var(--red)">${lossDays}</div></div>`;
    s4Html += `<div class="perf-stat-card"><div class="psc-label">Cumulative PnL</div><div class="psc-value ${pnlClass(cumPnl)}">${fmt(cumPnl)}%</div></div>`;
    s4Html += `<div class="perf-stat-card"><div class="psc-label">Max Drawdown</div><div class="psc-value" style="color:var(--red)">${fmt(maxDD)}%</div></div>`;
    s4Html += '</div>';

    // Cumulative PnL line chart (SVG)
    s4Html += '<h4 style="font-size:13px;color:var(--text-dim);margin-bottom:4px">Cumulative PnL% Over Time</h4>';
    const svgW = 900, svgH = 180, pad = 30;
    const minY = Math.min(0, ...cumData.map(d => d.cum));
    const maxY = Math.max(0, ...cumData.map(d => d.cum));
    const rangeY = (maxY - minY) || 1;
    const scaleX = (svgW - pad * 2) / (cumData.length - 1 || 1);
    const scaleY = (svgH - pad * 2) / rangeY;
    const toX = i => pad + i * scaleX;
    const toY = v => svgH - pad - (v - minY) * scaleY;
    let pathD = cumData.map((d, i) => `${i === 0 ? 'M' : 'L'}${toX(i).toFixed(1)},${toY(d.cum).toFixed(1)}`).join(' ');
    // Fill area
    const fillD = pathD + ` L${toX(cumData.length - 1).toFixed(1)},${toY(0).toFixed(1)} L${toX(0).toFixed(1)},${toY(0).toFixed(1)} Z`;
    const zeroY = toY(0);
    s4Html += `<div class="perf-cumulative"><svg class="perf-cum-svg" viewBox="0 0 ${svgW} ${svgH}" preserveAspectRatio="none">`;
    s4Html += `<line x1="${pad}" y1="${zeroY}" x2="${svgW - pad}" y2="${zeroY}" stroke="var(--border)" stroke-width="1" stroke-dasharray="4"/>`;
    s4Html += `<path d="${fillD}" fill="${cumPnl >= 0 ? 'rgba(76,175,80,0.1)' : 'rgba(244,67,54,0.1)'}" />`;
    s4Html += `<path d="${pathD}" fill="none" stroke="${cumPnl >= 0 ? 'var(--green)' : 'var(--red)'}" stroke-width="2"/>`;
    // Labels
    const labelStep = Math.max(1, Math.floor(cumData.length / 8));
    cumData.forEach((d, i) => {
      if (i % labelStep === 0 || i === cumData.length - 1) {
        s4Html += `<text x="${toX(i)}" y="${svgH - 4}" fill="var(--text-dim)" font-size="9" text-anchor="middle">${d.date.slice(5)}</text>`;
      }
    });
    // Y axis labels
    const ySteps = 5;
    for (let i = 0; i <= ySteps; i++) {
      const val = minY + (rangeY / ySteps) * i;
      const y = toY(val);
      s4Html += `<text x="${pad - 4}" y="${y + 3}" fill="var(--text-dim)" font-size="9" text-anchor="end">${fmt(val, 0)}</text>`;
    }
    s4Html += '</svg></div>';

    // Daily P&L bars
    s4Html += '<h4 style="font-size:13px;color:var(--text-dim);margin:12px 0 4px">Daily P&L%</h4>';
    const maxAbsDaily = Math.max(1, ...cumData.map(d => Math.abs(d.pnl)));
    s4Html += '<div class="perf-daily-chart">';
    cumData.forEach(d => {
      const h = Math.max(2, Math.abs(d.pnl) / maxAbsDaily * 90);
      const color = d.pnl >= 0 ? 'var(--green)' : 'var(--red)';
      s4Html += `<div class="perf-daily-wrap" title="${d.date}: ${fmt(d.pnl)}% (${d.count} trades)"><div class="perf-daily-bar" style="height:${h}px;background:${color}"></div></div>`;
    });
    s4Html += '</div>';
    s4Html += '<div class="perf-legend"><span><span class="perf-legend-dot" style="background:var(--green)"></span>Profitable day</span><span><span class="perf-legend-dot" style="background:var(--red)"></span>Losing day</span></div>';
  } else {
    s4Html += '<p style="color:var(--text-dim);font-size:13px">Not enough daily data to chart performance over time.</p>';
  }
  s4Html += '</div>';

  // ── SECTION 5: Score Accuracy Analysis ──
  let s5Html = '<div class="perf-section"><h3>Score Accuracy Analysis</h3>';
  s5Html += '<p style="font-size:12px;color:var(--text-dim);margin-bottom:12px">Does a higher score actually predict better trade outcomes? This validates whether our scoring formula is useful.</p>';

  const scoreBands = tierBands; // reuse 0-10, 10-20, ..., 90-100
  const accuracyData = scoreBands.map(b => {
    const picks = closed.filter(p => (p._perfScore || 0) >= b.min && (p._perfScore || 0) < b.max);
    const stats = calcStats(picks);
    return { label: b.label, ...stats };
  });

  // Accuracy table
  s5Html += '<div style="overflow-x:auto"><table class="data-table" id="perf-accuracy-table"><thead><tr>';
  s5Html += '<th>Score Band</th><th># Trades</th><th>Win Rate</th><th>Avg PnL%</th><th>Total PnL%</th><th>Profit Factor</th>';
  s5Html += '</tr></thead><tbody>';
  accuracyData.forEach(a => {
    const rowColor = a.totalPnl > 0 ? 'rgba(76,175,80,0.08)' : a.totalPnl < 0 ? 'rgba(244,67,54,0.08)' : '';
    s5Html += `<tr style="background:${rowColor}">`;
    s5Html += `<td><strong>${a.label}</strong></td>`;
    s5Html += `<td class="num">${a.count}</td>`;
    s5Html += `<td class="num ${a.winRate >= 50 ? 'pnl-pos' : 'pnl-neg'}">${a.count ? fmt(a.winRate, 1) + '%' : '-'}</td>`;
    s5Html += `<td class="num ${pnlClass(a.avgPnl)}">${a.count ? fmt(a.avgPnl) + '%' : '-'}</td>`;
    s5Html += `<td class="num ${pnlClass(a.totalPnl)}"><strong>${a.count ? fmt(a.totalPnl) + '%' : '-'}</strong></td>`;
    s5Html += `<td class="num">${a.count ? (a.profitFactor >= 999 ? '∞' : fmt(a.profitFactor)) : '-'}</td>`;
    s5Html += '</tr>';
  });
  s5Html += '</tbody></table></div>';

  // Avg PnL% by score band bar chart
  const maxAbsAccPnl = Math.max(1, ...accuracyData.map(a => Math.abs(a.avgPnl)));
  s5Html += '<div style="margin-top:16px"><h4 style="font-size:13px;color:var(--text-dim);margin-bottom:8px">Avg PnL% by Score Band</h4>';
  s5Html += '<div class="perf-bar-chart">';
  accuracyData.forEach(a => {
    const h = a.count ? Math.max(2, Math.abs(a.avgPnl) / maxAbsAccPnl * 160) : 2;
    const color = a.avgPnl >= 0 ? 'var(--green)' : 'var(--red)';
    s5Html += `<div class="perf-bar-wrap"><div class="perf-bar-val">${a.count ? fmt(a.avgPnl, 1) + '%' : '-'}</div><div class="perf-bar" style="height:${h}px;background:${color}" title="${a.label}: ${a.count} trades, avg ${fmt(a.avgPnl)}%"></div><div class="perf-bar-label">${a.label}</div></div>`;
  });
  s5Html += '</div>';

  // Verdict
  const highScorePicks = closed.filter(p => (p._perfScore || 0) >= 60);
  const lowScorePicks = closed.filter(p => (p._perfScore || 0) < 40);
  const highAvg = highScorePicks.length ? highScorePicks.reduce((s, p) => s + (p.pnl_pct || 0), 0) / highScorePicks.length : 0;
  const lowAvg = lowScorePicks.length ? lowScorePicks.reduce((s, p) => s + (p.pnl_pct || 0), 0) / lowScorePicks.length : 0;
  const scorePredictive = highAvg > lowAvg;
  const verdictColor = scorePredictive ? 'var(--green)' : 'var(--red)';
  const verdictIcon = scorePredictive ? '&#10003;' : '&#10007;';
  const verdictText = scorePredictive
    ? `Score IS predictive: High-score picks (>=60) avg ${fmt(highAvg)}% vs low-score (<40) avg ${fmt(lowAvg)}%`
    : `Score NOT predictive: High-score picks (>=60) avg ${fmt(highAvg)}% vs low-score (<40) avg ${fmt(lowAvg)}%`;
  s5Html += `<div style="margin-top:16px;padding:12px 16px;background:var(--card);border:1px solid ${verdictColor};border-radius:8px;font-size:13px"><span style="color:${verdictColor};font-weight:700;font-size:16px">${verdictIcon}</span> <span style="color:${verdictColor};font-weight:600">${verdictText}</span></div>`;
  s5Html += '</div></div>';

  // ── SECTION 6: Super Parameter Enhancement ──
  let s6Html = '<div class="perf-section"><h3>Super Parameter Analysis</h3>';
  s6Html += '<p style="font-size:12px;color:var(--text-dim);margin-bottom:16px">Deep breakdown of trade parameters to find the optimal filter combination for winning trades.</p>';

  // Interactive Filters
  s6Html += '<div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding:12px 14px;background:var(--card);border:1px solid var(--border);border-radius:8px;margin-bottom:16px" id="param-filter-bar">';
  s6Html += '<label style="font-size:12px;color:var(--text-dim)">Score:</label><select id="pf-score" style="background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:4px;padding:4px 8px;font-size:12px"><option value="">All</option><option value="20">&gt; 20</option><option value="40">&gt; 40</option><option value="60">&gt; 60</option><option value="80">&gt; 80</option></select>';
  s6Html += '<label style="font-size:12px;color:var(--text-dim)">Confidence:</label><select id="pf-conf" style="background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:4px;padding:4px 8px;font-size:12px"><option value="">All</option><option value="0.4">&gt; 0.4</option><option value="0.6">&gt; 0.6</option><option value="0.8">&gt; 0.8</option></select>';
  s6Html += '<label style="font-size:12px;color:var(--text-dim)">Direction:</label><select id="pf-dir" style="background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:4px;padding:4px 8px;font-size:12px"><option value="">All</option><option value="LONG">LONG</option><option value="SHORT">SHORT</option></select>';
  s6Html += '<label style="font-size:12px;color:var(--text-dim)">Asset:</label><select id="pf-asset" style="background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:4px;padding:4px 8px;font-size:12px"><option value="">All</option><option value="CRYPTO">CRYPTO</option><option value="EQUITY">EQUITY</option><option value="FOREX">FOREX</option></select>';
  s6Html += '<label style="font-size:12px;color:var(--text-dim)">System:</label><select id="pf-sys" style="background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:4px;padding:4px 8px;font-size:12px"><option value="">All</option>';
  const allSystems6 = [...new Set(closed.map(p => p.source_system || 'unknown'))].sort();
  allSystems6.forEach(s => { s6Html += `<option value="${s}">${s.replace(/_/g,' ')}</option>`; });
  s6Html += '</select>';
  s6Html += '<button id="pf-apply" style="background:var(--purple);color:#000;border:none;border-radius:6px;padding:5px 14px;font-size:12px;font-weight:600;cursor:pointer;margin-left:8px">Apply Filters</button>';
  s6Html += '<button id="pf-reset" style="background:var(--card);color:var(--text-dim);border:1px solid var(--border);border-radius:6px;padding:5px 12px;font-size:12px;cursor:pointer">Reset</button>';
  s6Html += '</div>';

  // Container for parameter analysis tables (will be populated by JS)
  s6Html += '<div id="param-analysis-content"></div>';
  s6Html += '</div>';

  // ── S7: Regime Validation (Mercury's Checklist) ──
  const rv = D.regime_validation || {};
  const mc = rv.mercury_checks || {};
  const rwb = rv.regime_wr_breakdown || {};
  const au = rv.alignment_uplift || {};
  const dc = rv.data_coverage || {};
  const arc = rv.active_regime_composition || {};

  let s7Html = '<div class="perf-section"><h3>Regime Validation (Mercury\'s Checklist)</h3>';
  s7Html += '<p style="font-size:12px;color:var(--text-dim);margin-bottom:12px">Validates whether the regime meta-router is improving trade selection. Three automated checks from Mercury\'s validation framework.</p>';

  const stt = mc.signal_to_trade_ratio || {};
  const rwr = mc.regime_specific_wr || {};
  const mdd = mc.max_dd_reduction || {};

  function checkBadge(pass_val) {
    if (pass_val === true) return '<span style="color:#22c55e;font-weight:700">PASS</span>';
    if (pass_val === false) return '<span style="color:#ef4444;font-weight:700">FAIL</span>';
    return '<span style="color:#f59e0b;font-weight:700">PENDING</span>';
  }

  s7Html += '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;margin-bottom:16px">';

  // Check 1: Signal-to-Trade Ratio
  s7Html += '<div style="background:var(--card);border:1px solid var(--border);border-radius:8px;padding:14px">';
  s7Html += '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px"><strong style="font-size:13px">1. Signal-to-Trade Ratio</strong>' + checkBadge(stt.pass) + '</div>';
  s7Html += '<div style="font-size:12px;color:var(--text-dim);margin-bottom:6px">' + (stt.description || 'Signal reduction ~30%, WR uplift >=5pp') + '</div>';
  s7Html += '<div style="font-size:12px">Misaligned (filtered): <strong>' + fmt(stt.misaligned_pct||0) + '%</strong> (target ~' + fmt(stt.target_pct||30) + '%)</div>';
  s7Html += '<div style="font-size:12px">Aligned WR: <strong style="color:var(--green)">' + fmt(stt.aligned_wr||0) + '%</strong> vs Misaligned WR: <strong style="color:var(--red)">' + fmt(stt.misaligned_wr||0) + '%</strong></div>';
  s7Html += '<div style="font-size:12px">WR Uplift: <strong style="color:' + ((stt.wr_improvement_pp||0)>=5?'var(--green)':'var(--red)') + '">' + (stt.wr_improvement_pp != null ? (stt.wr_improvement_pp>=0?'+':'') + fmt(stt.wr_improvement_pp) + 'pp' : 'N/A') + '</strong> (target >=5pp)</div>';
  s7Html += '</div>';

  // Check 2: Regime-Specific WR
  s7Html += '<div style="background:var(--card);border:1px solid var(--border);border-radius:8px;padding:14px">';
  s7Html += '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px"><strong style="font-size:13px">2. Regime-Specific WR</strong>';
  const rsPasses = [rwr.ranging_pass, rwr.high_vol_pass].filter(function(v) { return v !== null && v !== undefined; });
  const rsAllPass = rsPasses.length > 0 && rsPasses.every(function(v) { return v === true; });
  s7Html += (rsPasses.length > 0 ? checkBadge(rsAllPass) : checkBadge(null)) + '</div>';
  s7Html += '<div style="font-size:12px;color:var(--text-dim);margin-bottom:6px">' + (rwr.description || 'RANGING >55%, HIGH_VOL >50%') + '</div>';
  s7Html += '<div style="font-size:12px">RANGING WR: <strong style="color:' + ((rwr.ranging_wr||0)>55?'var(--green)':'var(--red)') + '">' + fmt(rwr.ranging_wr||0) + '%</strong> (' + (rwr.ranging_trades||0) + ' trades, target >55%)</div>';
  s7Html += '<div style="font-size:12px">HIGH_VOL WR: <strong style="color:' + ((rwr.high_vol_wr||0)>50?'var(--green)':'var(--red)') + '">' + fmt(rwr.high_vol_wr||0) + '%</strong> (' + (rwr.high_vol_trades||0) + ' trades, target >50%)</div>';
  s7Html += '</div>';

  // Check 3: Max-DD Reduction
  s7Html += '<div style="background:var(--card);border:1px solid var(--border);border-radius:8px;padding:14px">';
  s7Html += '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px"><strong style="font-size:13px">3. Max-DD Reduction</strong>' + checkBadge(null) + '</div>';
  s7Html += '<div style="font-size:12px;color:var(--text-dim);margin-bottom:6px">' + (mdd.description || 'Rolling 30d DD should shrink >=15%') + '</div>';
  s7Html += '<div style="font-size:12px;color:var(--text-dim)">' + (mdd.note || 'Requires rolling 30-day time series data') + '</div>';
  s7Html += '</div>';

  s7Html += '</div>';

  // Regime WR Breakdown Table
  s7Html += '<h4 style="font-size:13px;margin:16px 0 8px">Regime WR Breakdown</h4>';
  s7Html += '<div style="overflow-x:auto"><table class="data-table"><thead><tr>';
  s7Html += '<th>Regime</th><th class="num">Trades</th><th class="num">Wins</th><th class="num">Losses</th><th class="num">Win Rate</th>';
  s7Html += '</tr></thead><tbody>';
  var regimeOrder = ['TRENDING_UP','TRENDING_DOWN','RANGING','HIGH_VOLATILITY','CRASH'];
  var regimeLabels = {'TRENDING_UP':'Trending Up','TRENDING_DOWN':'Trending Down','RANGING':'Ranging','HIGH_VOLATILITY':'High Volatility','CRASH':'Crash'};
  var regimeColors = {'TRENDING_UP':'#22c55e','TRENDING_DOWN':'#ef4444','RANGING':'#f59e0b','HIGH_VOLATILITY':'#a78bfa','CRASH':'#dc2626'};
  regimeOrder.forEach(function(r) {
    var d = rwb[r] || {total:0,wins:0,losses:0,win_rate:0};
    s7Html += '<tr><td><span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:' + regimeColors[r] + ';margin-right:6px"></span>' + regimeLabels[r] + '</td>';
    s7Html += '<td class="num">' + d.total + '</td><td class="num">' + d.wins + '</td><td class="num">' + d.losses + '</td>';
    s7Html += '<td class="num" style="color:' + (d.win_rate>50?'var(--green)':'var(--red)') + ';font-weight:600">' + (d.total > 0 ? fmt(d.win_rate) + '%' : '\u2014') + '</td></tr>';
  });
  s7Html += '</tbody></table></div>';

  // Alignment Uplift
  s7Html += '<h4 style="font-size:13px;margin:16px 0 8px">Alignment Uplift</h4>';
  s7Html += '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;margin-bottom:12px">';
  s7Html += '<div style="background:var(--card);border:1px solid var(--border);border-radius:6px;padding:10px;text-align:center"><div style="font-size:11px;color:var(--text-dim)">Aligned WR</div><div style="font-size:20px;font-weight:700;color:var(--green)">' + (au.aligned_trades > 0 ? fmt(au.aligned_wr) + '%' : '\u2014') + '</div><div style="font-size:11px;color:var(--text-dim)">' + (au.aligned_trades||0) + ' trades</div></div>';
  s7Html += '<div style="background:var(--card);border:1px solid var(--border);border-radius:6px;padding:10px;text-align:center"><div style="font-size:11px;color:var(--text-dim)">Misaligned WR</div><div style="font-size:20px;font-weight:700;color:var(--red)">' + (au.misaligned_trades > 0 ? fmt(au.misaligned_wr) + '%' : '\u2014') + '</div><div style="font-size:11px;color:var(--text-dim)">' + (au.misaligned_trades||0) + ' trades</div></div>';
  s7Html += '<div style="background:var(--card);border:1px solid var(--border);border-radius:6px;padding:10px;text-align:center"><div style="font-size:11px;color:var(--text-dim)">Neutral WR</div><div style="font-size:20px;font-weight:700;color:var(--yellow)">' + (au.neutral_trades > 0 ? fmt(au.neutral_wr) + '%' : '\u2014') + '</div><div style="font-size:11px;color:var(--text-dim)">' + (au.neutral_trades||0) + ' trades</div></div>';
  s7Html += '<div style="background:var(--card);border:1px solid var(--border);border-radius:6px;padding:10px;text-align:center"><div style="font-size:11px;color:var(--text-dim)">Uplift (aligned - misaligned)</div><div style="font-size:20px;font-weight:700;color:' + ((au.uplift_pp||0)>=0?'var(--green)':'var(--red)') + '">' + (au.uplift_pp != null ? (au.uplift_pp>=0?'+':'') + fmt(au.uplift_pp) + 'pp' : '\u2014') + '</div><div style="font-size:11px;color:var(--text-dim)">target >=5pp</div></div>';
  s7Html += '</div>';

  // Signal Reduction & Data Coverage
  s7Html += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px">';
  s7Html += '<div style="background:var(--card);border:1px solid var(--border);border-radius:6px;padding:12px"><h4 style="font-size:12px;margin-bottom:6px">Active Pick Regime Composition</h4>';
  s7Html += '<div style="font-size:12px">Total active: <strong>' + (arc.total||0) + '</strong></div>';
  s7Html += '<div style="font-size:12px">With regime data: <strong>' + (arc.with_regime_data||0) + '</strong></div>';
  s7Html += '<div style="font-size:12px">Aligned: <strong style="color:var(--green)">' + (arc.aligned||0) + '</strong> | Misaligned: <strong style="color:var(--red)">' + (arc.misaligned||0) + '</strong> | Neutral: <strong>' + (arc.neutral||0) + '</strong></div>';
  s7Html += '<div style="font-size:12px;margin-top:4px">Signal reduction: <strong>' + fmt(rv.signal_reduction_pct||0) + '%</strong> misaligned (penalized -30% conf)</div></div>';
  s7Html += '<div style="background:var(--card);border:1px solid var(--border);border-radius:6px;padding:12px"><h4 style="font-size:12px;margin-bottom:6px">Data Coverage</h4>';
  s7Html += '<div style="font-size:12px">Closed with regime: <strong>' + (dc.closed_with_regime||0) + '</strong>/' + (dc.closed_total||0) + ' (<strong>' + fmt(dc.coverage_pct||0) + '%</strong>)</div>';
  s7Html += '<div style="font-size:12px">Closed with alignment: <strong>' + (dc.closed_with_alignment||0) + '</strong>/' + (dc.closed_total||0) + ' (<strong>' + fmt(dc.alignment_coverage_pct||0) + '%</strong>)</div>';
  if (dc.enrichment_note) {
    s7Html += '<div style="font-size:11px;color:var(--yellow);margin-top:6px">' + dc.enrichment_note + '</div>';
  }
  s7Html += '</div></div>';
  s7Html += '</div>';

  const blueprintBtn = '<div style="margin:0 0 16px;display:flex;gap:12px;align-items:center;">' +
    '<a href="trading_blueprint.html" target="_blank" style="display:inline-flex;align-items:center;gap:8px;padding:10px 20px;background:linear-gradient(135deg,#06b6d4,#a78bfa);color:#fff;border-radius:8px;text-decoration:none;font-weight:600;font-size:14px;">' +
    '\ud83d\udcca Open Crypto Trading Blueprint</a>' +
    '<span style="color:var(--text-dim);font-size:12px;">Full system analysis for AI/human review — strategy breakdowns, BT vs FWD, simulated optimal portfolios, reviewer questions</span></div>';
  el('tab-performance').innerHTML = blueprintBtn + s1Html + s2Html + s3Html + s4Html + s5Html + s6Html + s7Html;

  // ── Wire up Super Parameter Analysis ──
  function renderParamAnalysis(filteredClosed) {
    const fc = filteredClosed || closed;
    let html = '';

    // Helper for building breakdown tables
    function buildBreakdownTable(title, bands, keyFn) {
      let t = `<div style="margin-bottom:24px"><h4 style="font-size:14px;color:var(--cyan);margin-bottom:8px">${title}</h4>`;
      t += '<div style="overflow-x:auto"><table class="data-table"><thead><tr>';
      t += '<th>Band</th><th># Trades</th><th>Win Rate</th><th>Avg PnL%</th><th>Total PnL%</th><th>Profit Factor</th>';
      t += '</tr></thead><tbody>';
      let bestBand = null, bestWR = -1;
      bands.forEach(b => {
        const picks = fc.filter(p => keyFn(p, b));
        const stats = calcStats(picks);
        if (stats.count >= 3 && stats.winRate > bestWR) { bestWR = stats.winRate; bestBand = b.label; }
        const rowBg = stats.totalPnl > 0 ? 'rgba(76,175,80,0.08)' : stats.totalPnl < 0 ? 'rgba(244,67,54,0.08)' : '';
        t += `<tr style="background:${rowBg}">`;
        t += `<td><strong>${b.label}</strong></td>`;
        t += `<td class="num">${stats.count}</td>`;
        t += `<td class="num ${stats.winRate >= 50 ? 'pnl-pos' : stats.count ? 'pnl-neg' : ''}">${stats.count ? fmt(stats.winRate, 1) + '%' : '-'}</td>`;
        t += `<td class="num ${pnlClass(stats.avgPnl)}">${stats.count ? fmt(stats.avgPnl) + '%' : '-'}</td>`;
        t += `<td class="num ${pnlClass(stats.totalPnl)}"><strong>${stats.count ? fmt(stats.totalPnl) + '%' : '-'}</strong></td>`;
        t += `<td class="num">${stats.count ? (stats.profitFactor >= 999 ? '&infin;' : fmt(stats.profitFactor)) : '-'}</td>`;
        t += '</tr>';
      });
      t += '</tbody></table></div>';
      if (bestBand) t += `<div style="font-size:11px;color:var(--green);margin-top:4px">Sweet spot: <strong>${bestBand}</strong> (${fmt(bestWR,1)}% WR, min 3 trades)</div>`;
      t += '</div>';
      return t;
    }

    // (a) Buy Score Distribution
    const scoreBands6 = [
      {label:'0-10',min:0,max:10},{label:'10-20',min:10,max:20},{label:'20-30',min:20,max:30},
      {label:'30-40',min:30,max:40},{label:'40-50',min:40,max:50},{label:'50-60',min:50,max:60},
      {label:'60-70',min:60,max:70},{label:'70-80',min:70,max:80},{label:'80-90',min:80,max:90},{label:'90-100',min:90,max:101}
    ];
    html += buildBreakdownTable('Buy Score Distribution', scoreBands6, (p, b) => {
      const s = p._perfScore || 0;
      return s >= b.min && s < b.max;
    });

    // (b) Confidence Distribution
    const confBands = [
      {label:'0 - 0.2',min:0,max:0.2},{label:'0.2 - 0.4',min:0.2,max:0.4},
      {label:'0.4 - 0.6',min:0.4,max:0.6},{label:'0.6 - 0.8',min:0.6,max:0.8},{label:'0.8 - 1.0',min:0.8,max:1.01}
    ];
    html += buildBreakdownTable('Confidence Distribution', confBands, (p, b) => {
      const c = p.confidence || 0;
      return c >= b.min && c < b.max;
    });

    // (c) R:R Ratio Analysis
    const rrBands = [
      {label:'< 1.0',min:-999,max:1.0},{label:'1.0 - 1.5',min:1.0,max:1.5},
      {label:'1.5 - 2.0',min:1.5,max:2.0},{label:'2.0 - 3.0',min:2.0,max:3.0},{label:'3.0+',min:3.0,max:9999}
    ];
    html += buildBreakdownTable('R:R Ratio Analysis', rrBands, (p, b) => {
      let rr = 0;
      if (p.entry_price && p.take_profit && p.stop_loss) {
        const risk = Math.abs(p.entry_price - p.stop_loss);
        const reward = Math.abs(p.take_profit - p.entry_price);
        rr = risk > 0 ? reward / risk : 0;
      }
      return rr >= b.min && rr < b.max;
    });

    // (d) Direction Analysis
    const dirBands = [{label:'LONG'},{label:'SHORT'}];
    html += '<div style="margin-bottom:24px"><h4 style="font-size:14px;color:var(--cyan);margin-bottom:8px">Direction Analysis</h4>';
    html += '<div style="overflow-x:auto"><table class="data-table"><thead><tr>';
    html += '<th>Direction</th><th># Trades</th><th>Win Rate</th><th>Avg PnL%</th><th>Total PnL%</th><th>Profit Factor</th>';
    html += '</tr></thead><tbody>';
    dirBands.forEach(b => {
      const picks = fc.filter(p => (p.direction || '').toUpperCase() === b.label);
      const stats = calcStats(picks);
      const rowBg = stats.totalPnl > 0 ? 'rgba(76,175,80,0.08)' : stats.totalPnl < 0 ? 'rgba(244,67,54,0.08)' : '';
      html += `<tr style="background:${rowBg}">`;
      html += `<td><span class="badge ${b.label === 'LONG' ? 'badge-long' : 'badge-short'}">${b.label}</span></td>`;
      html += `<td class="num">${stats.count}</td>`;
      html += `<td class="num ${stats.winRate >= 50 ? 'pnl-pos' : stats.count ? 'pnl-neg' : ''}">${stats.count ? fmt(stats.winRate, 1) + '%' : '-'}</td>`;
      html += `<td class="num ${pnlClass(stats.avgPnl)}">${stats.count ? fmt(stats.avgPnl) + '%' : '-'}</td>`;
      html += `<td class="num ${pnlClass(stats.totalPnl)}"><strong>${stats.count ? fmt(stats.totalPnl) + '%' : '-'}</strong></td>`;
      html += `<td class="num">${stats.count ? (stats.profitFactor >= 999 ? '&infin;' : fmt(stats.profitFactor)) : '-'}</td>`;
      html += '</tr>';
    });
    html += '</tbody></table></div></div>';

    // (e) Asset Class Analysis
    const assetBands = [{label:'CRYPTO'},{label:'EQUITY'},{label:'FOREX'}];
    html += '<div style="margin-bottom:24px"><h4 style="font-size:14px;color:var(--cyan);margin-bottom:8px">Asset Class Analysis</h4>';
    html += '<div style="overflow-x:auto"><table class="data-table"><thead><tr>';
    html += '<th>Asset Class</th><th># Trades</th><th>Win Rate</th><th>Avg PnL%</th><th>Total PnL%</th><th>Profit Factor</th>';
    html += '</tr></thead><tbody>';
    assetBands.forEach(b => {
      const picks = fc.filter(p => (p.asset_class || '').toUpperCase() === b.label);
      const stats = calcStats(picks);
      const rowBg = stats.totalPnl > 0 ? 'rgba(76,175,80,0.08)' : stats.totalPnl < 0 ? 'rgba(244,67,54,0.08)' : '';
      const badgeCls = b.label === 'CRYPTO' ? 'badge-crypto' : b.label === 'FOREX' ? 'badge-forex' : 'badge-equity';
      html += `<tr style="background:${rowBg}">`;
      html += `<td><span class="badge ${badgeCls}">${b.label}</span></td>`;
      html += `<td class="num">${stats.count}</td>`;
      html += `<td class="num ${stats.winRate >= 50 ? 'pnl-pos' : stats.count ? 'pnl-neg' : ''}">${stats.count ? fmt(stats.winRate, 1) + '%' : '-'}</td>`;
      html += `<td class="num ${pnlClass(stats.avgPnl)}">${stats.count ? fmt(stats.avgPnl) + '%' : '-'}</td>`;
      html += `<td class="num ${pnlClass(stats.totalPnl)}"><strong>${stats.count ? fmt(stats.totalPnl) + '%' : '-'}</strong></td>`;
      html += `<td class="num">${stats.count ? (stats.profitFactor >= 999 ? '&infin;' : fmt(stats.profitFactor)) : '-'}</td>`;
      html += '</tr>';
    });
    html += '</tbody></table></div></div>';

    // (f) Optimal Filter Finder
    const overallStats = calcStats(fc);
    // Find best score threshold (min 5 trades)
    let bestScoreThresh = 0, bestScoreWR = 0, bestScoreAvg = 0;
    [20,40,60,80].forEach(t => {
      const p = fc.filter(x => (x._perfScore||0) > t);
      if (p.length >= 5) {
        const s = calcStats(p);
        if (s.winRate > bestScoreWR) { bestScoreWR = s.winRate; bestScoreThresh = t; bestScoreAvg = s.avgPnl; }
      }
    });
    // Best confidence threshold
    let bestConfThresh = 0, bestConfWR = 0, bestConfAvg = 0;
    [0.4,0.6,0.8].forEach(t => {
      const p = fc.filter(x => (x.confidence||0) > t);
      if (p.length >= 5) {
        const s = calcStats(p);
        if (s.winRate > bestConfWR) { bestConfWR = s.winRate; bestConfThresh = t; bestConfAvg = s.avgPnl; }
      }
    });
    // Best R:R threshold
    let bestRRThresh = 0, bestRRWR = 0;
    [1.0,1.5,2.0,3.0].forEach(t => {
      const p = fc.filter(x => {
        if (!x.entry_price || !x.take_profit || !x.stop_loss) return false;
        const risk = Math.abs(x.entry_price - x.stop_loss);
        const reward = Math.abs(x.take_profit - x.entry_price);
        return risk > 0 && (reward/risk) >= t;
      });
      if (p.length >= 5) {
        const s = calcStats(p);
        if (s.winRate > bestRRWR) { bestRRWR = s.winRate; bestRRThresh = t; }
      }
    });
    // Best direction
    const longPicks = fc.filter(p => (p.direction||'').toUpperCase() === 'LONG');
    const shortPicks = fc.filter(p => (p.direction||'').toUpperCase() === 'SHORT');
    const longStats = calcStats(longPicks);
    const shortStats = calcStats(shortPicks);
    const bestDir = longStats.winRate >= shortStats.winRate ? 'LONG' : 'SHORT';
    const bestDirWR = Math.max(longStats.winRate, shortStats.winRate);
    // Best system
    let bestSysName = '-', bestSysWR = 0, bestSysPnl = -Infinity;
    Object.entries(systemMap).forEach(([name, picks]) => {
      if (picks.length >= 3) {
        const s = calcStats(picks);
        if (s.totalPnl > bestSysPnl) { bestSysPnl = s.totalPnl; bestSysName = name; bestSysWR = s.winRate; }
      }
    });
    // Best strategy
    let bestStratName = '-', bestStratWR = 0, bestStratPnl = -Infinity;
    Object.entries(strategyMap).forEach(([name, data]) => {
      if (data.picks.length >= 3) {
        const s = calcStats(data.picks);
        if (s.totalPnl > bestStratPnl) { bestStratPnl = s.totalPnl; bestStratName = name; bestStratWR = s.winRate; }
      }
    });

    html += '<div style="margin-bottom:24px;padding:18px 20px;background:linear-gradient(135deg,rgba(167,139,250,0.08),rgba(34,211,238,0.08));border:1px solid var(--purple);border-radius:10px">';
    html += '<h4 style="font-size:15px;color:var(--purple);margin-bottom:12px">Optimal Filter Finder</h4>';
    html += `<p style="font-size:13px;color:var(--text);line-height:1.8;margin-bottom:8px">Based on <strong>${fc.length}</strong> closed trades, the optimal filters for winning trades are:</p>`;
    html += '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:8px;font-size:13px">';
    html += `<div style="padding:8px 12px;background:var(--card);border-radius:6px;border:1px solid var(--border)"><span style="color:var(--text-dim)">Score:</span> <strong style="color:var(--green)">&gt; ${bestScoreThresh}</strong> <span style="color:var(--text-dim)">(${fmt(bestScoreWR,1)}% WR, ${fmt(bestScoreAvg)}% avg)</span></div>`;
    html += `<div style="padding:8px 12px;background:var(--card);border-radius:6px;border:1px solid var(--border)"><span style="color:var(--text-dim)">Confidence:</span> <strong style="color:var(--green)">&gt; ${bestConfThresh}</strong> <span style="color:var(--text-dim)">(${fmt(bestConfWR,1)}% WR)</span></div>`;
    html += `<div style="padding:8px 12px;background:var(--card);border-radius:6px;border:1px solid var(--border)"><span style="color:var(--text-dim)">R:R:</span> <strong style="color:var(--green)">&gt; ${bestRRThresh}</strong> <span style="color:var(--text-dim)">(${fmt(bestRRWR,1)}% WR)</span></div>`;
    html += `<div style="padding:8px 12px;background:var(--card);border-radius:6px;border:1px solid var(--border)"><span style="color:var(--text-dim)">Direction:</span> <strong style="color:${bestDir==='LONG'?'var(--green)':'var(--red)'}">${bestDir}</strong> <span style="color:var(--text-dim)">(${fmt(bestDirWR,1)}% WR)</span></div>`;
    html += `<div style="padding:8px 12px;background:var(--card);border-radius:6px;border:1px solid var(--border)"><span style="color:var(--text-dim)">Best System:</span> <strong style="color:var(--cyan)">${bestSysName.replace(/_/g,' ')}</strong> <span style="color:var(--text-dim)">(${fmt(bestSysWR,1)}% WR)</span></div>`;
    html += `<div style="padding:8px 12px;background:var(--card);border-radius:6px;border:1px solid var(--border)"><span style="color:var(--text-dim)">Best Strategy:</span> <strong style="color:var(--cyan)">${bestStratName.replace(/_/g,' ')}</strong> <span style="color:var(--text-dim)">(${fmt(bestStratWR,1)}% WR)</span></div>`;
    html += '</div></div>';

    // Filtered summary
    html += `<div style="padding:10px 14px;background:var(--card);border:1px solid var(--border);border-radius:8px;font-size:12px;color:var(--text-dim)">Showing <strong style="color:var(--text)">${fc.length}</strong> trades | WR: <strong class="${overallStats.winRate >= 50 ? 'pnl-pos' : 'pnl-neg'}">${fmt(overallStats.winRate,1)}%</strong> | Total PnL: <strong class="${pnlClass(overallStats.totalPnl)}">${fmt(overallStats.totalPnl)}%</strong> | PF: <strong>${overallStats.profitFactor >= 999 ? '&infin;' : fmt(overallStats.profitFactor)}</strong></div>`;

    el('param-analysis-content').innerHTML = html;
  }

  // Initial render of param analysis
  renderParamAnalysis(closed);

  // Wire up filter buttons
  setTimeout(() => {
    const pfApply = document.getElementById('pf-apply');
    const pfReset = document.getElementById('pf-reset');
    if (pfApply) pfApply.addEventListener('click', () => {
      let filtered = closed.slice();
      const scoreMin = parseFloat(document.getElementById('pf-score')?.value || '');
      const confMin = parseFloat(document.getElementById('pf-conf')?.value || '');
      const dirVal = document.getElementById('pf-dir')?.value || '';
      const assetVal = document.getElementById('pf-asset')?.value || '';
      const sysVal = document.getElementById('pf-sys')?.value || '';
      if (!isNaN(scoreMin) && scoreMin > 0) filtered = filtered.filter(p => (p._perfScore || 0) > scoreMin);
      if (!isNaN(confMin) && confMin > 0) filtered = filtered.filter(p => (p.confidence || 0) > confMin);
      if (dirVal) filtered = filtered.filter(p => (p.direction || '').toUpperCase() === dirVal);
      if (assetVal) filtered = filtered.filter(p => (p.asset_class || '').toUpperCase() === assetVal);
      if (sysVal) filtered = filtered.filter(p => (p.source_system || '') === sysVal);
      renderParamAnalysis(filtered);
    });
    if (pfReset) pfReset.addEventListener('click', () => {
      ['pf-score','pf-conf','pf-dir','pf-asset','pf-sys'].forEach(id => {
        const sel = document.getElementById(id);
        if (sel) sel.value = '';
      });
      renderParamAnalysis(closed);
    });
  }, 100);

  // Wire up table sorting for performance tables
  ['perf-threshold-table', 'perf-system-table', 'perf-strategy-table', 'perf-accuracy-table'].forEach(tableId => {
    const table = document.getElementById(tableId);
    if (!table) return;
    table.querySelectorAll('th[data-col]').forEach(th => {
      th.addEventListener('click', () => {
        const col = th.dataset.col;
        const tbody = table.querySelector('tbody');
        const rows = Array.from(tbody.querySelectorAll('tr'));
        const idx = Array.from(th.parentElement.children).indexOf(th);
        const isAsc = th.dataset.sortDir !== 'asc';
        th.parentElement.querySelectorAll('th').forEach(h => h.dataset.sortDir = '');
        th.dataset.sortDir = isAsc ? 'asc' : 'desc';
        rows.sort((a, b) => {
          let aVal = a.children[idx]?.textContent?.trim() || '';
          let bVal = b.children[idx]?.textContent?.trim() || '';
          const aNum = parseFloat(aVal.replace(/[%∞,]/g, ''));
          const bNum = parseFloat(bVal.replace(/[%∞,]/g, ''));
          if (!isNaN(aNum) && !isNaN(bNum)) return isAsc ? aNum - bNum : bNum - aNum;
          return isAsc ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal);
        });
        rows.forEach(r => tbody.appendChild(r));
      });
    });
  });
}

// ── ML Health Tab ──
function renderMLHealth() {
  const container = el('tab-mlhealth');
  const systems = D.ml_health || [];
  if (!systems.length) {
    container.innerHTML = '<div class="empty-state"><h3>No ML health data</h3><p>ML health data will appear after the next generator run.</p></div>';
    return;
  }
  const now = Date.now();
  let hasStaleAlert = false;
  let cards = '';

  systems.forEach(s => {
    // Determine staleness
    let ageHours = null;
    let ageText = 'N/A';
    if (s.updated_at) {
      const updMs = new Date(s.updated_at).getTime();
      ageHours = (now - updMs) / 3600000;
      if (ageHours < 1) ageText = Math.round(ageHours * 60) + 'm ago';
      else if (ageHours < 48) ageText = Math.round(ageHours) + 'h ago';
      else ageText = Math.round(ageHours / 24) + 'd ago';
    }

    // Color logic: green=active+recent, yellow=heuristic or >12h, red=disabled or >48h or AUC<0.50
    let color = 'var(--green)';
    let statusLabel = 'Active';
    if (s.status === 'disabled') {
      color = 'var(--red)';
      statusLabel = 'Disabled';
    } else if (s.status === 'anti_predictive') {
      color = 'var(--red)';
      statusLabel = 'Anti-Predictive';
    } else if (s.status === 'heuristic_fallback') {
      color = 'var(--yellow)';
      statusLabel = 'Heuristic Fallback';
    } else if (ageHours !== null && ageHours > 48) {
      color = 'var(--red)';
      statusLabel = 'Stale (>48h)';
    } else if (ageHours !== null && ageHours > 12) {
      color = 'var(--yellow)';
      statusLabel = 'Aging (>12h)';
    }
    if (s.cv_auc !== undefined && s.cv_auc !== null && s.cv_auc < 0.50) {
      color = 'var(--red)';
      statusLabel = 'AUC < 0.50';
    }
    if (ageHours !== null && ageHours > 24) hasStaleAlert = true;

    const aucDisplay = (s.cv_auc !== undefined && s.cv_auc !== null)
      ? '<div style="margin-top:8px"><span style="color:var(--text-dim);font-size:11px">CV AUC</span><div style="font-size:22px;font-weight:700;color:' + (s.cv_auc >= 0.65 ? 'var(--green)' : s.cv_auc >= 0.50 ? 'var(--yellow)' : 'var(--red)') + '">' + s.cv_auc.toFixed(4) + '</div></div>'
      : '';
    const versionDisplay = s.version ? '<div style="margin-top:4px;font-size:11px;color:var(--text-dim)">Version: ' + s.version + '</div>' : '';
    const reasonDisplay = s.reason ? '<div style="margin-top:4px;font-size:11px;color:var(--red)">' + s.reason + '</div>' : '';
    const linkDisplay = s.link ? '<a href="' + s.link + '" target="_blank" style="display:inline-block;margin-top:8px;font-size:11px;color:var(--purple)">Open Dashboard</a>' : '';

    cards += `<div style="background:var(--card);border:1px solid var(--border);border-radius:10px;padding:18px;position:relative;overflow:hidden">
      <div style="position:absolute;top:0;left:0;right:0;height:3px;background:${color}"></div>
      <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px">
        <h3 style="font-size:15px;color:var(--text);margin:0">${s.system}</h3>
        <span style="font-size:11px;font-weight:600;padding:3px 8px;border-radius:4px;background:${color}20;color:${color};border:1px solid ${color}40">${statusLabel}</span>
      </div>
      <div style="font-size:12px;color:var(--text-dim);margin-bottom:4px">${s.model_type}</div>
      <div style="font-size:12px;margin-bottom:4px">
        <span style="color:var(--text-dim)">Mode:</span>
        <span style="color:${s.mode === 'disabled' ? 'var(--red)' : s.mode === 'heuristic' ? 'var(--yellow)' : 'var(--cyan)'};font-weight:600">${s.mode}</span>
      </div>
      <div style="font-size:12px">
        <span style="color:var(--text-dim)">Updated:</span>
        <span style="color:${ageHours !== null && ageHours > 24 ? 'var(--red)' : ageHours !== null && ageHours > 12 ? 'var(--yellow)' : 'var(--text)'}">${ageText}${ageHours !== null && ageHours > 24 ? ' &#9888;' : ''}</span>
      </div>
      ${aucDisplay}${versionDisplay}${reasonDisplay}${linkDisplay}
    </div>`;
  });

  let staleWarning = '';
  if (hasStaleAlert) {
    staleWarning = '<div style="background:rgba(244,67,54,0.15);border:1px solid var(--red);border-radius:8px;padding:12px 16px;margin-bottom:16px;font-size:13px;color:var(--red)">' +
      '<strong>&#9888; Staleness Alert:</strong> One or more ML systems have not been updated in over 24 hours. Check GitHub Actions workflows.' +
      '</div>';
  }

  container.innerHTML = '<div style="padding:8px 0">' +
    '<h2 style="font-size:18px;margin-bottom:16px;color:var(--text)">ML System Health Monitor</h2>' +
    staleWarning +
    '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px">' +
    cards +
    '</div>' +
    '<div style="margin-top:16px;font-size:11px;color:var(--text-dim)">Color coding: <span style="color:var(--green)">&#9679;</span> Active + recent &nbsp; <span style="color:var(--yellow)">&#9679;</span> Heuristic / >12h stale &nbsp; <span style="color:var(--red)">&#9679;</span> Disabled / >48h stale / AUC &lt; 0.50</div>' +
    '</div>';
}

// ── 4-AI Battle Tab ──
function renderAIBattle() {
  const container = document.getElementById('ai-battle-body');
  if (!container) return;
  const agents = [
    // Phase 2 picks (fresh round — all SHORT bias after Phase 1 lessons)
    {name: 'Claude P2', color: '#22d3ee', icon: 'C2', url: 'data/claude_top_picks_phase2.json', parser: 'claude'},
    {name: 'Grok P2', color: '#fb923c', icon: 'G2', url: 'data/grok_top_picks_phase2.json', parser: 'grok'},
    {name: 'Mercury P2', color: '#34d399', icon: 'M2', url: 'data/mercury_top_picks_phase2.json', parser: 'mercury'},
    {name: 'KIMI P2', color: '#ff6b9d', icon: 'K2', url: 'data/kimi_top_picks_phase2.json', parser: 'kimi'},
    {name: 'AG P2', color: '#a78bfa', icon: 'A2', url: 'data/ag_top_picks_phase2.json', parser: 'ag'},
    // Phase 1 picks (initial round — tracking to completion)
    {name: 'Grok P1', color: '#fb923c44', icon: 'G1', url: 'data/grok_top_picks.json', parser: 'grok'},
    {name: 'Mercury P1', color: '#34d39944', icon: 'M1', url: 'data/mercury_top_picks.json', parser: 'mercury'},
    {name: 'KIMI P1', color: '#ff6b9d44', icon: 'K1', url: 'data/kimi_top_3_live_picks.json', parser: 'kimi'},
    {name: 'AG P1', color: '#a78bfa44', icon: 'A1', url: 'data/ag_top_picks.json', parser: 'ag'},
    {name: 'Claude P1', color: '#22d3ee44', icon: 'C1', url: 'data/claude_top_picks.json', parser: 'claude'}
  ];
  function normalizePicks(data, parser) {
    if (!data) return [];
    if (parser === 'claude') return (data.picks || []).map(p => ({symbol: p.symbol, dir: p.direction, entry: p.entry_price, tp: p.take_profit, sl: p.stop_loss, rr: p.risk_reward, conf: p.confidence, strategy: p.strategy, reason: p.reasoning || p.reason || '', status: p.status, outcome: p.outcome, pnl_pct: p.pnl_pct || 0, realized_usd: p.realized_pnl_usd || null}));
    if (parser === 'ag') return (data.top_picks || []).map(p => ({symbol: p.symbol, dir: p.signal_type || p.direction || 'BUY', entry: p.entry_price, tp: p.take_profit, sl: p.stop_loss, rr: p.risk_reward || (p.take_profit && p.stop_loss && p.entry_price ? Math.abs((p.entry_price - p.take_profit) / (p.stop_loss - p.entry_price)).toFixed(1) : '?'), conf: p.confidence, strategy: p.strategy || p.signal_type, reason: p.rationale || '', status: p.outcome === 'SL_HIT' || p.outcome === 'TP_HIT' ? 'CLOSED' : (p.status || 'ACTIVE'), outcome: p.outcome || 'PENDING', pnl_pct: p.pnl_pct || 0}));
    if (parser === 'grok') return (data.grok_top_picks || []).map(p => ({symbol: p.symbol, dir: p.signal_type, entry: p.entry_price, tp: p.take_profit, sl: p.stop_loss, rr: p.take_profit && p.stop_loss && p.entry_price ? Math.abs((p.entry_price - p.take_profit) / (p.stop_loss - p.entry_price)).toFixed(1) : '?', conf: p.confidence, strategy: p.strategy, reason: p.rationale || '', status: p.status === 'OPEN' ? 'ACTIVE' : (p.status || 'ACTIVE'), outcome: p.outcome || 'PENDING', pnl_pct: p.pnl_pct || 0}));
    if (parser === 'kimi') return (data.picks || []).map(p => ({symbol: p.symbol, dir: p.direction || 'BUY', entry: p.entry_price, tp: p.take_profit, sl: p.stop_loss, rr: p.risk_reward, conf: p.confidence, strategy: p.strategy || p.strategy_id, reason: p.rationale || '', status: p.status === 'ACTIVE_ENTRY' ? 'ACTIVE' : (p.outcome === 'SL_HIT' || p.outcome === 'TP_HIT' ? 'CLOSED' : p.status), outcome: p.outcome || 'PENDING', pnl_pct: p.pnl_pct || 0}));
    if (parser === 'mercury') return (data.mercury_top_picks || []).map(p => ({symbol: p.symbol, dir: p.signal_type, entry: p.entry_price, tp: p.take_profit, sl: p.stop_loss, rr: p.take_profit && p.stop_loss && p.entry_price ? Math.abs((p.entry_price - p.take_profit) / (p.stop_loss - p.entry_price)).toFixed(1) : '?', conf: p.confidence, strategy: p.strategy, reason: p.rationale || '', status: p.status === 'OPEN' ? 'ACTIVE' : (p.outcome === 'SL_HIT' || p.outcome === 'TP_HIT' ? 'CLOSED' : p.status), outcome: p.outcome || 'PENDING', pnl_pct: p.pnl_pct || 0}));
    return [];
  }
  Promise.all([
    ...agents.map(a => fetch(a.url + '?t=' + Date.now()).then(r => r.ok ? r.json() : null).catch(() => null)),
    // Failover: try multiple Binance hosts for geo-block resilience
    (async () => {
      for (const h of ['api.binance.com','api1.binance.com','api.binance.us','data-api.binance.vision']) {
        try { const r = await fetch(`https://${h}/api/v3/ticker/price`, {signal: AbortSignal.timeout(8000)}); if (r.ok) return r.json(); } catch(e) {}
      }
      // Bybit fallback
      try { const r = await fetch('https://api.bybit.com/v5/market/tickers?category=spot'); if (r.ok) { const d = await r.json(); return (d.result?.list||[]).map(t => ({symbol:t.symbol,price:t.lastPrice})); } } catch(e) {}
      return [];
    })()
  ]).then(async results => {
    const priceData = results[agents.length] || [];
    const livePrices = {};
    priceData.forEach(t => { livePrices[t.symbol] = parseFloat(t.price); });
    // Fetch stock/equity prices via 7-tier failover for non-crypto symbols
    try {
      const allPicks = agents.map((a, i) => normalizePicks(results[i], a.parser)).flat();
      const stockSymbols = [...new Set(allPicks.map(p => p.symbol).filter(s => s && !s.endsWith('USDT') && !s.endsWith('BUSD') && !s.endsWith('PERP') && !s.includes('BTC') && !s.includes('ETH') && !livePrices[s]))];
      if (stockSymbols.length > 0) {
        // Build fake pick objects so fetchStockPrices can identify them via _KNOWN_STOCKS or direct call
        const fakePicks = stockSymbols.map(s => ({symbol: s, asset_class: 'EQUITY', entry_price: 1}));
        await fetchStockPrices(fakePicks);
        // fetchStockPrices updates p._livePrice; copy resolved prices into livePrices
        fakePicks.forEach(p => { if (p._livePrice) livePrices[p.symbol] = p._livePrice; });
        console.log('[AI-BATTLE] Stock prices loaded for', stockSymbols.length, 'symbols');
      }
    } catch(e) { console.warn('Stock price fetch failed:', e); }
    let html = '';
    const agentStats = agents.map((a, i) => {
      const picks = normalizePicks(results[i], a.parser);
      let totalPnlPct = 0, wins = 0, losses = 0, active = 0, pickCount = 0;
      picks.forEach(p => {
        const live = livePrices[p.symbol];
        const isShort = (p.dir || '').toUpperCase().includes('SHORT');
        if (p.outcome === 'TP_HIT') {
          // Use realized P/L% from data, not live price
          const closedPnl = p.pnl_pct || (p.tp && p.entry ? (isShort ? ((p.entry - p.tp) / p.entry * 100) : ((p.tp - p.entry) / p.entry * 100)) : 0);
          p._livePnl = closedPnl;
          wins++; pickCount++; totalPnlPct += closedPnl;
        } else if (p.outcome === 'SL_HIT') {
          const closedPnl = p.pnl_pct || (p.sl && p.entry ? (isShort ? ((p.entry - p.sl) / p.entry * 100) : ((p.sl - p.entry) / p.entry * 100)) : 0);
          p._livePnl = closedPnl;
          losses++; pickCount++; totalPnlPct += closedPnl;
        } else if (live && p.entry) {
          const pnl = isShort ? ((p.entry - live) / p.entry * 100) : ((live - p.entry) / p.entry * 100);
          p._livePnl = pnl;
          active++; pickCount++; totalPnlPct += pnl;
        }
      });
      const avgPnlPct = pickCount > 0 ? totalPnlPct / pickCount : 0;
      return {agent: a, picks, avgPnlPct, totalPnlPct, wins, losses, active, pickCount};
    });
    // Sort by avg P/L% per pick (not $ amount)
    agentStats.sort((a, b) => b.avgPnlPct - a.avgPnlPct);
    html += '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-bottom:20px">';
    agentStats.forEach((s, i) => {
      const medal = i === 0 ? '1st' : i === 1 ? '2nd' : i === 2 ? '3rd' : i === 3 ? '4th' : '5th';
      html += '<div style="background:rgba(255,255,255,0.03);border:2px solid ' + s.agent.color + (i === 0 ? '' : '44') + ';border-radius:10px;padding:14px;text-align:center' + (i === 0 ? ';box-shadow:0 0 15px ' + s.agent.color + '33' : '') + '">';
      html += '<div style="font-size:11px;color:' + s.agent.color + ';font-weight:700;text-transform:uppercase;letter-spacing:1px">' + medal + '</div>';
      html += '<div style="font-size:18px;font-weight:700;color:' + s.agent.color + ';margin:4px 0">' + s.agent.name + '</div>';
      html += '<div style="font-size:15px;font-weight:700;color:' + (s.avgPnlPct >= 0 ? 'var(--green)' : 'var(--red)') + ';margin:4px 0">Avg P/L: ' + (s.avgPnlPct >= 0 ? '+' : '') + s.avgPnlPct.toFixed(2) + '%</div>';
      html += '<div style="font-size:11px;color:var(--text-dim);margin-top:4px">' + s.pickCount + ' picks \u2022 W:' + s.wins + ' L:' + s.losses + ' A:' + s.active + '</div>';
      html += '</div>';
    });
    html += '</div>';
    agentStats.forEach(s => {
      const a = s.agent;
      html += '<div style="margin-bottom:16px;border:1px solid ' + a.color + '33;border-radius:8px;overflow:hidden">';
      html += '<div style="background:' + a.color + '15;padding:10px 16px;display:flex;align-items:center;gap:8px;border-bottom:1px solid ' + a.color + '33">';
      html += '<span style="background:' + a.color + ';color:#000;font-weight:700;padding:2px 8px;border-radius:4px;font-size:11px">' + a.icon + '</span>';
      html += '<span style="font-weight:600;color:' + a.color + '">' + a.name + ' Top Picks</span>';
      html += '<span style="font-size:11px;color:var(--text-dim);margin-left:auto">W:' + s.wins + ' L:' + s.losses + ' Active:' + s.active + '</span>';
      html += '</div>';
      html += '<table class="data-table" style="margin:0;table-layout:fixed;width:100%"><colgroup><col style="width:30px"><col style="width:80px"><col style="width:55px"><col style="width:75px"><col style="width:75px"><col style="width:75px"><col style="width:75px"><col style="width:70px"><col style="width:45px"><col style="width:50px"><col style="width:auto"><col style="width:90px"></colgroup><thead><tr><th>#</th><th>Symbol</th><th>Dir</th><th>Entry</th><th>Live</th><th>TP</th><th>SL</th><th>P/L</th><th>R:R</th><th>Conf</th><th>Strategy</th><th>Status</th></tr></thead><tbody>';
      s.picks.forEach((p, i) => {
        const live = livePrices[p.symbol];
        const isShort = (p.dir || '').toUpperCase().includes('SHORT');
        // For closed picks, use the pre-calculated P/L (not live price)
        const pnl = (p.outcome === 'TP_HIT' || p.outcome === 'SL_HIT') ? p._livePnl : (live && p.entry ? (isShort ? ((p.entry - live) / p.entry * 100) : ((live - p.entry) / p.entry * 100)) : null);
        const fmt = v => !v ? '\u2014' : v < 0.01 ? v.toFixed(6) : v < 1 ? v.toFixed(4) : v < 100 ? v.toFixed(2) : v < 10000 ? v.toFixed(1) : v.toLocaleString(undefined, {maximumFractionDigits: 0});
        let statusText = p.outcome === 'TP_HIT' ? 'TP HIT' : p.outcome === 'SL_HIT' ? 'SL HIT' : p.status || 'ACTIVE';
        let statusColor = p.outcome === 'TP_HIT' ? 'var(--green)' : p.outcome === 'SL_HIT' ? 'var(--red)' : pnl > 0 ? 'var(--green)' : pnl < 0 ? 'var(--orange)' : 'var(--text-dim)';
        if (statusText === 'ACTIVE' && pnl !== null) statusText = pnl > 0 ? 'IN PROFIT' : 'DRAWDOWN';
        if (statusText === 'WATCHLIST_NEAR_TRIGGER' || statusText === 'WATCHLIST') { statusText = 'WATCH'; statusColor = 'var(--yellow)'; }
        if (statusText === 'WATCHLIST_WAITING_PULLBACK' || statusText === 'WAITING_PULLBACK') { statusText = 'WAIT'; statusColor = 'var(--yellow)'; }
        const dirColor = isShort ? 'var(--red)' : 'var(--green)';
        const pnlStr = pnl !== null ? (pnl >= 0 ? '+' : '') + pnl.toFixed(2) + '%' : '\u2014';
        const pnlColor = pnl > 0 ? 'var(--green)' : pnl < 0 ? 'var(--red)' : 'var(--text-dim)';
        html += '<tr><td style="color:' + a.color + ';font-weight:700">' + (i + 1) + '</td>';
        html += '<td style="font-weight:600">' + (p.symbol || '').replace('USDT', '') + '</td>';
        html += '<td style="color:' + dirColor + ';font-weight:600">' + (p.dir || '?') + '</td>';
        html += '<td class="num">' + fmt(p.entry) + '</td>';
        const displayPrice = (p.outcome === 'TP_HIT') ? p.tp : (p.outcome === 'SL_HIT') ? p.sl : live;
        html += '<td class="num" style="color:' + pnlColor + ';font-weight:600">' + (displayPrice ? fmt(displayPrice) : '\u2014') + '</td>';
        html += '<td class="num" style="color:var(--green)">' + fmt(p.tp) + '</td>';
        html += '<td class="num" style="color:var(--red)">' + fmt(p.sl) + '</td>';
        html += '<td class="num" style="color:' + pnlColor + ';font-weight:700">' + pnlStr + '</td>';
        html += '<td class="num">' + (p.rr || '?') + '</td>';
        html += '<td class="num" style="color:' + a.color + '">' + (typeof p.conf === 'number' ? (p.conf > 1 ? p.conf : Math.round(p.conf * 100)) + '%' : p.conf || '?') + '</td>';
        html += '<td style="font-size:11px;color:var(--text-dim)">' + (p.strategy || '?') + '</td>';
        html += '<td style="color:' + statusColor + ';font-weight:600;font-size:12px">' + statusText + '</td></tr>';
      });
      html += '</tbody></table></div>';
    });
    html += '<div style="margin-top:12px;font-size:11px;color:var(--text-dim);text-align:center">Prices refresh on page load from Binance API. Outcomes auto-checked every 4h by CI pipeline. <a href="#" onclick="renderAIBattle();return false" style="color:var(--yellow)">Refresh now</a></div>';
    container.innerHTML = html;
  });
}

// ── Claude Top Picks Tab ──
function renderClaudeTopPicks() {
  const container = document.getElementById('claude-top-picks-content');
  if (!container) return;
  fetch('data/claude_top_picks.json?t=' + Date.now()).then(r => r.ok ? r.json() : null).catch(() => null).then(async data => {
    if (!data || !data.picks || !data.picks.length) { container.innerHTML = '<div class="empty-state">No Claude Top Picks data. Run scanner first.</div>'; return; }
    const picks = data.picks;
    const stats = data.lifetime_stats || {};
    const history = data.historical_rounds || [];
    let livePrices = {};
    try {
      const symbols = picks.map(p => p.symbol);
      // Failover: try multiple Binance hosts
      let priceResp = null;
      for (const h of ['api.binance.com','api1.binance.com','api.binance.us','data-api.binance.vision']) {
        try { priceResp = await fetch(`https://${h}/api/v3/ticker/price`, {signal: AbortSignal.timeout(8000)}); if (priceResp.ok) break; } catch(e) { priceResp = null; }
      }
      if (priceResp && priceResp.ok) { const allPrices = await priceResp.json(); allPrices.forEach(t => { if (symbols.includes(t.symbol)) livePrices[t.symbol] = parseFloat(t.price); }); }
      // Fetch stock prices via 7-tier failover for non-crypto symbols missing from Binance
      const stockSyms = symbols.filter(s => !livePrices[s] && !s.endsWith('USDT') && !s.endsWith('BUSD'));
      if (stockSyms.length > 0) {
        try {
          const fakePicks = stockSyms.map(s => ({symbol: s, asset_class: 'EQUITY', entry_price: 1}));
          await fetchStockPrices(fakePicks);
          fakePicks.forEach(p => { if (p._livePrice) livePrices[p.symbol] = p._livePrice; });
        } catch(e2) { console.warn('Stock prices fetch failed:', e2); }
      }
    } catch(e) {}
    let html = '';
    const wr = stats.win_rate !== null && stats.win_rate !== undefined ? stats.win_rate.toFixed(1) + '%' : 'N/A';
    const cumPnl = stats.cumulative_pnl_pct || 0;
    html += '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin-bottom:20px">';
    html += '<div class="stat-card" style="padding:10px 14px"><div class="label">Total Picks</div><div class="value" style="font-size:22px">' + (stats.total_picks || picks.length) + '</div></div>';
    html += '<div class="stat-card" style="padding:10px 14px"><div class="label">Win Rate</div><div class="value" style="font-size:22px;color:' + (stats.win_rate >= 50 ? 'var(--green)' : stats.win_rate === null ? 'var(--text-dim)' : 'var(--red)') + '">' + wr + '</div></div>';
    html += '<div class="stat-card" style="padding:10px 14px"><div class="label">Cumulative PnL</div><div class="value" style="font-size:22px;color:' + (cumPnl >= 0 ? 'var(--green)' : 'var(--red)') + '">' + (cumPnl >= 0 ? '+' : '') + cumPnl.toFixed(2) + '%</div></div>';
    html += '<div class="stat-card" style="padding:10px 14px"><div class="label">Rounds</div><div class="value" style="font-size:22px">' + (stats.total_rounds || 1) + '</div></div>';
    html += '</div>';
    html += '<h4 style="color:var(--cyan);margin-bottom:10px;font-size:14px">Current Round \u2014 Active Picks</h4>';
    html += '<div style="overflow-x:auto"><table class="data-table"><thead><tr><th>#</th><th>Symbol</th><th>Dir</th><th>Entry</th><th>Current</th><th>TP</th><th>SL</th><th>Unrealized P/L</th><th>R:R</th><th>Conf</th><th>Status</th></tr></thead><tbody>';
    picks.forEach(p => {
      const livePrice = livePrices[p.symbol] || null;
      const entry = p.entry_price, tp = p.take_profit, sl = p.stop_loss;
      let unrealPnl = 0, unrealPnlStr = '\u2014', statusColor = 'var(--yellow)', statusText = p.outcome || 'PENDING';
      let priceStr = livePrice ? (livePrice < 1 ? livePrice.toFixed(6) : livePrice < 100 ? livePrice.toFixed(4) : livePrice.toFixed(2)) : '\u2014';
      if (livePrice && entry) {
        unrealPnl = ((livePrice - entry) / entry) * 100 * (p.direction === 'LONG' ? 1 : -1);
        // Cap outlier PnL from bad entry prices
        if (Math.abs(unrealPnl) > 500) { unrealPnl = 0; unrealPnlStr = 'ERR'; }
        else unrealPnlStr = (unrealPnl >= 0 ? '+' : '') + unrealPnl.toFixed(2) + '%';
        if (p.outcome === 'TP_HIT') { statusText = 'TP HIT'; statusColor = 'var(--green)'; }
        else if (livePrice >= tp) { statusText = 'TP HIT'; statusColor = 'var(--green)'; }
        else if (livePrice <= sl) { statusText = 'SL HIT'; statusColor = 'var(--red)'; }
        else if (unrealPnl > 0) { statusText = 'IN PROFIT'; statusColor = 'var(--green)'; }
        else if (unrealPnl < 0) { statusText = 'DRAWDOWN'; statusColor = 'var(--orange)'; }
      }
      if (p.outcome === 'TP_HIT') { statusText = 'TP HIT'; statusColor = 'var(--green)'; unrealPnlStr = '+' + (p.pnl_pct || 0).toFixed(2) + '% ($' + (p.realized_pnl_usd || 0).toFixed(2) + ')'; }
      const fmt = v => v < 1 ? v.toFixed(6) : v < 100 ? v.toFixed(4) : v.toFixed(2);
      html += '<tr><td style="color:var(--cyan);font-weight:700">' + p.rank + '</td>';
      html += '<td style="font-weight:700">' + p.symbol.replace('USDT', '') + '</td>';
      html += '<td style="color:var(--green)">' + p.direction + '</td>';
      html += '<td class="num">' + fmt(entry) + '</td>';
      html += '<td class="num" style="color:' + (livePrice && livePrice >= entry ? 'var(--green)' : 'var(--red)') + ';font-weight:600">' + priceStr + '</td>';
      html += '<td class="num" style="color:var(--green)">' + fmt(tp) + '</td>';
      html += '<td class="num" style="color:var(--red)">' + fmt(sl) + '</td>';
      html += '<td class="num" style="color:' + (unrealPnl >= 0 ? 'var(--green)' : 'var(--red)') + ';font-weight:700">' + unrealPnlStr + '</td>';
      html += '<td class="num">' + (p.risk_reward || 1.33).toFixed(2) + '</td>';
      html += '<td class="num" style="color:var(--cyan)">' + Math.round((p.confidence || 0) * 100) + '%</td>';
      html += '<td style="color:' + statusColor + ';font-weight:600">' + statusText + '</td></tr>';
      html += '<tr style="background:rgba(34,211,238,0.03)"><td></td><td colspan="10" style="padding:4px 8px;font-size:11px;color:var(--text-dim);border-bottom:1px solid rgba(255,255,255,0.05)"><span style="color:var(--cyan)">Why:</span> ' + (p.reasoning || p.reason || '') + '</td></tr>';
    });
    html += '</tbody></table></div>';
    html += '<div style="margin-top:20px;padding:12px 16px;background:rgba(34,211,238,0.05);border:1px solid rgba(34,211,238,0.15);border-radius:8px;font-size:12px;color:var(--text-dim)">';
    html += '<strong style="color:var(--cyan)">Methodology:</strong> ' + (data.methodology || 'Multi-factor analysis');
    html += '<br><strong style="color:var(--cyan)">Auto-check:</strong> Prices checked against TP/SL every scan cycle. Picks expire after 24h if neither TP nor SL hit.';
    html += '</div>';
    container.innerHTML = html;
  });
}

// ── Try to fetch freshest data from GitHub before rendering ──
async function tryFetchFreshData() {
  const PAYLOAD_URL = 'https://raw.githubusercontent.com/eltonaguiar/findtorontoevents_antigravity.ca/main/audit_trail/data/dashboard_payload.json';
  try {
    const resp = await fetch(PAYLOAD_URL + '?t=' + Date.now(), {cache: 'no-store'});
    if (!resp.ok) return false;
    const fresh = await resp.json();
    if (!fresh.generated_at) return false;
    const freshTime = new Date(fresh.generated_at).getTime();
    const embeddedTime = D.generated_at ? new Date(D.generated_at).getTime() : 0;
    if (freshTime > embeddedTime) {
      // Merge fresh data into D
      Object.assign(D, fresh);
      window.DASHBOARD_DATA = D;
      console.log('[Audit] Loaded fresh data from GitHub (' + fresh.generated_at + ') replacing embedded (' + (D.generated_at||'none') + ')');
      return true;
    }
    return false;
  } catch(e) {
    console.log('[Audit] Could not fetch fresh data:', e.message);
    return false;
  }
}

// ── Initial render ──
async function init() {
  // Try to get freshest data from GitHub (non-blocking for embedded data)
  let freshLoaded = false;
  if (D.generated_at) {
    const embeddedAge = (Date.now() - new Date(D.generated_at).getTime()) / 60000;
    if (embeddedAge > 5) {
      // Embedded data is >5 min old, try to fetch fresh
      freshLoaded = await tryFetchFreshData();
    }
  } else {
    freshLoaded = await tryFetchFreshData();
  }

  if (!D.generated_at) {
    document.body.innerHTML = '<div class="empty-state" style="margin-top:100px"><h2>No data loaded</h2><p>Run the generator: <code>python -m audit_trail.dashboard_generator</code></p></div>';
    return;
  }
  renderPerfAlerts();
  renderSummary();
  populateFilters();

  // Default filters: Crypto only — let users add more restrictive filters themselves
  el('f-asset').value = 'CRYPTO';
  window._scoreGateFilter = false;

  renderAgreementMatrix();
  renderOverview();
  renderPicks();
  // Fetch live prices and update PnL after initial render
  fetchLivePrices();
  renderPortfolios();
  renderClaudePortfolios();
  renderClaudeTopPicks();
  renderAIBattle();
  renderDashboards();
  renderSystems();
  renderBtVsFwd();
  renderLeaderboard();
  renderBundles();
  renderPermutations();
  renderPerformance();
  renderAuditLog();
  renderMLHealth();

  // Show data age and auto-refresh countdown
  const genAt = new Date(D.generated_at);
  function updateAge() {
    const mins = Math.floor((Date.now() - genAt.getTime()) / 60000);
    const ageText = mins < 1 ? 'just now' : mins < 60 ? mins + 'm ago' : Math.floor(mins/60) + 'h ' + (mins%60) + 'm ago';
    const ageColor = mins > 60 ? 'var(--red)' : mins > 15 ? 'var(--yellow)' : 'var(--green)';
    const staleWarn = mins > 60 ? ' \u2014 DATA STALE! Check workflow status.' : '';
    const freshBadge = freshLoaded ? ' <span style="color:#22c55e;font-size:10px;" title="Fresh data fetched from GitHub on page load">\u26a1 LIVE</span>' : '';
    el('last-updated').innerHTML = 'Data from ' + ageText + staleWarn + freshBadge + ' <span style="color:' + ageColor + '">\u25cf</span>';
    // Also update the filter bar data age indicator
    const ageIndicator = document.getElementById('data-age-indicator');
    if (ageIndicator) {
      ageIndicator.innerHTML = `<span style="color:${ageColor}">\u25cf</span> Data: ${ageText}`;
      ageIndicator.title = `Data generated at ${genAt.toLocaleString('en-US', {timeZone: 'America/New_York'})} EST. Reload Page = force browser refresh. Full Refresh = trigger GitHub Actions pipeline to re-collect all data (needs ~3-5 min).`;
    }
    if (mins > 15) {
      el('last-updated').title = 'Data may be stale (>' + mins + 'm old). Auto-refreshes every 5 min via meta tag, or click Refresh button.';
    }
  }
  updateAge();
  setInterval(updateAge, 30000);
}
// Set default asset filter to Crypto on page load
el('f-asset').value = 'CRYPTO';
init();
</script>

<!-- Trade Drill-Down Modal -->
<div class="trade-modal-overlay" id="trade-modal-overlay" onclick="if(event.target===this)closeTradeModal()">
  <div class="trade-modal">
    <button class="trade-modal-close" onclick="closeTradeModal()">&times;</button>
    <div id="trade-modal-content"></div>
  </div>
</div>

<!-- Floating tooltip for sys-desc-tip icons -->
<div class="sys-desc-popup-float" id="sys-float-tip"></div>
<script>
(function(){
  const tip = document.getElementById('sys-float-tip');
  document.addEventListener('mouseover', function(e) {
    const icon = e.target.closest('.sys-desc-tip');
    if (!icon) return;
    const popup = icon.querySelector('.sys-desc-popup');
    if (!popup) return;
    tip.innerHTML = popup.innerHTML;
    tip.style.display = 'block';
    const r = icon.getBoundingClientRect();
    let top = r.bottom + 6;
    let left = r.left;
    // Keep within viewport
    if (left + 360 > window.innerWidth) left = window.innerWidth - 370;
    if (left < 8) left = 8;
    if (top + 200 > window.innerHeight) top = r.top - 210;
    tip.style.top = top + 'px';
    tip.style.left = left + 'px';
  });
  document.addEventListener('mouseout', function(e) {
    const icon = e.target.closest('.sys-desc-tip');
    if (icon) tip.style.display = 'none';
  });
})();
</script>

<!-- Score Tracker: snapshot top picks & track what-if performance -->
<script>
(function(){
  const ST_KEY = 'antigravity_score_snapshots';
  const MAX_SNAPSHOTS = 500; // ~5 days at 15-min intervals
  const TOP_N = 10; // track top 10 scored picks per snapshot

  function getSnapshots() {
    try { return JSON.parse(localStorage.getItem(ST_KEY) || '[]'); } catch { return []; }
  }
  function saveSnapshots(snaps) {
    while (snaps.length > MAX_SNAPSHOTS) snaps.shift();
    localStorage.setItem(ST_KEY, JSON.stringify(snaps));
  }

  // Take snapshot of current top picks (called once on page load after scoring)
  function takeSnapshot() {
    const active = (D.picks?.active || []).slice();
    if (!active.length) return;
    const now = new Date();
    const nowISO = now.toISOString();
    // Don't snapshot more than once per 10 minutes
    const snaps = getSnapshots();
    if (snaps.length > 0) {
      const last = new Date(snaps[snaps.length - 1].ts);
      if ((now - last) < 10 * 60 * 1000) return;
    }
    // Score all active picks
    active.forEach(p => {
      const _now = Date.now();
      if (p.timestamp) {
        const t = new Date(p.timestamp).getTime();
        if (!isNaN(t)) p.age_hours = Math.max(0, (_now - t) / 3600000);
      }
      const result = computeScore(p);
      p._score = result.score;
    });
    // Take top N by score
    active.sort((a, b) => (b._score || 0) - (a._score || 0));
    const topPicks = active.slice(0, TOP_N).map(p => ({
      sym: p.symbol,
      dir: p.direction,
      score: p._score || 0,
      entry: parseFloat(p.entry_price) || 0,
      tp: parseFloat(p.take_profit) || 0,
      sl: parseFloat(p.stop_loss) || 0,
      pnl: p.pnl_pct ?? 0,
      conf: p.confidence ?? 0,
      strat: p.strategy || '?',
      sys: p.source_system || '?',
      tier: p.trust_tier || '?'
    }));
    snaps.push({ ts: nowISO, picks: topPicks });
    saveSnapshots(snaps);
  }

  // Calculate what-if: if you entered each snapshot's top picks at their entry price,
  // what's the current PnL based on the latest snapshot's data?
  function calcWhatIf(snaps) {
    if (snaps.length < 2) return { totalPnl: 0, wins: 0, losses: 0, trades: 0, bestPick: null, worstPick: null };
    const latest = snaps[snaps.length - 1];
    const latestPrices = {};
    latest.picks.forEach(p => { latestPrices[p.sym] = p; });
    let totalPnl = 0, wins = 0, losses = 0, trades = 0;
    let bestPick = null, worstPick = null;
    // For each historical snapshot (except the latest), check how top picks evolved
    snaps.forEach((snap, idx) => {
      if (idx === snaps.length - 1) return;
      snap.picks.forEach(pick => {
        // Look for this symbol in later snapshots to see PnL evolution
        const laterSnap = snaps[Math.min(idx + 4, snaps.length - 1)]; // check ~1h later (4 x 15min)
        const laterPick = laterSnap.picks.find(p => p.sym === pick.sym);
        if (laterPick && pick.entry > 0) {
          const pnlDelta = laterPick.pnl - pick.pnl; // PnL change from snapshot to +1h
          totalPnl += pnlDelta;
          trades++;
          if (pnlDelta > 0) wins++;
          else if (pnlDelta < 0) losses++;
          if (!bestPick || pnlDelta > bestPick.pnl) bestPick = { sym: pick.sym, pnl: pnlDelta, ts: snap.ts };
          if (!worstPick || pnlDelta < worstPick.pnl) worstPick = { sym: pick.sym, pnl: pnlDelta, ts: snap.ts };
        }
      });
    });
    const wr = trades > 0 ? (wins / trades * 100).toFixed(1) : '0.0';
    return { totalPnl: totalPnl.toFixed(3), wins, losses, trades, wr, bestPick, worstPick };
  }

  function renderScoreTracker() {
    const snaps = getSnapshots();
    el('st-count').textContent = snaps.length + ' snapshots stored (' + (snaps.length > 0 ? new Date(snaps[0].ts).toLocaleDateString() + ' - ' + new Date(snaps[snaps.length-1].ts).toLocaleDateString() : 'none') + ')';

    // Summary cards
    const wif = calcWhatIf(snaps);
    const pnlColor = parseFloat(wif.totalPnl) >= 0 ? 'var(--green)' : 'var(--red)';
    el('st-summary').innerHTML = `
      <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:14px;text-align:center">
        <div style="font-size:11px;color:var(--text-dim);text-transform:uppercase">Cumulative PnL</div>
        <div style="font-size:24px;font-weight:700;color:${pnlColor};margin-top:4px">${wif.totalPnl}%</div>
      </div>
      <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:14px;text-align:center">
        <div style="font-size:11px;color:var(--text-dim);text-transform:uppercase">Win Rate</div>
        <div style="font-size:24px;font-weight:700;color:var(--cyan);margin-top:4px">${wif.wr || '0.0'}%</div>
        <div style="font-size:11px;color:var(--text-dim)">${wif.wins}W / ${wif.losses}L / ${wif.trades} total</div>
      </div>
      <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:14px;text-align:center">
        <div style="font-size:11px;color:var(--text-dim);text-transform:uppercase">Best Pick</div>
        <div style="font-size:16px;font-weight:700;color:var(--green);margin-top:4px">${wif.bestPick ? wif.bestPick.sym + ' +' + wif.bestPick.pnl.toFixed(2) + '%' : 'N/A'}</div>
      </div>
      <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:14px;text-align:center">
        <div style="font-size:11px;color:var(--text-dim);text-transform:uppercase">Worst Pick</div>
        <div style="font-size:16px;font-weight:700;color:var(--red);margin-top:4px">${wif.worstPick ? wif.worstPick.sym + ' ' + wif.worstPick.pnl.toFixed(2) + '%' : 'N/A'}</div>
      </div>
    `;

    // Equity curve (text-based mini chart using Unicode blocks)
    if (snaps.length >= 2) {
      let cumPnl = 0;
      const curve = [];
      snaps.forEach((snap, idx) => {
        if (idx === 0) { curve.push(0); return; }
        const prev = snaps[idx - 1];
        let delta = 0;
        snap.picks.forEach(p => {
          const prevPick = prev.picks.find(pp => pp.sym === p.sym);
          if (prevPick) delta += (p.pnl - prevPick.pnl);
        });
        cumPnl += delta;
        curve.push(cumPnl);
      });
      const maxV = Math.max(...curve.map(Math.abs), 0.01);
      const barWidth = Math.max(2, Math.floor(600 / curve.length));
      const chartH = 120;
      const mid = chartH / 2;
      let svg = `<svg width="100%" height="${chartH}" viewBox="0 0 ${curve.length * barWidth} ${chartH}" preserveAspectRatio="none">`;
      svg += `<line x1="0" y1="${mid}" x2="${curve.length * barWidth}" y2="${mid}" stroke="#444" stroke-width="1"/>`;
      curve.forEach((v, i) => {
        const h = Math.abs(v) / maxV * (chartH / 2 - 4);
        const y = v >= 0 ? mid - h : mid;
        const color = v >= 0 ? '#4caf50' : '#f44336';
        svg += `<rect x="${i * barWidth}" y="${y}" width="${Math.max(1, barWidth - 1)}" height="${Math.max(1, h)}" fill="${color}" opacity="0.8"/>`;
      });
      svg += '</svg>';
      el('st-equity-chart').innerHTML = `<div style="font-size:12px;color:var(--text-dim);margin-bottom:8px">Cumulative PnL curve (each bar = one snapshot interval)</div>${svg}`;
    } else {
      el('st-equity-chart').innerHTML = '<div style="text-align:center;color:var(--text-dim);padding:40px">Need at least 2 snapshots to show equity curve. Check back in ~30 min.</div>';
    }

    // Timeline of snapshots
    const reversed = [...snaps].reverse();
    let html = '<div style="display:flex;flex-direction:column;gap:12px">';
    reversed.slice(0, 50).forEach(snap => {
      const dt = new Date(snap.ts);
      const timeStr = dt.toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', hour12: true });
      const avgScore = snap.picks.length ? (snap.picks.reduce((s, p) => s + p.score, 0) / snap.picks.length).toFixed(0) : 0;
      const avgPnl = snap.picks.length ? (snap.picks.reduce((s, p) => s + p.pnl, 0) / snap.picks.length).toFixed(2) : '0.00';
      const pnlC = parseFloat(avgPnl) >= 0 ? 'var(--green)' : 'var(--red)';
      html += `<div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:12px">`;
      html += `<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">`;
      html += `<span style="font-weight:600;font-size:13px;color:var(--text)">${timeStr}</span>`;
      html += `<span style="font-size:12px">Avg Score: <span style="color:var(--yellow);font-weight:600">${avgScore}</span> | Avg PnL: <span style="color:${pnlC};font-weight:600">${avgPnl}%</span></span>`;
      html += '</div>';
      html += '<div style="display:flex;flex-wrap:wrap;gap:6px">';
      snap.picks.forEach(p => {
        const pc = p.pnl >= 0 ? 'var(--green)' : 'var(--red)';
        const dirBg = (p.dir || '').toUpperCase().includes('SHORT') ? '#7c3aed33' : '#22c55e22';
        html += `<div style="background:${dirBg};border:1px solid var(--border);border-radius:6px;padding:4px 8px;font-size:11px;display:inline-flex;align-items:center;gap:4px" title="Strategy: ${p.strat}\nSystem: ${p.sys}\nTier: ${p.tier}\nEntry: ${p.entry}\nTP: ${p.tp} | SL: ${p.sl}">`;
        html += `<span style="font-weight:600">${p.sym}</span>`;
        html += `<span style="color:var(--text-dim)">${(p.dir || '?').substring(0, 1)}</span>`;
        html += `<span style="background:var(--bg);border-radius:3px;padding:0 4px;color:var(--yellow);font-weight:600">${p.score}</span>`;
        html += `<span style="color:${pc};font-weight:600">${p.pnl >= 0 ? '+' : ''}${p.pnl.toFixed(2)}%</span>`;
        html += '</div>';
      });
      html += '</div></div>';
    });
    if (reversed.length > 50) html += `<div style="text-align:center;color:var(--text-dim);font-size:12px">... and ${reversed.length - 50} more snapshots</div>`;
    html += '</div>';
    el('st-timeline').innerHTML = html;
  }

  // Wire up buttons
  el('st-clear').addEventListener('click', () => {
    if (confirm('Clear all score tracking history? This cannot be undone.')) {
      localStorage.removeItem(ST_KEY);
      renderScoreTracker();
    }
  });
  el('st-export').addEventListener('click', () => {
    const snaps = getSnapshots();
    let csv = 'snapshot_time,rank,symbol,direction,score,entry,tp,sl,pnl_pct,confidence,strategy,system,trust_tier\n';
    snaps.forEach(snap => {
      snap.picks.forEach((p, i) => {
        csv += `${snap.ts},${i+1},${p.sym},${p.dir},${p.score},${p.entry},${p.tp},${p.sl},${p.pnl},${p.conf},${p.strat},${p.sys},${p.tier}\n`;
      });
    });
    const blob = new Blob([csv], { type: 'text/csv' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = 'score_tracker_' + new Date().toISOString().slice(0,10) + '.csv';
    a.click(); URL.revokeObjectURL(url);
  });

  // Auto-snapshot after a short delay (let init() score everything first)
  setTimeout(() => {
    takeSnapshot();
    renderScoreTracker();
  }, 3000);

  // Re-render when switching to the tab
  document.querySelectorAll('[data-tab="scoretracker"]').forEach(btn => {
    btn.addEventListener('click', renderScoreTracker);
  });
})();
</script>

<!-- ══════════════════════════════════════════════════════════════════
     AI PICK ANALYSIS MODAL — Institutional-grade pick analysis
     ══════════════════════════════════════════════════════════════════ -->
<div id="ai-analysis-modal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;z-index:9999;background:rgba(0,0,0,0.75);backdrop-filter:blur(4px);overflow-y:auto">
  <div id="ai-analysis-content" style="max-width:720px;margin:40px auto;background:#0f172a;border:1px solid #334155;border-radius:12px;padding:0;box-shadow:0 8px 32px rgba(0,0,0,0.6);font-size:13px;color:#e2e8f0;line-height:1.5">
  </div>
</div>
<script>
(function() {
  // ── Store rendered picks for lookup ──
  window._renderedPicks = window._renderedPicks || [];

  const modal = document.getElementById('ai-analysis-modal');
  const content = document.getElementById('ai-analysis-content');

  // Close on backdrop click or Escape
  modal.addEventListener('click', e => { if (e.target === modal) modal.style.display = 'none'; });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') modal.style.display = 'none'; });

  // Delegate click on brain icons
  document.addEventListener('click', e => {
    const btn = e.target.closest('.ai-analyze-btn');
    if (!btn) return;
    e.stopPropagation();
    const pickId = btn.dataset.pickId;
    const pick = window._renderedPicks.find(p => (p.id || p.symbol + '_' + p.source_system) === pickId);
    if (!pick) return;
    content.innerHTML = generateAnalysis(pick);
    modal.style.display = 'block';
  });

  // ── Helper functions ──
  function fmt(v, d=2) { return v != null ? Number(v).toFixed(d) : '—'; }
  function fmtPct(v) { return v != null ? (v >= 0 ? '+' : '') + Number(v).toFixed(2) + '%' : '—'; }
  function pctColor(v) { return v > 0 ? '#22c55e' : v < 0 ? '#ef4444' : '#9ca3af'; }
  function tierColor(t) { return t === 'PROVEN' ? '#22c55e' : t === 'PROBATION' ? '#ef4444' : t === 'DEMOTED' ? '#f97316' : '#eab308'; }
  function tierBg(t) { return tierColor(t) + '22'; }

  function bar(pct, color) {
    const w = Math.min(100, Math.max(0, pct));
    return `<div style="flex:1;height:8px;background:#1e293b;border-radius:4px;overflow:hidden"><div style="width:${w}%;height:100%;background:${color || '#3b82f6'};border-radius:4px"></div></div>`;
  }

  function riskMeter(score) {
    const labels = ['Very Low', 'Low', 'Moderate', 'High', 'Very High'];
    const colors = ['#22c55e', '#84cc16', '#eab308', '#f97316', '#ef4444'];
    const idx = Math.min(4, Math.floor(score / 20));
    return `<span style="color:${colors[idx]};font-weight:600">${labels[idx]}</span>`;
  }

  // ── Find all picks for same symbol across all systems ──
  function findRelatedPicks(pick) {
    const sym = (pick.symbol || '').toUpperCase().replace(/-/g, '').replace(/USDT$|USD$/i, '');
    return (window._renderedPicks || []).filter(p => {
      const ps = (p.symbol || '').toUpperCase().replace(/-/g, '').replace(/USDT$|USD$/i, '');
      return ps === sym && p !== pick;
    });
  }

  // ── Get system stats from dashboard data ──
  function getSysStats(sysName) {
    if (!D.systems) return null;
    return D.systems.find(s => (s.name || '').toLowerCase().includes(sysName.toLowerCase()));
  }

  // ── Kelly Criterion ──
  function kellyFraction(winRate, avgWin, avgLoss) {
    if (!avgLoss || avgLoss === 0) return 0;
    const rr = Math.abs(avgWin / avgLoss);
    const f = (winRate * rr - (1 - winRate)) / rr;
    return Math.max(0, Math.min(0.25, f)); // cap at 25%
  }

  // ── Expected Value per trade ──
  function expectedValue(winRate, avgWin, avgLoss) {
    return (winRate * avgWin) - ((1 - winRate) * Math.abs(avgLoss));
  }

  // ── Data integrity assessment ──
  function getIntegrity(sys, sysName) {
    const issues = [];
    let level = 'VERIFIED';
    if (!sys || (sys.closed_picks || 0) < 5) { level = 'UNVERIFIED'; issues.push('Fewer than 5 closed trades'); }
    else if ((sys.closed_picks || 0) < 30) { level = 'LIMITED'; issues.push(`Only ${sys.closed_picks} trades — needs 30+ for confidence`); }

    const nm = sysName.toLowerCase();
    if (nm.includes('alpha_engine') && !nm.includes('fast')) issues.push('Simulated fills at exact TP/SL (slippage added Mar 14)');
    if (nm.includes('luxalgo')) { level = 'UNVERIFIED'; issues.push('All trades from single session (Mar 13)'); }
    if (nm.includes('crypto_ml_edge')) { level = 'UNVERIFIED'; issues.push('Zero closed picks — no verifiable history'); }
    if (nm.includes('battleground') && !nm.includes('revival')) issues.push('248 overlapping concurrent positions in history');
    if (nm.includes('mercury2') && !nm.includes('fast')) issues.push('PnL computed retroactively (was NULL until Mar 14)');

    if (sys && sys.closed_picks >= 50 && (sys.win_rate || 0) > 0) level = 'VERIFIED';
    return { level, issues };
  }

  // ── Main analysis generator ──
  function generateAnalysis(p) {
    const b = p._scoreBreakdown || {};
    const score = p.score || 0;
    const grade = score >= 80 ? 'A' : score >= 70 ? 'B' : score >= 55 ? 'C' : score >= 40 ? 'D' : 'F';
    const dir = (p.direction || '').toUpperCase();
    const entry = parseFloat(p.entry_price) || 0;
    const tp = parseFloat(p.take_profit) || 0;
    const sl = parseFloat(p.stop_loss) || 0;
    const conf = (p.confidence || 0);
    const age = p.age_hours || 0;
    const pnl = p.pnl_pct || 0;
    const sys = getSysStats(p.source_system || '');
    const related = findRelatedPicks(p);
    const integrity = getIntegrity(sys, p.source_system || '');
    const tier = p.trust_tier || 'SANDBOX';

    // Risk/reward
    let rrRatio = 0, upsidePct = 0, downsidePct = 0;
    if (entry && tp && sl) {
      upsidePct = Math.abs((tp - entry) / entry * 100);
      downsidePct = Math.abs((entry - sl) / entry * 100);
      rrRatio = downsidePct > 0 ? upsidePct / downsidePct : 0;
    }

    // Kelly & EV
    const wr = sys ? (sys.win_rate || 0) / 100 : 0.5;
    const avgWin = sys ? Math.abs(sys.avg_win || upsidePct || 3) : upsidePct || 3;
    const avgLoss = sys ? Math.abs(sys.avg_loss || downsidePct || 2) : downsidePct || 2;
    const kelly = kellyFraction(wr, avgWin, avgLoss);
    const ev = expectedValue(wr, avgWin, avgLoss);

    // Risk score (0-100, higher = riskier)
    let riskScore = 50;
    if (tier === 'PROBATION') riskScore += 20;
    if (tier === 'SANDBOX') riskScore += 10;
    if (integrity.level === 'UNVERIFIED') riskScore += 15;
    if (rrRatio < 1.5) riskScore += 10;
    if (age > 24) riskScore += 10;
    if (pnl < -2) riskScore += 15;
    if (conf < 0.5) riskScore += 10;
    if (dir === 'LONG' && typeof _marketRegime !== 'undefined' && _marketRegime === 'BEARISH') riskScore += 15;
    if (tier === 'PROVEN') riskScore -= 15;
    if (rrRatio > 2) riskScore -= 10;
    if (b.consensus >= 80) riskScore -= 10;
    riskScore = Math.max(0, Math.min(100, riskScore));

    // Consensus breakdown
    const provenAgree = related.filter(r => r.trust_tier === 'PROVEN' && (r.direction || '').toUpperCase() === dir);
    const sandboxAgree = related.filter(r => r.trust_tier !== 'PROVEN' && r.trust_tier !== 'PROBATION' && (r.direction || '').toUpperCase() === dir);
    const opposing = related.filter(r => (r.direction || '').toUpperCase() !== dir);

    // ── Build executive summary ──
    let summary = '';
    const sysName = (p.source_system || 'unknown').replace(/_/g, ' ');
    const stratName = (p.strategy || 'unknown').replace(/_/g, ' ');

    if (score >= 70) summary = `<strong>${p.symbol} ${dir}</strong> is a <span style="color:#22c55e">high-conviction</span> signal scoring ${score}/100 (Grade ${grade}).`;
    else if (score >= 55) summary = `<strong>${p.symbol} ${dir}</strong> is a <span style="color:#eab308">moderate-conviction</span> signal scoring ${score}/100 (Grade ${grade}).`;
    else summary = `<strong>${p.symbol} ${dir}</strong> is a <span style="color:#ef4444">low-conviction</span> signal scoring ${score}/100 (Grade ${grade}).`;

    summary += ` Generated by <strong>${sysName}</strong>`;
    if (sys && sys.closed_picks >= 10) summary += ` (${sys.closed_picks} trades, ${fmt(sys.win_rate,1)}% WR)`;
    summary += ` using the <em>${stratName}</em> strategy.`;

    if (provenAgree.length > 0) summary += ` <span style="color:#22c55e">${provenAgree.length} proven system${provenAgree.length>1?'s':''}</span> also ${dir === 'LONG' ? 'long' : 'short'} this asset.`;
    if (opposing.length > 0) summary += ` <span style="color:#ef4444">Warning: ${opposing.length} system${opposing.length>1?'s':''} have opposing signals.</span>`;

    // ── Score Explanation for profitable but low-scoring picks ──
    let scoreExplainHtml = '';
    const isProfitableButLow = pnl >= 2 && score < 55;
    if (isProfitableButLow) {
      const reasons = [];
      const crushers = []; // what's killing the score

      // Allocation tier penalty
      const at = p._allocTier;
      if (at && at.score_multiplier < 0.50) {
        const pctPenalty = Math.round((1 - at.score_multiplier) * 100);
        crushers.push({label: `${at.label} Tier`, penalty: `${pctPenalty}%`, detail: `Strategy forward-test WR is below threshold. ${at.promotion_path || ''}`});
      }

      // Trust tier penalty
      const trustW = p.trust_weight || 0.25;
      if (trustW < 0.50) {
        const pctPenalty = Math.round((1 - trustW) * 100);
        crushers.push({label: `${tier} Trust`, penalty: `${pctPenalty}%`, detail: `System has insufficient proven track record. Need 50+ trades with WR > 50% for higher trust.`});
      }

      // Signal insight penalty
      const si = p._signalInsight;
      if (si && (si.tier === 'DANGER' || si.tier === 'WARNING')) {
        crushers.push({label: `${si.label}`, penalty: si.tier === 'DANGER' ? '65%' : '35%', detail: si.detail || 'Historical performance below threshold.'});
      }

      // Time decay
      if (age > 48) {
        crushers.push({label: 'Time Decay', penalty: age > 72 ? '50%' : age > 48 ? '25-40%' : '10%', detail: `Pick is ${Math.round(age)}h old. Even profitable picks lose score over time as the entry opportunity passes.`});
      }

      // PnL floor active?
      const isPnlFloored = (pnl >= 3 && score <= 25) || (pnl >= 5 && score <= 35) || (pnl >= 10 && score <= 50);
      if (isPnlFloored) {
        reasons.push(`Score is at the PnL safety floor (${pnl >= 10 ? '50' : pnl >= 5 ? '35' : '25'}) — without this floor, the computed score would be near 0.`);
      }

      // Check if other systems scanned this symbol
      const otherSystems = related.filter(r => r.source_system !== p.source_system);
      const agreedSystems = otherSystems.filter(r => (r.direction||'').toUpperCase() === dir);
      const missedBy = [];
      const expectedSystems = ['super_signals', 'aggregated_picks', 'battleground', 'incubator_gainer', 'alpha_engine'];
      for (const es of expectedSystems) {
        const found = otherSystems.find(r => (r.source_system||'').includes(es));
        if (!found) missedBy.push(es.replace(/_/g,' '));
      }

      if (agreedSystems.length > 0) {
        reasons.push(`${agreedSystems.length} other system${agreedSystems.length>1?'s':''} agree (${agreedSystems.map(r=>(r.source_system||'').replace(/_/g,' ')).join(', ')}). A multi-system consensus pick would score significantly higher.`);
      }
      if (missedBy.length > 0) {
        reasons.push(`Not picked up by: ${missedBy.join(', ')}. If these systems also flagged this asset, consensus scoring would boost the score significantly.`);
      }

      // Build the explanation HTML
      scoreExplainHtml = `<div style="padding:16px 20px;border-bottom:1px solid #1e293b;background:linear-gradient(135deg,#1a1005,#0f172a)">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
          <span style="font-size:16px">&#x26A0;&#xFE0F;</span>
          <div style="font-size:12px;color:#fbbf24;text-transform:uppercase;letter-spacing:1px;font-weight:700">Why Low Score Despite +${fmt(pnl,1)}% Profit?</div>
        </div>
        <div style="color:#fde68a;font-size:12px;margin-bottom:12px">This pick is currently profitable but scores low because the scoring system evaluates <em>predictive reliability</em>, not just current P&L. The market is validating this trade, but the system behind it has a poor historical track record.</div>`;

      if (crushers.length > 0) {
        scoreExplainHtml += `<div style="font-size:11px;color:#9ca3af;margin-bottom:6px;font-weight:600">Score Crushers:</div>`;
        for (const c of crushers) {
          scoreExplainHtml += `<div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;font-size:11px">
            <span style="background:#ef444433;color:#fca5a5;border-radius:4px;padding:1px 6px;font-weight:700;min-width:45px;text-align:center">-${c.penalty}</span>
            <span style="color:#f8fafc;font-weight:600">${c.label}</span>
            <span style="color:#6b7280">— ${c.detail}</span>
          </div>`;
        }
      }

      if (reasons.length > 0) {
        scoreExplainHtml += `<div style="font-size:11px;color:#9ca3af;margin:8px 0 4px;font-weight:600">Context:</div>`;
        for (const r of reasons) {
          scoreExplainHtml += `<div style="font-size:11px;color:#94a3b8;margin-bottom:3px;padding-left:12px;border-left:2px solid #334155">${r}</div>`;
        }
      }

      scoreExplainHtml += `<div style="margin-top:10px;padding:8px 12px;background:#22c55e15;border:1px solid #22c55e33;border-radius:6px;font-size:11px;color:#86efac">
        <strong>Bottom line:</strong> The market says this trade is right (+${fmt(pnl,1)}%), but the system that generated it hasn't proven itself over enough trades. Consider this a <em>lucky hit until the system proves consistent</em>. If you trust the current price action, the trade is valid — but size accordingly.
      </div></div>`;
    }

    // ── Build HTML ──
    let html = '';

    // Header
    html += `<div style="padding:16px 20px;border-bottom:1px solid #334155;display:flex;justify-content:space-between;align-items:center">
      <div style="display:flex;align-items:center;gap:12px">
        <span style="font-size:24px">🧠</span>
        <div>
          <div style="font-size:18px;font-weight:700;color:#f8fafc">${p.symbol} <span style="background:${dir==='LONG'?'#22c55e33':'#ef444433'};color:${dir==='LONG'?'#22c55e':'#ef4444'};padding:2px 8px;border-radius:4px;font-size:13px">${dir}</span></div>
          <div style="font-size:11px;color:#64748b">AI Pick Analysis • ${new Date().toLocaleString('en-US', {timeZone:'America/New_York'})} EST</div>
        </div>
      </div>
      <div style="text-align:right">
        <div style="font-size:28px;font-weight:700;color:${score>=70?'#22c55e':score>=45?'#eab308':'#ef4444'}">${score}<span style="font-size:14px;opacity:0.7">/${100}</span></div>
        <div style="font-size:11px;color:#64748b">Grade ${grade} • ${tier}</div>
      </div>
    </div>`;

    // Executive Summary
    html += `<div style="padding:16px 20px;border-bottom:1px solid #1e293b;background:#0f172acc">
      <div style="font-size:11px;color:#64748b;text-transform:uppercase;letter-spacing:1px;margin-bottom:6px">Executive Summary</div>
      <div style="color:#cbd5e1">${summary}</div>
    </div>`;

    // Score Explanation (for profitable but low-scoring picks)
    if (scoreExplainHtml) html += scoreExplainHtml;

    // Risk/Reward Section
    html += `<div style="padding:16px 20px;border-bottom:1px solid #1e293b">
      <div style="font-size:11px;color:#64748b;text-transform:uppercase;letter-spacing:1px;margin-bottom:10px">Risk / Reward Analysis</div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:12px">
        <div style="background:#1e293b;border-radius:6px;padding:10px;text-align:center">
          <div style="font-size:10px;color:#64748b">Entry</div>
          <div style="font-size:16px;font-weight:600;color:#f8fafc">$${entry > 1 ? fmt(entry,2) : fmt(entry,6)}</div>
        </div>
        <div style="background:#1e293b;border-radius:6px;padding:10px;text-align:center">
          <div style="font-size:10px;color:#64748b">Take Profit</div>
          <div style="font-size:16px;font-weight:600;color:#22c55e">${tp ? '$'+(tp>1?fmt(tp,2):fmt(tp,6)) : '—'} <span style="font-size:11px">(+${fmt(upsidePct,1)}%)</span></div>
        </div>
        <div style="background:#1e293b;border-radius:6px;padding:10px;text-align:center">
          <div style="font-size:10px;color:#64748b">Stop Loss</div>
          <div style="font-size:16px;font-weight:600;color:#ef4444">${sl ? '$'+(sl>1?fmt(sl,2):fmt(sl,6)) : '—'} <span style="font-size:11px">(-${fmt(downsidePct,1)}%)</span></div>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:8px">
        <div style="background:#1e293b;border-radius:6px;padding:8px;text-align:center">
          <div style="font-size:10px;color:#64748b">R:R Ratio</div>
          <div style="font-size:14px;font-weight:600;color:${rrRatio>=2?'#22c55e':rrRatio>=1.5?'#eab308':'#ef4444'}">${fmt(rrRatio,2)}</div>
          <div style="font-size:9px;color:#475569">${rrRatio>=2?'Excellent':''}${rrRatio>=1.5&&rrRatio<2?'Acceptable':''}${rrRatio<1.5?'Below standard':''}</div>
        </div>
        <div style="background:#1e293b;border-radius:6px;padding:8px;text-align:center">
          <div style="font-size:10px;color:#64748b">Kelly Size</div>
          <div style="font-size:14px;font-weight:600;color:#3b82f6">${fmt(kelly*100,1)}%</div>
          <div style="font-size:9px;color:#475569">of portfolio</div>
        </div>
        <div style="background:#1e293b;border-radius:6px;padding:8px;text-align:center">
          <div style="font-size:10px;color:#64748b">Expected Value</div>
          <div style="font-size:14px;font-weight:600;color:${pctColor(ev)}">${fmtPct(ev)}</div>
          <div style="font-size:9px;color:#475569">per trade</div>
        </div>
        <div style="background:#1e293b;border-radius:6px;padding:8px;text-align:center">
          <div style="font-size:10px;color:#64748b">Risk Level</div>
          <div style="font-size:14px;font-weight:600">${riskMeter(riskScore)}</div>
          <div style="font-size:9px;color:#475569">${riskScore}/100</div>
        </div>
      </div>
      ${pnl !== 0 ? `<div style="margin-top:10px;padding:8px;background:${pnl<-2?'#ef444415':pnl>3?'#22c55e15':'#1e293b'};border-radius:6px;font-size:12px;color:${pctColor(pnl)}"><strong>Current P/L: ${fmtPct(pnl)}</strong>${pnl<-2?' — Entry has drifted significantly. Consider if entry is still valid.':pnl>5?' — Price has moved well past entry. Late entry carries chase risk.':''}</div>` : ''}
    </div>`;

    // Score Breakdown
    html += `<div style="padding:16px 20px;border-bottom:1px solid #1e293b">
      <div style="font-size:11px;color:#64748b;text-transform:uppercase;letter-spacing:1px;margin-bottom:10px">Score Breakdown</div>
      <div style="display:grid;gap:6px">
        ${[['Strategy Performance', b.strategy, 15], ['Signal Quality', b.signal, 15], ['Freshness', b.freshness, 10], ['Forward Performance', b.forward, 10], ['Consensus', b.consensus, 20], ['No Conflict', b.noConflict, 5], ['Live PnL', b.livePnl, 20], ['Timeframe', b.timeframe, 5]].map(([label, val, weight]) => {
          const v = val || 0;
          const c = v >= 70 ? '#22c55e' : v >= 45 ? '#eab308' : '#ef4444';
          return `<div style="display:flex;align-items:center;gap:8px"><span style="width:130px;font-size:11px;color:#94a3b8;text-align:right">${label} <span style="color:#475569">(${weight}%)</span></span>${bar(v, c)}<span style="width:30px;font-size:12px;font-weight:600;color:${c}">${Math.round(v)}</span></div>`;
        }).join('')}
      </div>
    </div>`;

    // System Consensus Panel
    const allDir = related.filter(r => (r.direction||'').toUpperCase() === dir);
    html += `<div style="padding:16px 20px;border-bottom:1px solid #1e293b">
      <div style="font-size:11px;color:#64748b;text-transform:uppercase;letter-spacing:1px;margin-bottom:10px">System Consensus</div>
      <div style="display:flex;gap:12px;margin-bottom:10px;flex-wrap:wrap">
        <div style="background:#22c55e15;border:1px solid #22c55e40;border-radius:6px;padding:6px 12px;font-size:12px"><span style="color:#22c55e;font-weight:600">${provenAgree.length + (tier==='PROVEN'?1:0)}</span> <span style="color:#94a3b8">Proven</span></div>
        <div style="background:#eab30815;border:1px solid #eab30840;border-radius:6px;padding:6px 12px;font-size:12px"><span style="color:#eab308;font-weight:600">${sandboxAgree.length + (tier!=='PROVEN'&&tier!=='PROBATION'?1:0)}</span> <span style="color:#94a3b8">Sandbox</span></div>
        ${opposing.length > 0 ? `<div style="background:#ef444415;border:1px solid #ef444440;border-radius:6px;padding:6px 12px;font-size:12px"><span style="color:#ef4444;font-weight:600">${opposing.length}</span> <span style="color:#94a3b8">Opposing</span></div>` : ''}
        <div style="background:#3b82f615;border:1px solid #3b82f640;border-radius:6px;padding:6px 12px;font-size:12px"><span style="color:#3b82f6;font-weight:600">${allDir.length + 1}</span> <span style="color:#94a3b8">Total agreeing</span></div>
      </div>`;

    // Per-system breakdown table
    if (allDir.length > 0 || opposing.length > 0) {
      const allRelated = [...allDir, ...opposing].sort((a,b) => {
        const ta = a.trust_tier === 'PROVEN' ? 0 : a.trust_tier === 'PROBATION' ? 2 : 1;
        const tb = b.trust_tier === 'PROVEN' ? 0 : b.trust_tier === 'PROBATION' ? 2 : 1;
        return ta - tb;
      });
      html += `<div style="font-size:11px;color:#64748b;margin-bottom:6px">Per-system signals for ${p.symbol}:</div>`;
      html += `<table style="width:100%;font-size:11px;border-collapse:collapse">
        <thead><tr style="color:#64748b;border-bottom:1px solid #1e293b">
          <th style="text-align:left;padding:4px">System</th><th>Tier</th><th>Dir</th><th>Entry</th><th>Conf</th><th>Strategy</th><th title="Strategy-specific forward-tested trade count (not system-wide)">Strat Trades</th><th title="Strategy-specific forward win rate (not system-wide). Based on closed trades for THIS strategy.">Strat WR</th>
        </tr></thead><tbody>`;
      // Include the current pick's own system first
      const curSys = getSysStats(p.source_system || '');
      // Per-strategy WR: prefer strat_fwd_wr (enriched by generator), fallback to forward_wr on pick, then system WR
      const pStratTrades = p.strat_fwd_trades || p.forward_trades || null;
      const pStratWr = p.strat_fwd_wr ?? p.forward_wr ?? null;
      const pStratWrDisplay = pStratWr != null ? `<span style="color:${pStratWr>=60?'#22c55e':pStratWr>=50?'#fbbf24':'#ef4444'};font-weight:600">${fmt(pStratWr,1)}%</span>` : (curSys ? `<span style="color:#64748b" title="System-wide WR (no strategy-specific data)">${fmt(curSys.win_rate,1)}%*</span>` : '—');
      html += `<tr style="border-bottom:1px solid #1e293b22;background:#1e293b44">
        <td style="padding:4px;font-weight:600">${sysName} <span style="font-size:9px;color:#64748b">(this pick)</span></td>
        <td style="text-align:center"><span style="color:${tierColor(tier)};font-size:10px;font-weight:600">${tier}</span></td>
        <td style="text-align:center;color:${dir==='LONG'?'#22c55e':'#ef4444'}">${dir}</td>
        <td style="text-align:center">$${entry>1?fmt(entry,2):fmt(entry,6)}</td>
        <td style="text-align:center">${fmt(conf,2)}</td>
        <td style="font-size:10px">${stratName}</td>
        <td style="text-align:center">${pStratTrades || '—'}</td>
        <td style="text-align:center">${pStratWrDisplay}</td>
      </tr>`;
      allRelated.slice(0, 15).forEach(r => {
        const rDir = (r.direction||'').toUpperCase();
        const rSys = getSysStats(r.source_system || '');
        const isOpposing = rDir !== dir;
        // Per-strategy WR for related picks
        const rStratTrades = r.strat_fwd_trades || r.forward_trades || null;
        const rStratWr = r.strat_fwd_wr ?? r.forward_wr ?? null;
        const rStratWrDisplay = rStratWr != null ? `<span style="color:${rStratWr>=60?'#22c55e':rStratWr>=50?'#fbbf24':'#ef4444'};font-weight:600">${fmt(rStratWr,1)}%</span>` : (rSys ? `<span style="color:#64748b" title="System-wide WR (no strategy-specific data)">${fmt(rSys.win_rate,1)}%*</span>` : '—');
        html += `<tr style="border-bottom:1px solid #1e293b22;${isOpposing?'background:#ef444410':''}">
          <td style="padding:4px">${(r.source_system||'').replace(/_/g,' ')}</td>
          <td style="text-align:center"><span style="color:${tierColor(r.trust_tier||'SANDBOX')};font-size:10px;font-weight:600">${r.trust_tier||'SANDBOX'}</span></td>
          <td style="text-align:center;color:${rDir==='LONG'?'#22c55e':'#ef4444'}">${rDir}${isOpposing?' ⚠️':''}</td>
          <td style="text-align:center">${r.entry_price ? '$'+(parseFloat(r.entry_price)>1?fmt(parseFloat(r.entry_price),2):fmt(parseFloat(r.entry_price),6)) : '—'}</td>
          <td style="text-align:center">${fmt(r.confidence,2)}</td>
          <td style="font-size:10px">${(r.strategy||'').replace(/_/g,' ')}</td>
          <td style="text-align:center">${rStratTrades || '—'}</td>
          <td style="text-align:center">${rStratWrDisplay}</td>
        </tr>`;
      });
      html += `</tbody></table>`;
    } else {
      html += `<div style="color:#64748b;font-size:12px;font-style:italic">No other systems have active signals for ${p.symbol}.</div>`;
    }
    html += `</div>`;

    // Market Context
    const regime = typeof _marketRegime !== 'undefined' ? _marketRegime : 'UNKNOWN';
    const regimeColor = regime === 'BULLISH' ? '#22c55e' : regime === 'BEARISH' ? '#ef4444' : '#eab308';
    const directionMismatch = (regime === 'BEARISH' && dir === 'LONG') || (regime === 'BULLISH' && dir === 'SHORT');
    html += `<div style="padding:16px 20px;border-bottom:1px solid #1e293b">
      <div style="font-size:11px;color:#64748b;text-transform:uppercase;letter-spacing:1px;margin-bottom:10px">Market Context</div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px">
        <div style="background:#1e293b;border-radius:6px;padding:8px">
          <div style="font-size:10px;color:#64748b">Market Regime</div>
          <div style="font-size:13px;font-weight:600;color:${regimeColor}">${regime}</div>
        </div>
        <div style="background:#1e293b;border-radius:6px;padding:8px">
          <div style="font-size:10px;color:#64748b">Direction Alignment</div>
          <div style="font-size:13px;font-weight:600;color:${directionMismatch?'#ef4444':'#22c55e'}">${directionMismatch?'⚠️ MISALIGNED':'✓ Aligned'}</div>
        </div>
        <div style="background:#1e293b;border-radius:6px;padding:8px">
          <div style="font-size:10px;color:#64748b">Signal Age</div>
          <div style="font-size:13px;font-weight:600;color:${age<=1?'#22c55e':age<=4?'#84cc16':age<=12?'#eab308':'#ef4444'}">${age < 1 ? Math.round(age*60)+'m' : fmt(age,1)+'h'}</div>
        </div>
      </div>
      ${directionMismatch ? `<div style="margin-top:8px;padding:8px;background:#ef444415;border:1px solid #ef444440;border-radius:6px;font-size:12px;color:#fca5a5"><strong>⚠️ Regime Warning:</strong> Going ${dir} in a ${regime} market increases risk. Consider reduced position size or tighter stops.</div>` : ''}
      ${typeof isMeme === 'function' && isMeme(p.symbol) ? `<div style="margin-top:8px;padding:8px;background:#f59e0b15;border:1px solid #f59e0b40;border-radius:6px;font-size:12px;color:#fbbf24"><strong>⚡ Meme Coin:</strong> High volatility, thin liquidity, vulnerable to social media sentiment. Wider stops and smaller position size recommended.</div>` : ''}
    </div>`;

    // Data Integrity
    const intColor = integrity.level === 'VERIFIED' ? '#22c55e' : integrity.level === 'LIMITED' ? '#eab308' : '#ef4444';
    html += `<div style="padding:16px 20px;border-bottom:1px solid #1e293b">
      <div style="font-size:11px;color:#64748b;text-transform:uppercase;letter-spacing:1px;margin-bottom:10px">Data Integrity</div>
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
        <span style="background:${intColor}22;color:${intColor};border:1px solid ${intColor}40;padding:3px 10px;border-radius:4px;font-weight:700;font-size:12px">${integrity.level === 'VERIFIED' ? '✓ VERIFIED' : integrity.level === 'LIMITED' ? '⚠ LIMITED SAMPLE' : '✗ UNVERIFIED'}</span>
        ${sys ? `<span style="font-size:11px;color:#64748b">${sys.closed_picks || 0} closed trades on record</span>` : ''}
      </div>
      ${integrity.issues.length > 0 ? `<ul style="margin:0;padding-left:16px;font-size:11px;color:#94a3b8">${integrity.issues.map(i => `<li style="margin:2px 0">${i}</li>`).join('')}</ul>` : ''}
    </div>`;

    // Max drawdown scenario
    html += `<div style="padding:16px 20px;border-bottom:1px solid #1e293b">
      <div style="font-size:11px;color:#64748b;text-transform:uppercase;letter-spacing:1px;margin-bottom:10px">Worst-Case Scenario</div>
      <div style="font-size:12px;color:#cbd5e1">
        <strong>Max loss on this trade:</strong> <span style="color:#ef4444">-${fmt(downsidePct,1)}%</span> of position (SL hit)<br>
        <strong>If Kelly-sized (${fmt(kelly*100,1)}% of portfolio):</strong> <span style="color:#ef4444">-${fmt(downsidePct * kelly,2)}%</span> portfolio impact<br>
        ${sys && sys.max_drawdown ? `<strong>System historical max drawdown:</strong> <span style="color:#ef4444">${fmt(sys.max_drawdown,1)}%</span><br>` : ''}
        <strong>Recovery trades needed after SL:</strong> ~${Math.ceil(downsidePct / (ev > 0 ? ev : 1))} winning trades at current EV
      </div>
    </div>`;

    // Disclaimer
    html += `<div style="padding:12px 20px;background:#1e293b44;font-size:10px;color:#475569;border-radius:0 0 12px 12px">
      <strong>Disclaimer:</strong> This analysis is generated from historical system performance data and does not constitute financial advice. Past performance does not guarantee future results. All metrics are computed from self-reported system data${integrity.level === 'VERIFIED' ? ' that has been cross-verified against market prices' : ''}. Position sizing suggestions assume independent, uncorrelated trades.
      <div style="margin-top:4px;text-align:right"><button onclick="document.getElementById('ai-analysis-modal').style.display='none'" style="background:#334155;color:#94a3b8;border:none;border-radius:4px;padding:4px 12px;cursor:pointer;font-size:11px">Close</button></div>
    </div>`;

    return html;
  }

  window.generateAnalysis = generateAnalysis;
})();
</script>
<script>
// === EXCEL/CSV EXPORT ===
function exportTableToExcel(tableEl, filename) {
    if (typeof tableEl === 'string') tableEl = document.getElementById(tableEl) || document.querySelector(tableEl);
    if (!tableEl) { alert('No table found'); return; }
    const rows = tableEl.querySelectorAll('tr');
    let csv = '';
    rows.forEach(row => {
        if (row.classList.contains('filter-row')) return;
        const cells = row.querySelectorAll('th, td');
        const vals = Array.from(cells).map(c => {
            let t = c.innerText.replace(/,/g, '').replace(/\n/g, ' ').replace(/"/g, "'").trim();
            return '"' + t + '"';
        });
        csv += vals.join(',') + '\n';
    });
    const blob = new Blob(['\ufeff' + csv], {type: 'text/csv;charset=utf-8;'});
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = (filename || 'audit_export') + '_' + new Date().toISOString().slice(0,10) + '.csv';
    link.click();
}

// Add export buttons + sortable headers + column filters to all major tables
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('table').forEach((table, idx) => {
        if (table.querySelectorAll('tr').length < 3) return;

        // --- Export CSV button ---
        const btn = document.createElement('button');
        btn.innerHTML = '\ud83d\udcca Export CSV';
        btn.title = 'Export this table to CSV/Excel';
        btn.style.cssText = 'background:#217346;color:white;border:none;padding:4px 10px;border-radius:4px;cursor:pointer;font-size:0.8em;margin-bottom:6px;float:right;';
        btn.onclick = function() { exportTableToExcel(table, 'audit_table_' + idx); };
        if (table.parentElement) {
            table.parentElement.insertBefore(btn, table);
        }

        // --- Sortable column headers ---
        const headers = table.querySelectorAll('thead > tr:first-child > th');
        if (headers.length < 2) return;

        headers.forEach((th, colIdx) => {
            th.style.cursor = 'pointer';
            th.style.userSelect = 'none';
            th.title = (th.title ? th.title + ' | ' : '') + 'Click to sort';

            th.addEventListener('click', function() {
                const tbody = table.querySelector('tbody') || table;
                const rows = Array.from(tbody.querySelectorAll('tr')).filter(r => r.querySelectorAll('td').length > 0);
                if (rows.length === 0) return;

                const asc = this.dataset.sortDir !== 'asc';
                this.dataset.sortDir = asc ? 'asc' : 'desc';

                headers.forEach(h => {
                    if (h !== this) {
                        delete h.dataset.sortDir;
                        h.textContent = h.textContent.replace(/ [\u25B2\u25BC]/g, '');
                    }
                });
                this.textContent = this.textContent.replace(/ [\u25B2\u25BC]/g, '') + (asc ? ' \u25B2' : ' \u25BC');

                rows.sort((a, b) => {
                    const aText = (a.cells[colIdx]?.textContent || '').trim();
                    const bText = (b.cells[colIdx]?.textContent || '').trim();
                    const aNum = parseFloat(aText.replace(/[^0-9.\-]/g, ''));
                    const bNum = parseFloat(bText.replace(/[^0-9.\-]/g, ''));
                    if (!isNaN(aNum) && !isNaN(bNum)) {
                        return asc ? aNum - bNum : bNum - aNum;
                    }
                    return asc ? aText.localeCompare(bText) : bText.localeCompare(aText);
                });

                rows.forEach(r => tbody.appendChild(r));
            });
        });

        // --- Column filter inputs ---
        if (headers.length < 3) return;
        if (table.querySelectorAll('tr').length < 5) return;

        const filterRow = document.createElement('tr');
        filterRow.className = 'filter-row';
        headers.forEach((th, colIdx) => {
            const td = document.createElement('th');
            td.style.padding = '2px';
            const input = document.createElement('input');
            input.type = 'text';
            input.placeholder = 'Filter...';
            input.style.cssText = 'width:90%;padding:2px 4px;background:#1a1a2e;color:#ccc;border:1px solid #333;border-radius:3px;font-size:0.75em;';
            input.addEventListener('click', function(e) { e.stopPropagation(); });
            input.addEventListener('input', function() {
                const val = this.value.toLowerCase();
                const tbody = table.querySelector('tbody') || table;
                tbody.querySelectorAll('tr').forEach(row => {
                    if (row.classList.contains('filter-row')) return;
                    if (row.querySelectorAll('td').length === 0) return;
                    const cell = row.cells[colIdx];
                    if (!cell) return;
                    const match = cell.textContent.toLowerCase().includes(val);
                    row.style.display = (val === '' || match) ? '' : 'none';
                });
            });
            td.appendChild(input);
            filterRow.appendChild(td);
        });

        const thead = table.querySelector('thead');
        if (thead) {
            thead.appendChild(filterRow);
        } else if (headers[0]?.parentElement) {
            headers[0].parentElement.parentElement.insertBefore(filterRow, headers[0].parentElement.nextSibling);
        }
    });
});
</script>
<div style="position:fixed;bottom:0;left:0;right:0;background:rgba(10,10,18,0.95);border-top:1px solid #2a2a4a;padding:6px 16px;font-size:11px;color:#888;text-align:center;z-index:9999;backdrop-filter:blur(4px);">
  <strong style="color:#f59e0b;">Disclaimer:</strong> This is <strong>NOT financial advice</strong>. All trading signals, picks, scores, and analysis are for <strong>educational and research purposes only</strong>. Past performance does not guarantee future results. Trading cryptocurrencies involves substantial risk of loss. Always do your own research (DYOR) before making any investment decisions.
</div>
</body>
</html>
