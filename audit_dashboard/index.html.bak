// These systems are HARD-BLOCKED — their picks are completely hidden from all views.
// Added Mar 13 2026 based on full system audit.
const BLOCKED_SYSTEMS = new Set([
  'mercury2_fast',          // 14 trades, 25% WR, -639% PnL, PF 0.02
