const sysDescriptions = {
  'alpha_engine': 'Proven Underdog Portfolio. 100 statistically-validated strategies (Connors RSI-2 75% WR, VIX Spike 72% WR). Scans crypto, forex, equities every 30 min.',
  'alpha_engine_fast': 'Alpha Engine with tighter TP/SL and shorter hold periods for more frequent signals. Same proven strategies, faster exits.',
  'battleground': 'Forward-testing arena. Runs proven winners (VWAP Deviation +332%, RSI ETH +291%) against live market. Gold standard for validation.',
  'kimi_riseoftheclaw': 'KIMI v11.0 — 81 algorithm scanner. Includes crypto acceleration, proven research-backed strategies, ML signal ranking, and elimination engine. Runs every 15 min.',
  'kimi_live_signals': 'KIMI real-time signal feed. Raw live_signals_now.json output from the 81-algorithm scanner. May overlap with kimi_riseoftheclaw active picks.',
  'kimi_signal_tracking': 'KIMI historical signal audit log. Tracks TP/SL validation against real Binance prices via signal_tracker.py.',
  'mercury2': 'Mercury2 XGBoost ML ensemble. Gradient-boosted tree model trained on 100+ technical features. Targets crypto momentum with ML confidence scoring.',
  'mercury2_fast': 'Mercury2 fast variant with shorter timeframes. WARNING: Has shown broken entry prices ($1M+) — on probation.',
  'paper_trading': 'Paper trading portfolio manager. Simulates real trades with virtual capital, tracks equity curves and drawdowns.',
  'crypto_signal_engine': 'Multi-model crypto signal engine. Combines XGBoost day-trade, LightGBM top-gainer, and ML ensemble models.',
  'genetic_programmer': 'DARWIN GP Engine (GENESIS). Evolves trading strategies using genetic programming — buy/sell formulas are expression trees that mutate and crossover. Population of 40, 10+ generations.',
  'audit_ensemble': 'DARWIN Audit Ensemble (NEXUS). Evolves meta-weights for combining audit scores across systems. Optimizes how much to trust each system based on forward performance.',
  'mape_evolver': 'DARWIN MAP-Elites (ATLAS). Quality-Diversity evolution — fills a grid of (volatility x trend) niches with the best strategy for each market condition. Ensures diverse strategies, not just one dominant one.',
  'ensemble_evolver': 'DARWIN Ensemble Coevolution (LEGION). Co-evolves teams of strategies that complement each other. Optimizes portfolio-level metrics (Sharpe, drawdown) not individual signals.',
  'neat_neural': 'DARWIN NEAT Neural Evolution. NeuroEvolution of Augmenting Topologies — evolves neural network topology AND weights simultaneously. Grows network complexity as needed.',
  'hyperparam_dna': 'DARWIN Hyperparameter DNA. Evolves optimal indicator parameters (RSI period, EMA length, ATR multiplier) using genetic algorithms instead of grid search.',
  'failure_evolver': 'DARWIN Failure Evolver. Learns specifically from LOSING picks. Mutates failed strategies to find what went wrong and evolve corrections.',
  'momentum_evolver': 'DARWIN Momentum Evolver. Specialized GP focused on momentum/trend signals. Evolves buy/sell rules optimized for trending markets.',
  'multitf_evolver': 'DARWIN Multi-Timeframe Evolver. Evolves strategies that combine signals across 1h, 4h, 1d timeframes. Higher timeframe confirmation for lower timeframe entries.',
  'contrarian_evolver': 'DARWIN Contrarian Evolver. GP evolved for mean-reversion/contrarian signals. Optimized for oversold bounces and overbought reversals.',
  'ml_bg_system_a': 'ML Battleground System A — Filter-based ML. Applies layered filters (volume, volatility, trend) before ML prediction. Most conservative ML approach.',
  'ml_bg_system_b': 'ML Battleground System B — Regime Detection. Uses Hidden Markov Model to detect market regimes (trending/ranging/volatile) and gates signals accordingly.',
  'ml_bg_system_c': 'ML Battleground System C — Deep Learning. LSTM + attention-based neural network for sequence prediction. WARNING: 0% WR across 5 trades — on probation.',
  'ml_bg_system_d': 'ML Battleground System D — Carry Trade. ML model for identifying carry trade opportunities (funding rate arbitrage). Currently disabled.',
  'ml_bg_system_e': 'ML Battleground System E — Momentum ML. Gradient-boosted momentum classifier. Currently disabled.',
  'ml_bg_system_f': 'ML Battleground System F — Claws of Doom. Proprietary multi-factor ML combining KIMI signals with battleground validation.',
  'ml_bg_ensemble': 'ML Battleground Ensemble — combines predictions from Systems A-F using weighted voting. Only fires when multiple ML systems agree.',
  'breakout_a_sr': 'Breakout Arena A — Pure Support/Resistance. Identifies key S/R levels from price structure and trades breakouts with ATR-based confirmation.',
