function _buildPickReason(p) {
  const parts = [];
  const reason = p.reason || p.signal_reason || p.entry_reason || '';
  if (reason) parts.push('ENTRY: ' + reason);
  const strat = (p.strategy || '').toLowerCase();
  for (const [key, desc] of Object.entries(_STRATEGY_DESCRIPTIONS)) {
    if (strat.includes(key.toLowerCase())) { parts.push('STRATEGY: ' + desc); break; }
  }
  const trust = getTrustTier(p);
  if (trust && trust.tier) parts.push('TRUST: ' + trust.tier + ' (' + (trust.reason || '') + ')');
  if (p.forward_wr != null) {
    const fwdWR = (p.forward_wr > 1 ? p.forward_wr : p.forward_wr * 100).toFixed(1);
    parts.push('FORWARD: ' + fwdWR + '% WR on ' + (p.forward_trades || '?') + ' trades' + (p.forward_validated ? ' (VALIDATED)' : ' (unvalidated)'));
  }
  const cs = p.confluence_strategies || [];
  if (cs.length > 0) {
    const csDescs = cs.map(s => {
      const sl = s.toLowerCase();
      for (const [key, desc] of Object.entries(_STRATEGY_DESCRIPTIONS)) {
        if (sl.includes(key.toLowerCase())) return s + ': ' + desc.split('.')[0];
      }
      return s;
    });
    parts.push('CONFLUENCE (' + cs.length + ' strategies agree): ' + csDescs.join(' | '));
  }
  const sys = (p.source_system || '').toLowerCase();
  for (const [key, desc] of Object.entries(_SYSTEM_DESCRIPTIONS)) {
    if (sys.includes(key.toLowerCase())) { parts.push('SYSTEM: ' + desc); break; }
  }
  return parts.join(' /// ') || 'No entry reason available';
}

// ── Comprehensive audit-trail builders for Excel export ──

function _buildScoreBreakdown(p, scoreResult) {
  // Returns plain English breakdown of every scoring component
  const b = scoreResult.breakdown;
  const parts = [];
  // 1. Strategy component
  const fwdWr = p.strat_fwd_wr ?? 0;
  const health = p.strat_health || 'unknown';
  parts.push(`Strategy: ${b.strategy}/100 (fwd WR=${fwdWr.toFixed(1)}%, health=${health}${b.csr != null ? ', CSR=' + b.csr.toFixed(2) : ''}${b.csrMult !== 100 ? ', CSR mult=' + b.csrMult + '%' : ''}) × 20%`);
  // 2. Signal component
  const conf = ((p.confidence ?? 0) * 100).toFixed(0);
  const entry = parseFloat(p.entry_price) || 0;
  const tp = parseFloat(p.take_profit) || 0;
  const sl = parseFloat(p.stop_loss) || 0;
  let rrVal = 'N/A';
  if (entry && tp && sl) rrVal = (Math.abs(tp - entry) / (Math.abs(entry - sl) || 1)).toFixed(2);
  parts.push(`Signal: ${b.signal}/100 (confidence=${conf}%, R:R=${rrVal}) × 15%`);
  // 3. Freshness
  const age = (p.age_hours ?? 999).toFixed(1);
  const pickPnl = (p.pnl_pct ?? 0).toFixed(2);
  const freshBranch = parseFloat(pickPnl) > 0 ? 'profitable-slow-decay' : 'losing-fast-decay';
  parts.push(`Freshness: ${b.freshness}/100 (age=${age}h, PnL=${pickPnl}%, mode=${freshBranch}) × 10%`);
  // 4. Forward
  let fwdDetail = 'no system data';
  if (D.systems) {
    const sys = D.systems.find(s => s.name === p.source_system);
    if (sys && sys.closed_picks >= 5) fwdDetail = `sys WR=${(sys.win_rate||0).toFixed(1)}%, PF=${(sys.profit_factor||0).toFixed(2)}, ${sys.closed_picks} trades`;
    else if (sys) fwdDetail = `only ${sys.closed_picks} trades (need 5+)`;
  }
  parts.push(`Forward: ${b.forward}/100 (${fwdDetail}) × 20%`);
  // 5. Consensus
  const agree = p.agreement_count || 0;
  parts.push(`Consensus: ${b.consensus}/100 (${agree} systems agree) × 15%`);
  // 6. No-conflict
  let conflictDetail = 'no conflict';
  if (p.has_conflict && p._conflictInfo) {
    const myC = p._conflictInfo.myDirCount || 1;
    const oppC = p._conflictInfo.opposing || 0;
    conflictDetail = `${myC} same dir vs ${oppC} opposing (${(myC/(myC+oppC)*100).toFixed(0)}% agreement)`;
  }
  parts.push(`NoConflict: ${b.noConflict}/100 (${conflictDetail}) × 5%`);
  // 7. Live PnL
  parts.push(`LivePnL: ${b.livePnl}/100 (current PnL=${pickPnl}%) × 15%`);
  // 8. Raw total
  const rawTotal = Math.round(b.strategy*0.20 + b.signal*0.15 + b.freshness*0.10 + b.forward*0.20 + b.consensus*0.15 + b.noConflict*0.05 + b.livePnl*0.15);
  parts.push(`--- Raw weighted total: ${rawTotal}/100`);
  // 9. Multipliers
  const trust = getTrustTier(p);
  parts.push(`Trust: ${trust.tier} ${(trust.w).toFixed(2)}x (${trust.reason || 'default'})`);
  parts.push(`Time decay: ${b.timeDecay}% (age=${age}h)`);
  const dir = (p.direction || '').toUpperCase();
  const regime = typeof _marketRegime !== 'undefined' ? _marketRegime : 'UNKNOWN';
  parts.push(`Direction bias: ${b.dirPenalty}% (${dir} in ${regime} market)`);
  parts.push(`Entry drift: ${b.entryDrift}% (PnL=${pickPnl}%)`);
  parts.push(`Insight mult: ${b.insightMult}%${p._allocTier ? ' (alloc tier ' + p._allocTier.tier + ')' : p._signalInsight ? ' (insight ' + p._signalInsight.tier + ')' : ''}`);
  parts.push(`Consensus mult: ${b.consensusMult}%`);
  // Regime sentinel
  if (b.regimeLabel) parts.push(`Regime sentinel: ${b.regimeLabel}, adj=${b.regimeAdj}%`);
  // PnL floor
  if (b.pnlFloor === 'active') parts.push(`PnL floor: ACTIVE (profitable pick gets minimum score protection)`);
  // Final
  parts.push(`=== FINAL SCORE: ${scoreResult.score}/100`);
  return parts.join(' | ');
}

function _buildDirectionReason(p) {
  // Explain WHY this direction was chosen
  const dir = (p.direction || '').toUpperCase();
  const parts = [];
  const reason = p.reason || p.signal_reason || p.entry_reason || '';
  // Extract direction clues from reason
  if (reason) {
    const r = reason.toLowerCase();
    if (r.includes('rsi') && r.match(/rsi[^0-9]*([<>]=?\s*\d+)/i)) parts.push('RSI condition: ' + r.match(/rsi[^0-9]*([<>]=?\s*\d+)/i)[0]);
    if (r.includes('ema') || r.includes('sma') || r.includes('ma ')) parts.push('MA signal detected in entry criteria');
    if (r.includes('bullish') || r.includes('bearish')) parts.push(r.includes('bullish') ? 'Bullish signal' : 'Bearish signal');
    if (r.includes('oversold')) parts.push('Oversold condition detected');
    if (r.includes('overbought')) parts.push('Overbought condition detected');
    if (r.includes('breakout')) parts.push('Breakout detected');
    if (r.includes('fear')) parts.push('Fear/Greed extreme');
    if (r.includes('funding')) parts.push('Funding rate signal');
    if (r.includes('divergence')) parts.push('Divergence signal');
  }
  // From strategy name
  const strat = (p.strategy || '').toLowerCase();
  if (strat.includes('fear_greed') || strat.includes('extreme_fear')) parts.push('Extreme Fear Contrarian — buy when others panic');
  if (strat.includes('funding_rate')) parts.push('Funding rate imbalance — overleveraged traders create opportunity');
  if (strat.includes('momentum') || strat.includes('breakout')) parts.push('Momentum/breakout strategy — following trend continuation');
  if (strat.includes('reversion') || strat.includes('mean_rev')) parts.push('Mean reversion — price expected to revert to average');
  if (strat.includes('squeeze')) parts.push('Volatility squeeze — compressed range about to expand');
  if (strat.includes('divergence')) parts.push('Price-indicator divergence — hidden signal of reversal');
  // Consensus direction
  const agree = p.agreement_count || 0;
  if (agree >= 3) parts.push(`${agree} independent systems all agree on ${dir}`);
  else if (agree >= 2) parts.push(`${agree} systems confirm ${dir} direction`);
  // Regime context
  const regime = typeof _marketRegime !== 'undefined' ? _marketRegime : '';
  if (regime) {
    if (regime === 'BULLISH' && (dir === 'LONG' || dir === 'BUY')) parts.push('Direction aligns with BULLISH market regime (+10% boost)');
    else if (regime === 'BULLISH' && (dir === 'SHORT' || dir === 'SELL')) parts.push('WARNING: Shorting in BULLISH regime (-40% penalty)');
    else if (regime === 'BEARISH' && (dir === 'LONG' || dir === 'BUY')) parts.push('WARNING: Longing in BEARISH regime (-35% penalty)');
    else if (regime === 'BEARISH' && (dir === 'SHORT' || dir === 'SELL')) parts.push('Direction aligns with BEARISH market regime (+10% boost)');
    else if (regime === 'CHOPPY') parts.push('CHOPPY regime — reduced conviction either direction');
  }
  return parts.join('; ') || `${dir} — direction set by strategy signal (no detailed criteria available)`;
}

function _buildConsensusSystemReasons(p) {
  // For multi-system picks, explain WHY each system rated it
  const srcStrats = p.source_strategies || {};
  const srcSystems = p.source_systems || [];
  if (Object.keys(srcStrats).length === 0 && srcSystems.length <= 1) {
    // Solo pick — explain the single system
    const sys = (p.source_system || '').toLowerCase();
    const strat = (p.strategy || '').toLowerCase();
    let sysDesc = '';
    for (const [key, desc] of Object.entries(_SYSTEM_DESCRIPTIONS)) {
      if (sys.includes(key.toLowerCase())) { sysDesc = desc; break; }
    }
    let stratDesc = '';
    for (const [key, desc] of Object.entries(_STRATEGY_DESCRIPTIONS)) {
      if (strat.includes(key.toLowerCase())) { stratDesc = desc; break; }
    }
    return `[Solo pick] ${p.source_system || 'unknown'} → ${p.strategy || 'unknown'}${stratDesc ? ': ' + stratDesc : ''}${sysDesc ? ' | System: ' + sysDesc : ''}`;
  }
  // Multi-system consensus pick
  const explanations = [];
  for (const [sysName, stratName] of Object.entries(srcStrats)) {
    const sysLower = sysName.toLowerCase();
    const stratLower = (stratName || '').toLowerCase();
    // Find system description
    let sysDesc = '';
    for (const [key, desc] of Object.entries(_SYSTEM_DESCRIPTIONS)) {
      if (sysLower.includes(key.toLowerCase())) { sysDesc = desc.split('.')[0]; break; }
    }
    // Find strategy description
    let stratDesc = '';
    for (const [key, desc] of Object.entries(_STRATEGY_DESCRIPTIONS)) {
      if (stratLower.includes(key.toLowerCase())) { stratDesc = desc.split('.')[0]; break; }
    }
    // Build explanation per system
    let explanation = `[${sysName}] strategy=${stratName}`;
    if (stratDesc) explanation += ` — ${stratDesc}`;
    if (sysDesc && !stratDesc) explanation += ` — ${sysDesc}`;
    // Add system-specific forward data
    if (D.systems) {
      const sysData = D.systems.find(s => s.name === sysName);
      if (sysData && sysData.closed_picks >= 5) {
        explanation += ` (sys WR=${(sysData.win_rate||0).toFixed(1)}%, PF=${(sysData.profit_factor||0).toFixed(2)}, ${sysData.closed_picks} trades)`;
      }
    }
    explanations.push(explanation);
  }
  // Also include systems from source_systems not in source_strategies
  for (const sysName of srcSystems) {
    if (!srcStrats[sysName]) {
      let sysDesc = '';
      const sysLower = sysName.toLowerCase();
      for (const [key, desc] of Object.entries(_SYSTEM_DESCRIPTIONS)) {
        if (sysLower.includes(key.toLowerCase())) { sysDesc = desc.split('.')[0]; break; }
      }
      explanations.push(`[${sysName}] agreed (${sysDesc || 'no description'})`);
    }
  }
  return `${explanations.length} systems agree: ` + explanations.join(' ||| ');
}

el('btn-export-excel').addEventListener('click', () => {
  const f = getFilters();
  let picks = (D.picks?.active || []).filter(p => matchFilter(p, f));
  const _now = Date.now();
  picks.forEach(p => {
    if (p.timestamp) {
      try { let ts = String(p.timestamp).trim(); if (!/[Z+-]\d{2}:?\d{2}$/.test(ts) && !ts.endsWith('Z')) ts += 'Z'; const ms = Date.parse(ts); if (!isNaN(ms)) p.age_hours = Math.max(0, (_now - ms) / 3600000); } catch(e) {}
    }
  });
  picks = picks.filter(p => { const age = p.age_hours ?? 999; const pnl = p.pnl_pct ?? 0; if (age > 48 && Math.abs(pnl) < 1) return false; const entry = parseFloat(p.entry_price) || 0; if (entry <= 0 || entry > 1000000) return false; return true; });
  picks = picks.filter(p => !isBlockedSystem(p.source_system));
  if (!picks.length) { alert('No active picks match current filters.'); return; }
  const headers = [
    'Symbol','Direction','Direction Reason','System','Strategy',
    'Entry Price','Live Price','PnL%','TP','SL','R:R',
    'Score','Grade','Meta Win Prob','Meta Grade','Score Breakdown (English)',
    'Confidence','Trust Tier','Trust Reason',
    'Forward WR','Forward Trades','Forward Validated',
    'Confluence Count','Consensus System Reasons',
    'Entry Reason (Raw)','Entry Reason (Full Audit)',
    'Market Regime','Regime Sentinel','Regime Adjustment',
    'Strategy Description','System Description',
    'Status','Asset Class','Timeframe','Age (hours)','Picked At'
  ];
  const rows = picks.map(p => {
    const s = computeScore(p);
    const score = s.score ?? 0;
    const grade = score >= 80 ? 'A' : score >= 70 ? 'B' : score >= 55 ? 'C' : score >= 40 ? 'D' : 'F';
    const trust = getTrustTier(p);
    const entry = parseFloat(p.entry_price) || 0;
    const tp = parseFloat(p.take_profit) || 0;
    const sl = parseFloat(p.stop_loss) || 0;
    const slDist = Math.abs(entry - sl);
    const rr = (entry && tp && sl && slDist > 0.001) ? (Math.abs(tp - entry) / slDist).toFixed(2) : '';
    const fwdWR = p.forward_wr != null ? (p.forward_wr > 1 ? p.forward_wr : p.forward_wr * 100).toFixed(1) + '%' : (p.strat_fwd_wr ? p.strat_fwd_wr.toFixed(1) + '%' : '');
    const fwdTrades = p.forward_trades ?? p.strat_fwd_trades ?? '';
    const confluenceCount = (p.agreement_count || 0) || Object.keys(p.source_strategies || {}).length || '';
    const scoreBreakdown = _buildScoreBreakdown(p, s);
    const directionReason = _buildDirectionReason(p);
    const consensusReasons = _buildConsensusSystemReasons(p);
    const rawReason = p.reason || p.signal_reason || p.entry_reason || '';
    const fullAudit = _buildPickReason(p);
    const mktRegime = typeof _marketRegime !== 'undefined' ? _marketRegime : '';
    const sentinelRegime = p.regime || p.sentinel_regime || '';
    const regimeAdj = s.breakdown.regimeLabel || '';
    const stratLower = (p.strategy || '').toLowerCase();
    let stratDesc = '';
    for (const [key, desc] of Object.entries(_STRATEGY_DESCRIPTIONS)) {
      if (stratLower.includes(key.toLowerCase())) { stratDesc = desc; break; }
    }
    const sysLower = (p.source_system || '').toLowerCase();
    let sysDesc = '';
    for (const [key, desc] of Object.entries(_SYSTEM_DESCRIPTIONS)) {
      if (sysLower.includes(key.toLowerCase())) { sysDesc = desc; break; }
    }
    return [
      p.symbol, p.direction, directionReason, p.source_system, p.strategy,
      p.entry_price, p.live_price ?? p.current_price ?? '',
      p.pnl_pct != null ? p.pnl_pct.toFixed(2) : '',
      p.take_profit, p.stop_loss, rr,
      score, grade,
      p._metaWinProb != null ? (p._metaWinProb * 100).toFixed(1) + '%' : '',
      p._metaGrade || '',
      scoreBreakdown,
      p.confidence != null ? (p.confidence * 100).toFixed(0) + '%' : '',
      trust ? trust.tier : '', trust ? (trust.reason || '') : '',
      fwdWR, fwdTrades, p.forward_validated ? 'YES' : 'NO',
      confluenceCount, consensusReasons,
      rawReason, fullAudit,
      mktRegime, sentinelRegime, regimeAdj,
      stratDesc, sysDesc,
      p.status || 'OPEN', p.asset_class || '',
      p.trade_timeframe || p.timeframe || '',
      p.age_hours != null ? p.age_hours.toFixed(1) : '',
      p.timestamp ? new Date(p.timestamp).toLocaleString('en-US', {timeZone:'America/New_York'}) : ''
    ].map(csvEscape).join(',');
  });
  const dateStr = new Date().toISOString().slice(0,10);
  downloadCSV(`antigravity_active_picks_${dateStr}.csv`, headers, rows);
});

el('btn-export-closed').addEventListener('click', () => {
