  'proven_triple_ema_pullback': {w: 0.20, reason: '0% WR despite name (Mar 16 v97 audit)'},
  'proven_propfirm_conservative': {w: 0.20, reason: '0% WR despite name (Mar 16 v97 audit)'},
  'spike_momentum_ignition': {w: 0.20, reason: '0% WR (Mar 16 v97 audit)'},
  'multi_timeframe_ema_stack': {w: 0.15, reason: '-7.87% avg PnL, worst strategy (Mar 16 v97 audit)'},
};
function getTrustTier(p) {
  const sys = (p.source_system || '').toLowerCase();
  const strat = (p.strategy || '').toLowerCase();
  // 1. PROBATION — system-level blocks (broken/garbage systems)
  for (const [k, v] of Object.entries(_TRUST_PROBATION)) {
    if (sys.includes(k) || strat.includes(k)) return {tier: 'PROBATION', ...v};
  }
  // 2. PROVEN_STRATEGIES + DEMOTED — merged longest-match lookup
  //    We must check BOTH tables together sorted by key length (longest first).
  //    This ensures:
  //    - keltner_compression_expansion_doge (28ch) → DEMOTED (beats keltner_compression_expansion 31ch PROVEN)
  //    - drawdown_recovery_rsi_eth (23ch) → PROVEN (beats drawdown_recovery_rsi 20ch DEMOTED)
  const mergedEntries = [];
  for (const [k, v] of Object.entries(_TRUST_PROVEN_STRATEGIES)) {
    mergedEntries.push({key: k, tier: 'PROVEN', ...v});
  }
  for (const [k, v] of Object.entries(_TRUST_DEMOTED)) {
    mergedEntries.push({key: k, tier: 'DEMOTED', ...v});
  }
  mergedEntries.sort((a, b) => b.key.length - a.key.length); // longest first
  for (const entry of mergedEntries) {
    if (strat.includes(entry.key)) {
      const {key, ...rest} = entry;
      return rest;
    }
  }
  // 3. PROVEN_SYSTEMS — check system name (with v95 data-driven safety net)
  for (const [k, v] of Object.entries(_TRUST_PROVEN_SYSTEMS)) {
    if (sys.includes(k)) {
      // v95 Safety net: cross-check manual tier against live data — live data always wins
      if (D && D.systems) {
        const liveData = D.systems.find(s => s.name === p.source_system);
        if (liveData && (liveData.closed_picks || 0) >= 10) {
          const liveWR = liveData.win_rate || 0;
          const livePF = liveData.profit_factor || 0;
          if (liveWR < 45) return {tier: 'SANDBOX', w: 0.35, reason: `⚠️ DATA OVERRIDE: Live WR=${liveWR.toFixed(1)}% on ${liveData.closed_picks} trades — LOSING system despite manual PROVEN entry`};
          if (liveWR < 50 && (liveData.closed_picks || 0) >= 20) return {tier: 'WATCH', w: 0.55, reason: `⚠️ DATA OVERRIDE: Live WR=${liveWR.toFixed(1)}% on ${liveData.closed_picks} trades — marginal edge`};
          if (livePF < 1.0) return {tier: 'WATCH', w: 0.50, reason: `⚠️ DATA OVERRIDE: Live PF=${livePF.toFixed(2)} — losing money overall despite manual PROVEN entry`};
        }
      }
      return {tier: 'PROVEN', ...v};
    }
  }
  // 4. Per-strategy trust (v96→v98.1.1): score each pick on its OWN strategy's forward record
  //    v98.1.1 ADDITIONS (Perplexity review):
  //    a) Bayesian shrink: small samples shrink toward 50% WR prior. 5 trades at 100% WR ≠ reliable.
  //       Formula: shrunkWR = (rawWR × N + priorWR × priorWeight) / (N + priorWeight)
  //       priorWeight=20 means you need ~20 trades before raw WR dominates the prior.
  //    b) Auto-disable: PF < 1.1 with ≥20 trades = auto-SANDBOX (Perplexity rec #2)
  //    c) Quality gate: per-timeframe PF minimums (Perplexity rec #1)
  const stratTrades = p.strat_fwd_trades ?? 0;
  if (stratTrades >= 3) {
    const rawWR = p.strat_fwd_wr ?? 0;
    const stratPF = p.strat_fwd_pf ?? 0;
    // Bayesian shrink: pull small-sample WRs toward 50% (uninformative prior)
    const PRIOR_WR = 50;
    const PRIOR_WEIGHT = 20; // effective sample size of prior
    const shrunkWR = (rawWR * stratTrades + PRIOR_WR * PRIOR_WEIGHT) / (stratTrades + PRIOR_WEIGHT);
    // Auto-disable gate (Perplexity #2): PF < 1.1 with enough data = losing system
    if (stratTrades >= 20 && stratPF < 1.1) {
      return {tier: 'SANDBOX', w: 0.25, reason: `⚠️ AUTO-DISABLE: PF ${stratPF.toFixed(2)} < 1.1 on ${stratTrades} trades — no edge (Bayesian WR: ${shrunkWR.toFixed(0)}%)`};
    }
    if (stratTrades >= 5) {
      if (shrunkWR >= 58 && stratPF >= 2.0) return {tier: 'PROVEN', w: 0.95, reason: `Strategy: ${rawWR.toFixed(0)}% WR→${shrunkWR.toFixed(0)}% Bayesian, PF ${stratPF.toFixed(1)} (${stratTrades} trades) — elite edge`};
      if (shrunkWR >= 53 && stratPF >= 1.5) return {tier: 'RELIABLE', w: 0.85, reason: `Strategy: ${rawWR.toFixed(0)}% WR→${shrunkWR.toFixed(0)}% Bayesian, PF ${stratPF.toFixed(1)} (${stratTrades} trades) — strong edge`};
      if (shrunkWR >= 50 && stratPF >= 1.0) return {tier: 'RELIABLE', w: 0.75, reason: `Strategy: ${rawWR.toFixed(0)}% WR→${shrunkWR.toFixed(0)}% Bayesian, PF ${stratPF.toFixed(1)} (${stratTrades} trades) — positive edge`};
      if (shrunkWR >= 48) return {tier: 'WATCH', w: 0.60, reason: `Strategy: ${shrunkWR.toFixed(0)}% Bayesian WR (${stratTrades} trades) — marginal edge`};
      if (shrunkWR >= 42) return {tier: 'SANDBOX', w: 0.40, reason: `Strategy: ${shrunkWR.toFixed(0)}% Bayesian WR (${stratTrades} trades) — weak edge`};
      return {tier: 'SANDBOX', w: 0.25, reason: `Strategy: ${shrunkWR.toFixed(0)}% Bayesian WR (${stratTrades} trades) — losing strategy`};
    }
    // 3-4 trades: even heavier Bayesian shrink (barely any data)
    if (shrunkWR >= 54) return {tier: 'WATCH', w: 0.55, reason: `Strategy: ${rawWR.toFixed(0)}% raw→${shrunkWR.toFixed(0)}% Bayesian (${stratTrades} trades) — promising but tiny sample`};
    if (shrunkWR >= 48) return {tier: 'SANDBOX', w: 0.40, reason: `Strategy: ${shrunkWR.toFixed(0)}% Bayesian (${stratTrades} trades) — early data`};
    return {tier: 'SANDBOX', w: 0.25, reason: `Strategy: ${shrunkWR.toFixed(0)}% Bayesian (${stratTrades} trades) — losing early`};
  }

  // 5. System-level auto-trust with auto-disable (v98.1.1, Perplexity rec #2)
  //    Strategies with no track record inherit their system's trust level.
  //    Auto-disable: PF < 1.1 on ≥20 trades = SANDBOX (Perplexity: "disable any system with PF < 1.1")
  if (D && D.systems) {
    const sysData = D.systems.find(s => s.name === p.source_system);
    if (sysData && (sysData.closed_picks || 0) >= 5) {
      const wr = sysData.win_rate || 0;
      const pf = sysData.profit_factor || 0;
      const n = sysData.closed_picks || 0;
      // AUTO-DISABLE GATE: PF < 1.1 with enough data = net loser
      if (n >= 20 && pf < 1.1) return {tier: 'SANDBOX', w: 0.30, reason: `⚠️ AUTO-DISABLE: System PF ${pf.toFixed(2)} < 1.1 on ${n} trades — no proven edge`};
      // Bayesian shrink for system-level WR too
      const shrunkSysWR = (wr * n + 50 * 20) / (n + 20);
      if (shrunkSysWR >= 57 && pf >= 2.0) return {tier: 'RELIABLE', w: 0.90, reason: `System: ${wr.toFixed(0)}%→${shrunkSysWR.toFixed(0)}% Bayesian WR, PF ${pf.toFixed(1)} (${n} trades)`};
      if (shrunkSysWR >= 53 && pf >= 1.5) return {tier: 'RELIABLE', w: 0.80, reason: `System: ${wr.toFixed(0)}%→${shrunkSysWR.toFixed(0)}% Bayesian WR, PF ${pf.toFixed(1)} (${n} trades)`};
      if (shrunkSysWR >= 50) return {tier: 'WATCH', w: 0.70, reason: `System: ${shrunkSysWR.toFixed(0)}% Bayesian WR (${n} trades) — edge detected`};
      if (shrunkSysWR >= 47) return {tier: 'WATCH', w: 0.55, reason: `System: ${shrunkSysWR.toFixed(0)}% Bayesian WR (${n} trades) — marginal edge`};
      return {tier: 'SANDBOX', w: 0.40, reason: `System: ${shrunkSysWR.toFixed(0)}% Bayesian WR (${n} trades) — below threshold`};
    }
    // System exists but has <5 closed trades = ZERO TRACK RECORD
    if (sysData && (sysData.closed_picks || 0) < 5) {
      const ct = sysData.closed_picks || 0;
      return {tier: 'UNPROVEN', w: 0.30, reason: `⚠️ ZERO TRACK RECORD: only ${ct} closed trade${ct!==1?'s':''}. No statistical evidence this system works.`};
    }
  }
  // System not even in D.systems = completely unknown
  // v97: raised from 0.10 to 0.25 — 0.10 made it mathematically impossible for new strategies
  // to score above 10, burying +10% PnL winners at score 28 (see Mar 16 audit)
  return {tier: 'UNPROVEN', w: 0.25, reason: '⚠️ NO DATA: System not found in any dataset. Treat with caution.'};
}

function computeScore(p) {
  // ════════════════════════════════════════════════════════════════════════════
  // SCORING FRAMEWORK MAPPING (see docs/evaluation_framework.md)
  // Industry benchmarks per Kimi Evaluation Framework v1.0:
  //   Sharpe: 0.5 min, 1.0 good, 1.5+ excellent
  //   PF:     1.2 min, 1.5 good, 2.0+ excellent
  //   WR:     40% min, 50% good, 60%+ excellent (>80% = suspect curve-fit)
  //   MDD:    <40% min, <25% good, <15% excellent
  //   Min trades: 100+ for statistical significance, 5+ for basic signal
  //
  // v98 component weights (updated from v97 — data-driven from 1,908 trades):
  //   strategy   (15%) → Criteria 2 (Statistical Robustness) + 4 (Out-of-Sample)
  //   signal     (15%) → Criteria 7 (Trade Details: entry/SL/TP/R:R)
  //   freshness  (10%) → Criteria 10 (Signal Delivery: timeliness)
  //   forward    (10%) → Criteria 1 (Verified Track Record) + 3 (Risk Metrics)
  //   consensus  (20%) → Criteria 5 (Market Regime: multi-system agreement)
  //   noConflict  (5%) → Criteria 5 (Market Regime: directional consensus)
  //   livePnl    (20%) → Market validation (PnL-aware — intentionally reactive)
  //   timeframe   (5%) → INTRADAY 86% WR vs POSITION 8.3% WR
  // Trust tier     → Criteria 1 (Verified Track Record: sample size gating)
  // Insight mult   → Criteria 4 (Out-of-Sample: walk-forward validation)
  // Direction bias → Criteria 5 (Market Regime Performance)
  // NOT TRACKED: Criteria 6 (Methodology transparency), 8 (Cost), 9 (Risk Disclosure),
  //              11 (Support), 12 (Credentials), 13-15 (Red flags / due diligence)
  // ════════════════════════════════════════════════════════════════════════════
  const breakdown = {};
  // 1. Strategy Performance (25%) — maps to Criteria 2+4
  const fwdWr = p.strat_fwd_wr ?? 0;
  const fwdPf = p.strat_fwd_pf ?? 0;
  const health = p.strat_health;
  const perfBase = Math.min(100, (fwdWr * 0.6) + (Math.min(fwdPf, 3) / 3 * 100 * 0.4));
  const healthMult = health === 'healthy' ? 1.0 : health === 'watch' ? 0.75 : health === 'degraded' ? 0.4 : 0.5;
  // Common Sense Ratio (CSR) quality multiplier — KIMI weights at 10%
  // CSR = (WR × AvgWin) / (LR × AvgLoss). >1 profitable, >2 strong, >3 excellent
  const csr = p.strat_csr ?? null;
  let csrMult = 1.0;
  if (csr !== null) {
    if (csr > 2.0) csrMult = 1.10;       // +10% boost for strong CSR
    else if (csr < 0.5) csrMult = 0.80;   // -20% penalty for poor CSR
  }
  breakdown.csr = csr;
  breakdown.csrMult = Math.round(csrMult * 100);
  breakdown.strategy = Math.round(perfBase * healthMult * csrMult);

  // 2. Signal Quality (20%) — maps to Criteria 7 (Trade Details: entry/SL/TP provided)
  const conf = (p.confidence ?? 0) * 100;
  const entry = parseFloat(p.entry_price) || 0;
  const tp = parseFloat(p.take_profit) || 0;
  const sl = parseFloat(p.stop_loss) || 0;
  let rrScore = 50;
  if (entry && tp && sl) {
    const slDist = Math.abs(entry - sl);
    const rr = slDist > 0.001 ? Math.abs(tp - entry) / slDist : 0; // v98.1: guard against sl===entry garbage R:R
    // v97: Parabolic R:R scoring. Data shows R:R 1.5-2.0 is the sweet spot (76.9% WR, +9.71% PnL).
    // R:R >3 has only 22.2% WR. Old linear scoring (rr*40) over-rewarded extreme R:R.
    if (rr < 0.5) rrScore = 10;
    else if (rr <= 2.0) rrScore = Math.min(100, Math.round(20 + (rr - 0.5) * 53.3)); // 0.5→20, 1.0→47, 1.5→73, 2.0→100
    else if (rr <= 3.0) rrScore = Math.round(100 - (rr - 2.0) * 30); // 2.0→100, 3.0→70
    else rrScore = Math.max(30, Math.round(70 - (rr - 3.0) * 20)); // >3.0 declines further
  }
  breakdown.signal = Math.round(conf * 0.6 + rrScore * 0.4);

  // 3. Freshness (15%) — maps to Criteria 10 (Signal Delivery: real-time/near-real-time)
  // v97: INVERTED for profitable picks. Age-PnL correlation = +0.62 (strong positive).
  // Winners accumulate PnL over time; penalizing them destroys score quality.
  // Old logic: exp(-age/12) punished ALL aging picks. >72h picks had 100% WR but scored 0 freshness.
  // New logic: losing picks still decay; profitable picks get MOMENTUM bonus.
  const age = p.age_hours ?? 999;
  const pickPnl = p.pnl_pct ?? p.unrealized_pnl_pct ?? 0;
  let freshnessScore;
  if (pickPnl > 0) {
    // Profitable pick: slow decay (winners need time to run)
    // 1h=95, 12h=78, 24h=61, 48h=37, 72h=22 — much gentler than exp(-age/12)
    freshnessScore = Math.max(15, Math.min(100, 100 * Math.exp(-age / 48)));
    // Momentum bonus: profitable + aging = confirmed thesis
    if (pickPnl >= 5 && age >= 6) freshnessScore = Math.max(freshnessScore, 60);
    if (pickPnl >= 10 && age >= 12) freshnessScore = Math.max(freshnessScore, 70);
  } else {
    // Losing pick: aggressive decay (stale losers should be buried)
    freshnessScore = Math.max(0, Math.min(100, 100 * Math.exp(-age / 8)));
  }
  breakdown.freshness = Math.round(freshnessScore);

  // DESIGN NOTE (v98.1 code review): PnL intentionally influences 4 paths:
  // freshness (momentum bonus), livePnl (direct), entryDrift (mult), timeDecay (gentle/aggressive).
  // This creates a strongly bimodal distribution: winners score 60-85, losers 0-10.
  // This is BY DESIGN — meta-model training confirms Score>24 = WIN (AUC 0.89).
  // The quadruple-counting IS the signal. Do not "fix" by removing PnL influence.

  // 4. Forward Performance (15%) — maps to Criteria 1 (Verified Track Record) + 3 (Risk Metrics)
  //    Framework requires: min 100+ trades for significance, PF>1.5 good, WR 40-70% healthy range
  //    v90: Unproven systems (0 or <5 closed trades) get 0 instead of 50.
  //    Users were trading on signals from systems with ZERO track record.
  let fwdScore = 0; // default: no data = no credit
  if (D.systems) {
    const sys = D.systems.find(s => s.name === p.source_system);
    if (sys && sys.closed_picks >= 5) {
      const wrScore = Math.min(100, (sys.win_rate || 0) * 1.2); // WR scaled (60% WR = 72 score)
      const pfScore = Math.max(0, Math.min(100, ((sys.profit_factor || 0) - 0.5) * 66.7)); // PF 0.5=0, 1.2=47(min), 1.5=67(good), 2.0=100(excellent) per framework
      const expScore = Math.min(100, Math.max(0, ((sys.expectancy || 0) + 5) * 10)); // exp 5% = 100
      fwdScore = Math.round(wrScore * 0.5 + pfScore * 0.3 + expScore * 0.2);
      // Bonus for large sample sizes (50+ trades = more reliable)
      if (sys.closed_picks >= 50) fwdScore = Math.min(100, Math.round(fwdScore * 1.1));
    } else if (sys && sys.closed_picks >= 1) {
      // 1-4 trades: tiny credit (not enough to trust but some data exists)
      fwdScore = Math.round(Math.min(30, (sys.win_rate || 0) * 0.5));
    }
    // else: 0 closed trades = fwdScore stays 0
  }
  breakdown.forward = Math.max(0, Math.min(100, fwdScore));

  // 5. Consensus (15%) — maps to Criteria 5 (multi-system/strategy agreement)
  let agree = (p.agreement_count ?? 0);
  // Fallback: use confluence from alpha_engine (multiple strategies agreeing on same symbol)
  if (agree === 0) {
    const confStrats = p.confluence_strategies || [];
    const convergence = p.convergence ?? 0;
    if (confStrats.length >= 1) agree = confStrats.length;
    else if (convergence >= 1) agree = convergence;
  }
  breakdown.consensus = Math.min(100, agree * 35);

  // 6. No-conflict bonus (10%) — maps to Criteria 5 (directional consensus)
  //    v90: Now uses conflict RATIO, not just binary flag.
  //    50/50 split (e.g., 29 SHORT vs 28 LONG) = near-zero score (coin flip)
  //    80/20 split = minor penalty (clear consensus with some dissent)
  //    Also: if a PROVEN system opposes this pick's direction, heavier penalty
  // v91 FIX: Continuous conflict scoring using actual ratio math instead of discrete buckets.
  // This is critical for BTC (29 SHORT vs 28 LONG = 50.9% agreement = coin flip).
  // User lost money on BTC because it appeared tradeable despite near-50/50 split.
  let conflictScore = 100;
  if (p.has_conflict && p._conflictInfo) {
    const myCount = p._conflictInfo.myDirCount || 1;
    const oppCount = p._conflictInfo.opposing || 0;
    const total = myCount + oppCount;
    const agreementRatio = total > 0 ? myCount / total : 0.5;
    // Continuous scoring: maps ratio linearly from coin-flip (0.5) → unanimous (1.0)
    // agreementRatio=0.5 → score 5 (near-zero, coin flip)
    // agreementRatio=0.6 → score 25
    // agreementRatio=0.7 → score 45
    // agreementRatio=0.8 → score 65
    // agreementRatio=0.9 → score 85
    // agreementRatio=1.0 → score 100 (unanimous)
    if (agreementRatio <= 0.55) {
      conflictScore = 5; // COIN FLIP — hard floor. 45-55% split = no signal.
    } else {
      conflictScore = Math.round(Math.max(5, (agreementRatio - 0.5) * 200));
    }
    // Extra penalty if PROVEN system (100+ trades) opposes this direction
    if (p._conflictInfo.provenOpposing > 0) {
      conflictScore = Math.round(conflictScore * 0.5); // 50% haircut (was 60%)
    }
  } else if (p.has_conflict) {
    conflictScore = 20; // Fallback for conflict without ratio data
  }
  breakdown.noConflict = conflictScore;

  // 7. Direction bias penalty — penalize LONG-only systems in bearish/choppy regimes
  // Uses _marketRegime computed in renderPicks from aggregate PnL of active picks
  // v97: Direction bias now penalizes BOTH directions in wrong regime.
  // Data: LONGs +10.58% avg, 81.1% WR; SHORTs -2.70%, 22.5% WR in current bullish market.
  // SHORTs had 3x higher avg score than LONGs — scoring was PROMOTING the losing direction.
  let dirPenalty = 1.0;
  if (typeof _marketRegime !== 'undefined') {
    const dir = (p.direction || '').toUpperCase();
    if (_marketRegime === 'BULLISH' && (dir === 'SHORT' || dir === 'SELL')) {
      dirPenalty = 0.30; // 70% penalty for shorts in bullish regime (data: 20.9% WR, -0.95% avg on 397 trades)
    } else if (_marketRegime === 'BULLISH' && (dir === 'LONG' || dir === 'BUY')) {
      dirPenalty = 1.10; // 10% bonus for longs in bullish regime (LONGs 81.1% WR)
    } else if (_marketRegime === 'BEARISH' && (dir === 'LONG' || dir === 'BUY')) {
      dirPenalty = 0.65; // 35% penalty for longs in bearish regime
    } else if (_marketRegime === 'BEARISH' && (dir === 'SHORT' || dir === 'SELL')) {
      dirPenalty = 1.10; // 10% bonus for shorts in bearish regime
    } else if (_marketRegime === 'CHOPPY' && (dir === 'LONG' || dir === 'BUY')) {
      dirPenalty = 0.90; // 10% penalty for longs in choppy regime
    } else if (_marketRegime === 'CHOPPY' && (dir === 'SHORT' || dir === 'SELL')) {
      dirPenalty = 0.85; // 15% penalty for shorts in choppy regime (shorts underperform overall)
    }
  }
  breakdown.dirPenalty = Math.round(dirPenalty * 100);
  const recentPnl = p.recent_pnl ?? 0;
  const recentDd = p.recent_max_dd ?? 0;
  const recentScoreRaw = recentPnl - recentDd;
  breakdown.recentScore = Math.round(Math.max(0, Math.min(100, recentScoreRaw)));

  // 8. Entry zone drift — v97 overhaul based on correlation data.
  // OLD: penalized >5% PnL as "chase risk". But data shows >72h picks (high PnL) = 100% WR.
  // NEW: Only penalize losers. Winners get neutral-to-positive treatment.
  // The "chase risk" concern is handled by the TP/SL hit detection, not by crushing winners.
  const pnl = p.pnl_pct ?? 0;
  let entryDrift = 1.0;
  if (pnl < -5) entryDrift = 0.25;       // Deeply underwater — failed thesis
  else if (pnl < -3) entryDrift = 0.40;   // Significantly losing
  else if (pnl < -1) entryDrift = 0.70;   // Mildly losing
  else if (pnl >= 0 && pnl <= 3) entryDrift = 1.0;  // Ideal zone — entry confirmed
  else if (pnl > 3) entryDrift = 1.0;    // v97: Winners keep full score (was 0.85/0.6/0.4)
  // TP/SL hit detection handles the "when to close" question separately
  breakdown.entryDrift = Math.round(entryDrift * 100);

  // 6b. Regime Sentinel weight adjustment — boost relevant components based on market cycle
  // Uses on-chain regime from regime_sentinel.py (ACCUMULATION/MARKUP/DISTRIBUTION/MARKDOWN)
  // Applied BEFORE rawTotal so component boosts flow into the weighted sum.
  // Direction-based multiplier (regimeAdj) applied AFTER as a post-hoc penalty/bonus.
  let regimeAdj = 1.0;
  let regimeLabel = '';
  const sentinelRegime = (p.regime || p.sentinel_regime || '').toUpperCase();
  const pickDir = (p.direction || '').toUpperCase();
  const isLong = pickDir === 'LONG' || pickDir === 'BUY';
  const isShort = pickDir === 'SHORT' || pickDir === 'SELL';
  if (sentinelRegime === 'ACCUMULATION') {
    breakdown.forward = Math.round(Math.min(100, breakdown.forward * 1.3));
    breakdown.consensus = Math.round(Math.min(100, breakdown.consensus * 1.2));
    regimeLabel = 'ACCUMULATION (+30% fwd, +20% consensus)';
  } else if (sentinelRegime === 'MARKUP') {
    breakdown.signal = Math.round(Math.min(100, breakdown.signal * 1.3));
    breakdown.freshness = Math.round(Math.min(100, breakdown.freshness * 1.2));
    regimeLabel = 'MARKUP (+30% signal, +20% fresh)';
  } else if (sentinelRegime === 'DISTRIBUTION') {
    breakdown.noConflict = Math.round(Math.min(100, breakdown.noConflict * 1.5));
    regimeAdj = isLong ? 0.8 : 1.0;
    regimeLabel = 'DISTRIBUTION (+50% no-conflict' + (isLong ? ', -20% LONG penalty)' : ')');
  } else if (sentinelRegime === 'MARKDOWN') {
    breakdown.noConflict = Math.round(Math.min(100, breakdown.noConflict * 2.0));
    if (isLong) regimeAdj = 0.5;
    else if (isShort) regimeAdj = 1.0;
    else regimeAdj = 0.7;
    regimeLabel = 'MARKDOWN (+100% no-conflict' + (isLong ? ', -50% LONG penalty)' : isShort ? ', SHORT favored)' : ')');
  }
  breakdown.regimeAdj = Math.round(regimeAdj * 100);
  breakdown.regimeLabel = regimeLabel;

  // Weighted composite (raw, before trust tier)
  // v98.1 weights: strategy 15%, signal 15%, freshness 10%, forward 10%, consensus 20%, noConflict 5%, livePnl 20%, timeframe 5% (NEW)
  // Changes from v97 based on 1,908-trade backtest (Mar 16 2026):
  //   forward 20%→10%: Forward WR is ANTI-predictive (FW≥65% = 25% actual WR)
  //   strategy 20%→15%: Relies on same unreliable forward data
  //   consensus 15%→20%: Confluence≥3 = 90.7% WR — strongest signal
  //   livePnl 15%→20%: r=0.62 correlation, best single predictor
  //   NEW timeframe 5%: INTRADAY 86% WR vs POSITION 8.3% WR
  const livePnlScore = Math.max(0, Math.min(100, (pickPnl + 5) * 10)); // -5%→0, 0%→50, 5%→100
  breakdown.livePnl = Math.round(livePnlScore);
  // v98.1: Timeframe quality score — data-driven from 1,908 closed trades
  const tf = (p.timeframe || '').toUpperCase();
  let tfScore = 50; // default
  if (tf === 'INTRADAY') tfScore = 90;        // 86% WR, +6.74% avg
  else if (tf === 'SWING') tfScore = 45;       // 44.3% WR, +0.61% avg
  else if (tf === 'SCALP') tfScore = 40;       // 41.5% WR, -0.53% avg
  else if (tf === 'POSITION') tfScore = 10;    // 8.3% WR, -4.93% avg — near-death
  breakdown.timeframe = tfScore;
  const rawTotal = Math.round(
    breakdown.strategy * 0.15 +
    breakdown.signal * 0.15 +
    breakdown.freshness * 0.10 +
    breakdown.forward * 0.10 +
    breakdown.consensus * 0.20 +
    breakdown.noConflict * 0.05 +
    breakdown.livePnl * 0.20 +
    breakdown.timeframe * 0.05
  );

  // Apply trust tier multiplier
  const trust = getTrustTier(p);
  p.trust_tier = trust.tier;
  p.trust_weight = trust.w;
  p.trust_reason = trust.reason;
  const afterTrust = Math.round(rawTotal * trust.w);
  breakdown.trust = Math.round(trust.w * 100);

  // 9b. Signal Insight multiplier — penalize DANGER picks, boost GOLDEN
  // Based on 1000+ closed forward-tested trades analysis (Mar 15 2026)
  // Phase 2 (Mar 16 2026): Graduated allocation tiers take priority when available.
  // Allocation tier score_multiplier: S=1.0x, A=0.60x, B=0.30x, C=0.20x, ELIMINATED=0.02x
  let insightMult = 1.0;
  if (p._allocTier) {
    // Graduated allocation tier — data-driven from rolling 20-trade window
    insightMult = p._allocTier.score_multiplier ?? 1.0;
  } else if (p._signalInsight) {
    // Fallback to legacy insight tiers for strategies without allocation data
    const si = p._signalInsight;
    if (si.tier === 'DANGER')  insightMult = 0.35;  // -65% score for dead/failing strategies
    else if (si.tier === 'WARNING') insightMult = 0.65; // -35% for overfit/KIMI solo
    else if (si.tier === 'GOLDEN')  insightMult = 1.15; // +15% boost for walk-forward proven
    else if (si.tier === 'STRONG')  insightMult = 1.10; // +10% for consensus + validated
    // GOOD tier gets no modifier (informational only)
  }
  breakdown.insightMult = Math.round(insightMult * 100);

  // 9c. Consensus quality multiplier (Grok review 2026-03-16):
  // 3+ system agreement historically 78.6% WR. Boost consensus picks, penalize solo picks.
  // Also anti-herding: if ALL agreeing systems are the same system, no boost (Grok: "battleground herding risk")
  let consensusMult = 1.0;
  const agreeCt = p.agreement_count || 0;
  const uniqueSystems = new Set((p.source_systems || []).map(s => s.replace(/_(standalone|live_signals|signal_tracking)$/, '')));
  if (agreeCt >= 3 && uniqueSystems.size >= 2) {
    consensusMult = 1.20; // +20% for 3+ diverse system agreement (historically 78.6% WR)
  } else if (agreeCt >= 2 && uniqueSystems.size >= 2) {
    consensusMult = 1.05; // +5% for 2 diverse systems
  } else if (agreeCt <= 0 && (p.strat_fwd_trades || 0) < 20) {
    consensusMult = 0.85; // -15% for solo unproven picks (herding/noise risk)
  }
  breakdown.consensusMult = Math.round(consensusMult * 100);

  // v98.1: PnL-aware time decay — stop crushing profitable aging picks.
  // Data: >72h picks with profit = 100% WR. Freshness component already handles PnL-aware decay.
  // Old: flat 0.25x at 48h+ destroyed +10% winners. New: winners decay gently, losers decay hard.
  const decayAge = p.age_hours ?? 999;
  let timeDecay;
  if (pickPnl > 0) {
    // PROFITABLE: gentle decay — winners need time to run (confirmed by data)
    // 0-6h: 1.0x | 6-24h: 0.90x | 24-48h: 0.75x | 48-72h: 0.60x | 72h+: 0.50x
    timeDecay = decayAge <= 6 ? 1.0 : decayAge <= 24 ? 0.90 : decayAge <= 48 ? 0.75
      : decayAge <= 72 ? 0.60 : 0.50;
  } else {
    // LOSING: aggressive decay — stale losers should be buried
    // 0-2h: 1.0x | 2-6h: 0.90x | 6-12h: 0.75x | 12-24h: 0.55x | 24-36h: 0.35x | 36h+: 0.20x
    timeDecay = decayAge <= 2 ? 1.0 : decayAge <= 6 ? 0.90 : decayAge <= 12 ? 0.75
      : decayAge <= 24 ? 0.55 : decayAge <= 36 ? 0.35 : 0.20;
  }
  const afterDecay = Math.round(afterTrust * timeDecay);

  // 9. Conflict penalty — REMOVED separate 0.7x multiplier
  //    Was double-dipping: noConflict component (10% weight) already handles this.
  //    Previous 0.7x multiplier + noConflict=0 was a ~44% total reduction,
  //    crushing even PROVEN picks from 67 → 47. Now handled solely via noConflict component.
  breakdown.conflictPenalty = 100; // No separate multiplier

  // v98.1: Combined multiplier with floor to prevent extinction stacking.
  // Old: trust 0.10 × insight 0.30 × timeDecay 0.25 × dirPenalty 0.60 = 0.0045x (99.55% penalty!)
  // New: compute combined mult, floor at 0.10x so scoring components can still differentiate.
  const combinedMult = (dirPenalty || 1.0) * (entryDrift || 1.0) * (insightMult || 1.0) * (consensusMult || 1.0) * (regimeAdj || 1.0);
  const flooredMult = Math.max(0.10, combinedMult); // Never let post-trust multipliers crush below 10%
  let adjustedTotal = Math.round(afterDecay * flooredMult);
  breakdown.timeDecay = Math.round(timeDecay * 100);

  // v98.1: Live PnL floor — market validation overrides system distrust.
  // If a pick is actively profitable, the market is proving the thesis RIGHT.
  // Trust penalties should dampen score, not annihilate it to 0 for a +10% winner.
  // Floor: +3% PnL → min score 25, +5% → 35, +10% → 50, +20% → 65
  if (pickPnl >= 3 && adjustedTotal < 25)  adjustedTotal = 25;
  if (pickPnl >= 5 && adjustedTotal < 35)  adjustedTotal = 35;
  if (pickPnl >= 10 && adjustedTotal < 50) adjustedTotal = 50;
  if (pickPnl >= 20 && adjustedTotal < 65) adjustedTotal = 65;
  breakdown.pnlFloor = pickPnl >= 3 ? 'active' : 'none';

  return { score: Math.max(0, Math.min(100, adjustedTotal)), breakdown };
}

function renderPicks() {
  const f = getFilters();
  let activePicks = (D.picks?.active || []).filter(p => matchFilter(p, f));
  // Compute live age_hours from timestamp (server-side age_hours goes stale between regenerations)
  const _now = Date.now();
  activePicks.forEach(p => {
    if (p.timestamp) {
      try {
        let ts = String(p.timestamp).trim();
        if (!/[Z+-]\d{2}:?\d{2}$/.test(ts) && !ts.endsWith('Z')) ts += 'Z';
        const ms = Date.parse(ts);
        if (!isNaN(ms)) p.age_hours = Math.max(0, (_now - ms) / 3600000);
      } catch(e) {}
    }
  });
  // Auto-remove stale low-impact picks: hide picks older than 48h unless significant PnL (>1%).
  activePicks = activePicks.filter(p => {
    const age = p.age_hours ?? 999;
    const pnl = p.pnl_pct ?? 0;
    if (age > 48 && Math.abs(pnl) < 1) return false;
    return true;
  });
  // Filter out picks with garbage entry prices BEFORE regime detection (prevents outlier skew)
  activePicks = activePicks.filter(p => {
    const entry = parseFloat(p.entry_price) || 0;
    if (entry <= 0) return false;  // No entry price = useless for tracking
    if (entry > 1000000) return false;  // $1M+ entry = broken system (mercury2_fast etc)
    return true;
  });
  // ── Market Regime Detection (fixed: uses cleaned data + capped PnL + median) ──
  // Detect regime from aggregate PnL of active crypto LONG picks.
  // If most LONGs are losing, market is bearish. Score penalizes LONG-only systems accordingly.
  const _cryptoLongs = activePicks.filter(p => {
    const d = (p.direction||'').toUpperCase();
    const ac = (p.asset_class||'').toUpperCase();
    return (d === 'LONG' || d === 'BUY') && (ac === 'CRYPTO' || (p.symbol||'').includes('USD'));
  });
  // Cap individual PnL at ±50% to prevent outlier skew (stale picks with 1000%+ PnL)
  const _longPnls = _cryptoLongs.map(p => Math.max(-50, Math.min(50, p.pnl_pct ?? 0))).filter(v => v !== 0);
  // Use MEDIAN instead of mean — resistant to outliers
  const _sortedPnls = [..._longPnls].sort((a,b) => a - b);
  const _medianLongPnl = _sortedPnls.length >= 5 ? _sortedPnls[Math.floor(_sortedPnls.length / 2)] : null;
  const _avgLongPnl = _longPnls.length >= 5 ? _longPnls.reduce((a,b) => a+b, 0) / _longPnls.length : null;
  const _pctLongsLosing = _longPnls.length >= 5 ? _longPnls.filter(v => v < 0).length / _longPnls.length : 0;
  // Regime uses median (outlier-resistant): BEARISH if >65% losing OR median < -2%, CHOPPY if >50% losing, else BULLISH
  const _regimePnl = _medianLongPnl ?? _avgLongPnl;
  window._marketRegime = _regimePnl === null ? 'UNKNOWN'
    : _pctLongsLosing > 0.65 || _regimePnl < -2 ? 'BEARISH'
    : _pctLongsLosing > 0.50 || _regimePnl < -0.5 ? 'CHOPPY' : 'BULLISH';
  // Filter out BLOCKED systems — proven losers that should never appear as recommendations
  activePicks = activePicks.filter(p => !isBlockedSystem(p.source_system));
  // Proven-only filter: if the user clicked "★ Proven Only", only show picks from proven/reliable systems
  if (window._provenOnlyFilter) {
    activePicks = activePicks.filter(p => {
      const t = getTrustTier(p);
      return t.tier === 'PROVEN' || t.tier === 'RELIABLE';
    });
  }
  // Score Gate filter (v98.2): hide picks below Score 24
  // Decision tree trained on 1,908 trades: Score>24 = WIN (AUC 0.93)
  if (window._scoreGateFilter) {
    activePicks = activePicks.filter(p => (p.score || 0) >= 24);
  }
  // Trade Entry filter: Score >= 30, conf >= 0.5, crypto (further loosened for bearish regime)
  if (window._tradeWorthyFilter) {
    activePicks = activePicks.filter(p => {
      const s = p.score || 0;
      const c = p.confidence || 0;
      const ac = (p.asset_class || '').toUpperCase();
      return s >= 30 && c >= 0.5 && ac === 'CRYPTO';
    });
  }
  // Leverage Entry filter: Score >= 50, conf >= 0.65, crypto only
  if (window._leverageWorthyFilter) {
    activePicks = activePicks.filter(p => {
      const s = p.score || 0;
      const c = p.confidence || 0;
      const ac = (p.asset_class || '').toUpperCase();
      return s >= 50 && c >= 0.65 && ac === 'CRYPTO';
    });
  }
  // Auto-hide rapid_fire picks with score < 10 (v98.2: 212 picks avg score 8, pure noise)
  activePicks = activePicks.filter(p => {
    if ((p.source_system || '').toLowerCase() === 'rapid_fire' && (p.score || 0) < 10) return false;
    return true;
  });
  // Hide resolved picks (TP HIT + SL HIT) by default — not active entries anymore
  // User can toggle TP winners back on with the button; SL hits always hidden
  const _isResolved = p => {
    const rl = p._resolved_live || '';
    const st = p.status || '';
    const oc = p.outcome || '';
    return rl === 'TP_HIT' || rl === 'SL_HIT' || st === 'TP_HIT' || st === 'SL_HIT' || oc === 'TP_HIT' || oc === 'SL_HIT';
  };
  const _isTpHit = p => {
    return (p._resolved_live === 'TP_HIT' || p.status === 'TP_HIT' || p.outcome === 'TP_HIT');
  };
  activePicks = activePicks.filter(p => {
    if (!_isResolved(p)) return true;  // Not resolved — keep
    if (_isTpHit(p) && window._showTpHitPicks) return true;  // TP HIT + toggle on — keep
    return false;  // All other resolved picks (SL HIT, or TP HIT with toggle off) — hide
  });
  // Compute system-wide performance score (0-100) based on system win rate.
  function computeSystemScore(p) {
    if (!D.systems) return 0;
    const sys = D.systems.find(s => s.name === p.source_system);
    if (!sys) return 0;
    // Use win_rate (percentage) directly.
    return Math.round(sys.win_rate ?? 0);
  }
  // Build conflict details: for each symbol, track opposing picks with system trade counts
  const _conflictDetails = {};
  (function buildConflictDetails() {
    const bySymDir = {};
    for (const p of activePicks) {
      const sym = p.symbol || '';
      const dir = (p.direction || '').toUpperCase();
      if (!bySymDir[sym]) bySymDir[sym] = {};
      if (!bySymDir[sym][dir]) bySymDir[sym][dir] = [];
      // Find system trade count from leaderboard
      const sysTrades = (D.systems || []).find(s => s.name === p.source_system);
      bySymDir[sym][dir].push({
        system: p.source_system || '',
        strategy: p.strategy || '',
        trades: sysTrades?.total_trades || 0,
        wr: sysTrades?.win_rate || 0,
      });
    }
    for (const [sym, dirs] of Object.entries(bySymDir)) {
      if (dirs['LONG'] && dirs['SHORT']) {
        _conflictDetails[sym] = { LONG: dirs['LONG'], SHORT: dirs['SHORT'] };
      }
    }
  })();

  activePicks = activePicks.map(p => {
    p.has_conflict = _conflictSymbols.has(p.symbol);
    // Attach conflict details for tooltip
    if (p.has_conflict && _conflictDetails[p.symbol]) {
      const myDir = (p.direction || '').toUpperCase();
      const oppDir = myDir === 'LONG' ? 'SHORT' : 'LONG';
      const mySystems = (_conflictDetails[p.symbol][myDir] || []);
      const opposingSystems = (_conflictDetails[p.symbol][oppDir] || []);
      // Check if any opposing system has 100+ trades (proven)
      const provenOpposing = opposingSystems.filter(s => s.trades >= 100);
      p._conflictInfo = {
        myDir,
        oppDir,
        myDirCount: mySystems.length,
        opposing: opposingSystems.length,
        opposingSystems: opposingSystems.slice(0, 5), // top 5 for tooltip
        provenOpposing: provenOpposing.length,
        provenNames: provenOpposing.map(s => s.system),
      };
    }
    const result = computeScore(p);
    p.score = result.score;
    p._scoreBreakdown = result.breakdown;
    // System performance score (0-100)
    p.system_score = computeSystemScore(p);
    // Strategy performance score from breakdown (0-100)
    p.strategy_score = result.breakdown.strategy ?? 0;

    // ── Meta-Model Win Probability (v98.2) ──────────────────────────────
    // Leak-free logistic regression trained on 1,526 closed trades (AUC 0.7358)
    // Uses only ex-ante features: grade, confluence, trust, direction, timeframe
    // Per 5-AI consensus: these are the only features that matter
    {
      const trustMap = {'DEMOTED':-2,'SANDBOX':-1,'PROBATION':0,'WATCH':1,'RELIABLE':2,'PROVEN':3};
      const gradeMap = {'F':0,'D':1,'C':2,'B':3,'A':4};
      const grade = p.score >= 80 ? 'A' : p.score >= 70 ? 'B' : p.score >= 55 ? 'C' : p.score >= 40 ? 'D' : 'F';
      const tf = (p.trade_timeframe || '').toUpperCase();
      const metaFeatures = {
        'grade_code': gradeMap[grade] || 0,
        'Confluence Count': p.agreement_count || 0,
        'trust_code': trustMap[(p._trustTier || '').toUpperCase()] || 0,
        'is_long': (p.direction || '').toUpperCase() === 'LONG' ? 1 : 0,
        'tf_INTRADAY': tf === 'INTRADAY' ? 1 : 0,
        'tf_POSITION': tf === 'POSITION' ? 1 : 0,
        'tf_SCALP': tf === 'SCALP' ? 1 : 0,
        'tf_SWING': tf === 'SWING' ? 1 : 0,
        'Forward Trades': p.strat_fwd_trades || 0,
      };
      // Logistic regression: z = intercept + sum(coef * (x - mean) / std)
      const M = [
        // [coef, mean, std] — only non-zero features from training
        ['grade_code',      2.09919748, 0.30209699, 0.47183677],
        ['Confluence Count', 0.30626347, 1.20314548, 0.67584465],
        ['trust_code',      0.28493187, 0.91153342, 1.37403773],
        ['is_long',         0.26453005, 0.87483617, 0.33090458],
        ['tf_SCALP',       -0.28081655, 0.00262123, 0.05113082],
        ['tf_POSITION',    -0.20420651, 0.00131062, 0.03617870],
        ['tf_SWING',        0.05529973, 0.68741809, 0.46354553],
        ['Forward Trades',  0.01565400, 0.45674967, 5.20136119],
        ['tf_INTRADAY',    -0.00841595, 0.30865007, 0.46193636],
      ];
      let z = 1.52863942; // intercept
      for (const [name, coef, mean, std] of M) {
        z += coef * ((metaFeatures[name] || 0) - mean) / (std || 1);
      }
      p._metaWinProb = 1.0 / (1.0 + Math.exp(-z));
      p._metaGrade = p._metaWinProb >= 0.80 ? 'A' : p._metaWinProb >= 0.65 ? 'B' : p._metaWinProb >= 0.50 ? 'C' : p._metaWinProb >= 0.35 ? 'D' : 'F';
    }

    // ── Signal Insight Engine — data-driven badges from 1000+ closed trades ──
    const strat = (p.strategy || '').toLowerCase();
    const sys = (p.source_system || '').toLowerCase();
    const fwdWr = p.strat_fwd_wr ?? p.forward_wr ?? null;
    const fwdTrades = p.strat_fwd_trades ?? p.forward_trades ?? 0;
    const tf = (p.trade_timeframe || '').toUpperCase();
    const dir = (p.direction || '').toUpperCase();
    const agreeCt = p.agreement_count || 0;
    p._signalInsight = null;

    // GOLDEN: Statistically proven (p<0.05 walk-forward + 50+ trades)
    const PROVEN_STRATS = {
      'crypto_keltner_compression_expansion_v1': {wr:66.1, trades:59, pval:0.0007, note:'Walk-forward validated (p=0.0007). WR improved OOS.'},
      'keltner_compression_expansion_sol_v1': {wr:64.1, trades:39, pval:0.049, note:'Walk-forward passed. 64% WR across 39 closed trades.'},
      'multi_period_rsi_confluence_eth': {wr:60.5, trades:38, pval:null, note:'Walk-forward passed. WR improved out-of-sample.'},
      'multi_period_rsi_confluence_xrp': {wr:64.0, trades:25, pval:null, note:'64% WR, best avg PnL (+0.73%) of all strategies.'},
    };
    // DANGER: Known losers (0% WR on forward-tested trades)
    const KILL_STRATS = ['seasonal_factor_rotation','community_london_breakout_v2_forex'];
    const WARN_STRATS = {'hurst_regime_adaptive': {trades:5, note:'Only 5 trades — insufficient sample. Monitor closely.'}};
    const OVERFIT_STRATS = ['drawdown_recovery_rsi']; // 100% train -> 16.7% OOS
    const KILL_SYSTEMS = ['crypto_winners'];
    const WEAK_SYSTEMS = {'luxalgo_filters': {wr:39.6, trades:91, note:'39.6% WR on 91 trades (36W/55L). Below breakeven — monitor. Previously shown as 15.8% from a stale 19-trade snapshot.'}};
    // ETH-specific: RSI recovery works on BTC (80% WR) but FAILS on ETH (6.2% WR)
    const ETH_TRAP = strat.includes('drawdown_recovery_rsi') && (p.symbol||'').toUpperCase().includes('ETH');

    if (PROVEN_STRATS[strat]) {
      const ps = PROVEN_STRATS[strat];
      p._signalInsight = {tier:'GOLDEN', icon:'\u2B50', label:'Proven Edge', color:'#fbbf24',
        detail:`${ps.wr}% WR over ${ps.trades} forward-tested trades. ${ps.note}`};
    } else if (sys === 'deep_value_engine') {
      p._signalInsight = {tier:'GOLDEN', icon:'\u2B50', label:'Hidden Gem', color:'#fbbf24',
        detail:'deep_value_engine: 11/11 wins (100% WR) in paper trading. +$751 total.'};
    } else if (ETH_TRAP) {
      // ETH RSI recovery: 61.5% WR in battleground (16W/10L) but wins were at $1815-1866,
      // losses at $1918+. Current entries above $2100 are uncharted territory.
      const ethEntry = parseFloat(p.entry_price) || 0;
      const ethRisk = ethEntry > 2100 ? 'EXTREME' : ethEntry > 1950 ? 'HIGH' : 'NORMAL';
      if (ethRisk === 'EXTREME') {
        p._signalInsight = {tier:'WARNING', icon:'\u26A0\uFE0F', label:'High Entry', color:'#f97316',
          detail:`drawdown_recovery_rsi_eth: 61.5% WR (16W/10L) in battleground, BUT all wins were at entries $1815-$1866. Losses at $1918+. Current entry $${ethEntry.toFixed(0)} is the highest ever attempted — uncharted territory. Strategy WR may not hold at this price level.`};
      } else if (ethRisk === 'HIGH') {
        p._signalInsight = {tier:'WARNING', icon:'\u26A0\uFE0F', label:'Entry Risk', color:'#f97316',
          detail:`drawdown_recovery_rsi_eth: 61.5% WR but most wins at lower entries ($1815-$1866). Entry at $${ethEntry.toFixed(0)} is in the loss zone ($1918+). Proceed with caution.`};
      }
    } else if (KILL_STRATS.includes(strat)) {
      const tradeMap = {'seasonal_factor_rotation':10, 'community_london_breakout_v2_forex':6};
      const n = tradeMap[strat] || '?';
      p._signalInsight = {tier:'WARNING', icon:'\u26A0\uFE0F', label:'Struggling (0% WR)', color:'#f97316',
        detail:`0% WR on ${n} forward-tested trades. Small sample but concerning. Monitor closely.`};
    } else if (WARN_STRATS[strat]) {
      const ws = WARN_STRATS[strat];
      p._signalInsight = {tier:'WARNING', icon:'\u26A0\uFE0F', label:'Low Sample', color:'#f97316',
        detail: ws.note};
    } else if (OVERFIT_STRATS.includes(strat) && !(p.symbol||'').includes('XRP')) {
      p._signalInsight = {tier:'WARNING', icon:'\u26A0\uFE0F', label:'Overfit Risk', color:'#f97316',
        detail:'Walk-forward collapsed: 100% train WR -> 16.7% OOS. Likely curve-fit. Use with caution.'};
    } else if (KILL_SYSTEMS.includes(sys)) {
      p._signalInsight = {tier:'DANGER', icon:'\u274C', label:'Failing System', color:'#ef4444',
        detail:`${sys}: 0% WR across 10 trades. Losing money consistently.`};
    } else if (WEAK_SYSTEMS[sys]) {
      const wk = WEAK_SYSTEMS[sys];
      p._signalInsight = {tier:'WARNING', icon:'\u26A0\uFE0F', label:'Low WR System', color:'#f97316',
        detail:`${sys}: ${wk.wr}% WR on ${wk.trades} trades. ${wk.note}`};
    } else if (sys === 'kimi_live_signals' || (sys === 'kimi_riseoftheclaw' && agreeCt < 2)) {
      p._signalInsight = {tier:'WARNING', icon:'\uD83E\uDD1E', label:'KIMI Solo', color:'#f97316',
        detail:'KIMI standalone: 8% WR across 340 closed trades. Only trust when 3+ systems agree.'};
    } else if (agreeCt >= 3 && fwdTrades >= 10 && (fwdWr||0) >= 55) {
      p._signalInsight = {tier:'STRONG', icon:'\uD83D\uDCA1', label:'3+ Consensus', color:'#22c55e',
        detail:`${agreeCt} systems agree + ${(fwdWr||0).toFixed(0)}% fwd WR (${fwdTrades} trades). Sweet spot: 3-sys consensus = 78.6% WR historically.`};
    } else if (agreeCt >= 3) {
      p._signalInsight = {tier:'GOOD', icon:'\uD83E\uDD1D', label:'Multi-Agree', color:'#60a5fa',
        detail:`${agreeCt} systems agree on this pick. 3+ consensus historically 78.6% WR.`};
    } else if (fwdTrades >= 20 && (fwdWr||0) >= 60) {
      p._signalInsight = {tier:'STRONG', icon:'\u2705', label:'Fwd Validated', color:'#22c55e',
        detail:`${(fwdWr||0).toFixed(0)}% WR over ${fwdTrades} forward-tested trades. Statistically meaningful sample.`};
    } else if (strat.includes('ml_predictor') && dir === 'SHORT') {
      p._signalInsight = {tier:'GOOD', icon:'\uD83D\uDD0D', label:'ML Short Edge', color:'#60a5fa',
        detail:'ML Predictor SELL signals: 85.7% WR (6/7). BUY signals are 4.2% — short-only edge.'};
    }

    // ── Graduated Allocation Tier Engine (Phase 2 — Mar 16 2026) ──
    // Formal promotion/demotion tiers with allocation limits.
    // S-Core (50% alloc, 1.0x score), A-Viable (30%, 0.6x), B-Probation (15%, 0.3x),
    // C-Recovery (5%, 0.05x), Eliminated (0%, 0x).
    p._allocTier = null;
    const _allocTierDefs = {
      TIER_S_CORE:      {label:'S-Core',      allocation_max:0.50, score_multiplier:1.00, color:'#fbbf24', icon:'\u2B50', desc:'Elite tier: walk-forward proven with statistically significant alpha. Requires WR\u226565%, 50+ trades, PF\u22652.0. Full allocation (50%).'},
      TIER_A_VIABLE:    {label:'A-Viable',     allocation_max:0.30, score_multiplier:0.60, color:'#22c55e', icon:'\u2705', desc:'Strategy shows statistical viability: meets minimum trade count (20+), positive expectancy (WR\u226555%, PF\u22651.5), and passes basic quality gates. Not yet elite but worth allocating to at moderate size (30%).'},
      TIER_B_PROBATION: {label:'B-Probation',  allocation_max:0.15, score_multiplier:0.30, color:'#f97316', icon:'\u26A0\uFE0F', desc:'On notice: strategy has 10+ trades but marginal edge (WR 45-55%). Must improve or face demotion. Reduced allocation (15%).'},
      TIER_C_RECOVERY:  {label:'C-Recovery',   allocation_max:0.05, score_multiplier:0.20, color:'#ef4444', icon:'\u274C', desc:'Last chance: strategy is underperforming (WR 35-45%). Gets 10 more trades to prove itself or faces elimination. Minimal allocation (5%).'},
      ELIMINATED:       {label:'Eliminated',   allocation_max:0.00, score_multiplier:0.02, color:'#64748b', icon:'\uD83D\uDEAB', desc:'Strategy failed to meet minimum viability thresholds. Zero allocation. Requires walk-forward validation to re-enter as C-Recovery.'}
    };
    const _atWr = (fwdWr || 0) / 100;
    const _atTrades = fwdTrades || 0;
    const _atPf = p.strat_fwd_pf ?? p.forward_pf ?? 0;
    if (_atTrades >= 5) {
      let _tierKey = 'ELIMINATED';
      if (_atWr >= 0.65 && _atTrades >= 50 && _atPf >= 2.0) _tierKey = 'TIER_S_CORE';
      else if (_atWr >= 0.55 && _atTrades >= 20 && _atPf >= 1.5) _tierKey = 'TIER_A_VIABLE';
      else if (_atWr >= 0.45 && _atTrades >= 10) _tierKey = 'TIER_B_PROBATION';
      else if (_atWr >= 0.35) _tierKey = 'TIER_C_RECOVERY';
      const _td = _allocTierDefs[_tierKey];
      const _promoPath = {
        TIER_S_CORE: 'Maintain WR\u226560%. Drops below \u2192 A-Viable.',
        TIER_A_VIABLE: 'WR\u226565% + PF\u22652.0 over 20t \u2192 S-Core. WR<50% \u2192 B-Probation.',
        TIER_B_PROBATION: 'WR\u226555% + PF\u22651.5 \u2192 A-Viable. WR<40% \u2192 C-Recovery.',
        TIER_C_RECOVERY: 'Last chance: 10 trades. WR\u226545% \u2192 B-Probation. WR<35% \u2192 Eliminated.',
        ELIMINATED: 'Walk-forward validation required to re-enter as C-Recovery.'
      }[_tierKey] || '';
      p._allocTier = {
        tier: _tierKey, label: _td.label, allocation_max: _td.allocation_max,
        score_multiplier: _td.score_multiplier, color: _td.color, icon: _td.icon,
        wr: (_atWr * 100).toFixed(1), trades: _atTrades, pf: _atPf.toFixed(2),
        promotion_path: _promoPath, desc: _td.desc || '',
        detail: _td.label + ' \u2014 WR:' + (_atWr*100).toFixed(1) + '%, ' + _atTrades + 't, PF:' + _atPf.toFixed(2) + ' | Max alloc: ' + (_td.allocation_max*100).toFixed(0) + '% | Score mult: ' + (_td.score_multiplier*100).toFixed(0) + '%'
      };
    }

    return p;
  });
  let closedPicks = (D.picks?.recent_closed || []).filter(p => matchFilter(p, f));
  closedPicks = closedPicks.filter(p => !isBlockedSystem(p.source_system));

  // Store for AI analysis modal lookup
  window._renderedPicks = activePicks;

  // Apply advanced dropdown sort or column header sort
  if (f.sort) {
    activePicks = advancedSort(activePicks, f.sort);
    closedPicks = advancedSort(closedPicks, f.sort);
  } else {
    activePicks = sortPicks(activePicks, sortCol);
    closedPicks = sortPicks(closedPicks, sortCol);
  }

  // Show active filters summary with NAMES of active filters
  const activeFilters = [];
  if (f.pnl) activeFilters.push({name: 'PnL', val: f.pnl === 'pos' ? '>0%' : f.pnl === 'neg' ? '<0%' : f.pnl === 'gt5' ? '>5%' : '>10%'});
  if (f.conf) activeFilters.push({name: 'Conf', val: '≥' + f.conf});
  if (f.age) activeFilters.push({name: 'Age', val: '≤' + f.age + 'h'});
  if (f.tpRem) activeFilters.push({name: 'TP Rem', val: '≤' + f.tpRem + '%'});
  if (f.sort) activeFilters.push({name: 'Sort', val: f.sort.replace(/_/g,' ')});
  if (f.dir) activeFilters.push({name: 'Dir', val: f.dir});
  if (f.asset) activeFilters.push({name: 'Asset', val: f.asset});
  if (f.system) activeFilters.push({name: 'System', val: f.system.replace(/_/g,' ')});
  if (f.conflicts && f.conflicts !== '') activeFilters.push({name: 'Conflicts', val: f.conflicts});
  if (window._provenOnlyFilter) activeFilters.push({name: 'Tier', val: 'PROVEN only'});
  if (window._scoreGateFilter) activeFilters.push({name: 'Gate', val: 'Score ≥ 24'});
  const filterNote = activeFilters.length > 0
    ? ` <span style="color:var(--purple);font-size:12px">(${activeFilters.length} filter${activeFilters.length>1?'s':''}: ${activeFilters.map(f => `<span style="background:rgba(167,139,250,0.15);padding:1px 6px;border-radius:3px;margin:0 2px" title="${f.name}: ${f.val}">${f.name}=${f.val}</span>`).join(' ')})</span>`
    : '';

  // Correlation warning: detect ≥3 picks with same strategy+direction on different symbols
  let corrWarnings = '';
  const corrGroups = {};
  (D.picks?.active || []).forEach(p => {
    const key = (p.strategy||'') + '|' + (p.direction||'');
    if (!corrGroups[key]) corrGroups[key] = [];
    corrGroups[key].push(p.symbol);
  });
  const corrAlerts = Object.entries(corrGroups)
    .filter(([, syms]) => new Set(syms).size >= 3)
    .map(([key, syms]) => {
      const [strat, dir] = key.split('|');
      const uniq = [...new Set(syms)];
      return `<div style="background:rgba(245,158,11,0.1);border:1px solid var(--yellow);border-radius:6px;padding:8px 12px;margin-bottom:8px;font-size:12px"><strong style="color:var(--yellow)">\u26a0 Correlated exposure:</strong> <span style="color:var(--text)">${strat.replace(/_/g,' ')} ${dir} on ${uniq.join(', ')} (${uniq.length} assets)</span></div>`;
    });
  if (corrAlerts.length) corrWarnings = corrAlerts.join('');

  // Conflict warning: same symbol with LONG+SHORT simultaneously
  const symbolDirs = {};
  (D.picks?.active || []).forEach(p => {
    const sym = p.symbol || '';
    if (!symbolDirs[sym]) symbolDirs[sym] = {LONG:[], SHORT:[]};
    if (p.direction === 'LONG') symbolDirs[sym].LONG.push(p.strategy);
    else if (p.direction === 'SHORT') symbolDirs[sym].SHORT.push(p.strategy);
  });
  const conflictEntries = Object.entries(symbolDirs)
    .filter(([, dirs]) => dirs.LONG.length > 0 && dirs.SHORT.length > 0);
  if (conflictEntries.length) {
    let cHtml = '<div style="background:#2d1b1b;border:1px solid #ef4444;border-radius:8px;padding:12px 16px;margin-bottom:16px;">';
    cHtml += '<div style="color:#ef4444;font-weight:600;margin-bottom:8px">\u26a0\ufe0f Direction Conflicts Detected</div>';
    conflictEntries.forEach(([sym, dirs]) => {
      const lc = dirs.LONG.length, sc = dirs.SHORT.length;
      const net = lc > sc ? 'LONG' : sc > lc ? 'SHORT' : 'NEUTRAL';
      const netColor = net === 'LONG' ? '#22c55e' : net === 'SHORT' ? '#ef4444' : '#eab308';
      cHtml += `<div style="color:#fca5a5;font-size:13px;margin:4px 0;">${sym}: LONG \u00d7${lc} (${dirs.LONG.slice(0,3).map(s=>s.replace(/_/g,' ')).join(', ')}${lc>3?'...':''}) vs SHORT \u00d7${sc} (${dirs.SHORT.slice(0,3).map(s=>s.replace(/_/g,' ')).join(', ')}${sc>3?'...':''}) \u2014 NET <span style="color:${netColor};font-weight:600">${net}</span> \u2014 ${lc+sc} systems conflicting</div>`;
    });
    cHtml += '</div>';
    corrWarnings += cHtml;
  }

  // Populate Warnings tab (conflicts & correlated exposure)
  const warnCount = (corrAlerts.length || 0) + conflictEntries.length;
  const warnBtnEl = document.getElementById('tab-btn-warnings');
  if (warnCount > 0) {
    if (warnBtnEl) { warnBtnEl.style.display = ''; warnBtnEl.innerHTML = '\u26a0\ufe0f Warnings <span style="background:#ef4444;color:#fff;border-radius:10px;padding:1px 6px;font-size:10px;margin-left:4px">'+warnCount+'</span>'; }
    el('tab-warnings').innerHTML = `<h2 style="margin-bottom:12px">\u26a0\ufe0f ${warnCount} Warning${warnCount!==1?'s':''}</h2>
      <p style="color:var(--text-dim);font-size:12px;margin-bottom:12px">Direction conflicts (LONG vs SHORT on same symbol) and correlated exposure (same strategy on 3+ assets).</p>
      ${corrWarnings}`;
  } else {
    if (warnBtnEl) warnBtnEl.style.display = 'none';
    el('tab-warnings').innerHTML = '<div class="empty-state">No warnings detected.</div>';
  }
  // Small inline link to warnings tab from active picks (non-intrusive)
  let warningSection = '';
  if (warnCount > 0) {
    warningSection = `<div style="margin-bottom:8px;font-size:12px;color:#ef4444;cursor:pointer" onclick="document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));document.querySelectorAll('.tab-content').forEach(c=>c.classList.remove('active'));document.getElementById('tab-btn-warnings').classList.add('active');document.getElementById('tab-warnings').classList.add('active');">\u26a0\ufe0f ${warnCount} warning${warnCount!==1?'s':''} (conflicts & correlated exposure) \u2014 <u>view Warnings tab</u></div>`;
  }
  // Regime banner
  const regimeColor = _marketRegime === 'BEARISH' ? '#ef4444' : _marketRegime === 'CHOPPY' ? '#f59e0b' : _marketRegime === 'UNKNOWN' ? '#6b7280' : '#22c55e';
  const regimeIcon = _marketRegime === 'BEARISH' ? '🔴' : _marketRegime === 'CHOPPY' ? '🟡' : _marketRegime === 'UNKNOWN' ? '⚪' : '🟢';
  const _displayPnl = (_regimePnl??0).toFixed(2);
  const regimeTip = _marketRegime === 'BEARISH'
    ? `${_pctLongsLosing > 0 ? Math.round(_pctLongsLosing*100) : 0}% of LONGs are losing (median ${_displayPnl}%). LONG picks penalized -30%. Consider SHORT or cash.`
    : _marketRegime === 'CHOPPY'
    ? `${_pctLongsLosing > 0 ? Math.round(_pctLongsLosing*100) : 0}% of LONGs are losing (median ${_displayPnl}%). LONG picks penalized -15%. Mixed signals.`
    : _marketRegime === 'UNKNOWN'
    ? `Insufficient data — need ≥5 active LONG picks with non-zero PnL to detect regime. No scoring penalty applied.`
    : `LONGs performing well (median ${_displayPnl}%). Trending bullish.`;
  const regimeBanner = `<div style="background:${regimeColor}15;border:1px solid ${regimeColor}55;border-radius:8px;padding:8px 14px;margin-bottom:12px;display:flex;align-items:center;gap:8px;font-size:13px"><span style="font-size:16px">${regimeIcon}</span><span style="color:${regimeColor};font-weight:600">Market Regime: ${_marketRegime}</span><span style="color:#9ca3af">— ${regimeTip}</span></div>`;

  // Count resolved picks from ALL data (before filtering) for toggle button + info
  const _allRaw = (D.picks?.active || []);
  const _tpHitCount = _allRaw.filter(p => p._resolved_live === 'TP_HIT' || p.status === 'TP_HIT' || p.outcome === 'TP_HIT').length;
  const _slHitCount = _allRaw.filter(p => p._resolved_live === 'SL_HIT' || p.status === 'SL_HIT' || p.outcome === 'SL_HIT').length;
  const _tpLabel = _tpHitCount > 0 ? `${window._showTpHitPicks ? 'Hide' : 'Show'} TP Winners (${_tpHitCount})` : (window._showTpHitPicks ? 'Hide TP Winners' : 'Show TP Winners');
  const _tpHitBtn = ` <button id="btn-tp-hit-toggle" style="background:${window._showTpHitPicks ? 'linear-gradient(135deg,#22c55e,#059669)' : 'linear-gradient(135deg,#374151,#1f2937)'};color:#fff;border:none;border-radius:6px;padding:4px 12px;font-weight:600;font-size:11px;cursor:pointer;vertical-align:middle;margin-left:8px" title="Show/hide picks that already hit Take Profit. These are winners but no longer active entries.">${_tpLabel}</button>`;
  const _resolvedNote = (_tpHitCount + _slHitCount) > 0 ? ` <span style="font-size:11px;color:#6b7280;margin-left:4px">(${_tpHitCount} TP + ${_slHitCount} SL resolved, hidden)</span>` : '';
  el('tab-active').innerHTML = regimeBanner + warningSection + `<h2 style="margin-bottom:12px">Active Picks (${activePicks.length})${filterNote}${_tpHitBtn}${_resolvedNote}</h2>` + picksTable(activePicks, activeCols);
  // Wire TP HIT toggle button
  const _tpBtn = document.getElementById('btn-tp-hit-toggle');
  if (_tpBtn) _tpBtn.addEventListener('click', () => { window._showTpHitPicks = !window._showTpHitPicks; renderSummary(); renderPicks(); });
  el('tab-closed').innerHTML = `<h2 style="margin-bottom:12px">Recent Closed Picks (${closedPicks.length})${filterNote}</h2>` + picksTable(closedPicks, closedCols);

  // Wire sorting
  document.querySelectorAll('.data-table th[data-col]').forEach(th => {
    th.addEventListener('click', () => {
      const col = th.dataset.col;
      if (sortCol === col) sortAsc = !sortAsc;
      else { sortCol = col; sortAsc = true; }
      el('f-sort').value = '';  // Clear dropdown sort when using column header
      renderPicks();
    });
  });
  // Score tooltip hover
  document.querySelectorAll('.score-badge').forEach(badge => {
    const tip = badge.parentElement.querySelector('.score-tip');
    if (tip) {
      badge.addEventListener('mouseenter', () => { tip.style.display = 'block'; });
      badge.addEventListener('mouseleave', () => { tip.style.display = 'none'; });
    }
  });
}

// ── Overview tab ──
function renderOverview() {
  const ac = D.performance?.by_asset_class || {};
  function drillLink(count, filterKey, filterVal, tab) {
    return `<a href="#" class="drill-link" data-filter-key="${filterKey}" data-filter-val="${filterVal}" data-tab="${tab||'active'}" style="color:inherit;text-decoration:underline dotted;cursor:pointer">${count}</a>`;
  }

  let acRows = '';
  for (const [cls, data] of Object.entries(ac)) {
    const total = data.wins + data.losses;
    acRows += `<tr>
      <td>${acBadge(cls)}</td>
      <td class="num">${drillLink(data.active, 'f-asset', cls, 'active')}</td>
      <td class="num">${drillLink(data.closed, 'f-asset', cls, 'closed')}</td>
      <td class="num">${data.wins}</td>
      <td class="num">${data.losses}</td>
      <td class="num">${total > 0 ? fmt(data.win_rate) + '%' : '\u2014'}</td>
      <td class="num ${pnlClass(data.pnl)}">${fmtPct(data.pnl)}</td>
      <td class="num" style="color:${(data.profit_factor||0)>=1?'var(--green)':'var(--red)'}">${data.profit_factor!=null ? fmt(data.profit_factor,2) : '\u2014'}</td>
      <td class="num">${data.avg_win ? '+'+fmt(data.avg_win,2)+'%' : '\u2014'}</td>
      <td class="num">${data.avg_loss ? '-'+fmt(data.avg_loss,2)+'%' : '\u2014'}</td>
      <td class="num" style="color:${(data.expectancy||0)>=0?'var(--green)':'var(--red)'}">${data.expectancy!=null ? (data.expectancy>=0?'+':'')+fmt(data.expectancy,2)+'%' : '\u2014'}</td>
    </tr>`;
  }

  // ── Quant-Style System Ranking (industry standard composite score) ──
  // Methodology: Composite score from multiple risk-adjusted metrics, each converted to a percentile
  // rank within the universe. Modeled after CTA Challenge, BarclayHedge, and fund-of-funds due diligence.
  const rankedSys = [...(D.systems || [])].filter(s => s.closed_picks >= 5 && !isBlockedSystem(s.name));

  // Compute composite score for each system
  rankedSys.forEach(s => {
    const wr = s.win_rate || 0;
    const pf = s.profit_factor || 0;
    const exp = s.expectancy || 0;
    const pnl = s.total_pnl_pct || 0;
    const closed = s.closed_picks || 0;

    // Sharpe-like ratio: (avg_pnl / volatility proxy) — use PnL per trade / WR variance as proxy
    const avgPnl = closed > 0 ? pnl / closed : 0;
    const wrVariance = wr * (100 - wr) / 100; // binomial variance proxy
    s._sharpeProxy = wrVariance > 0 ? (avgPnl / Math.sqrt(wrVariance)) * 10 : 0;

    // Calmar-like: return / max drawdown proxy (use worst-case loss estimate)
    s._calmarProxy = (s.max_drawdown && s.max_drawdown < 0) ? Math.abs(pnl / s.max_drawdown) : (pnl > 0 ? 2.0 : 0);

    // Track record length score (0-100)
    s._trackRecord = Math.min(100, closed * 2); // 50 trades = 100

    // Tier classification for badge
    const nm = (s.name || '').toLowerCase();
    s._tier = 'SANDBOX';
    for (const k of Object.keys(_TRUST_PROVEN_SYSTEMS)) { if (nm.includes(k)) { s._tier = 'PROVEN'; break; } }
    for (const k of Object.keys(_TRUST_PROBATION)) { if (nm.includes(k)) { s._tier = 'PROBATION'; break; } }
  });

  // Compute percentile ranks for each metric
  function percentileRank(arr, value) {
    const below = arr.filter(v => v < value).length;
    return arr.length > 1 ? (below / (arr.length - 1)) * 100 : 50;
  }
  const wrArr = rankedSys.map(s => s.win_rate || 0);
  const pfArr = rankedSys.map(s => s.profit_factor || 0);
  const expArr = rankedSys.map(s => s.expectancy || 0);
  const sharpeArr = rankedSys.map(s => s._sharpeProxy || 0);
  const trackArr = rankedSys.map(s => s._trackRecord || 0);

  rankedSys.forEach(s => {
    // Composite = 30% WR + 25% PF + 20% Expectancy + 15% Sharpe proxy + 10% Track Record
    s._composite = Math.round(
      0.30 * percentileRank(wrArr, s.win_rate || 0) +
      0.25 * percentileRank(pfArr, s.profit_factor || 0) +
      0.20 * percentileRank(expArr, s.expectancy || 0) +
      0.15 * percentileRank(sharpeArr, s._sharpeProxy || 0) +
      0.10 * percentileRank(trackArr, s._trackRecord || 0)
    );
    // Quartile badge
    s._quartile = s._composite >= 75 ? 'Q1' : s._composite >= 50 ? 'Q2' : s._composite >= 25 ? 'Q3' : 'Q4';
  });

  // Sort by composite score
  rankedSys.sort((a, b) => b._composite - a._composite);
  const topSys = rankedSys.slice(0, 15);

  const qColors = {Q1: '#22c55e', Q2: '#60a5fa', Q3: '#f59e0b', Q4: '#ef4444'};
  const tierBadges = {PROVEN: '\u2605', PROBATION: '\u26a0', SANDBOX: '\u2610'};
  let sysRows = topSys.map((s, i) => {
    const qColor = qColors[s._quartile];
    const rank = i + 1;
    const tierIcon = tierBadges[s._tier] || '';
    const tierColor = s._tier === 'PROVEN' ? '#22c55e' : s._tier === 'PROBATION' ? '#f59e0b' : 'var(--text-dim)';
    const compositeTitle = `Composite Score: ${s._composite}/100\nWR Percentile: ${Math.round(percentileRank(wrArr, s.win_rate||0))}%\nPF Percentile: ${Math.round(percentileRank(pfArr, s.profit_factor||0))}%\nExpectancy Percentile: ${Math.round(percentileRank(expArr, s.expectancy||0))}%\nSharpe Proxy Percentile: ${Math.round(percentileRank(sharpeArr, s._sharpeProxy||0))}%\nTrack Record: ${s.closed_picks} trades`;
    return `<tr>
    <td style="text-align:center;font-weight:700;color:${qColor}">#${rank}</td>
    <td><span style="background:${qColor}22;color:${qColor};padding:1px 6px;border-radius:3px;font-size:10px;font-weight:600;margin-right:4px">${s._quartile}</span>${sysLink(s.name)} <span style="color:${tierColor};font-size:9px">${tierIcon}</span></td>
    <td class="num">${drillLink(s.active_picks, 'f-system', s.name, 'active')}</td>
    <td class="num">${drillLink(s.closed_picks, 'f-system', s.name, 'closed')}</td>
    <td class="num" style="color:${(s.win_rate||0)>=50?'var(--green)':'var(--red)'}; font-weight:600">${fmt(Math.min(100, s.win_rate||0))}%</td>
    <td class="num ${pnlClass(s.total_pnl_pct)}">${fmtPct(s.total_pnl_pct)}</td>
    <td class="num" style="color:${(s.profit_factor||0)>=1?'var(--green)':'var(--red)'}">${s.profit_factor!=null ? fmt(s.profit_factor,2) : '\u2014'}</td>
    <td class="num" style="color:${(s.expectancy||0)>=0?'var(--green)':'var(--red)'}">${s.expectancy!=null ? (s.expectancy>=0?'+':'')+fmt(s.expectancy,2)+'%' : '\u2014'}</td>
    <td class="num" style="text-align:center;cursor:help" title="${compositeTitle}"><span style="background:${qColor}22;color:${qColor};padding:2px 8px;border-radius:4px;font-weight:700;font-size:13px">${s._composite}</span></td>
    <td style="white-space:nowrap;font-size:11px;color:var(--text-dim)">${s.last_signal_at ? toEST(s.last_signal_at) : '\u2014'}</td>
    <td>${statusBadge(s.status)}</td>
  </tr>`}).join('');

  // ── Performance Breakdown by Category ──
  // Group systems by tier and WR threshold to show "the good within the horrible"
  const allSys = (D.systems || []).filter(s => (s.closed_picks || 0) >= 1 && !isBlockedSystem(s.name));
  function classifySysTier(s) {
    const nm = (s.name || '').toLowerCase();
    for (const k of Object.keys(_TRUST_PROBATION)) { if (nm.includes(k)) return 'PROBATION'; }
    for (const k of Object.keys(_TRUST_PROVEN_SYSTEMS)) { if (nm.includes(k)) return 'PROVEN'; }
    for (const k of Object.keys(_TRUST_DEMOTED)) { if (nm.includes(k)) return 'DEMOTED'; }
    return 'SANDBOX';
  }
  const tierGroups = {PROVEN: [], SANDBOX: [], PROBATION: [], DEMOTED: []};
  allSys.forEach(s => { const t = classifySysTier(s); tierGroups[t].push(s); });

  function tierAgg(systems) {
    // Derive wins/losses from win_rate + closed_picks since backend doesn't send them directly
    const wins = systems.reduce((a,s) => {
      if (s.wins != null) return a + s.wins;
      const c = s.closed_picks || 0;
      const wr = (s.win_rate || 0) / 100;
      return a + Math.round(c * wr);
    }, 0);
    const losses = systems.reduce((a,s) => {
      if (s.losses != null) return a + s.losses;
      const c = s.closed_picks || 0;
      const wr = (s.win_rate || 0) / 100;
      return a + Math.round(c * (1 - wr));
    }, 0);
    const totalPnl = systems.reduce((a,s) => a + (s.total_pnl_pct||0), 0);
    const wr = (wins+losses) > 0 ? (wins/(wins+losses)*100) : 0;
    const closed = systems.reduce((a,s) => a + (s.closed_picks||0), 0);
    const active = systems.reduce((a,s) => a + (s.active_picks||0), 0);
    const sysWins = (s) => s.wins != null ? s.wins : Math.round((s.closed_picks||0) * (s.win_rate||0) / 100);
    const sysLosses = (s) => s.losses != null ? s.losses : Math.round((s.closed_picks||0) * (1 - (s.win_rate||0) / 100));
    const grossWin = systems.reduce((a,s) => a + (s.gross_win||s.avg_win||0)*sysWins(s), 0);
    const grossLoss = systems.reduce((a,s) => a + Math.abs(s.gross_loss||s.avg_loss||0)*sysLosses(s), 0);
    const pf = grossLoss > 0 ? grossWin / grossLoss : (grossWin > 0 ? 99 : 0);
    return {count: systems.length, active, closed, wins, losses, wr, totalPnl, pf};
  }

  const wrGood = allSys.filter(s => s.win_rate >= 50 && (s.closed_picks||0) >= 5);
  const wrBad = allSys.filter(s => s.win_rate < 50 && (s.closed_picks||0) >= 5);

  const tierColors = {PROVEN:'#22c55e', SANDBOX:'#a78bfa', PROBATION:'#f59e0b', DEMOTED:'#ef4444'};
  const tierIcons = {PROVEN:'\u2605', SANDBOX:'\u2610', PROBATION:'\u26a0', DEMOTED:'\u2716'};

  const tierExplain = {
    'Proven Systems': 'Systems containing statistically proven strategies (e.g. Connors RSI-2: 75.7% WR, VIX Spike: 72% WR). NOTE: The dashboard WR shown is the aggregate across ALL strategies in the system — including experimental ones still being tested. Individual proven strategies perform much better than the system-wide average. A system is classified as Proven if it contains at least one forward-verified strategy with significant results. Picks get full (100%) trust weight in scoring.',
    'Sandbox (Unproven)': 'New or unverified systems still accumulating trade history. Need 50+ closed trades to graduate. Picks get reduced trust weight (25%) until proven. Most systems start here.',
    'Probation': 'Systems with documented poor performance — broken risk management, garbage entries, or consistently losing. Picks get minimal weight (10-15%). Must show sustained improvement to exit probation.',
    'Demoted': 'Previously promising strategies that failed on specific assets (e.g., RSI confluence works on ETH but fails on SOL/DOGE). Picks get 25% weight. The strategy itself may be valid on other pairs.'
  };

  function tierRow(label, color, icon, agg, sysNames, systems) {
    if (agg.closed === 0 && agg.active === 0) return '';
    const rowId = 'tier-expand-' + label.replace(/[^a-zA-Z]/g, '');
    const explain = tierExplain[label] || '';
    const infoTip = explain ? ` <span class="sys-desc-tip" style="font-size:11px">\u24D8<span class="sys-desc-popup" style="min-width:280px"><b>${label}</b><br>${explain}</span></span>` : '';
    // Build expandable system list
    let expandHtml = '';
    if (systems && systems.length > 0) {
      const sysRows = systems.map(s => {
        const wr = s.win_rate != null ? fmt(s.win_rate,1) + '%' : 'n/a';
        const pnl = s.total_pnl_pct != null ? fmtPct(s.total_pnl_pct) : 'n/a';
        const pnlC = (s.total_pnl_pct||0) >= 0 ? 'pnl-pos' : 'pnl-neg';
        const closed = s.closed_picks || 0;
        const active = s.active_picks || 0;
        const sysLink = sysLinks[(s.name||'').toLowerCase()] || sysLinks[s.name||''] || '';
        const nameHtml = sysLink ? '<a href="'+sysLink+'" target="_blank" style="color:inherit;text-decoration:underline dotted">'+s.name.replace(/_/g,' ')+'</a>' : s.name.replace(/_/g,' ');
        const provenKey = label === 'Proven Systems' ? Object.keys(_TRUST_PROVEN_SYSTEMS).find(k=>(s.name||'').toLowerCase().includes(k)) : null;
        const provenData = provenKey ? _TRUST_PROVEN_SYSTEMS[provenKey] : null;
        const reason = label === 'Probation' ? (_TRUST_PROBATION[Object.keys(_TRUST_PROBATION).find(k=>(s.name||'').toLowerCase().includes(k))]?.reason || '') :
                       label === 'Demoted' ? (_TRUST_DEMOTED[Object.keys(_TRUST_DEMOTED).find(k=>(s.name||'').toLowerCase().includes(k))]?.reason || '') :
                       provenData ? provenData.reason : '';
        const bestWrHtml = (provenData && provenData.bestWR && s.win_rate < 50) ? ' <span style="color:#22c55e;font-size:10px;margin-left:4px" title="System-wide WR is low because it aggregates 100+ strategies. Best proven strategy: '+provenData.bestStrat+' at '+provenData.bestWR+' WR">[best: '+provenData.bestWR+' '+provenData.bestStrat+']</span>' : '';
        const reasonHtml = reason ? '<span style="color:var(--text-dim);font-size:10px;margin-left:6px">'+reason+'</span>' : '';
        const sWins = s.wins != null ? s.wins : Math.round((s.closed_picks||0) * (s.win_rate||0) / 100);
        const sLosses = s.losses != null ? s.losses : Math.round((s.closed_picks||0) * (1 - (s.win_rate||0) / 100));
        const sGrossWin = (s.gross_win||s.avg_win||0)*sWins;
        const sGrossLoss = Math.abs(s.gross_loss||s.avg_loss||0)*sLosses;
        const sPf = sGrossLoss > 0 ? (sGrossWin / sGrossLoss) : (sGrossWin > 0 ? 99 : 0);
        return '<tr class="tier-sub-'+rowId+'" style="display:none;background:rgba(255,255,255,0.02)"><td style="padding-left:28px;font-size:12px">'+nameHtml+reasonHtml+'</td><td class="num" style="font-size:12px"></td><td class="num" style="font-size:12px">'+active+'</td><td class="num" style="font-size:12px">'+closed+'</td><td class="num" style="font-size:12px">'+sWins+'</td><td class="num" style="font-size:12px">'+sLosses+'</td><td class="num" style="font-size:12px;color:'+(s.win_rate>=50?'var(--green)':'var(--red)')+'">'+wr+bestWrHtml+'</td><td class="num '+pnlC+'" style="font-size:12px">'+pnl+'</td><td class="num" style="font-size:12px;color:'+(sPf>=1?'var(--green)':'var(--red)')+'">'+( sPf < 90 ? fmt(sPf,2) : '\u221e')+'</td></tr>';
      }).join('');
      expandHtml = sysRows;
      // Add footnote for Proven Systems explaining WR discrepancy
      if (label === 'Proven Systems') {
        expandHtml += '<tr class="tier-sub-'+rowId+'" style="display:none;background:rgba(34,197,94,0.04)"><td colspan="9" style="padding:6px 28px;font-size:11px;color:var(--text-dim);border-top:1px dashed rgba(255,255,255,0.06)"><span style="color:#f59e0b">\u26A0</span> <b>Why do some Proven systems show low WR?</b> Each system runs many strategies (alpha_engine has 100+). The WR shown is the <em>aggregate</em> across all strategies, including experimental ones. The system is Proven because it contains individually verified strategies (e.g. Connors RSI-2: 75.7% WR, VIX Spike: 72%) that consistently outperform. A low system-wide WR with positive Total PnL means the winning strategies\' gains outweigh the losers.</td></tr>';
      }
    }
    return `<tr style="cursor:pointer" onclick="document.querySelectorAll('.tier-sub-${rowId}').forEach(r=>{r.style.display=r.style.display==='none'?'table-row':'none';});this.querySelector('.tier-arrow').textContent=document.querySelector('.tier-sub-${rowId}')?.style.display==='none'?'\u25B6':'\u25BC';">
      <td style="color:${color};font-weight:600"><span class="tier-arrow" style="font-size:10px;margin-right:4px">\u25B6</span>${icon} ${label}${infoTip}</td>
      <td class="num">${agg.count}</td>
      <td class="num">${agg.active}</td>
      <td class="num">${agg.closed}</td>
      <td class="num">${agg.wins}</td>
      <td class="num">${agg.losses}</td>
      <td class="num" style="color:${agg.wr>=50?'var(--green)':'var(--red)'}; font-weight:600">${fmt(agg.wr)}%</td>
      <td class="num ${pnlClass(agg.totalPnl)}" style="font-weight:600">${fmtPct(agg.totalPnl)}</td>
      <td class="num" style="color:${agg.pf>=1?'var(--green)':'var(--red)'}">${agg.pf < 90 ? fmt(agg.pf,2) : '\u221e'}</td>
    </tr>${expandHtml}`;
  }

  const provenAgg = tierAgg(tierGroups.PROVEN);
  const sandboxAgg = tierAgg(tierGroups.SANDBOX);
  const probationAgg = tierAgg(tierGroups.PROBATION);
  const demotedAgg = tierAgg(tierGroups.DEMOTED);
  const wrGoodAgg = tierAgg(wrGood);
  const wrBadAgg = tierAgg(wrBad);

  let breakdownRows = '';
  breakdownRows += tierRow('Proven Systems', tierColors.PROVEN, tierIcons.PROVEN, provenAgg, tierGroups.PROVEN.map(s=>s.name), tierGroups.PROVEN);
  breakdownRows += tierRow('Sandbox (Unproven)', tierColors.SANDBOX, tierIcons.SANDBOX, sandboxAgg, tierGroups.SANDBOX.map(s=>s.name), tierGroups.SANDBOX);
  breakdownRows += tierRow('Probation', tierColors.PROBATION, tierIcons.PROBATION, probationAgg, tierGroups.PROBATION.map(s=>s.name), tierGroups.PROBATION);
  breakdownRows += tierRow('Demoted', tierColors.DEMOTED, tierIcons.DEMOTED, demotedAgg, tierGroups.DEMOTED.map(s=>s.name), tierGroups.DEMOTED);
  breakdownRows += `<tr style="border-top:2px solid var(--border)"><td colspan="9" style="height:4px"></td></tr>`;
  breakdownRows += tierRow('Systems WR \u2265 50% (min 5)', '#22c55e', '\u2713', wrGoodAgg, wrGood.map(s=>s.name), wrGood);
  breakdownRows += tierRow('Systems WR < 50% (min 5)', '#ef4444', '\u2717', wrBadAgg, wrBad.map(s=>s.name), wrBad);

  const breakdownHTML = `
    <h2 style="margin-bottom:4px">Performance Breakdown</h2>
    <p style="color:var(--text-dim);font-size:12px;margin:0 0 10px">Why overall stats look bad: unproven sandbox systems drag down the average. Click any tier row to expand and see individual systems.</p>
    <table class="data-table"><thead><tr>
      <th>Category</th><th class="num">Systems</th><th class="num col-tip" data-tip="Active = currently open positions (trades not yet closed). These are live, in-progress trades.">Active</th><th class="num col-tip" data-tip="Closed = completed trades with a final P&L result. Only closed trades count for win rate and performance.">Closed</th><th class="num">Wins</th><th class="num">Losses</th>
      <th class="num">Win Rate</th><th class="num">Total PnL</th><th class="num col-tip" data-tip="Profit Factor = gross wins / gross losses. Above 1.0 = profitable. Above 1.5 = strong.">PF</th>
    </tr></thead><tbody>${breakdownRows}</tbody></table>
    <div style="margin:10px 0 20px;padding:8px 14px;background:rgba(34,197,94,0.08);border:1px solid rgba(34,197,94,0.3);border-radius:8px;font-size:12px;color:var(--text-dim)">
      <strong style="color:var(--green)">Key insight:</strong> Trading only systems with WR \u2265 50% yields <strong style="color:var(--green)">${fmt(wrGoodAgg.wr)}% WR</strong> and <strong style="color:${wrGoodAgg.totalPnl>=0?'var(--green)':'var(--red)'}">${fmtPct(wrGoodAgg.totalPnl)} total PnL</strong> vs ${fmtPct(wrBadAgg.totalPnl)} for WR < 50% systems. The Score column already weights this.
    </div>`;

  // ── Systems with Active Picks AND Positive History ──
  const activePositiveSys = allSys.filter(s => (s.active_picks||0) > 0 && (s.total_pnl_pct||0) > 0 && (s.closed_picks||0) >= 3);
  activePositiveSys.sort((a,b) => (b.total_pnl_pct||0) - (a.total_pnl_pct||0));
  let activePositiveHTML = '';
  if (activePositiveSys.length > 0) {
    const apRows = activePositiveSys.map(s => {
      const sUrl = sysLinks[(s.name||'').toLowerCase()] || sysLinks[s.name||''] || '';
      const nameHtml = sUrl ? '<a href="'+sUrl+'" target="_blank" style="color:var(--cyan);text-decoration:underline dotted">'+s.name.replace(/_/g,' ')+'</a>' : s.name.replace(/_/g,' ');
      const tier = classifySysTier(s);
      const tierBadge = tier === 'PROVEN' ? '<span style="color:#22c55e;font-size:10px;margin-left:3px">\u2605</span>' : tier === 'PROBATION' ? '<span style="color:#f59e0b;font-size:10px;margin-left:3px">\u26a0</span>' : '';
      const wr = s.win_rate != null ? fmt(s.win_rate,1) : 'n/a';
      return `<tr>
        <td>${nameHtml}${tierBadge}</td>
        <td class="num" style="color:var(--cyan);font-weight:600">${s.active_picks}</td>
        <td class="num">${s.closed_picks||0}</td>
        <td class="num" style="color:${s.win_rate>=50?'var(--green)':'var(--red)'}; font-weight:600">${wr}%</td>
        <td class="num pnl-pos" style="font-weight:600">${fmtPct(s.total_pnl_pct)}</td>
      </tr>`;
    }).join('');
    activePositiveHTML = `
    <div style="margin:0 0 20px;padding:12px 16px;background:rgba(34,197,94,0.06);border:1px solid rgba(34,197,94,0.25);border-radius:8px;">
      <h3 style="font-size:14px;color:var(--green);margin:0 0 6px;">\u2705 Systems with Active Picks AND Positive History <span style="font-size:11px;color:var(--text-dim);font-weight:400">(${activePositiveSys.length} systems currently generating profitable signals)</span></h3>
      <p style="font-size:11px;color:var(--text-dim);margin:0 0 8px;">These systems have open positions right now AND a positive historical track record (min 3 closed trades).</p>
      <table class="data-table" style="margin:0"><thead><tr>
        <th>System</th><th class="num">Active Picks</th><th class="num">Closed</th><th class="num">Win Rate</th><th class="num">Total PnL</th>
      </tr></thead><tbody>${apRows}</tbody></table>
    </div>`;
  }

  el('tab-overview').innerHTML = breakdownHTML + activePositiveHTML + `
    <h2 style="margin-bottom:12px">Asset Class Breakdown</h2>
    <table class="data-table"><thead><tr>
      <th>Asset Class</th><th class="num">Active</th><th class="num">Closed</th><th class="num">Wins</th><th class="num">Losses</th>
      <th class="num col-tip" data-tip="Win Rate = Percentage of trades that were profitable.">Win Rate</th>
      <th class="num col-tip" data-tip="Total cumulative PnL across all closed trades.">PnL</th>
      <th class="num col-tip" data-tip="Profit Factor = gross wins / gross losses. >1.0 = profitable system. The KEY metric explaining why 44% WR = negative PnL.">PF</th>
      <th class="num col-tip" data-tip="Average PnL of winning trades.">Avg Win</th>
      <th class="num col-tip" data-tip="Average PnL of losing trades.">Avg Loss</th>
      <th class="num col-tip" data-tip="Expectancy = expected PnL per trade = (WR\u00d7AvgWin) \u2212 (LR\u00d7AvgLoss). Positive = profitable over time.">Expect.</th>
    </tr></thead><tbody>${acRows}</tbody></table>

    <h2 style="margin:20px 0 12px">System Leaderboard <span style="font-size:12px;color:var(--text-dim);font-weight:400">— Composite Ranking (min 5 closed trades)</span></h2>
    <p style="color:var(--text-dim);font-size:12px;margin:0 0 10px">Ranked by a composite score modeled after institutional fund-of-funds methodology. Each system is scored across 5 dimensions (Win Rate 30%, Profit Factor 25%, Expectancy 20%, Risk-Adjusted Return 15%, Track Record Length 10%), then ranked by percentile within the universe. <strong>Q1</strong> = top quartile, <strong>Q4</strong> = bottom. Hover the score for a full breakdown.</p>
    <table class="data-table" id="overview-sys-table"><thead><tr>
      <th class="num" style="cursor:pointer;width:40px" data-osort="_rank">Rank</th>
      <th style="cursor:pointer" data-osort="name">System</th><th class="num" style="cursor:pointer" data-osort="active_picks">Active</th><th class="num" style="cursor:pointer" data-osort="closed_picks">Closed</th>
      <th class="num" style="cursor:pointer" data-osort="win_rate">Win Rate</th><th class="num" style="cursor:pointer" data-osort="total_pnl_pct">Total PnL</th>
      <th class="num col-tip" style="cursor:pointer" data-osort="profit_factor" data-tip="Profit Factor = gross wins / gross losses. >1 = profitable. The single most important metric for system quality.">PF</th>
      <th class="num col-tip" style="cursor:pointer" data-osort="expectancy" data-tip="Expectancy = expected PnL per trade. Positive = profitable system over time.">Expect.</th>
      <th class="num col-tip" style="cursor:pointer" data-osort="_composite" data-tip="Composite Score (0-100). Percentile-weighted across: WR (30%), PF (25%), Expectancy (20%), Risk-Adjusted Return (15%), Track Record (10%). Modeled after CTA/hedge fund ranking methodology.">Score</th>
      <th class="col-tip" style="cursor:pointer" data-osort="last_signal_at" data-tip="When this system last generated a pick.">Last Pick</th>
      <th style="cursor:pointer" data-osort="status">Status</th>
    </tr></thead><tbody>${sysRows}</tbody></table>
  `;

  // ── Open Forward-Trade Stats: Live P/L by System ──
  const activeSystems = (D.systems || []).filter(s => (s.active_picks || 0) > 0 && !isBlockedSystem(s.name));
  if (activeSystems.length > 0) {
    const allActive = D.picks?.active || [];
    const openStatsRows = activeSystems.map(s => {
      const sysPicks = allActive.filter(p => p.source_system === s.name);
      const withPnl = sysPicks.filter(p => p.pnl_pct != null && p.pnl_pct !== 0 && Math.abs(p.pnl_pct) <= 500);
      const avgPnl = withPnl.length > 0 ? withPnl.reduce((a, p) => a + p.pnl_pct, 0) / withPnl.length : 0;
      const winners = withPnl.filter(p => p.pnl_pct > 0).length;
      const losers = withPnl.filter(p => p.pnl_pct <= 0).length;
      const totalUnrealizedPnl = withPnl.reduce((a, p) => a + p.pnl_pct, 0);
      const bestPick = withPnl.length > 0 ? withPnl.reduce((best, p) => p.pnl_pct > best.pnl_pct ? p : best) : null;
      const worstPick = withPnl.length > 0 ? withPnl.reduce((worst, p) => p.pnl_pct < worst.pnl_pct ? p : worst) : null;
      return {
        name: s.name, total: sysPicks.length, withPnl: withPnl.length,
        avgPnl, winners, losers, totalUnrealizedPnl,
        bestPick, worstPick, wr: s.win_rate
      };
    }).filter(s => s.withPnl > 0).sort((a, b) => b.avgPnl - a.avgPnl);

    if (openStatsRows.length > 0) {
      const osRows = openStatsRows.map(s => {
        const wlRatio = s.losers > 0 ? (s.winners / s.losers).toFixed(1) : s.winners > 0 ? '\u221e' : '0';
        return `<tr>
          <td>${sysLink(s.name)}</td>
          <td class="num">${s.total}</td>
          <td class="num" style="color:var(--green)">${s.winners}</td>
          <td class="num" style="color:var(--red)">${s.losers}</td>
          <td class="num" style="color:${s.avgPnl >= 0 ? 'var(--green)' : 'var(--red)'}; font-weight:600">${s.avgPnl >= 0 ? '+' : ''}${fmt(s.avgPnl, 2)}%</td>
          <td class="num" style="color:${s.totalUnrealizedPnl >= 0 ? 'var(--green)' : 'var(--red)'}">${s.totalUnrealizedPnl >= 0 ? '+' : ''}${fmt(s.totalUnrealizedPnl, 1)}%</td>
          <td class="num">${wlRatio}</td>
          <td style="font-size:11px">${s.bestPick ? '<span style="color:var(--green)">'+s.bestPick.symbol+' +'+fmt(s.bestPick.pnl_pct,2)+'%</span>' : '\u2014'}</td>
          <td style="font-size:11px">${s.worstPick ? '<span style="color:var(--red)">'+s.worstPick.symbol+' '+fmt(s.worstPick.pnl_pct,2)+'%</span>' : '\u2014'}</td>
        </tr>`;
      }).join('');

      const totalWinners = openStatsRows.reduce((a, s) => a + s.winners, 0);
      const totalLosers = openStatsRows.reduce((a, s) => a + s.losers, 0);
      const totalAll = openStatsRows.reduce((a, s) => a + s.withPnl, 0);
      const overallAvgPnl = totalAll > 0 ? openStatsRows.reduce((a, s) => a + s.totalUnrealizedPnl, 0) / totalAll : 0;

      el('tab-overview').innerHTML += `
        <h2 style="margin:20px 0 4px">Open Forward-Trades: Live P/L by System</h2>
        <p style="color:var(--text-dim);font-size:12px;margin:0 0 4px">Real-time unrealized P/L for all currently open positions, grouped by source system. Shows which systems are winning RIGHT NOW.</p>
        <div style="display:flex;gap:12px;margin-bottom:10px;flex-wrap:wrap">
          <span style="font-size:12px;padding:4px 10px;background:rgba(34,197,94,0.1);border-radius:4px;color:var(--green)">\u2191 ${totalWinners} winners</span>
          <span style="font-size:12px;padding:4px 10px;background:rgba(244,67,54,0.1);border-radius:4px;color:var(--red)">\u2193 ${totalLosers} losers</span>
          <span style="font-size:12px;padding:4px 10px;background:var(--card);border-radius:4px;color:${overallAvgPnl>=0?'var(--green)':'var(--red)'}">Avg: ${overallAvgPnl>=0?'+':''}${fmt(overallAvgPnl,2)}% per trade</span>
        </div>
        <table class="data-table"><thead><tr>
          <th>System</th><th class="num">Open</th><th class="num" style="color:var(--green)">Winners</th><th class="num" style="color:var(--red)">Losers</th>
          <th class="num col-tip" data-tip="Average unrealized P/L across all open picks for this system.">Avg P/L</th>
          <th class="num col-tip" data-tip="Total unrealized P/L (sum of all open picks).">Total P/L</th>
          <th class="num col-tip" data-tip="Winners/Losers ratio. Higher = more winning picks right now.">W/L</th>
          <th>Best Pick</th><th>Worst Pick</th>
        </tr></thead><tbody>${osRows}</tbody></table>`;
    }
  }

  // Wire drill-down links
  document.querySelectorAll('.drill-link').forEach(a => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const key = a.dataset.filterKey;
      const val = a.dataset.filterVal;
      const tab = a.dataset.tab;
      el(key).value = val;
      // Switch to target tab
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
      document.querySelector('[data-tab="' + tab + '"]').classList.add('active');
      el('tab-' + tab).classList.add('active');
      renderPicks();
    });
  });

  // Sortable Top Systems table
  let oSortKey = 'win_rate';
  let oSortDir = -1;
  function rebuildSysTable() {
    const sorted = [...topSys].sort((a, b) => {
      let av = a[oSortKey] ?? '', bv = b[oSortKey] ?? '';
      if (oSortKey === 'name') return String(av).localeCompare(String(bv)) * oSortDir;
      if (oSortKey === 'status') return String(av).localeCompare(String(bv)) * oSortDir;
      if (oSortKey === 'last_signal_at') return String(av||'').localeCompare(String(bv||'')) * oSortDir;
      return ((parseFloat(av)||0) - (parseFloat(bv)||0)) * oSortDir;
    });
    const rows = sorted.map(s => `<tr>
    <td>${sysLink(s.name)}</td>
    <td class="num">${drillLink(s.active_picks, 'f-system', s.name, 'active')}</td>
    <td class="num">${drillLink(s.closed_picks, 'f-system', s.name, 'closed')}</td>
    <td class="num">${fmt(Math.min(100, s.win_rate||0))}%</td>
    <td class="num ${pnlClass(s.total_pnl_pct)}">${fmtPct(s.total_pnl_pct)}</td>
    <td class="num" style="color:${(s.profit_factor||0)>=1?'var(--green)':'var(--red)'}">${s.profit_factor!=null ? fmt(s.profit_factor,2) : '\u2014'}</td>
    <td class="num" style="color:${(s.expectancy||0)>=0?'var(--green)':'var(--red)'}">${s.expectancy!=null ? (s.expectancy>=0?'+':'')+fmt(s.expectancy,2)+'%' : '\u2014'}</td>
    <td style="white-space:nowrap;font-size:11px;color:var(--text-dim)">${s.last_signal_at ? toEST(s.last_signal_at) : '\u2014'}</td>
    <td>${statusBadge(s.status)}</td>
  </tr>`).join('');
    const table = el('overview-sys-table');
    if (table) {
      table.querySelector('tbody').innerHTML = rows;
      // Update header arrows
      table.querySelectorAll('th[data-osort]').forEach(th => {
        const key = th.dataset.osort;
        const baseText = th.textContent.replace(/[\u25B2\u25BC]/g, '').trim();
        if (key === oSortKey) {
          th.textContent = baseText + ' ' + (oSortDir > 0 ? '\u25B2' : '\u25BC');
        } else {
          th.textContent = baseText;
        }
      });
      // Rewire drill links
      table.querySelectorAll('.drill-link').forEach(a => {
        a.addEventListener('click', (e) => {
          e.preventDefault();
          const key2 = a.dataset.filterKey;
          const val2 = a.dataset.filterVal;
          const tab2 = a.dataset.tab;
          el(key2).value = val2;
          document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
          document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
          document.querySelector('[data-tab="' + tab2 + '"]').classList.add('active');
          el('tab-' + tab2).classList.add('active');
          renderPicks();
        });
      });
    }
  }
  const sysTable = el('overview-sys-table');
  if (sysTable) {
    sysTable.addEventListener('click', function(e) {
      const th = e.target.closest('th[data-osort]');
      if (!th) return;
      const key = th.dataset.osort;
      if (oSortKey === key) { oSortDir *= -1; } else { oSortKey = key; oSortDir = key === 'name' || key === 'status' ? 1 : -1; }
      rebuildSysTable();
    });
  }
}

// ── Portfolios tab ──
function renderPortfolios() {
  const ports = D.portfolios || [];
  if (!ports.length) { el('tab-portfolios').innerHTML = '<div class="empty-state">No portfolios found.</div>'; return; }
  el('tab-portfolios').innerHTML = '<div class="card-grid">' + ports.map(p => `
    <div class="info-card">
      <h3>${p.name} <span class="badge badge-${p.source === 'paper_trading' ? 'active' : 'bt'}" style="font-size:10px">${p.source.replace(/_/g,' ')}</span></h3>
      <div class="row"><span class="lbl">Equity</span><span class="val">$${Number(p.equity||0).toLocaleString()}</span></div>
      <div class="row"><span class="lbl">PnL</span><span class="val ${pnlClass(p.pnl_pct)}">${fmtPct(p.pnl_pct)}</span></div>
      <div class="row"><span class="lbl">Win Rate</span><span class="val">${fmt(p.win_rate)}%</span></div>
      <div class="row"><span class="lbl">Trades</span><span class="val">${p.total_trades || 0}</span></div>
      <div class="row"><span class="lbl">Positions</span><span class="val">${p.positions || 0}</span></div>
      <div class="row"><span class="lbl">Max DD</span><span class="val pnl-neg">${p.max_drawdown ? fmt(p.max_drawdown) + '%' : '—'}</span></div>
    </div>
  `).join('') + '</div>';
}

// ── Claude's AI Portfolios (4-AI Consensus Firewall) ──
function renderClaudePortfolios() {
  const container = document.getElementById('tab-portfolios');
  if (!container) return;
  // Fetch Claude's portfolio data
  fetch('data/claudes_test_dashboard.json?t=' + Date.now())
    .then(r => r.ok ? r.json() : null)
    .catch(() => null)
    .then(data => {
      if (!data || !data.portfolios) {
        container.insertAdjacentHTML('beforeend', '<div class="empty-state" style="margin-top:30px">Claude\'s AI Portfolios: data not available</div>');
        return;
      }
      const regime = data.regime || 'UNKNOWN';
      const genAt = data.generated_at ? new Date(data.generated_at).toLocaleString() : '';
      const ranking = data.ranking || [];
      const ports = data.portfolios || [];
      // Summary stats
      const totalEquity = ports.reduce((s,p) => s + (p.equity||0), 0);
      const totalInitial = ports.reduce((s,p) => s + (p.initial_capital||0), 0);
      const totalPnl = totalEquity - totalInitial;
      const totalPnlPct = totalInitial > 0 ? (totalPnl / totalInitial * 100) : 0;
      const totalTrades = ports.reduce((s,p) => s + (p.stats?.total_trades||0), 0);
      const avgWR = ports.filter(p=>p.stats?.total_trades>0).reduce((s,p,_,a) => s + (p.stats.win_rate||0)/a.length, 0);
      let html = `
        <div style="margin-top:40px;padding-top:20px;border-top:2px solid rgba(139,92,246,0.3)">
          <h2 style="color:var(--cyan);margin-bottom:5px">Claude's AI Portfolios <span style="font-size:12px;color:#888">(4-AI Consensus Firewall)</span></h2>
          <p style="color:#888;font-size:12px;margin-bottom:15px">15 simulated portfolios with 2-stage scoring, trailing stops, concentration limits. Regime: <b style="color:${regime==='BULLISH'?'var(--green)':regime==='BEARISH'?'var(--red)':'#f59e0b'}">${regime}</b> | Updated: ${genAt}</p>
          <div class="stat-row" style="display:flex;gap:15px;flex-wrap:wrap;margin-bottom:20px">
            <div class="stat-card" style="background:rgba(255,255,255,0.03);padding:12px 18px;border-radius:8px;border:1px solid rgba(255,255,255,0.08)">
              <div style="color:#888;font-size:11px">Total Equity</div>
              <div style="font-size:18px;font-weight:700">$${totalEquity.toLocaleString(undefined,{maximumFractionDigits:0})}</div>
            </div>
            <div class="stat-card" style="background:rgba(255,255,255,0.03);padding:12px 18px;border-radius:8px;border:1px solid rgba(255,255,255,0.08)">
              <div style="color:#888;font-size:11px">Total PnL</div>
              <div style="font-size:18px;font-weight:700;color:${totalPnl>=0?'var(--green)':'var(--red)'}">${totalPnl>=0?'+':''}$${totalPnl.toLocaleString(undefined,{maximumFractionDigits:0})} (${totalPnlPct>=0?'+':''}${totalPnlPct.toFixed(2)}%)</div>
            </div>
            <div class="stat-card" style="background:rgba(255,255,255,0.03);padding:12px 18px;border-radius:8px;border:1px solid rgba(255,255,255,0.08)">
              <div style="color:#888;font-size:11px">Total Trades</div>
              <div style="font-size:18px;font-weight:700">${totalTrades}</div>
            </div>
            <div class="stat-card" style="background:rgba(255,255,255,0.03);padding:12px 18px;border-radius:8px;border:1px solid rgba(255,255,255,0.08)">
              <div style="color:#888;font-size:11px">Avg WR (closed)</div>
              <div style="font-size:18px;font-weight:700;color:${avgWR>=50?'var(--green)':'var(--red)'}">${avgWR.toFixed(1)}%</div>
            </div>
          </div>`;
      // Ranking table
      if (ranking.length) {
        html += `<table style="width:100%;border-collapse:collapse;margin-bottom:15px"><thead><tr style="border-bottom:1px solid rgba(255,255,255,0.1)">
          <th style="text-align:left;padding:6px 8px;font-size:11px;color:#888">#</th>
          <th style="text-align:left;padding:6px 8px;font-size:11px;color:#888">Portfolio</th>
          <th style="text-align:right;padding:6px 8px;font-size:11px;color:#888">PnL %</th>
          <th style="text-align:right;padding:6px 8px;font-size:11px;color:#888">WR</th>
          <th style="text-align:right;padding:6px 8px;font-size:11px;color:#888">Trades</th>
          <th style="text-align:right;padding:6px 8px;font-size:11px;color:#888">Max DD</th>
          <th style="text-align:right;padding:6px 8px;font-size:11px;color:#888">Sharpe</th>
          <th style="text-align:center;padding:6px 8px;font-size:11px;color:#888">Status</th>
        </tr></thead><tbody>`;
        ranking.forEach((r,i) => {
          const pnlColor = r.pnl_pct > 0 ? 'var(--green)' : r.pnl_pct < 0 ? 'var(--red)' : '#888';
          const statusBg = r.status === 'PASSED' ? 'rgba(34,197,94,0.2)' : r.status === 'BLOWN' ? 'rgba(239,68,68,0.2)' : 'rgba(255,255,255,0.05)';
          html += `<tr style="border-bottom:1px solid rgba(255,255,255,0.04)">
            <td style="padding:6px 8px;font-size:12px;color:#888">${i+1}</td>
            <td style="padding:6px 8px;font-size:12px"><b>${r.name}</b></td>
            <td style="padding:6px 8px;font-size:12px;text-align:right;color:${pnlColor};font-weight:600">${r.pnl_pct>=0?'+':''}${r.pnl_pct.toFixed(2)}%</td>
            <td style="padding:6px 8px;font-size:12px;text-align:right">${r.win_rate.toFixed(1)}%</td>
            <td style="padding:6px 8px;font-size:12px;text-align:right">${r.trades}</td>
            <td style="padding:6px 8px;font-size:12px;text-align:right;color:var(--red)">${r.max_dd>0?'-'+r.max_dd.toFixed(2)+'%':'—'}</td>
            <td style="padding:6px 8px;font-size:12px;text-align:right">${r.sharpe||'—'}</td>
            <td style="padding:6px 8px;font-size:12px;text-align:center"><span style="padding:2px 8px;border-radius:4px;background:${statusBg};font-size:10px">${r.status}</span></td>
          </tr>`;
        });
        html += '</tbody></table>';
      }
      // Expandable portfolio cards
      html += '<div class="card-grid" style="margin-top:15px">';
      ports.forEach(p => {
        const s = p.stats || {};
        const pnlColor = s.pnl_pct > 0 ? 'var(--green)' : s.pnl_pct < 0 ? 'var(--red)' : '#888';
        const statusBadge = p.status === 'PASSED' ? '<span style="color:var(--green);font-weight:700">✓ PASSED</span>' : p.status === 'BLOWN' ? '<span style="color:var(--red);font-weight:700">✗ BLOWN</span>' : '<span style="color:#888">ACTIVE</span>';
        const propLabel = p.prop_firm ? ' <span style="color:#f59e0b;font-size:10px">PROP FIRM</span>' : '';
        html += `<div class="info-card" style="border:1px solid rgba(139,92,246,0.15)">
          <h3>${p.name}${propLabel}</h3>
          <div style="font-size:11px;color:#888;margin-bottom:8px">${p.description||''}</div>
          <div class="row"><span class="lbl">Status</span><span class="val">${statusBadge}</span></div>
          <div class="row"><span class="lbl">Equity</span><span class="val">$${Number(p.equity||0).toLocaleString(undefined,{maximumFractionDigits:0})}</span></div>
          <div class="row"><span class="lbl">PnL</span><span class="val" style="color:${pnlColor};font-weight:600">${s.pnl_pct>=0?'+':''}${(s.pnl_pct||0).toFixed(2)}% ($${(s.pnl_usd||0).toFixed(0)})</span></div>
          <div class="row"><span class="lbl">Win Rate</span><span class="val">${s.win_rate||0}%</span></div>
          <div class="row"><span class="lbl">Trades</span><span class="val">${s.total_trades||0} (${s.open_positions||0} open)</span></div>
          <div class="row"><span class="lbl">Profit Factor</span><span class="val" style="color:${(s.profit_factor||0)>=1?'var(--green)':'var(--red)'}">${(s.profit_factor||0).toFixed(2)}</span></div>
          <div class="row"><span class="lbl">Max DD</span><span class="val" style="color:var(--red)">${s.max_drawdown_pct>0?'-'+s.max_drawdown_pct.toFixed(2)+'%':'—'}</span></div>
          <div class="row"><span class="lbl">Commission</span><span class="val">$${(s.total_commission||0).toFixed(2)}</span></div>
          ${p.prop_firm ? `<div class="row"><span class="lbl">Daily Loss Limit</span><span class="val">${p.daily_loss_limit_pct}%</span></div><div class="row"><span class="lbl">Resets</span><span class="val">${p.resets||0}</span></div>` : ''}
        </div>`;
      });
      html += '</div>';
      // Trading parameters box
      html += `<div style="margin-top:20px;padding:15px;background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.08);border-radius:8px;font-size:12px;color:#888">
        <b style="color:#ccc">Trading Parameters (Auditor Reference)</b><br>
        Commission: 0.15%/side (IBKR) | Slippage: 0.05%/side | Round-trip: 0.40% | No leverage | No margin<br>
        Exits: TP/SL + trailing stop (+5% activation, 50% lock) + time exit (7d loss, 14d max hold)<br>
        Firewall: 4-AI consensus (Mercury+Grok+Codex+Gemini) — blocks Revival_Mutated, requires min 5 trades, WR≥35%, R:R≥1.2<br>
        <a href="claudes_test.html" target="_blank" style="color:var(--cyan)">Open Full Dashboard →</a> |
        <a href="trading_blueprint.html" target="_blank" style="color:var(--cyan)">Trading Blueprint v2.0 →</a>
      </div>`;
      html += '</div>';
      container.insertAdjacentHTML('beforeend', html);
    });
}

// ── Systems tab ──
function renderSystems() {
  const sys = (D.systems || []).filter(s => !isBlockedSystem(s.name));
  if (!sys.length) { el('tab-systems').innerHTML = '<div class="empty-state">No systems found.</div>'; return; }
  const sysLinksMap = Object.assign({}, sysLinks);
  el('tab-systems').innerHTML = '<div class="card-grid">' + sys.map(s => {
    const link = sysLinksMap[s.name];
    const nm = (s.name || '').toLowerCase();
    // Detect probation/killed systems
    let sysTier = 'SANDBOX';
    let sysTierReason = '';
    for (const [k, v] of Object.entries(_TRUST_PROBATION)) { if (nm.includes(k)) { sysTier = 'PROBATION'; sysTierReason = v.reason; break; } }
    if (sysTier === 'SANDBOX') { for (const [k, v] of Object.entries(_TRUST_PROVEN_SYSTEMS)) { if (nm.includes(k)) { sysTier = 'PROVEN'; sysTierReason = v.reason; break; } } }
    const isKilled = sysTierReason.includes('KILLED') || sysTierReason.includes('BROKEN');
    const cardBorder = isKilled ? 'border-color:#ef4444;opacity:0.6' : sysTier === 'PROVEN' ? 'border-color:#22c55e' : sysTier === 'PROBATION' ? 'border-color:#f59e0b' : '';
    const tierBadge = sysTier === 'PROVEN' ? '<span style="color:#22c55e;font-size:10px" title="'+sysTierReason+'">\u2605 PROVEN</span>'
      : isKilled ? '<span style="color:#ef4444;font-size:10px;background:rgba(239,68,54,0.15);padding:1px 6px;border-radius:3px" title="'+sysTierReason+'">DEAD</span>'
      : sysTier === 'PROBATION' ? '<span style="color:#f59e0b;font-size:10px" title="'+sysTierReason+'">\u26a0 PROBATION</span>'
      : '<span style="color:var(--text-dim);font-size:10px">\u2610 SANDBOX</span>';
    const nameStyle = isKilled ? 'text-decoration:line-through;opacity:0.6' : '';
    const nameHtml = link ? `<a href="${link}" target="_blank" style="color:var(--cyan);text-decoration:none;${nameStyle}">${s.name.replace(/_/g,' ')}</a>` : `<span style="${nameStyle}">${s.name.replace(/_/g,' ')}</span>`;
    const pfColor = (s.profit_factor||0) >= 1 ? 'var(--green)' : 'var(--red)';
    const expColor = (s.expectancy||0) >= 0 ? 'var(--green)' : 'var(--red)';
    return `<div class="info-card" style="${cardBorder}">
      <h3>${nameHtml} ${statusBadge(s.status)} ${tierBadge}</h3>
      <div class="row"><span class="lbl">Active</span><span class="val">${s.active_picks}</span></div>
      <div class="row"><span class="lbl">Closed</span><span class="val">${s.closed_picks}</span></div>
      <div class="row"><span class="lbl">Win Rate</span><span class="val">${fmt(s.win_rate)}%</span></div>
      <div class="row"><span class="lbl">Profit Factor</span><span class="val" style="color:${pfColor}">${s.profit_factor!=null ? fmt(s.profit_factor,2) : '\u2014'}</span></div>
      <div class="row"><span class="lbl">Avg Win</span><span class="val pnl-pos">+${fmt(s.avg_win,2)}%</span></div>
      <div class="row"><span class="lbl">Avg Loss</span><span class="val pnl-neg">-${fmt(s.avg_loss,2)}%</span></div>
      <div class="row"><span class="lbl">Expectancy</span><span class="val" style="color:${expColor}">${s.expectancy!=null ? (s.expectancy>=0?'+':'')+fmt(s.expectancy,2)+'%/trade' : '\u2014'}</span></div>
      <div class="row"><span class="lbl">Max Drawdown</span><span class="val pnl-neg">${s.max_drawdown ? '-'+fmt(s.max_drawdown,2)+'%' : '\u2014'}</span></div>
      <div class="row"><span class="lbl">Total PnL</span><span class="val ${pnlClass(s.total_pnl_pct)}">${fmtPct(s.total_pnl_pct)}</span></div>
      <div class="row"><span class="lbl">Assets</span><span class="val">${(s.asset_classes||[]).map(a => acBadge(a)).join(' ')}</span></div>
      <div class="row"><span class="lbl">Last Pick</span><span class="val" style="font-size:11px">${s.last_signal_at ? toEST(s.last_signal_at) : '\u2014'}</span></div>
    </div>`;
  }).join('') + '</div>';
}

// ── BT vs Forward tab ──
let bfSortCol = 'bt_wr', bfSortAsc = false;
function renderBtVsFwd() {
  const data = D.backtest_vs_forward || [];
  if (!data.length) { el('tab-btvsfwd').innerHTML = '<div class="empty-state">No backtest vs forward data available. Run backfill first.</div>'; return; }
  const bfLookup = buildStratLookup();

  // Apply system filter
  const sysFilt = document.getElementById('bf-system');
  const sysVal = sysFilt ? sysFilt.value : '';
  let filtered = sysVal ? data.filter(r => r.system === sysVal) : [...data];

  // Sort
  filtered.sort((a, b) => {
    let va = a[bfSortCol], vb = b[bfSortCol];
    if (typeof va === 'string') va = (va||'').toLowerCase();
    if (typeof vb === 'string') vb = (vb||'').toLowerCase();
    if (va == null) va = -Infinity;
    if (vb == null) vb = -Infinity;
    return bfSortAsc ? (va > vb ? 1 : va < vb ? -1 : 0) : (va < vb ? 1 : va > vb ? -1 : 0);
  });

  const rows = filtered.map(r => {
    const decayCls = r.decay != null ? (r.decay >= 0 ? 'pnl-pos' : 'pnl-neg') : '';
    return `<tr data-sys="${r.system||''}">
      <td>${stratTooltipHtml(r.strategy, bfLookup)}</td>
      <td style="color:var(--text-dim);font-size:12px">${(r.system||'').replace(/_/g,' ')}</td>
      <td class="num">${r.bt_wr != null ? fmt(r.bt_wr) + '%' : '0%'}</td>
      <td class="num">${r.fwd_wr != null ? fmt(r.fwd_wr) + '%' : '—'}</td>
      <td class="num ${decayCls}">${r.decay != null ? (r.decay >= 0 ? '+' : '') + fmt(r.decay) + '%' : '—'}</td>
      <td class="num">${r.bt_trades || 0}</td>
      <td class="num">${r.fwd_trades || 0}</td>
    </tr>`;
  }).join('');
  // Build system filter options
  const bfSystems = [...new Set(data.map(r => r.system).filter(Boolean))].sort();
  const bfSysOpts = bfSystems.map(s => `<option value="${s}"${s === sysVal ? ' selected' : ''}>${s.replace(/_/g,' ')}</option>`).join('');

  const arrow = c => c === bfSortCol ? (bfSortAsc ? ' ▲' : ' ▼') : '';

  el('tab-btvsfwd').innerHTML = `
    <h2 style="margin-bottom:12px">Backtest vs Forward Performance (${data.length} strategies${sysVal ? ', showing ' + filtered.length : ''})</h2>
    <p style="color:var(--text-dim);font-size:12px;margin-bottom:12px">Compare how strategies perform in backtesting vs live forward testing. Decay = FWD WR − BT WR. Negative decay = overfitting (worse live than backtested). Click column headers to sort.</p>
    <div class="filter-bar" style="margin-bottom:12px">
      <label>System:</label>
      <select id="bf-system" onchange="renderBtVsFwd()"><option value="">All Systems</option>${bfSysOpts}</select>
    </div>
    <table class="data-table"><thead><tr>
      <th class="col-tip" data-tip="Strategy algorithm name." data-sort="strategy" onclick="bfSort(this)">Strategy${arrow('strategy')}</th>
      <th class="col-tip" data-tip="Which trading engine runs this strategy." data-sort="system" onclick="bfSort(this)">System${arrow('system')}</th>
      <th class="num col-tip" data-tip="BT Win Rate = Percentage of winning trades in historical backtesting." data-sort="bt_wr" onclick="bfSort(this)">BT Win Rate${arrow('bt_wr')}</th>
      <th class="num col-tip" data-tip="FWD Win Rate = Percentage of winning trades in live forward/paper testing." data-sort="fwd_wr" onclick="bfSort(this)">FWD Win Rate${arrow('fwd_wr')}</th>
      <th class="num col-tip" data-tip="Decay = FWD WR − BT WR. Green = holds up. Red = overfitting." data-sort="decay" onclick="bfSort(this)">Decay${arrow('decay')}</th>
      <th class="num col-tip" data-tip="Number of completed trades in backtesting." data-sort="bt_trades" onclick="bfSort(this)">BT Trades${arrow('bt_trades')}</th>
      <th class="num col-tip" data-tip="Number of completed trades in forward testing." data-sort="fwd_trades" onclick="bfSort(this)">FWD Trades${arrow('fwd_trades')}</th>
    </tr></thead><tbody>${rows}</tbody></table>
  `;
}
function bfSort(th) {
  const col = th.dataset.sort;
  if (bfSortCol === col) bfSortAsc = !bfSortAsc;
  else { bfSortCol = col; bfSortAsc = col === 'strategy' || col === 'system'; }
  renderBtVsFwd();
}

// ── Bundles tab ──
function renderBundles() {
  const bundles = D.bundles || [];
  if (!bundles.length) { el('tab-bundles').innerHTML = '<div class="empty-state">No bundles found.</div>'; return; }
  el('tab-bundles').innerHTML = '<div class="card-grid">' + bundles.map(b => {
    const conf = b.confidence || 'backtest-projected';
    const confCls = conf === 'forward-confirmed' ? 'fwd' : conf === 'mixed' ? 'mixed' : 'bt';
    const confLabel = conf === 'forward-confirmed' ? 'Forward Confirmed' : conf === 'mixed' ? 'Mixed' : 'Backtest Projected';
    const tb = b.trade_breakdown || {};
    const bt = b.backtest || {};
    return `<div class="info-card">
      <h3>#${b.rank || '?'} ${b.name || 'Unknown'}</h3>
      <div style="margin-bottom:8px"><span class="badge badge-${confCls}">${confLabel}</span></div>
      <div class="row"><span class="lbl">Win Rate</span><span class="val">${fmt(bt.win_rate || tb.blended_wr)}%</span></div>
      <div class="row"><span class="lbl">Total PnL</span><span class="val ${pnlClass(bt.total_return)}">${fmtPct(bt.total_return)}</span></div>
      <div class="row"><span class="lbl">FWD Trades</span><span class="val">${tb.forward_trades || 0}</span></div>
      <div class="row"><span class="lbl">BT Trades</span><span class="val">${tb.backtest_trades || 0}</span></div>
      <div class="row"><span class="lbl" title="Quality Score = weighted blend of: Win Rate (40%), Sharpe Ratio (25%), Forward Confirmation (20%), Trade Count Depth (15%). Higher = more reliable.">Quality Score ℹ️</span><span class="val" style="color:${(b.quality_score||0) >= 7 ? 'var(--green)' : (b.quality_score||0) >= 5 ? 'var(--yellow)' : 'var(--red)'}">${fmt(b.quality_score)}</span></div>
      <div class="row"><span class="lbl">Strategies</span><span class="val">${(b.strategies||[]).length}</span></div>
    </div>`;
  }).join('') + '</div>';
}

// ── Audit log tab ──
function renderAuditLog() {
  const events = D.audit_events || [];
  const filters = D.filter_events || [];
  if (!events.length && !filters.length) {
    el('tab-audit').innerHTML = '<div class="empty-state">No audit events found.</div>';
    return;
  }
  let html = '<h2 style="margin-bottom:12px">Recent Audit Events</h2>';
  if (events.length) {
    html += events.map(e => `
      <div class="audit-entry">
        <span class="type">${e.event_type}</span>
        ${e.symbol ? ` <span class="badge badge-crypto">${e.symbol}</span>` : ''}
        ${e.origin ? ` <span style="color:var(--text-dim);font-size:11px">[${e.origin}]</span>` : ''}
        <div class="ts">${toEST(e.timestamp)}</div>
      </div>
    `).join('');
  }
  if (filters.length) {
    html += '<h2 style="margin:20px 0 12px">Recent Filter Decisions</h2>';
    html += filters.map(f => `
      <div class="audit-entry" style="border-left-color:var(--yellow)">
        <span class="type" style="color:var(--yellow)">${f.filter_reason}</span>
        ${f.symbol ? ` <span class="badge badge-crypto">${f.symbol}</span>` : ''}
        ${f.source_system ? ` <span style="color:var(--text-dim);font-size:11px">[${f.source_system}]</span>` : ''}
        ${f.details ? `<div style="color:var(--text-dim);font-size:12px;margin-top:2px">${f.details}</div>` : ''}
        <div class="ts">${toEST(f.timestamp)}</div>
      </div>
    `).join('');
  }
  el('tab-audit').innerHTML = html;
}

// ── Dashboards tab ──
function renderDashboards() {
  const dashboards = [
    { name: 'Unified Audit Dashboard', url: '', desc: 'This page — birds-eye view of all systems', status: 'active' },
    { name: 'Baby Bundles Battleground', url: 'https://eltonaguiar.github.io/findtorontoevents_antigravity.ca/battleground/', desc: 'Strategy bundles with forward/backtest performance', status: 'active' },
    { name: 'Alpha Engine (GitHub Pages)', url: 'https://eltonaguiar.github.io/findtorontoevents_antigravity.ca/alpha/', desc: '100 strategies — crypto, forex, equity', status: 'active' },
    { name: 'Alpha Engine (FTP)', url: 'https://findtorontoevents.ca/alpha/', desc: 'Alpha Engine mirror on findtorontoevents.ca', status: 'active' },
    { name: 'KIMI Rise of the Claw', url: 'https://eltonaguiar.github.io/findtorontoevents_antigravity.ca/riseoftheclaw.html', desc: '81 algorithms — crypto/forex/stocks scanner', status: 'active' },
    { name: 'Cross-System Monitor', url: 'https://eltonaguiar.github.io/findtorontoevents_antigravity.ca/monitor/', desc: 'Consensus picks across all systems', status: 'active' },
    { name: 'Updates Page', url: 'https://findtorontoevents.ca/updates/', desc: 'Project changelog and feature announcements', status: 'active' },
    { name: 'Paper Trading Dashboard', url: 'https://eltonaguiar.github.io/findtorontoevents_antigravity.ca/paper_trading/', desc: '12 conviction-tier portfolios', status: 'active' },
  ];

  const discordChannels = [
    { name: '#consensus-picks', webhook: 'DISCORD_WEBHOOK_URL', desc: 'Main consensus picks — DIAMOND/PLATINUM/GOLD tier alerts' },
    { name: '#sandbox', webhook: 'DISCORD_WEBHOOK_SANDBOX', desc: 'Experimental/low-confidence picks for testing' },
    { name: '#dna-master-picks', webhook: 'DISCORD_WEBHOOK_DNA_MASTER', desc: 'Elite DNA-evolved strategy picks' },
    { name: '#portfolio-updates', webhook: 'DISCORD_WEBHOOK_PORTFOLIO', desc: 'Portfolio snapshots, TP/SL hit notifications' },
    { name: '#freshpicks', webhook: 'DISCORD_WEBHOOK_URL', desc: 'New picks as they arrive (rate-limited)' },
  ];

  el('tab-dashboards').innerHTML = `
    <h2 style="margin-bottom:12px">Live Dashboards</h2>
    <div class="card-grid">
      ${dashboards.map(d => `
        <div class="info-card">
          <h3>${d.url ? `<a href="${d.url}" target="_blank">${d.name}</a>` : d.name} ${statusBadge(d.status)}</h3>
          <div style="color:var(--text-dim);font-size:13px">${d.desc}</div>
          ${d.url ? `<div style="margin-top:8px"><a href="${d.url}" target="_blank" style="font-size:12px">${d.url}</a></div>` : ''}
        </div>
      `).join('')}
    </div>

    <h2 style="margin:24px 0 12px">Discord Alert Channels</h2>
    <div class="card-grid">
      ${discordChannels.map(c => `
        <div class="info-card">
          <h3 style="color:var(--purple)">${c.name}</h3>
          <div style="color:var(--text-dim);font-size:13px">${c.desc}</div>
          <div style="margin-top:6px;font-size:11px;color:var(--text-dim)">Webhook: <code style="color:var(--blue)">${c.webhook}</code></div>
        </div>
      `).join('')}
    </div>

    <h2 style="margin:24px 0 12px">Discord Alerts by Channel</h2>
    <div id="discord-channel-filter" style="margin-bottom:12px">
      <label style="font-size:12px;color:var(--text-dim)">Filter channel:</label>
      <select id="f-discord-channel" style="background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:4px;padding:5px 8px;font-size:13px">
        <option value="">All Channels</option>
        <option value="consensus">consensus</option>
        <option value="sandbox">sandbox</option>
        <option value="dna_master">dna_master</option>
        <option value="portfolio">portfolio</option>
        <option value="freshpicks">freshpicks</option>
      </select>
    </div>
    <div id="discord-alerts-list"></div>
  `;

  // Render discord alerts from audit events that are pick-related
  const events = (D.audit_events || []).filter(e =>
    e.event_type && (e.event_type.includes('POSTED') || e.event_type.includes('TP_HIT') || e.event_type.includes('SL_HIT') || e.event_type.includes('REVERSAL'))
  );
  const filterEvents = (D.filter_events || []);

  function renderDiscordAlerts() {
    const ch = document.getElementById('f-discord-channel')?.value || '';
    let filtered = events;
    if (ch) {
      filtered = events.filter(e => {
        const payload = typeof e.payload === 'string' ? e.payload : JSON.stringify(e.payload || '');
        return payload.includes(ch) || (e.origin || '').includes(ch);
      });
    }
    const list = document.getElementById('discord-alerts-list');
    if (!list) return;
    if (!filtered.length) {
      list.innerHTML = '<div class="empty-state">No Discord alerts match this filter. Alerts are logged when the cross-aggregator runs.</div>';
      return;
    }
    list.innerHTML = filtered.map(e => `
      <div class="audit-entry" style="border-left-color:var(--purple)">
        <span class="type">${e.event_type}</span>
        ${e.symbol ? ` <span class="badge badge-crypto">${e.symbol}</span>` : ''}
        ${e.origin ? ` <span style="color:var(--text-dim);font-size:11px">[${e.origin}]</span>` : ''}
        <div class="ts">${toEST(e.timestamp)}</div>
      </div>
    `).join('');
  }

  renderDiscordAlerts();
  document.getElementById('f-discord-channel')?.addEventListener('change', renderDiscordAlerts);
}

// ── Strategy Leaderboard tab ──
function renderLeaderboard() {
  const data = D.leaderboard || [];
  if (!data.length) { el('tab-leaderboard').innerHTML = '<div class="empty-state">No strategy data available. Run the generator first.</div>'; return; }

  // Filter controls
  let filterVerdict = '';
  let filterType = '';
  let sortKey = 'fwd_trades';
  let sortDir = 'desc';

  function verdictBadge(v) {
    if (!v) return '';
    const colors = { SURVIVOR: 'var(--green)', PROMISING: 'var(--blue)', MARGINAL: 'var(--yellow)', ELIMINATED: 'var(--red)', INSUFFICIENT: 'var(--text-dim)' };
    return `<span class="badge" style="background:${colors[v] || 'var(--text-dim)'}22;color:${colors[v] || 'var(--text-dim)'}">${v}</span>`;
  }
  function typeBadge(t) {
    if (!t) return '';
    const colors = { proven: 'var(--green)', core: 'var(--blue)', incubator: 'var(--yellow)', catered: 'var(--cyan)' };
    return `<span class="badge" style="background:${colors[t] || 'var(--text-dim)'}22;color:${colors[t] || 'var(--text-dim)'}">${t}</span>`;
  }

  let filterMinWr = '';
  let filterActiveOnly = false;

  // Sort arrow helper
  function sa(key) {
    const active = sortKey === key;
    const arrow = active ? (sortDir === 'desc' ? '\u25BC' : '\u25B2') : '\u25BC';
    return `<span class="sort-arrow">${arrow}</span>`;
  }

  function render() {
    let filtered = data;
    if (filterVerdict) filtered = filtered.filter(r => r.bt_verdict === filterVerdict);
    if (filterType) filtered = filtered.filter(r => r.portfolio_type === filterType);
    if (filterMinWr) { const min = parseFloat(filterMinWr); filtered = filtered.filter(r => (r.fwd_wr || r.bt_wr || 0) >= min); }
    if (filterActiveOnly) filtered = filtered.filter(r => (r.active_picks || 0) > 0);

    // Sort — supports both numeric and string columns
    const strKeys = new Set(['strategy','bt_verdict','portfolio_type','health']);
    filtered = [...filtered].sort((a, b) => {
      let va = a[sortKey], vb = b[sortKey];
      if (strKeys.has(sortKey)) {
        va = (va || '').toString().toLowerCase();
        vb = (vb || '').toString().toLowerCase();
        const cmp = va.localeCompare(vb);
        return sortDir === 'desc' ? -cmp : cmp;
      }
      if (va == null) va = sortDir === 'desc' ? -Infinity : Infinity;
      if (vb == null) vb = sortDir === 'desc' ? -Infinity : Infinity;
      return sortDir === 'desc' ? vb - va : va - vb;
    });

    const stratLookup = buildStratLookup();
    const rows = filtered.map((r, i) => {
      const decayCls = r.decay != null ? (r.decay >= 0 ? 'pnl-pos' : 'pnl-neg') : '';
      const fwdPnlCls = r.fwd_total_pnl > 0 ? 'pnl-pos' : r.fwd_total_pnl < 0 ? 'pnl-neg' : '';
      const sqColors = {strong:'var(--green)',moderate:'var(--blue)',weak:'var(--yellow)',insufficient:'var(--red)'};
      const sqBadge = r.sample_quality ? `<span class="badge" style="background:${sqColors[r.sample_quality]||'var(--text-dim)'}22;color:${sqColors[r.sample_quality]||'var(--text-dim)'};font-size:9px;margin-left:4px">${r.sample_quality}</span>` : '';
      const decayWarn = r.decay != null && r.decay < -40 ? ' style="border-left:3px solid var(--red)"' : '';
      const dimStyle = r.fwd_trades < 5 ? ' style="opacity:0.5"' : '';
      return `<tr${decayWarn}${dimStyle}>
        <td class="num">${i + 1}</td>
        <td style="font-weight:600">${stratTooltipHtml(r.strategy, stratLookup)}</td>
        <td>${verdictBadge(r.bt_verdict)}</td>
        <td>${typeBadge(r.portfolio_type)}</td>
        <td class="num">${r.bt_wr != null ? fmt(r.bt_wr) + '%' : '\u2014'}</td>
        <td class="num">${r.bt_trades || '\u2014'}</td>
        <td class="num">${r.bt_sharpe != null ? fmt(r.bt_sharpe, 2) : '\u2014'}</td>
        <td class="num">${r.bt_sortino != null ? fmt(r.bt_sortino, 2) : '\u2014'}</td>
        <td class="num">${r.bt_var_99 != null ? '-' + fmt(r.bt_var_99, 1) + '%' : '\u2014'}</td>
        <td class="num" style="font-weight:600">${r.fwd_wr != null ? fmt(r.fwd_wr) + '%' : '\u2014'}</td>
        <td class="num">${r.fwd_trades || '\u2014'}${sqBadge}</td>
        <td class="num ${fwdPnlCls}">${r.fwd_total_pnl ? fmtPct(r.fwd_total_pnl) : '\u2014'}</td>
        <td class="num" style="color:${(r.fwd_pf||0)>=1?'var(--green)':'var(--red)'}">${r.fwd_pf != null ? fmt(r.fwd_pf, 2) : '\u2014'}</td>
        <td class="num" style="color:${r.omega_ratio!=null?((r.omega_ratio>=2?'var(--green)':r.omega_ratio>=1?'var(--yellow)':'var(--red)')):'var(--text-dim)'}">${r.omega_ratio != null ? fmt(r.omega_ratio, 2) : '\u2014'}</td>
        <td class="num" style="color:${r.tail_ratio!=null?(r.tail_ratio>=1?'var(--green)':'var(--red)'):'var(--text-dim)'}">${r.tail_ratio != null ? fmt(r.tail_ratio, 2) : '\u2014'}</td>
        <td class="num" style="color:${(r.fwd_expectancy||0)>=0?'var(--green)':'var(--red)'}">${r.fwd_expectancy != null ? (r.fwd_expectancy>=0?'+':'')+fmt(r.fwd_expectancy, 2)+'%' : '\u2014'}</td>
        <td class="num pnl-neg">${r.fwd_max_dd ? '-'+fmt(r.fwd_max_dd,1)+'%' : '\u2014'}</td>
        <td class="num ${decayCls}">${r.decay != null ? (r.decay >= 0 ? '+' : '') + fmt(r.decay) + '%' : '\u2014'}</td>
        <td class="num">${r.active_picks || 0}</td>
        <td>${r.health === 'healthy' ? '<span style="color:#22c55e;">\ud83d\udfe2 HEALTHY</span>' : r.health === 'watch' ? '<span style="color:#eab308;">\ud83d\udfe1 WATCH</span>' : r.health === 'degraded' ? '<span style="color:#ef4444;">\ud83d\udd34 DEGRADED</span>' : '<span style="color:var(--text-dim)">\u2014</span>'}</td>
        <td class="num" style="color:${r.fwd_last10_wr != null ? (r.fwd_last10_wr >= (r.fwd_wr || 0) ? 'var(--green)' : r.fwd_last10_wr >= (r.fwd_wr || 0) * 0.9 ? 'var(--yellow)' : 'var(--red)') : 'var(--text-dim)'}">${r.fwd_last10_wr != null ? fmt(r.fwd_last10_wr) + '%' : '\u2014'}</td>
        <td style="font-size:11px;color:var(--text-dim)">${(r.systems||[]).join(', ').replace(/_/g,' ') || '\u2014'}</td>
      </tr>`;
    }).join('');

    // Summary stats
    const withFwd = data.filter(r => r.fwd_trades > 0);
    const survivors = data.filter(r => r.bt_verdict === 'SURVIVOR');
    const avgDecay = withFwd.filter(r => r.decay != null);
    const avgDecayVal = avgDecay.length ? (avgDecay.reduce((s,r) => s + r.decay, 0) / avgDecay.length) : null;

    el('tab-leaderboard').innerHTML = `
      <h2 style="margin-bottom:8px">Strategy Leaderboard (${filtered.length} of ${data.length})</h2>
      <p style="color:var(--text-dim);font-size:12px;margin-bottom:12px">All strategies ranked by performance. Combines backtest survivor results with live forward-testing data.</p>

      <div class="summary-row" style="margin-bottom:12px">
        <div class="stat-card"><div class="label">Total Strategies</div><div class="value">${data.length}</div></div>
        <div class="stat-card"><div class="label">BT Survivors</div><div class="value positive">${survivors.length}</div></div>
        <div class="stat-card"><div class="label">Forward-Tested</div><div class="value" style="color:var(--blue)">${withFwd.length}</div></div>
        <div class="stat-card"><div class="label">Avg Decay</div><div class="value ${avgDecayVal != null && avgDecayVal >= 0 ? 'positive' : 'negative'}">${avgDecayVal != null ? (avgDecayVal >= 0 ? '+' : '') + fmt(avgDecayVal) + '%' : '—'}</div></div>
      </div>

      <div class="filter-bar" style="margin-bottom:12px">
        <label>Verdict:</label>
        <select id="lb-verdict"><option value="">All</option><option value="SURVIVOR">Survivor</option><option value="PROMISING">Promising</option><option value="MARGINAL">Marginal</option><option value="ELIMINATED">Eliminated</option></select>
        <label>Type:</label>
        <select id="lb-type"><option value="">All</option><option value="proven">Proven</option><option value="core">Core</option><option value="incubator">Incubator</option><option value="catered">Catered</option></select>
        <label>Min FWD WR:</label>
        <select id="lb-min-wr"><option value="">All</option><option value="50">≥ 50%</option><option value="55">≥ 55%</option><option value="60">≥ 60%</option><option value="65">≥ 65%</option><option value="70">≥ 70%</option></select>
        <label style="margin-left:8px"><input type="checkbox" id="lb-active-only" style="margin-right:4px;vertical-align:middle">Active Picks Only</label>
        <label>Sort:</label>
        <select id="lb-sort">
          <option value="fwd_trades:desc">FWD Trades ↓ (most proven)</option>
          <option value="fwd_last10_wr:desc">Last 10 WR ↓ (hot streak)</option>
          <option value="fwd_wr:desc">FWD WR ↓</option>
          <option value="fwd_total_pnl:desc">FWD PnL ↓</option>
          <option value="fwd_pf:desc">Profit Factor ↓</option>
          <option value="omega_ratio:desc">Omega Ratio ↓</option>
          <option value="tail_ratio:desc">Tail Ratio ↓</option>
          <option value="fwd_expectancy:desc">Expectancy ↓</option>
          <option value="bt_wr:desc">BT WR ↓</option>
          <option value="bt_sharpe:desc">BT Sharpe ↓</option>
          <option value="bt_sortino:desc">BT Sortino ↓</option>
          <option value="bt_var_99:asc">BT VaR(99%) ↓ (lowest risk)</option>
          <option value="decay:desc">Decay ↓ (best)</option>
          <option value="decay:asc">Decay ↑ (worst)</option>
          <option value="active_picks:desc">Active Picks ↓</option>
        </select>
      </div>

      <table class="data-table" id="lb-table"><thead><tr>
        <th class="num">#</th>
        <th data-sort="strategy" data-sort-type="str">Strategy${sa('strategy')}</th>
        <th data-sort="bt_verdict" data-sort-type="str" class="col-tip" data-tip="Verdict = Backtest survival classification. SURVIVOR: passed rigorous multi-symbol testing. PROMISING: shows potential. MARGINAL: weak edge. ELIMINATED: failed testing.">Verdict${sa('bt_verdict')}</th>
        <th data-sort="portfolio_type" data-sort-type="str" class="col-tip" data-tip="Type = Portfolio category. proven: statistically validated. core: standard strategies. incubator: experimental/new.">Type${sa('portfolio_type')}</th>
        <th data-sort="bt_wr" class="num col-tip" data-tip="BT WR = Backtest Win Rate.">BT WR${sa('bt_wr')}</th>
        <th data-sort="bt_trades" class="num col-tip" data-tip="BT Trades = Total trades in backtesting.">BT Trades${sa('bt_trades')}</th>
        <th data-sort="bt_sharpe" class="num col-tip" data-tip="Sharpe = Risk-adjusted return. >1.0 good, >2.0 excellent.">Sharpe${sa('bt_sharpe')}</th>
        <th data-sort="bt_sortino" class="num col-tip" data-tip="Sortino = Downside risk-adjusted return. >1.0 good, >2.0 excellent.">Sortino${sa('bt_sortino')}</th>
        <th data-sort="bt_var_99" class="num col-tip" data-tip="VaR(99%) = Max expected loss with 99% confidence.">VaR(99%)${sa('bt_var_99')}</th>
        <th data-sort="fwd_wr" class="num col-tip" data-tip="FWD WR = Forward (live paper) Win Rate. TRUE measure of strategy quality.">FWD WR${sa('fwd_wr')}</th>
        <th data-sort="fwd_trades" class="num col-tip" data-tip="FWD Trades = Number of forward/paper trades on real market data.">FWD Trades${sa('fwd_trades')}</th>
        <th data-sort="fwd_total_pnl" class="num col-tip" data-tip="FWD PnL = Cumulative profit/loss from forward testing.">FWD PnL${sa('fwd_total_pnl')}</th>
        <th data-sort="fwd_pf" class="num col-tip" data-tip="Profit Factor = gross win PnL / gross loss PnL. >1.0 = profitable.">PF${sa('fwd_pf')}</th>
        <th data-sort="omega_ratio" class="num col-tip" data-tip="Omega = Total money won / total money lost. ELI5: If you won $200 across all trades and lost $100, your Omega is 2.0. Simple as that. Omega 1.0 = breakeven, 2.0 = you make $2 for every $1 you lose. Higher = better. Used by institutional traders. KIMI Claw weights this at 10%.">Omega${sa('omega_ratio')}</th>
        <th data-sort="tail_ratio" class="num col-tip" data-tip="Tail = How big are your best wins vs your worst losses? ELI5: If your best trade was +5% but your worst was -8%, your Tail is 0.63 (bad — losses are bigger than wins). If best was +8% and worst was -3%, Tail is 2.67 (great — wins are much bigger). Tail >1.0 = your wins outsize your losses. Tail <1.0 = DANGER, losses dominate. KIMI Claw weights this at 10%.">Tail${sa('tail_ratio')}</th>
        <th data-sort="fwd_expectancy" class="num col-tip" data-tip="Expectancy = expected PnL per trade. THE most important single metric.">Expect.${sa('fwd_expectancy')}</th>
        <th data-sort="fwd_max_dd" class="num col-tip" data-tip="FWD Max DD = Max peak-to-trough drawdown.">Max DD${sa('fwd_max_dd')}</th>
        <th data-sort="decay" class="num col-tip" data-tip="Decay = FWD WR minus BT WR. Positive = better live than backtest.">Decay${sa('decay')}</th>
        <th data-sort="active_picks" class="num col-tip" data-tip="Active = Currently open positions from this strategy.">Active${sa('active_picks')}</th>
        <th data-sort="health" data-sort-type="str" class="col-tip" data-tip="Health = Overall strategy health status.">Health${sa('health')}</th>
        <th data-sort="fwd_last10_wr" class="num col-tip" data-tip="Last 10 = Win rate of last 10 forward trades. Green = at/above lifetime, red = below.">Last 10${sa('fwd_last10_wr')}</th>
        <th>Systems</th>
      </tr></thead><tbody>${rows}</tbody></table>
    `;

    // Wire filter controls
    const lbVerdict = document.getElementById('lb-verdict');
    const lbType = document.getElementById('lb-type');
    const lbSort = document.getElementById('lb-sort');
    if (lbVerdict) lbVerdict.value = filterVerdict;
    if (lbType) lbType.value = filterType;
    if (lbSort) lbSort.value = sortKey + ':' + sortDir;

    lbVerdict?.addEventListener('change', () => { filterVerdict = lbVerdict.value; render(); });
    lbType?.addEventListener('change', () => { filterType = lbType.value; render(); });
    lbSort?.addEventListener('change', () => {
      const [k, d] = lbSort.value.split(':');
      sortKey = k; sortDir = d;
      render();
    });
    const lbMinWr = document.getElementById('lb-min-wr');
    const lbActiveOnly = document.getElementById('lb-active-only');
    lbMinWr?.addEventListener('change', () => { filterMinWr = lbMinWr.value; render(); });
    lbActiveOnly?.addEventListener('change', () => { filterActiveOnly = lbActiveOnly.checked; render(); });

    // Clickable column headers for sorting
    document.querySelectorAll('#lb-table th[data-sort]').forEach(th => {
      th.classList.toggle('sort-active', th.dataset.sort === sortKey);
      th.addEventListener('click', () => {
        const key = th.dataset.sort;
        const isStr = th.dataset.sortType === 'str';
        if (sortKey === key) {
          sortDir = sortDir === 'desc' ? 'asc' : 'desc';
        } else {
          sortKey = key;
          sortDir = isStr ? 'asc' : 'desc'; // strings default A-Z, numbers default high-to-low
        }
        if (lbSort) lbSort.value = sortKey + ':' + sortDir;
        render();
      });
    });
  }

  render();
}

// ── Tab switching ──
document.querySelectorAll('.tab-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
    btn.classList.add('active');
    el('tab-' + btn.dataset.tab).classList.add('active');
  });
});

// ── Filter events ──
function onFilterChange() { renderSummary(); renderPicks(); }
['f-asset', 'f-system', 'f-status', 'f-dir', 'f-pnl', 'f-conf', 'f-age', 'f-tp-rem', 'f-sort', 'f-conflicts', 'f-timeframe'].forEach(id => {
  el(id).addEventListener('change', onFilterChange);
});
el('f-search').addEventListener('input', onFilterChange);

// ── Refresh button ──
el('btn-refresh').addEventListener('click', () => {
  el('btn-refresh').textContent = 'Refreshing...';
  el('btn-refresh').disabled = true;
  // Bust cache and reload
  setTimeout(() => location.reload(true), 200);
});

// ── Best Picks preset — show highest trust-tier-weighted scores ──
el('btn-best-fresh').addEventListener('click', () => {
  // Clear all filters — let trust tier scoring do the heavy lifting
  window._provenOnlyFilter = false;
  ['f-pnl','f-conf','f-age','f-tp-rem','f-dir','f-asset','f-system','f-status','f-conflicts','f-timeframe'].forEach(id => el(id).value = '');
  el('f-search').value = '';
  el('f-sort').value = 'score_desc';
  // Only apply light filters: age <= 48h (stale picks are useless)
  el('f-age').value = '48';
  // Switch to Active Picks tab
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
  document.querySelector('[data-tab="active"]').classList.add('active');
  el('tab-active').classList.add('active');
  renderPicks();
});

