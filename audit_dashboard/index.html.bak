  'ml_bg_system_a',         // 19 trades, 10.5% WR, -50% PnL, PF 0.14
  'ml_bg_system_b',         // 19 trades, 5.6% WR, -55% PnL, PF 0.02
  'ml_crypto_pred_v12',     // 117 trades, 36.8% WR, -32% PnL, PF 0.55
  // ── Added 2026-03-15: 5 proven losing systems blocked from consensus ──
  'multi_asset',            // 80 trades, 25.8% WR, PF 0.28
  'crypto_winners',         // 48 trades, 39.6% WR, PF 0.30
  'kimi_riseoftheclaw',     // 270 trades, 36.7% WR, -219% PnL (standalone only; still valid as confirmer)
  'ml_bg_system_c',         // 5 trades, 0% WR
  'ml_bg_ensemble',         // 8 trades, 0% WR, -33% PnL
]);
function isBlockedSystem(name) {
  const nm = (name || '').toLowerCase();
  for (const blocked of BLOCKED_SYSTEMS) {
    if (nm === blocked || nm.includes(blocked)) return true;
  }
  return false;
}

