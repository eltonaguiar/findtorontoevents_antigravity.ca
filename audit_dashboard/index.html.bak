// ── Deduplication groups: systems that share underlying engines ──
// Within each group, picks with same symbol+direction count as ONE signal in the agreement matrix
const SYS_DEDUP_GROUPS = {
  'genome_gp': ['genetic_programmer','audit_ensemble','mape_evolver','ensemble_evolver','neat_neural','hyperparam_dna','failure_evolver','momentum_evolver','multitf_evolver','contrarian_evolver','genome','macd_dna_mutations','mutation_lab','pumpwatch_mutations','signal_engine_mutations','dna_winner_picks','battleground_mutations','universal_picks','genome_hyperparam','genome_neat'],
  'kimi': ['kimi_riseoftheclaw','kimi_live_signals','kimi_signal_tracking','riseoftheclaw'],
  'revival': ['revival_all','revival_battleground','revival_breakout_a','revival_breakout_b','revival_signal_engine','revival_kimi','revival_mercury2','revival_paper_trading','revival_ml_system_b','revival_ml_system_c','revival_breakout_spike','revival_crypto_gainer_ml'],
