<script>
// Function to display detailed strategy performance popup
function showStrategyPopup(iconElem, strategyName) {
  // Find the nearest popup container
  const popup = iconElem.parentElement.querySelector('.strategy-popup');
  if (!popup) return;
  // If already visible, toggle off
  if (popup.style.display === 'block') {
    popup.style.display = 'none';
    return;
  }
  // Gather data for the strategy from the global dashboard data
  const stratData = (window.D && window.D.leaderboard) ? window.D.leaderboard.find(s => s.strategy === strategyName) : null;
  if (!stratData) {
    popup.innerHTML = '<div style="color:#f87171">Data not available</div>';
    popup.style.display = 'block';
    return;
  }
  // Build HTML content with required metrics
  const content = `
    <div style="font-weight:600; margin-bottom:4px;">${strategyName}</div>
    <div style="font-size:12px;">
      <b>Forward Trades:</b> ${stratData.fwd_trades ?? 'n/a'}<br/>
      <b>Forward Win Rate:</b> ${stratData.fwd_wr ?? 'n/a'}%<br/>
      <b>Forward PnL:</b> ${stratData.fwd_pnl_pct ?? 'n/a'}%<br/>
      <b>Forward Max Drawdown:</b> ${stratData.fwd_max_dd ?? 'n/a'}%<br/>
      <b>Sharpe Ratio:</b> ${stratData.sharpe ?? 'n/a'}<br/>
      <b>Avg PnL / Trade:</b> ${stratData.avg_pnl_per_trade ?? 'n/a'}%<br/>
      <b>Profit Factor:</b> ${stratData.profit_factor ?? 'n/a'}<br/>
      <b>W/L Ratio:</b> ${stratData.wl_ratio ?? 'n/a'}<br/>
      <b>Active Picks:</b> ${stratData.active_picks ?? 'n/a'}<br/>
      <b>Last 5 Picks:</b> ${stratData.last_5_picks ?? 'n/a'}<br/>
      <b>Backtest (90d) Win Rate:</b> ${stratData.bt_wr_90d ?? 'n/a'}%<br/>
      <b>Backtest (90d) PnL:</b> ${stratData.bt_pnl_90d ?? 'n/a'}%<br/>
    </div>
  `;
  popup.innerHTML = content;
  popup.style.display = 'block';
  // Position popup near the icon
  const rect = iconElem.getBoundingClientRect();
  popup.style.top = (rect.bottom + window.scrollY) + 'px';
  popup.style.left = (rect.left + window.scrollX) + 'px';
}
