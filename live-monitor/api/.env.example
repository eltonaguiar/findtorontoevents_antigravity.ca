# live-monitor/api/.env.example
#
# Copy this file to .env (same directory), fill in the real values,
# and FTP-upload it to the 50webs server at:
#   /findtorontoevents.ca/live-monitor/api/.env
#
# NEVER commit .env to git — it is gitignored.
# db_config.php reads this file as a fallback when getenv() returns empty
# (which it always does on 50webs shared hosting for custom variables).
#
# Quotes are optional; use double-quotes if the password contains # or spaces:
#   DB_SPORTS_PASSWORD="p@ss#word with spaces"

# Main stocks DB (ejaguiar1_stocks on mysql.50webs.com)
DB_STOCKS_PASSWORD=REPLACE_WITH_REAL_PASSWORD

# Sports betting DB (ejaguiar1_sportsbet on mysql.50webs.com)
DB_SPORTS_PASSWORD=REPLACE_WITH_REAL_PASSWORD
