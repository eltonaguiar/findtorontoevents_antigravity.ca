# ============================================================
# RUFLO SWARM — API Key Configuration
# ============================================================
# Copy this file to .env and fill in your keys.
# Keys in .env are gitignored — safe to commit placeholders.
# ============================================================

# --- FREE TIER KEYS (recommended first) ---

# OpenRouter Free Tier Key — gives access to 4+ working free models
#   ✅ Works: tencent/hy3-preview:free, nvidia/nemotron-3-nano-30b-a3b:free,
#            nvidia/nemotron-3-super-120b-a12b:free, minimax/minimax-m2.5:free
# Get from: https://openrouter.ai/credits → Dashboard → Credits
# OPENROUTER_FREE_KEY=sk-or-v1-...

# Google AI Studio (Gemini Free) — works without paid credits
#   ✅ Works: gemini-2.5-flash via OpenAI-compatible endpoint
# Get from: https://aistudio.google.com/app/apikey → Get API Key
# GEMINI_FREE_KEY=...

# OpenCode Free Tier — opencode.ai CLI
#   ✅ Works: opencode.ai free models
# Get from: https://opencode.ai/settings/api-keys
# OPENCODE_FREE_TIER=sk-...

# --- PAID TIER KEYS ---

# Cerebras (PAID) — gpt-oss-120b, extremely fast
#   ✅ Confirmed working: csk-ptx8n...
# Get from: https://cerebras.ai → API Keys
# CEREBRAS_API_KEY_PAID=csk-...
# CEREBRAS_API_KEY=csk-...  # legacy alias

# DeepSeek — strong coding model, good value
# Get from: https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=sk-...

# xAI (Grok) — Grok-3 latest model
# Get from: https://console.x.ai → API Keys
# X_AI_KEY=sk-...


# Groq — fast LPU inference, free tier available
# Get from: https://console.groq.com/keys
# GROQ_KEY=sk-...

# HuggingFace — inference API with free tier
# Get from: https://huggingface.co/settings/tokens
# HUGGINGFACE_API=hf_...

# OpenRouter (PAID) — 200+ models, various pricing
# Get from: https://openrouter.ai/settings → API Keys
# OPENROUTER_API_KEY=sk-or-v1-...

# Ollama Cloud — local Ollama CLI with cloud sync
# Get from: https://ollama.com/cloud → API Keys
# OLLAMA_CLOUD_KEY=sk-...

# --- AUTHENTICATION ---

# GitHub Token — for GitHub Models free inference + CLI tools
# Set via: gh auth login
# GITHUB_TOKEN=ghp_...
# GH_TOKEN=ghp_...

# ============================================================
# PROVIDER SIGNUP URLS (MASSREVIEW 2026-05-05 validated)
# ============================================================
# Pollinations:  https://pollinations.ai/     — NO KEY NEEDED!
# OpenRouter:    https://openrouter.ai/signup → keys: https://openrouter.ai/settings/keys
# Google Gemini: https://aistudio.google.com/  → keys: https://aistudio.google.com/app/apikeys
# Cerebras:      https://cloud.cerebras.ai/   → keys: https://cloud.cerebras.ai/platform/user/api-keys
# DeepSeek:      https://platform.deepseek.com/ → keys: https://platform.deepseek.com/api_keys
# xAI/Grok:      https://console.x.ai/        → keys: https://console.x.ai/team/[TEAM]/api-keys
# OpenCode:      https://opencode.ai/         → npm install -g opencode (CLI, not API key)
# Groq:          https://console.groq.com/    → keys: https://console.groq.com/keys
# HuggingFace:   https://huggingface.co/      → tokens: https://huggingface.co/settings/tokens
# GitHub:        https://github.com/marketplace/models → tokens: https://github.com/settings/tokens
# ============================================================
# ============================================================
# FTP deploy (updates/ pages + site files) — tools/deploy_updates_v05.py
# Copy these into the gitignored .env with real values after rotating
# the password (the old values were hard-coded in the script until
# 2026-10-19 and must be considered exposed until rotated).
# ============================================================
FTP_SERVER=your-ftp-host.example.com
FTP_USER=your-ftp-user
FTP_PASS=your-ftp-password
