    table.cell(guidePanel, 0, 21, "BUY/SELL NOW = trade signal. LEAN = directional bias only. Use Multi-Strategy Consensus for crypto.", text_color=#888888, text_size=size.tiny, bgcolor=#0f0f1e, text_halign=text.align_center)
    table.merge_cells(guidePanel, 0, 21, 1, 21)


// ============================================================================
//                  QUICK DECISION TREE (compact traffic light)
// ============================================================================
// 3 columns x 7 rows — glance-and-go verdict: GO / CAUTION / SKIP.
// Evaluates 5 key factors: Confidence, Volume, TF Match, Signal/Bias, Proven.

qdtPos = switch i_qdtLocation
    "Top Left" => position.top_left
    "Top Right" => position.top_right
    "Bottom Left" => position.bottom_left
    => position.bottom_right

var table qdtPanel = table.new(qdtPos, 3, 7, bgcolor=#0a0a14, border_color=#2a2a4a, border_width=1, frame_color=#f59e0b, frame_width=2)

if barstate.islast and i_showQDT
    // --- Compute decision factors ---
    _qdt_biasNet = _biasBull - _biasBear
    _qdt_proven = _activeIdx >= 0 and _activeIdx < array.size(strat_proven) ? array.get(strat_proven, _activeIdx) : false
    _qdt_conf = dynamicConfidence

    // 5 binary factors
    bool _qf1 = _qdt_conf >= 60.0
    bool _qf2 = not _vol_weak
    bool _qf3 = _tf_match_score >= 10.0
    bool _qf4 = isLong or isShort or math.abs(_qdt_biasNet) >= 3
    bool _qf5 = _qdt_proven

    int _qdt_pass = (_qf1?1:0) + (_qf2?1:0) + (_qf3?1:0) + (_qf4?1:0) + (_qf5?1:0)

    // --- Tier logic ---
    string _qdt_tier = "CAUTION"
    if _qf1 and _qf2 and _qf3 and _qf4
        _qdt_tier := "GO"
    else if _qdt_conf < 40.0 or _tf_match_score < 5.0 or (_vol_weak and _qdt_conf < 60.0)
        _qdt_tier := "SKIP"

    // Proven upgrade (one tier bump)
    if _qf5
        if _qdt_tier == "CAUTION"
            _qdt_tier := "GO"
        else if _qdt_tier == "SKIP"
            _qdt_tier := "CAUTION"

    // --- Colors ---
    _qdtTierColor = _qdt_tier == "GO" ? #22c55e : _qdt_tier == "SKIP" ? #ef4444 : #eab308
    _qdtTierBg = _qdt_tier == "GO" ? color.new(#22c55e, 70) : _qdt_tier == "SKIP" ? color.new(#ef4444, 70) : color.new(#eab308, 70)

    // --- Row 0: Title ---
    table.cell(qdtPanel, 0, 0, "QUICK DECISION", text_color=#00d4ff, text_size=size.small, text_halign=text.align_center)
    table.merge_cells(qdtPanel, 0, 0, 2, 0)

    // --- Rows 1-5: Factor checklist ---
    _p1 = _qf1 ? "YES" : "NO"
    _c1 = _qf1 ? #22c55e : #ef4444
    _p2 = _qf2 ? "YES" : "NO"
    _c2 = _qf2 ? #22c55e : #ef4444
    _p3 = _qf3 ? "YES" : "NO"
    _c3 = _qf3 ? #22c55e : #ef4444
    _p4 = _qf4 ? "YES" : "NO"
    _c4 = _qf4 ? #22c55e : #ef4444
    _p5 = _qf5 ? "YES" : "NO"
    _c5 = _qf5 ? #22c55e : #ef4444

    // Row 1: Confidence
    _confLabel = "Conf " + str.tostring(_qdt_conf, "#") + "%"
    table.cell(qdtPanel, 0, 1, "1", text_color=#555555, text_size=size.tiny, bgcolor=#0f0f1e, text_halign=text.align_center)
    table.cell(qdtPanel, 1, 1, _confLabel, text_color=#aaaacc, text_size=size.tiny, bgcolor=#0f0f1e)
    table.cell(qdtPanel, 2, 1, _p1, text_color=_c1, text_size=size.tiny, bgcolor=#0f0f1e, text_halign=text.align_center)

    // Row 2: Volume
    _volLabel = "Vol " + _vol_status
    table.cell(qdtPanel, 0, 2, "2", text_color=#555555, text_size=size.tiny, text_halign=text.align_center)
    table.cell(qdtPanel, 1, 2, _volLabel, text_color=#aaaacc, text_size=size.tiny)
    table.cell(qdtPanel, 2, 2, _p2, text_color=_c2, text_size=size.tiny, text_halign=text.align_center)

    // Row 3: TF Match
    table.cell(qdtPanel, 0, 3, "3", text_color=#555555, text_size=size.tiny, bgcolor=#0f0f1e, text_halign=text.align_center)
    table.cell(qdtPanel, 1, 3, "TF " + _tf_match_str, text_color=#aaaacc, text_size=size.tiny, bgcolor=#0f0f1e)
    table.cell(qdtPanel, 2, 3, _p3, text_color=_c3, text_size=size.tiny, bgcolor=#0f0f1e, text_halign=text.align_center)

    // Row 4: Signal / Bias strength
    _sigLabel = isLong ? "BUY signal" : isShort ? "SELL signal" : math.abs(_qdt_biasNet) >= 3 ? "Bias " + str.tostring(_qdt_biasNet) : "Weak bias"
    table.cell(qdtPanel, 0, 4, "4", text_color=#555555, text_size=size.tiny, text_halign=text.align_center)
    table.cell(qdtPanel, 1, 4, _sigLabel, text_color=#aaaacc, text_size=size.tiny)
    table.cell(qdtPanel, 2, 4, _p4, text_color=_c4, text_size=size.tiny, text_halign=text.align_center)

    // Row 5: Proven status
    _provenLabel = _qdt_proven ? "PROVEN" : "Unproven"
    table.cell(qdtPanel, 0, 5, "5", text_color=#555555, text_size=size.tiny, bgcolor=#0f0f1e, text_halign=text.align_center)
    table.cell(qdtPanel, 1, 5, _provenLabel, text_color=_qdt_proven ? #22c55e : #888888, text_size=size.tiny, bgcolor=#0f0f1e)
    table.cell(qdtPanel, 2, 5, _p5, text_color=_c5, text_size=size.tiny, bgcolor=#0f0f1e, text_halign=text.align_center)

    // Row 6: VERDICT (large, colored)
    _tierIcon = _qdt_tier == "GO" ? ">>  GO" : _qdt_tier == "SKIP" ? ">>  SKIP" : ">>  CAUTION"
    _passText = str.tostring(_qdt_pass) + "/5"
    table.cell(qdtPanel, 0, 6, _tierIcon, text_color=_qdtTierColor, text_size=size.normal, text_halign=text.align_center, bgcolor=_qdtTierBg)
    table.merge_cells(qdtPanel, 0, 6, 1, 6)
    table.cell(qdtPanel, 2, 6, _passText, text_color=_qdtTierColor, text_size=size.small, text_halign=text.align_center, bgcolor=_qdtTierBg)


// ============================================================================
