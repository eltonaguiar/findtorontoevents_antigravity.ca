i_decisionLocation = input.string("Top Left", "Decision Panel Location", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group=groupDecision)
i_minConfidence = input.int(40, "Minimum Confidence %", minval=0, maxval=95, step=5, group=groupDecision, tooltip="Signals below this confidence are filtered out")
i_htfTrend = input.string("60", "Higher TF Trend Filter", options=["15", "60", "240", "D", "W"], group=groupDecision, tooltip="Timeframe for trend alignment scoring (EMA 9/21)")
i_minRR = input.float(1.5, "Minimum R:R Ratio", minval=0.0, maxval=10.0, step=0.5, group=groupDecision, tooltip="Signals below this Risk:Reward ratio are filtered. 0 = disabled.")
i_smartTPSL = input.bool(true, "Smart TP/SL (auto-cleanup)", group=groupDecision, tooltip="Deletes previous TP/SL boxes when a new signal fires")
i_showGuide = input.bool(false, "Show User Guide", group=groupDecision, tooltip="Displays a reference guide explaining verdicts, confidence, and how to read the Decision Panel")
i_showQDT = input.bool(true, "Show Quick Decision Tree", group=groupDecision, tooltip="Compact traffic-light panel: GO / CAUTION / SKIP based on 5 key factors")
i_qdtLocation = input.string("Bottom Left", "Quick Decision Location", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group=groupDecision)

// === PERFORMANCE MODE ===
groupPerf = "PERFORMANCE DATA"
i_perfMode = input.string("Backtest", "Performance Mode", ["Backtest", "Forward-Test", "Both"], group=groupPerf, tooltip="Backtest: Historical validated results. Forward-Test: Live paper trading results.")
i_showDashboard = input.bool(false, "Show Strategy Dashboard", group=groupPerf)
i_dashLocation = input.string("Top Right", "Dashboard Location", ["Top Right", "Bottom Right", "Bottom Left"], group=groupPerf)
i_dashSize = input.string("Small", "Dashboard Size", ["Tiny", "Small", "Normal"], group=groupPerf)

// === RISK MANAGEMENT ===
groupRisk = "RISK MANAGEMENT"
i_showTPSL = input.bool(true, "Show TP/SL Zones", group=groupRisk)
i_tpMult = input.float(3.0, "TP Multiplier (ATR)", minval=1.0, maxval=10.0, step=0.5, group=groupRisk, tooltip="Take Profit = Entry + ATR * this value")
i_slMult = input.float(1.5, "SL Multiplier (ATR)", minval=0.5, maxval=5.0, step=0.5, group=groupRisk, tooltip="Stop Loss = Entry - ATR * this value")
i_atrPeriod = input.int(14, "ATR Period", minval=5, maxval=50, group=groupRisk)
i_tpslBars = input.int(25, "TP/SL Box Width (bars)", minval=5, maxval=100, group=groupRisk)

// === VISUAL SETTINGS ===
groupVisual = "VISUAL SETTINGS"
i_candleColor = input.string("Confirmation Gradient", "Candle Coloring", ["Confirmation Gradient", "Contrarian Gradient", "None"], group=groupVisual)
i_showReversal = input.bool(true, "Reversal Zones", group=groupVisual)
i_showSessions = input.bool(false, "Sessions (NY/London)", group=groupVisual)

// === REVERSAL ZONE SETTINGS ===
groupRZ = "REVERSAL ZONES"
i_rzLength = input.int(20, "SuperSmoother Length", minval=5, maxval=100, group=groupRZ)
i_rzAtrLen = input.int(14, "ATR Length (Bands)", minval=5, maxval=50, group=groupRZ)
i_rzInnerMult = input.float(3.14159, "Inner Band Mult (pi*1.0*ATR)", minval=1.0, maxval=10.0, group=groupRZ)
i_rzOuterMult = input.float(7.588, "Outer Band Mult (pi*2.415*ATR)", minval=2.0, maxval=20.0, group=groupRZ)

// === SESSION SETTINGS ===
