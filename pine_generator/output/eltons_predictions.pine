// --- Estimated round-trip transaction cost per trade (embedded by generator) ---
var float[] tx_cost   = array.from(0.03, 0.03, 0.25, 0.25, 0.25, 0.25, 0.25, 0.25, 0.25, 0.25, 0.25, 0.25, 0.25, 0.50, 0.25, 0.25, 0.03, 0.25, 0.25, 0.25, 0.25, 0.50, 0.50, 0.25, 0.03, 0.25, 0.03, 0.25, 0.25, 0.25)

// --- Proven status: declared earlier (before decision panel) ---

// --- Build Dashboard Table (12 columns x 26 rows) ---
// Column 0=Status, 1=Strategy, 2=WR%, 3=Net WR%, 4=Costs, 5=Sharpe, 6=p-val, 7=Trades, 8=TF, 9=Mode, 10=Method, 11=Tested On
dashPos = i_dashLocation == "Top Right" ? position.top_right : i_dashLocation == "Bottom Right" ? position.bottom_right : position.bottom_left
dSize = i_dashSize == "Tiny" ? size.tiny : i_dashSize == "Small" ? size.small : size.normal

var table dash = table.new(dashPos, 12, 35, bgcolor=#0f0f1a, border_color=#2a2a4a, border_width=1, frame_color=#2a2a4a, frame_width=2)

if barstate.islast and i_showDashboard
    // --- Title row ---
    table.cell(dash, 0, 0, "Elton's Predictions v6.0.2289 | 2/30 Strategies Proven", text_color=#00d4ff, text_size=dSize, text_halign=text.align_center)
    table.merge_cells(dash, 0, 0, 11, 0)

    // --- Generated date row ---
    table.cell(dash, 0, 1, "Generated: 2026-08-07T13:12:20Z", text_color=#666666, text_size=size.tiny, text_halign=text.align_center)
    table.merge_cells(dash, 0, 1, 11, 1)

    // --- Header row ---
    headerLabels = array.from("Status", "Strategy", "WR%", "Net WR%", "Costs", "Sharpe", "p-val", "Trades", "TF", "Mode", "Method", "Tested On")
    for i = 0 to 11
        table.cell(dash, i, 2, array.get(headerLabels, i), text_color=#aaaacc, text_size=dSize, bgcolor=#1a1a2e, text_halign=text.align_center)

    // --- Data rows (25 strategies) ---
    for row = 0 to 23
        isActive = row == _activeIdx or (_effectiveStrategy == "Multi-Strategy Consensus")
        isProven = array.get(strat_proven, row)
        rowBg = isActive ? #1a2a3a : isProven ? #0f0f1a : #0a0a10

        // Select backtest or forward-test data based on mode
        wr = i_perfMode == "Forward-Test" ? array.get(ft_wr, row) : array.get(bt_wr, row)
        trades = i_perfMode == "Forward-Test" ? array.get(ft_trades, row) : array.get(bt_trades, row)
        wrColor = isProven ? (wr > 65 ? #22c55e : wr > 55 ? #eab308 : #888888) : #555555
        mode = i_perfMode == "Forward-Test" ? "Forward" : "Backtest"

        // "Both" mode: show backtest WR with forward trades appended
        if i_perfMode == "Both"
            wr := array.get(bt_wr, row)
            trades := array.get(bt_trades, row) + array.get(ft_trades, row)
            mode := "Both"
            wrColor := isProven ? (wr > 65 ? #22c55e : wr > 55 ? #eab308 : #888888) : #555555

        // Text dimming for unproven strategies
        nameColor = isProven ? (isActive ? #00d4ff : #ffffff) : #666666
        statColor = isProven ? #cccccc : #444444
        methodColor = isProven ? #888888 : #333333

        // Status badge (PROVEN / UNPROVEN)
        statusText = isProven ? "PROVEN" : "UNPROVEN"
        statusColor = isProven ? #22c55e : #555555
        statusBg = isProven ? color.new(#22c55e, 90) : color.new(#555555, 90)
        table.cell(dash, 0, row + 3, statusText, text_color=statusColor, text_size=dSize, bgcolor=statusBg, text_halign=text.align_center)

        // Strategy name (highlight active, dim unproven)
        table.cell(dash, 1, row + 3, array.get(strat_names, row), text_color=nameColor, text_size=dSize, bgcolor=rowBg, text_halign=text.align_left)
        // Win Rate (show "--" for unproven with 0 trades)
        wrText = isProven ? str.tostring(wr, "#.#") + "%" : trades > 0 ? str.tostring(wr, "#.#") + "%" : "--"
        table.cell(dash, 2, row + 3, wrText, text_color=wrColor, text_size=dSize, bgcolor=rowBg, text_halign=text.align_center)
        // Net Win Rate (after transaction costs)
        nwr = array.get(net_wr, row)
        nwrText = isProven ? str.tostring(nwr, "#.#") + "%" : trades > 0 ? str.tostring(nwr, "#.#") + "%" : "--"
        nwrColor = isProven ? (nwr > 55 ? #22c55e : nwr > 50 ? #eab308 : #ef4444) : #555555
        table.cell(dash, 3, row + 3, nwrText, text_color=nwrColor, text_size=dSize, bgcolor=rowBg, text_halign=text.align_center)
        // Transaction Costs (round-trip %)
        costVal = array.get(tx_cost, row)
        costText = str.tostring(costVal, "#.##") + "%"
        costColor = costVal <= 0.05 ? #22c55e : costVal <= 0.3 ? #eab308 : #ef4444
        table.cell(dash, 4, row + 3, costText, text_color=costColor, text_size=dSize, bgcolor=rowBg, text_halign=text.align_center)
        // Sharpe Ratio
        sharpeText = isProven ? str.tostring(array.get(bt_sharpe, row), "#.##") : "--"
        table.cell(dash, 5, row + 3, sharpeText, text_color=statColor, text_size=dSize, bgcolor=rowBg, text_halign=text.align_center)
        // P-value
        pvalText = isProven ? array.get(bt_pval, row) : "N/A"
        table.cell(dash, 6, row + 3, pvalText, text_color=statColor, text_size=dSize, bgcolor=rowBg, text_halign=text.align_center)
        // Trade count
        tradeText = trades > 0 ? str.tostring(trades) : "--"
        table.cell(dash, 7, row + 3, tradeText, text_color=statColor, text_size=dSize, bgcolor=rowBg, text_halign=text.align_center)
        // Timeframe
        table.cell(dash, 8, row + 3, array.get(bt_tf, row), text_color=statColor, text_size=dSize, bgcolor=rowBg, text_halign=text.align_center)
        // Mode
        modeColor = mode == "Forward" ? #3b82f6 : mode == "Both" ? #a78bfa : isProven ? #f59e0b : #444444
        table.cell(dash, 9, row + 3, mode, text_color=modeColor, text_size=dSize, bgcolor=rowBg, text_halign=text.align_center)
        // Method
        table.cell(dash, 10, row + 3, array.get(bt_method, row), text_color=methodColor, text_size=dSize, bgcolor=rowBg, text_halign=text.align_left)
        // Tested On
        table.cell(dash, 11, row + 3, array.get(bt_symbol, row), text_color=methodColor, text_size=dSize, bgcolor=rowBg, text_halign=text.align_center)

    // --- Disclaimer row ---
    table.cell(dash, 0, 27, "Only PROVEN strategies (p<0.05) contribute to signal confidence. UNPROVEN = no real backtest data. Net WR = after fees/slippage.", text_color=#ef4444, text_size=size.tiny, text_halign=text.align_center)
    table.merge_cells(dash, 0, 27, 11, 27)

    // --- Proven summary row ---
    table.cell(dash, 0, 28, "2/30 strategies backed by real backtest data with statistical significance | Costs: exchange fees + spread + slippage", text_color=#22c55e, text_size=size.tiny, text_halign=text.align_center)
    table.merge_cells(dash, 0, 28, 11, 28)

    // --- Footer row: Active strategy summary with dynamic confidence ---
    footerText = "Active: " + _stratDisplay + " | Conf: " + str.tostring(dynamicConfidence, "#") + "% | ATR: " + str.tostring(atrVal, format.mintick)
    table.cell(dash, 0, 29, footerText, text_color=#00d4ff, text_size=size.tiny, text_halign=text.align_center)
    table.merge_cells(dash, 0, 29, 11, 29)


// ============================================================================
//                  SIGNAL HISTORY TRACKER
// ============================================================================
// Tracks recent signal counts for the active strategy (on-chart reference).

var int longCount  = 0
var int shortCount = 0
var int totalBars  = 0

if isLong
    longCount += 1
if isShort
    shortCount += 1
totalBars += 1

// Small info label on last bar
if barstate.islast and i_showSignals
    infoText = _stratDisplay + "\nLongs: " + str.tostring(longCount) + " | Shorts: " + str.tostring(shortCount) + "\nBars: " + str.tostring(totalBars)
    label.new(bar_index + 3, close, infoText, style=label.style_label_left, color=color.new(#1a1a2e, 20), textcolor=#aaaacc, size=size.tiny)


// ============================================================================
//                  BACKGROUND HIGHLIGHTS
// ============================================================================
// Subtle background color on signal bars for quick visual scanning.

bgLong  = isLong and i_showSignals ? color.new(#22c55e, 93) : na
bgShort = isShort and i_showSignals ? color.new(#ef4444, 93) : na
bgcolor(bgLong, title="Long Signal Background")
bgcolor(bgShort, title="Short Signal Background")


// ============================================================================
//                  MULTI-STRATEGY CONSENSUS METER
// ============================================================================
// When Multi-Strategy Consensus is selected, shows a visual meter of how many
// strategies agree on the current direction.

if barstate.islast and _effectiveStrategy == "Multi-Strategy Consensus" and i_showSignals
    // Uses pre-computed _consBull / _consBear from global scope (no conditional function calls)
    meterText = "CONSENSUS METER\n" + "Bull: " + str.tostring(_consBull) + "/23 | Bear: " + str.tostring(_consBear) + "/23\n" + "2/30 strategies proven (p<0.05)"
    meterColor = _consBull >= 3 ? color.new(#22c55e, 30) : _consBear >= 3 ? color.new(#ef4444, 30) : color.new(#888888, 30)
    label.new(bar_index + 6, high, meterText, style=label.style_label_left, color=meterColor, textcolor=color.white, size=size.small)


