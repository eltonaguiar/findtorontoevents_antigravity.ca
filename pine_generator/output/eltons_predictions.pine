// Placeholder index reference for the Python generator:
//
// Strategy order (index 0-23):
//   0 = Connors RSI-2
//   1 = VIX Spike Reversal
//   2 = MACD Momentum
//   3 = EMA Crossover
//   4 = Ichimoku Cloud
//   5 = Bollinger Squeeze
//   6 = VWAP Reversion
//   7 = RSI Divergence
//   8 = Supertrend
//   9 = Swing Failure Pattern (SFP)
//   10 = Break of Structure (BOS)
//   11 = Liquidation Cascade
//   12 = Momentum Crash
//   13 = Multi-Strategy Consensus
//   14 = Seasonal Bias
//   15 = Halving Cycle
//   16 = Turn of Month
//   17 = Day of Week
//   18 = Cycle Detection
//   19 = S/R Magnetism
//   20 = Liquidity Sweep Reversal
//   21 = Nonlinear TSMOM (Moskowitz 2025)
//   22 = CTREND Multi-MA (Fieberg 2025 JFQA)
//   23 = Flash Crash Reversal
//   24 = HMA Trend (Hull Moving Average, Alan Hull 2005)
//
// Backtest placeholders:
//   75.7 .. 0.0           float  Win rate percentage (e.g. 75.7)
//   4.514 .. 4.450   float  Sharpe ratio (e.g. 4.84)
//   "6.0e-06" .. "0.26"       string P-value (e.g. "6e-06")
//   74 .. 22   int    Number of trades (e.g. 148)
//   "Daily" .. "1H-Daily"           string Timeframe (e.g. "1D")
//   "RSI(2)<5+SMA200" .. "HMA50 dir+SMA50"   string Method name (e.g. "Mean Reversion")
//   "SPY" .. "SPY"   string Backtested symbol (e.g. "SPY")
//
// Forward-test placeholders:
//   0.0 .. 0.0           float  Forward-test win rate
//   0 .. 0   int    Forward-test trade count
//
// Transaction cost placeholders:
//   75.7 .. 0.0         float  Net win rate after transaction costs (e.g. 72.5)
//   0.03 .. 0.03       float  Estimated round-trip cost % (e.g. 0.25)
//
// Proven status placeholders:
//   true .. false          bool   true if real backtest with p<0.05
//
// Global placeholders:
//   6.0.2289          string  Version number (e.g. "5.0.0")
//   30   string  Number of strategies (e.g. "24")
//   2     string  Number of proven strategies (e.g. "2")
//   30      string  Total number of strategies (e.g. "24")
//   2026-08-07T13:12:20Z   string  ISO date of generation (e.g. "2026-02-20")
//   5.0 string  Template version (e.g. "4.0")
