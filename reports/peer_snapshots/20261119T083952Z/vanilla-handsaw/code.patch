+    assert b["ci_hi"] - b["ci_lo"] > a["ci_hi"] - a["ci_lo"]
+    # The i.i.d. default is unchanged and does not opt into block mode.
+    iid = bootstrap_mean_ci(spread)
+    assert iid["bootstrap_mode"] == "iid"
