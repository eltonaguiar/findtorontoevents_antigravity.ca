+            _row_keys = {(str(r.get("asset_class") or "").upper(),
+                          str(r.get("strategy") or r.get("source_system") or ""))
+                         for r in rows}
+            _row_keys_ci = {(ac, strat.lower()) for ac, strat in _row_keys}
+            # Class-relative PF baseline: a sleeve an order of magnitude above
+            # its own class aggregate is a grading artefact, not an edge.
+            _win: dict[str, float] = {}
+            _loss: dict[str, float] = {}
+            for _r in rows:
+                _c = str(_r.get("asset_class") or "").upper()
