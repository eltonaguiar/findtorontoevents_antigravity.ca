+                    if _cls_pf and _cls_pf > 0 and (_pf / _cls_pf) > IMPLAUSIBLE_PF_MULT:
+                        _reasons.append(f"pf is {_pf / _cls_pf:.1f}x the class aggregate "
+                                        f"({_pf:.2f} vs {_cls_pf:.2f}), ceiling "
