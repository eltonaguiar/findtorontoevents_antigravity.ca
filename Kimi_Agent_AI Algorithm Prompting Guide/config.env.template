# On-Chain Data Configuration
# ===========================

# API Keys (Get these from respective providers)
WHALE_ALERT_API_KEY=your_whale_alert_api_key_here
GLASSNODE_API_KEY=your_glassnode_api_key_here
DUNE_API_KEY=your_dune_api_key_here

# Rate Limits (adjust based on your plan)
WHALE_ALERT_RATE_LIMIT=10  # calls per minute (free tier)
GLASSNODE_RATE_LIMIT=30    # calls per minute (free tier)

# Cache Settings
CACHE_TTL_SECONDS=300      # Default cache time
WHALE_CACHE_TTL=60         # Whale data cache (frequent updates)
EXCHANGE_CACHE_TTL=300     # Exchange flow cache

# Whale Thresholds
WHALE_THRESHOLD_USD=10000000       # $10M minimum
MAJOR_WHALE_THRESHOLD_USD=50000000 # $50M for major signals

# Confidence Scoring Weights
WHALE_SCORE_WEIGHT=0.4      # 40% weight for whale data
EXCHANGE_SCORE_WEIGHT=0.6   # 60% weight for exchange flows
TECHNICAL_WEIGHT=0.7        # 70% weight for technical signals
ONCHAIN_WEIGHT=0.3          # 30% weight for on-chain signals

# Position Sizing Thresholds
MIN_CONFIDENCE=0.40         # Skip trades below this
SMALL_POSITION=0.50         # 50% size
MEDIUM_POSITION=0.65        # 75% size
FULL_POSITION=0.80          # 100% size
BOOST_POSITION=0.90         # 125% size

# Trading Parameters
LOOKBACK_HOURS=24           # Hours of on-chain data to analyze
DEFAULT_SYMBOLS=BTC,ETH     # Symbols to monitor
