//@version=5
strategy("RSI2_Optimized_STEPFUN", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1, initial_capital=10000, pyramiding=0)

// ============================================
// RSI-2 CRYPTO OPTIMIZED STRATEGY
// Based on Larry Connors' proven 75-80% win rate strategy
// Optimized for crypto volatility regimes
// ============================================

// ——— INPUT PARAMETERS ———
rsi_length = input.int(2, "RSI Length", minval=1, maxval=10)
oversold = input.int(30, "Oversold Level", minval=10, maxval=40)
overbought = input.int(70, "Overbought Level", minval=60, maxval=90)

// Trend filter (prevents counter-trend losses)
use_trend_filter = input.bool(true, "Use Trend Filter")
trend_filter_period = input.int(200, "Trend Filter SMA Period", minval=50, maxval=500)

// Volume confirmation
use_volume_confirm = input.bool(true, "Volume Confirmation")
volume_multiplier = input.float(1.5, "Volume Multiplier", minval=1.0, maxval=3.0)

// Exit strategy
exit_mode = input.string("Trailing", "Exit Mode", options=["Fixed RSI", "Trailing", "TP/SL"])
trail_offset_pct = input.float(1.0, "Trailing Offset %", minval=0.1, step=0.1)
tp_percent = input.float(3.0, "Take Profit %", minval=0.1, step=0.1)
sl_percent = input.float(1.5, "Stop Loss %", minval=0.1, step=0.1)

// Position sizing
position_size_pct = input.float(100.0, "Position Size %", minval=1.0, maxval=100.0)

// Cooldown period (avoid overtrading)
use_cooldown = input.bool(true, "Use Cooldown Period")
cooldown_bars = input.int(3, "Cooldown Bars", minval=1, maxval=20)

// ============================================
// INDICATOR CALCULATIONS
// ============================================

// RSI
rsi = ta.rsi(close, rsi_length)

// Trend filter (SMA)
trend_sma = ta.sma(close, trend_filter_period)
above_trend = close > trend_sma

// Volume filter
volume_avg = ta.sma(volume, 20)
volume_confirm = volume > volume_avg * volume_multiplier

// Cooldown tracking
var int last_entry_bar = na
cooldown_ok = na(last_entry_bar) ? true : (bar_index - last_entry_bar) >= cooldown_bars

// ============================================
// ENTRY CONDITIONS
// ============================================

// Long entry: RSI crosses above oversold + trend filter + volume
long_condition = rsi[1] <= oversold and rsi > oversold
if use_trend_filter
    long_condition := long_condition and above_trend
if use_volume_confirm
    long_condition := long_condition and volume_confirm
long_condition := long_condition and cooldown_ok

// Short entry: RSI crosses below overbought + trend filter + volume
short_condition = rsi[1] >= overbought and rsi < overbought
if use_trend_filter
    short_condition := short_condition and close < trend_sma
if use_volume_confirm
    short_condition := short_condition and volume_confirm
short_condition := short_condition and cooldown_ok

// ============================================
// EXIT LOGIC
// ============================================

// Long exit
long_exit = false
if strategy.position_size > 0
    if exit_mode == "Fixed RSI"
        long_exit := rsi >= 50  // Exit when RSI reaches neutral
    else if exit_mode == "Trailing"
        // Calculate trailing stop level
        highest_high = ta.highest(high, 10)
        trail_level = highest_high * (1 - trail_offset_pct / 100)
        long_exit := low <= trail_level
    else if exit_mode == "TP/SL"
        long_exit := false  // TP/SL handled by strategy.exit

// Short exit
short_exit = false
if strategy.position_size < 0
    if exit_mode == "Fixed RSI"
        short_exit := rsi <= 50
    else if exit_mode == "Trailing"
        lowest_low = ta.lowest(low, 10)
        trail_level = lowest_low * (1 + trail_offset_pct / 100)
        short_exit := high >= trail_level
    else if exit_mode == "TP/SL"
        short_exit := false  // TP/SL handled by strategy.exit

// ============================================
// STRATEGY EXECUTION
// ============================================

// Calculate TP/SL levels
float long_tp = na
float long_sl = na
float short_tp = na
float short_sl = na
if exit_mode == "TP/SL"
    long_tp := close * (1 + tp_percent / 100)
    long_sl := close * (1 - sl_percent / 100)
    short_tp := close * (1 - tp_percent / 100)
    short_sl := close * (1 + sl_percent / 100)

// Enter long
if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long, qty=position_size_pct)
    last_entry_bar := bar_index
    if exit_mode == "TP/SL"
        strategy.exit("Long Exit", "Long", limit=long_tp, stop=long_sl)

// Enter short
if short_condition and strategy.position_size == 0
    strategy.entry("Short", strategy.short, qty=position_size_pct)
    last_entry_bar := bar_index
    if exit_mode == "TP/SL"
        strategy.exit("Short Exit", "Short", limit=short_tp, stop=short_sl)

// Exit long on signal or exit condition
if (long_exit and strategy.position_size > 0) or (short_condition and strategy.position_size > 0)
    strategy.close("Long", comment="Exit Signal")

// Exit short on signal or exit condition
if (short_exit and strategy.position_size < 0) or (long_condition and strategy.position_size < 0)
    strategy.close("Short", comment="Exit Signal")

// ============================================
// PLOTTING
// ============================================

// Plot RSI
rsi_plot = plot(rsi, "RSI", color=color.blue, linewidth=1)
hline(oversold, "Oversold", color=color.green, linestyle=hline.style_dashed)
hline(overbought, "Overbought", color=color.red, linestyle=hline.style_dashed)
hline(50, "Neutral", color=color.gray, linestyle=hline.style_dotted)

// Entry/Exit markers
plotshape(long_condition, title="Long Entry", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small)
plotshape(short_condition, title="Short Entry", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small)

// Trend filter visualization
plot(use_trend_filter ? trend_sma : na, "Trend SMA", color=color.orange, linewidth=2)

// Background coloring for positions
bgcolor(strategy.position_size > 0 ? color.new(color.green, 90) : na)
bgcolor(strategy.position_size < 0 ? color.new(color.red, 90) : na)

// ============================================
// INFO TABLE
// ============================================
var table info_table = table.new(position.top_right, 2, 8, border_width=1)

if barstate.islast
    table.cell(info_table, 0, 0, "RSI-2 Optimized", bgcolor=color.blue, text_color=color.white)
    table.cell(info_table, 1, 0, "Value", bgcolor=color.blue, text_color=color.white)
    
    table.cell(info_table, 0, 1, "RSI", bgcolor=color.new(color.blue, 80))
    table.cell(info_table, 1, 1, str.tostring(rsi, "#.##"), text_color=color.white)
    
    table.cell(info_table, 0, 2, "Trend", bgcolor=color.new(color.orange, 80))
    table.cell(info_table, 1, 2, above_trend ? "Bullish" : "Bearish", text_color=color.white)
    
    table.cell(info_table, 0, 3, "Volume Confirm", bgcolor=color.new(color.purple, 80))
    table.cell(info_table, 1, 3, volume_confirm ? "YES" : "NO", text_color=color.white)
    
    table.cell(info_table, 0, 4, "Position", bgcolor=color.new(color.gray, 80))
    table.cell(info_table, 1, 4, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT", text_color=color.white)
    
    table.cell(info_table, 0, 5, "Exit Mode", bgcolor=color.new(color.blue, 80))
    table.cell(info_table, 1, 5, exit_mode, text_color=color.white)
    
    table.cell(info_table, 0, 6, "Cooldown", bgcolor=color.new(color.orange, 80))
    table.cell(info_table, 1, 6, cooldown_ok ? "OK" : str.tostring(cooldown_bars - (bar_index - last_entry_bar)) + " bars", text_color=color.white)
    
    table.cell(info_table, 0, 7, "Equity", bgcolor=color.new(color.green, 80))
    table.cell(info_table, 1, 7, str.tostring(strategy.equity, "#.##"), text_color=color.white)

// ============================================
// ALERTS
// ============================================
alertcondition(long_condition, "RSI2 Long", "RSI-2 Long Entry")
alertcondition(short_condition, "RSI2 Short", "RSI-2 Short Entry")
