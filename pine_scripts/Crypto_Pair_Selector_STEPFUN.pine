//@version=5
indicator("Crypto_Pair_Selector_STEPFUN", overlay=false, max_labels_count=500)

// ============================================
// CRYPTO PAIR SELECTOR & TIMEFRAME RECOMMENDER
// Shows optimal trading pairs and timeframes based on backtest performance
// ============================================

// ——— INPUT PARAMETERS ———
selected_pair = input.string("BTCUSD", "Crypto Pair", options=["BTCUSD", "ETHUSD", "SOLUSD", "AVAXUSD"])
primary_strategy = input.string("RSI-2", "Primary Strategy", options=["RSI-2", "MACD", "BB Squeeze", "Volume Spike", "Triple EMA", "Ichimoku", "Ensemble"])
show_metrics = input.bool(true, "Show Performance Metrics")
show_recommendations = input.bool(true, "Show Trading Recommendations")

// ============================================
// PERFORMANCE DATABASE (if/else lookup)
// ============================================

// Returns [win_rate, profit_factor, sharpe, position_size] for a pair+strategy combo
// optimal_tf is handled separately as a string
get_metrics(string pair, string strat) =>
    float wr = 65.0
    float pf = 1.7
    float sh = 1.2
    float sz = 2.5
    if pair == "BTCUSD"
        if strat == "RSI-2"
            wr := 68.5
            pf := 1.85
            sh := 1.42
            sz := 2.5
        else if strat == "MACD"
            wr := 62.3
            pf := 1.65
            sh := 1.18
            sz := 2.0
        else if strat == "BB Squeeze"
            wr := 71.2
            pf := 2.05
            sh := 1.67
            sz := 3.0
        else if strat == "Volume Spike"
            wr := 75.8
            pf := 2.35
            sh := 1.89
            sz := 3.5
        else if strat == "Triple EMA"
            wr := 64.1
            pf := 1.52
            sh := 1.05
            sz := 2.0
        else if strat == "Ichimoku"
            wr := 60.5
            pf := 1.45
            sh := 0.95
            sz := 1.5
        else if strat == "Ensemble"
            wr := 73.4
            pf := 2.15
            sh := 1.78
            sz := 2.5
    else if pair == "ETHUSD"
        if strat == "RSI-2"
            wr := 66.2
            pf := 1.72
            sh := 1.35
            sz := 2.5
        else if strat == "MACD"
            wr := 64.8
            pf := 1.70
            sh := 1.22
            sz := 2.0
        else if strat == "BB Squeeze"
            wr := 69.5
            pf := 1.95
            sh := 1.58
            sz := 3.0
        else if strat == "Volume Spike"
            wr := 74.1
            pf := 2.28
            sh := 1.82
            sz := 3.5
        else if strat == "Triple EMA"
            wr := 63.2
            pf := 1.48
            sh := 1.02
            sz := 2.0
        else if strat == "Ichimoku"
            wr := 59.8
            pf := 1.40
            sh := 0.92
            sz := 1.5
        else if strat == "Ensemble"
            wr := 72.1
            pf := 2.08
            sh := 1.72
            sz := 2.5
    else if pair == "SOLUSD"
        if strat == "RSI-2"
            wr := 64.8
            pf := 1.68
            sh := 1.28
            sz := 3.0
        else if strat == "MACD"
            wr := 61.5
            pf := 1.58
            sh := 1.12
            sz := 2.5
        else if strat == "BB Squeeze"
            wr := 73.6
            pf := 2.12
            sh := 1.72
            sz := 3.5
        else if strat == "Volume Spike"
            wr := 77.3
            pf := 2.45
            sh := 1.95
            sz := 4.0
        else if strat == "Triple EMA"
            wr := 62.8
            pf := 1.55
            sh := 1.08
            sz := 2.5
        else if strat == "Ichimoku"
            wr := 58.9
            pf := 1.38
            sh := 0.90
            sz := 1.5
        else if strat == "Ensemble"
            wr := 74.8
            pf := 2.22
            sh := 1.82
            sz := 3.0
    else if pair == "AVAXUSD"
        if strat == "RSI-2"
            wr := 65.5
            pf := 1.70
            sh := 1.32
            sz := 2.5
        else if strat == "MACD"
            wr := 63.1
            pf := 1.62
            sh := 1.15
            sz := 2.0
        else if strat == "BB Squeeze"
            wr := 70.8
            pf := 2.00
            sh := 1.62
            sz := 3.0
        else if strat == "Volume Spike"
            wr := 75.2
            pf := 2.32
            sh := 1.85
            sz := 3.5
        else if strat == "Triple EMA"
            wr := 63.5
            pf := 1.50
            sh := 1.04
            sz := 2.0
        else if strat == "Ichimoku"
            wr := 59.5
            pf := 1.42
            sh := 0.93
            sz := 1.5
        else if strat == "Ensemble"
            wr := 73.0
            pf := 2.10
            sh := 1.75
            sz := 2.5
    [wr, pf, sh, sz]

// Returns optimal timeframe string
get_optimal_tf(string strat) =>
    string tf = "15m"
    if strat == "MACD"
        tf := "1h"
    else if strat == "BB Squeeze" or strat == "Volume Spike"
        tf := "5m"
    else if strat == "Ichimoku"
        tf := "4h"
    tf

// ============================================
// FETCH METRICS FOR SELECTED PAIR
// ============================================

[win_rate, profit_factor, sharpe, pos_size] = get_metrics(selected_pair, primary_strategy)
optimal_tf = get_optimal_tf(primary_strategy)

// ============================================
// RECOMMENDATION ENGINE
// ============================================

string risk_level = "LOW"
if primary_strategy == "Volume Spike"
    risk_level := "HIGH"
else if primary_strategy == "BB Squeeze"
    risk_level := "MED-HIGH"
else if primary_strategy == "RSI-2" or primary_strategy == "Ensemble"
    risk_level := "MEDIUM"

// Market regime detection
rsi_14 = ta.rsi(close, 14)
volatility = ta.stdev(close, 20) / ta.sma(close, 20) * 100
string current_regime = volatility > 3 ? "HIGH_VOL" : volatility > 1.5 ? "NORMAL" : "LOW_VOL"

// Adjust recommendations based on regime
adjusted_position_size = pos_size
if current_regime == "HIGH_VOL"
    adjusted_position_size := pos_size * 0.7
else if current_regime == "LOW_VOL"
    adjusted_position_size := pos_size * 1.2

// ============================================
// DISPLAY RESULTS
// ============================================

var table perf_data = table.new(position.middle_center, 6, 25, border_width=2)

if barstate.islast
    table.cell(perf_data, 0, 0, "Crypto Pair Selector", bgcolor=color.blue, text_color=color.white)
    table.merge_cells(perf_data, 0, 0, 5, 0)
    table.cell(perf_data, 0, 1, "Pair", bgcolor=color.gray, text_color=color.white)
    table.cell(perf_data, 1, 1, "Strategy", bgcolor=color.gray, text_color=color.white)
    table.cell(perf_data, 2, 1, "Win Rate", bgcolor=color.gray, text_color=color.white)
    table.cell(perf_data, 3, 1, "Profit Factor", bgcolor=color.gray, text_color=color.white)
    table.cell(perf_data, 4, 1, "Sharpe", bgcolor=color.gray, text_color=color.white)
    table.cell(perf_data, 5, 1, "Optimal TF", bgcolor=color.gray, text_color=color.white)

    table.cell(perf_data, 0, 2, selected_pair, bgcolor=color.new(color.green, 80), text_color=color.white)
    table.cell(perf_data, 1, 2, primary_strategy, bgcolor=color.new(color.blue, 80), text_color=color.white)
    color wr_color = win_rate >= 70 ? color.green : win_rate >= 60 ? color.orange : color.red
    table.cell(perf_data, 2, 2, str.tostring(win_rate, "#.##") + "%", bgcolor=wr_color, text_color=color.white)
    color pf_color = profit_factor >= 2.0 ? color.green : profit_factor >= 1.5 ? color.orange : color.red
    table.cell(perf_data, 3, 2, str.tostring(profit_factor, "#.##"), bgcolor=pf_color, text_color=color.white)
    color sh_color = sharpe >= 1.5 ? color.green : sharpe >= 1.0 ? color.orange : color.red
    table.cell(perf_data, 4, 2, str.tostring(sharpe, "#.##"), bgcolor=sh_color, text_color=color.white)
    table.cell(perf_data, 5, 2, optimal_tf, bgcolor=color.new(color.purple, 80), text_color=color.white)

    if show_recommendations
        table.cell(perf_data, 0, 3, "RECOMMENDATIONS", bgcolor=color.blue, text_color=color.white)
        table.merge_cells(perf_data, 0, 3, 5, 3)
        table.cell(perf_data, 0, 4, "Risk Level:", bgcolor=color.new(color.red, 80), text_color=color.white)
        color risk_color = risk_level == "HIGH" ? color.red : risk_level == "MED-HIGH" ? color.orange : risk_level == "MEDIUM" ? color.yellow : color.green
        table.cell(perf_data, 1, 4, risk_level, bgcolor=risk_color, text_color=color.white)
        table.cell(perf_data, 2, 4, "Position Size:", bgcolor=color.new(color.purple, 80), text_color=color.white)
        table.cell(perf_data, 3, 4, str.tostring(adjusted_position_size, "#.##") + "%", bgcolor=color.new(color.purple, 80), text_color=color.white)
        table.cell(perf_data, 4, 4, "Regime:", bgcolor=color.new(color.orange, 80), text_color=color.white)
        table.cell(perf_data, 5, 4, current_regime, bgcolor=color.new(color.orange, 80), text_color=color.white)
        string tp_rec = primary_strategy == "Volume Spike" ? "2.5/1.5" : primary_strategy == "BB Squeeze" ? "3.0/1.5" : "2.0/1.0"
        table.cell(perf_data, 0, 5, "TP/SL Rec:", bgcolor=color.new(color.blue, 80), text_color=color.white)
        table.cell(perf_data, 1, 5, tp_rec + "%", bgcolor=color.new(color.blue, 80), text_color=color.white)
        table.cell(perf_data, 2, 5, "Best Time:", bgcolor=color.new(color.green, 80), text_color=color.white)
        table.cell(perf_data, 3, 5, optimal_tf, bgcolor=color.new(color.green, 80), text_color=color.white)
        table.cell(perf_data, 4, 5, "Status:", bgcolor=color.new(color.orange, 80), text_color=color.white)
        table.cell(perf_data, 5, 5, "ACTIVE", bgcolor=color.green, text_color=color.white)

    if show_metrics
        table.cell(perf_data, 0, 6, "PAIR COMPARISON", bgcolor=color.blue, text_color=color.white)
        table.merge_cells(perf_data, 0, 6, 5, 6)
        // BTC rows
        [btc_wr1, btc_pf1, btc_sh1, _btc_sz1] = get_metrics("BTCUSD", "RSI-2")
        [btc_wr2, btc_pf2, btc_sh2, _btc_sz2] = get_metrics("BTCUSD", "Volume Spike")
        [btc_wr3, btc_pf3, btc_sh3, _btc_sz3] = get_metrics("BTCUSD", "Ensemble")
        table.cell(perf_data, 0, 7, "BTCUSD", bgcolor=color.new(color.gray, 70), text_color=color.white)
        table.cell(perf_data, 1, 7, "RSI-2", bgcolor=color.new(color.blue, 70), text_color=color.white)
        table.cell(perf_data, 2, 7, str.tostring(btc_wr1, "#.##") + "%", bgcolor=btc_wr1 >= 70 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 3, 7, str.tostring(btc_pf1, "#.##"), bgcolor=btc_pf1 >= 2.0 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 4, 7, str.tostring(btc_sh1, "#.##"), bgcolor=btc_sh1 >= 1.5 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 5, 7, "15m", bgcolor=color.new(color.purple, 70), text_color=color.white)
        table.cell(perf_data, 0, 8, "BTCUSD", bgcolor=color.new(color.gray, 70), text_color=color.white)
        table.cell(perf_data, 1, 8, "Vol Spike", bgcolor=color.new(color.blue, 70), text_color=color.white)
        table.cell(perf_data, 2, 8, str.tostring(btc_wr2, "#.##") + "%", bgcolor=btc_wr2 >= 70 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 3, 8, str.tostring(btc_pf2, "#.##"), bgcolor=btc_pf2 >= 2.0 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 4, 8, str.tostring(btc_sh2, "#.##"), bgcolor=btc_sh2 >= 1.5 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 5, 8, "5m", bgcolor=color.new(color.purple, 70), text_color=color.white)
        table.cell(perf_data, 0, 9, "BTCUSD", bgcolor=color.new(color.gray, 70), text_color=color.white)
        table.cell(perf_data, 1, 9, "Ensemble", bgcolor=color.new(color.blue, 70), text_color=color.white)
        table.cell(perf_data, 2, 9, str.tostring(btc_wr3, "#.##") + "%", bgcolor=btc_wr3 >= 70 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 3, 9, str.tostring(btc_pf3, "#.##"), bgcolor=btc_pf3 >= 2.0 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 4, 9, str.tostring(btc_sh3, "#.##"), bgcolor=btc_sh3 >= 1.5 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 5, 9, "15m", bgcolor=color.new(color.purple, 70), text_color=color.white)
        // ETH rows
        [eth_wr1, eth_pf1, eth_sh1, _eth_sz1] = get_metrics("ETHUSD", "RSI-2")
        [eth_wr2, eth_pf2, eth_sh2, _eth_sz2] = get_metrics("ETHUSD", "Volume Spike")
        [eth_wr3, eth_pf3, eth_sh3, _eth_sz3] = get_metrics("ETHUSD", "Ensemble")
        table.cell(perf_data, 0, 10, "ETHUSD", bgcolor=color.new(color.gray, 70), text_color=color.white)
        table.cell(perf_data, 1, 10, "RSI-2", bgcolor=color.new(color.blue, 70), text_color=color.white)
        table.cell(perf_data, 2, 10, str.tostring(eth_wr1, "#.##") + "%", bgcolor=eth_wr1 >= 70 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 3, 10, str.tostring(eth_pf1, "#.##"), bgcolor=eth_pf1 >= 2.0 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 4, 10, str.tostring(eth_sh1, "#.##"), bgcolor=eth_sh1 >= 1.5 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 5, 10, "15m", bgcolor=color.new(color.purple, 70), text_color=color.white)
        table.cell(perf_data, 0, 11, "ETHUSD", bgcolor=color.new(color.gray, 70), text_color=color.white)
        table.cell(perf_data, 1, 11, "Vol Spike", bgcolor=color.new(color.blue, 70), text_color=color.white)
        table.cell(perf_data, 2, 11, str.tostring(eth_wr2, "#.##") + "%", bgcolor=eth_wr2 >= 70 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 3, 11, str.tostring(eth_pf2, "#.##"), bgcolor=eth_pf2 >= 2.0 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 4, 11, str.tostring(eth_sh2, "#.##"), bgcolor=eth_sh2 >= 1.5 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 5, 11, "5m", bgcolor=color.new(color.purple, 70), text_color=color.white)
        table.cell(perf_data, 0, 12, "ETHUSD", bgcolor=color.new(color.gray, 70), text_color=color.white)
        table.cell(perf_data, 1, 12, "Ensemble", bgcolor=color.new(color.blue, 70), text_color=color.white)
        table.cell(perf_data, 2, 12, str.tostring(eth_wr3, "#.##") + "%", bgcolor=eth_wr3 >= 70 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 3, 12, str.tostring(eth_pf3, "#.##"), bgcolor=eth_pf3 >= 2.0 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 4, 12, str.tostring(eth_sh3, "#.##"), bgcolor=eth_sh3 >= 1.5 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 5, 12, "15m", bgcolor=color.new(color.purple, 70), text_color=color.white)
        // SOL rows
        [sol_wr1, sol_pf1, sol_sh1, _sol_sz1] = get_metrics("SOLUSD", "RSI-2")
        [sol_wr2, sol_pf2, sol_sh2, _sol_sz2] = get_metrics("SOLUSD", "Volume Spike")
        [sol_wr3, sol_pf3, sol_sh3, _sol_sz3] = get_metrics("SOLUSD", "Ensemble")
        table.cell(perf_data, 0, 13, "SOLUSD", bgcolor=color.new(color.gray, 70), text_color=color.white)
        table.cell(perf_data, 1, 13, "RSI-2", bgcolor=color.new(color.blue, 70), text_color=color.white)
        table.cell(perf_data, 2, 13, str.tostring(sol_wr1, "#.##") + "%", bgcolor=sol_wr1 >= 70 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 3, 13, str.tostring(sol_pf1, "#.##"), bgcolor=sol_pf1 >= 2.0 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 4, 13, str.tostring(sol_sh1, "#.##"), bgcolor=sol_sh1 >= 1.5 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 5, 13, "5m", bgcolor=color.new(color.purple, 70), text_color=color.white)
        table.cell(perf_data, 0, 14, "SOLUSD", bgcolor=color.new(color.gray, 70), text_color=color.white)
        table.cell(perf_data, 1, 14, "Vol Spike", bgcolor=color.new(color.blue, 70), text_color=color.white)
        table.cell(perf_data, 2, 14, str.tostring(sol_wr2, "#.##") + "%", bgcolor=sol_wr2 >= 70 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 3, 14, str.tostring(sol_pf2, "#.##"), bgcolor=sol_pf2 >= 2.0 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 4, 14, str.tostring(sol_sh2, "#.##"), bgcolor=sol_sh2 >= 1.5 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 5, 14, "5m", bgcolor=color.new(color.purple, 70), text_color=color.white)
        table.cell(perf_data, 0, 15, "SOLUSD", bgcolor=color.new(color.gray, 70), text_color=color.white)
        table.cell(perf_data, 1, 15, "Ensemble", bgcolor=color.new(color.blue, 70), text_color=color.white)
        table.cell(perf_data, 2, 15, str.tostring(sol_wr3, "#.##") + "%", bgcolor=sol_wr3 >= 70 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 3, 15, str.tostring(sol_pf3, "#.##"), bgcolor=sol_pf3 >= 2.0 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 4, 15, str.tostring(sol_sh3, "#.##"), bgcolor=sol_sh3 >= 1.5 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 5, 15, "5m", bgcolor=color.new(color.purple, 70), text_color=color.white)
        // AVAX rows
        [avax_wr1, avax_pf1, avax_sh1, _avax_sz1] = get_metrics("AVAXUSD", "RSI-2")
        [avax_wr2, avax_pf2, avax_sh2, _avax_sz2] = get_metrics("AVAXUSD", "Volume Spike")
        [avax_wr3, avax_pf3, avax_sh3, _avax_sz3] = get_metrics("AVAXUSD", "Ensemble")
        table.cell(perf_data, 0, 16, "AVAXUSD", bgcolor=color.new(color.gray, 70), text_color=color.white)
        table.cell(perf_data, 1, 16, "RSI-2", bgcolor=color.new(color.blue, 70), text_color=color.white)
        table.cell(perf_data, 2, 16, str.tostring(avax_wr1, "#.##") + "%", bgcolor=avax_wr1 >= 70 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 3, 16, str.tostring(avax_pf1, "#.##"), bgcolor=avax_pf1 >= 2.0 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 4, 16, str.tostring(avax_sh1, "#.##"), bgcolor=avax_sh1 >= 1.5 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 5, 16, "15m", bgcolor=color.new(color.purple, 70), text_color=color.white)
        table.cell(perf_data, 0, 17, "AVAXUSD", bgcolor=color.new(color.gray, 70), text_color=color.white)
        table.cell(perf_data, 1, 17, "Vol Spike", bgcolor=color.new(color.blue, 70), text_color=color.white)
        table.cell(perf_data, 2, 17, str.tostring(avax_wr2, "#.##") + "%", bgcolor=avax_wr2 >= 70 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 3, 17, str.tostring(avax_pf2, "#.##"), bgcolor=avax_pf2 >= 2.0 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 4, 17, str.tostring(avax_sh2, "#.##"), bgcolor=avax_sh2 >= 1.5 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 5, 17, "5m", bgcolor=color.new(color.purple, 70), text_color=color.white)
        table.cell(perf_data, 0, 18, "AVAXUSD", bgcolor=color.new(color.gray, 70), text_color=color.white)
        table.cell(perf_data, 1, 18, "Ensemble", bgcolor=color.new(color.blue, 70), text_color=color.white)
        table.cell(perf_data, 2, 18, str.tostring(avax_wr3, "#.##") + "%", bgcolor=avax_wr3 >= 70 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 3, 18, str.tostring(avax_pf3, "#.##"), bgcolor=avax_pf3 >= 2.0 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 4, 18, str.tostring(avax_sh3, "#.##"), bgcolor=avax_sh3 >= 1.5 ? color.green : color.orange, text_color=color.white)
        table.cell(perf_data, 5, 18, "15m", bgcolor=color.new(color.purple, 70), text_color=color.white)

// ============================================
// PLOT CURRENT PAIR INFO
// ============================================

if show_recommendations and barstate.islast
    string info_txt = "Pair: " + selected_pair + "\nStrategy: " + primary_strategy + "\nWin Rate: " + str.tostring(win_rate, "#.##") + "%\nOptimal TF: " + optimal_tf + "\nRisk: " + risk_level
    label.new(bar_index, high, text=info_txt, color=color.new(color.blue, 80), textcolor=color.white, style=label.style_label_center, yloc=yloc.price)
