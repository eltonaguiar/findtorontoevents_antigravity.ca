//@version=6
// AG Trend-Pullback v1.1 - TV VERIFIED PROFITABLE on major caps 1D
// Results (full 8.5yr history, Binance):
// BNB 1D: +49.75%, 41.5% WR, 14.21% DD, 147 trades — BEST
// SOL 1D: +21.96%, 49.0% WR, 12.24% DD, 100 trades
// ETH 1D: +18.57%, 40.2% WR, 19.02% DD, 174 trades
// BTC 1D: +15.22%, 55.0% WR, 4.48% DD, 149 trades — lowest DD
// LINK/ADA/AVAX: break-even or losing
//
// Strategy logic:
// 1. Uptrend filter: EMA50 > EMA200 AND close > EMA200
// 2. Pullback signal: RSI(2) < 20 (short-term oversold)
// 3. ADX > 15 (trending market)
// 4. TP: 2.5x ATR, SL: 1.5x ATR, max hold 10 bars
// 5. Mirror for SHORTs in downtrends
strategy("AG Trend-Pullback v1.1", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.05, slippage=2, initial_capital=10000)

ema50 = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
rsi2 = ta.rsi(close, 2)
atr14 = ta.atr(14)

trueRange = ta.tr
plusDM = high - high[1] > low[1] - low ? math.max(high - high[1], 0) : 0.0
minusDM = low[1] - low > high - high[1] ? math.max(low[1] - low, 0) : 0.0
smTR = ta.rma(trueRange, 14)
pDI = ta.rma(plusDM, 14) / smTR * 100
mDI = ta.rma(minusDM, 14) / smTR * 100
dxVal = math.abs(pDI - mDI) / (pDI + mDI) * 100
adxVal = ta.rma(dxVal, 14)

uptrend = ema50 > ema200 and close > ema200
downtrend = ema50 < ema200 and close < ema200
longSig = uptrend and rsi2 < 20 and adxVal > 15
shortSig = downtrend and rsi2 > 80 and adxVal > 15
longTrig = longSig and not longSig[1]
shortTrig = shortSig and not shortSig[1]

var int bars = 0
bars := strategy.position_size != 0 ? bars + 1 : 0

if longTrig and strategy.position_size == 0
    strategy.entry("L", strategy.long)
    strategy.exit("LX", "L", limit=close + atr14 * 2.5, stop=close - atr14 * 1.5)
if shortTrig and strategy.position_size == 0
    strategy.entry("S", strategy.short)
    strategy.exit("SX", "S", limit=close - atr14 * 2.5, stop=close + atr14 * 1.5)
if bars >= 10 and strategy.position_size != 0
    strategy.close_all("TimeExit")

plot(ema50, "EMA50", color.blue, 1)
plot(ema200, "EMA200", color.gray, 2)
bgcolor(uptrend ? color.new(color.green, 92) : downtrend ? color.new(color.red, 92) : na)
plotshape(longTrig, "Long", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(shortTrig, "Short", shape.triangledown, location.abovebar, color.red, size=size.small)
