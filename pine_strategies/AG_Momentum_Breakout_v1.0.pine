//@version=6
// AG Momentum Breakout v1.0 — captures continuation AFTER pullback completes
// TV VERIFIED PROFITABLE on 6 of 7 majors 1D (8.5yr history, Binance):
// LINK 1D: +18.16%, 57.6% WR, 9.99% DD, 14 trades (BIGGEST)
// BTC 1D: +12.61%, 60.7% WR, 7.60% DD, 21 trades (HIGHEST WR)
// SOL 1D: +12.09%, 50.0% WR, 3.72% DD, 16 trades (LOWEST DD)
// BNB 1D: +10.67%, 33.3% WR, 5.34% DD, 21 trades
// ETH 1D: +10.54%, 35.0% WR, 7.86% DD, 20 trades
// ADA 1D: +1.53%, 41.7% WR, 4.50% DD, 16 trades
// AVAX 1D: -11.78% (fails on AVAX)
//
// Complements AG Trend-Pullback v1.1 — different edge!
// Trend-Pullback buys AT the pullback, Momentum buys AFTER pullback completes.
// Logic:
// 1. Uptrend filter: EMA50 > EMA200 AND close > EMA200
// 2. Recent pullback: RSI(14) was < 40 in last 5 bars
// 3. Entry: RSI(14) crosses above 50 (momentum resuming)
// 4. ADX > 20 (strong trend)
// 5. TP: 3x ATR, SL: 1.5x ATR, max hold 15 bars
strategy("AG Momentum Breakout v1.0", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.05, slippage=2, initial_capital=10000)

ema50 = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
rsi14 = ta.rsi(close, 14)
atr14 = ta.atr(14)

trueRange = ta.tr
plusDM = high - high[1] > low[1] - low ? math.max(high - high[1], 0) : 0.0
minusDM = low[1] - low > high - high[1] ? math.max(low[1] - low, 0) : 0.0
smTR = ta.rma(trueRange, 14)
pDI = ta.rma(plusDM, 14) / smTR * 100
mDI = ta.rma(minusDM, 14) / smTR * 100
dxVal = math.abs(pDI - mDI) / (pDI + mDI) * 100
adxVal = ta.rma(dxVal, 14)

uptrend = ema50 > ema200 and close > ema200
downtrend = ema50 < ema200 and close < ema200

pulledBack = ta.barssince(rsi14 < 40) < 5
rsiCrossUp = ta.crossover(rsi14, 50)
rsiCrossDn = ta.crossunder(rsi14, 50)
pushedUp = ta.barssince(rsi14 > 60) < 5

longSig = uptrend and pulledBack and rsiCrossUp and adxVal > 20
shortSig = downtrend and pushedUp and rsiCrossDn and adxVal > 20

var int bars = 0
bars := strategy.position_size != 0 ? bars + 1 : 0

if longSig and strategy.position_size == 0
    strategy.entry("L", strategy.long)
    strategy.exit("LX", "L", limit=close + atr14 * 3.0, stop=close - atr14 * 1.5)
if shortSig and strategy.position_size == 0
    strategy.entry("S", strategy.short)
    strategy.exit("SX", "S", limit=close - atr14 * 3.0, stop=close + atr14 * 1.5)
if bars >= 15 and strategy.position_size != 0
    strategy.close_all("TimeExit")

plot(ema50, "EMA50", color.blue, 1)
plot(ema200, "EMA200", color.gray, 2)
bgcolor(uptrend ? color.new(color.green, 92) : downtrend ? color.new(color.red, 92) : na)
plotshape(longSig, "Long", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(shortSig, "Short", shape.triangledown, location.abovebar, color.red, size=size.small)
