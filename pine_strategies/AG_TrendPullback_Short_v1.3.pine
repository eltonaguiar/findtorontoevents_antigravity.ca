//@version=6
// AG Trend-Pullback SHORT-Only v1.3
// From 960-combo grid search: SHORTs carry PF 1.36-1.43 vs LONGs near break-even
// Pure short-side edge strategy
//
// TV VERIFIED on 1D (8.5yr history):
// ETH 1D: +15.04%, 43.2% WR, 14.72% DD, 44 trades (BEST)
// AVAX 1D: +9.68%, 41.0% WR, 11.43% DD, 39 trades (rescued from LONG -18.38%)
// SOL 1D: +5.15%, 68.4% WR, 5.14% DD, 19 trades (HIGHEST WR)
// BTC 1D: +3.03%, 50.0% WR, 1.78% DD, 28 trades (LOWEST DD)
// LINK 1D: -0.57% (slight loss)
// ADA 1D: -1.79% (slight loss)
//
// 4 of 6 profitable. Low drawdowns. Great complement to long-only strategies.
// Logic: downtrend (EMA50<EMA200, close<EMA200) + RSI2>90 (overbought rip) + ADX>20
// TP 3x ATR, SL 2x ATR, max hold 10 bars.
strategy("AG TrendPullback Short v1.3", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.05, slippage=2, initial_capital=10000)

ema50 = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
rsi2 = ta.rsi(close, 2)
atr14 = ta.atr(14)

trueRange = ta.tr
plusDM = high - high[1] > low[1] - low ? math.max(high - high[1], 0) : 0.0
minusDM = low[1] - low > high - high[1] ? math.max(low[1] - low, 0) : 0.0
smTR = ta.rma(trueRange, 14)
pDI = ta.rma(plusDM, 14) / smTR * 100
mDI = ta.rma(minusDM, 14) / smTR * 100
dxVal = math.abs(pDI - mDI) / (pDI + mDI) * 100
adxVal = ta.rma(dxVal, 14)

downtrend = ema50 < ema200 and close < ema200
shortSig = downtrend and rsi2 > 90 and adxVal > 20
shortTrig = shortSig and not shortSig[1]

var int bars = 0
bars := strategy.position_size != 0 ? bars + 1 : 0

if shortTrig and strategy.position_size == 0
    strategy.entry("S", strategy.short)
    strategy.exit("SX", "S", limit=close - atr14 * 3.0, stop=close + atr14 * 2.0)
if bars >= 10 and strategy.position_size != 0
    strategy.close_all("TimeExit")

plot(ema50, "EMA50", color.blue, 1)
plot(ema200, "EMA200", color.gray, 2)
bgcolor(downtrend ? color.new(color.red, 92) : na)
plotshape(shortTrig, "Short", shape.triangledown, location.abovebar, color.red, size=size.small)
