name: MySQL Q-001 — Create picks table + sync from JSON

# DISABLED 2026-11-16: one-time 2026-05-24 MySQL equity-unlock sync (Q-001);
# its dated trigger passed and the last run failed (2026-05-24). Keep the
# file but stop it from running. Re-enable by restoring `on:` if a future
# backfill ever needs it.
on: {}

jobs:
  mysql-sync:
    runs-on: ubuntu-latest
    permissions:
      contents: write

    steps:
      - name: Checkout repository
        uses: actions/checkout@v6
        with:
          token: ${{ secrets.GH_PAT || github.token }}
          fetch-depth: 1

      - name: Set up Python
        uses: actions/setup-python@v6
        with:
          python-version: "3.11"
          cache: pip

      - name: Install dependencies
        run: pip install pymysql

      - name: Run Q-001 MySQL picks sync
        env:
          DB_PASS_STOCKS: ${{ secrets.DB_PASS_STOCKS || secrets.MYSQL_PASSWORD }}
          DB_HOST_STOCKS: ${{ secrets.DB_HOST_STOCKS || 'mysql.50webs.com' }}
          DB_NAME_STOCKS: ${{ secrets.DB_NAME_STOCKS || 'ejaguiar1_stocks' }}
          DB_USER_STOCKS: ${{ secrets.DB_USER_STOCKS || 'ejaguiar1_stocks' }}
        run: |
          DRY_FLAG=""
          if [ "${{ inputs.dry_run }}" = "true" ]; then
            DRY_FLAG="--dry-run"
          fi
          python tools/mysql_q001_sync.py \
            $DRY_FLAG \
            --max-rows ${{ inputs.max_rows || '50000' }}

      - name: Show report
        run: |
          REPORT=$(ls reports/mysql_q001_sync_*.json 2>/dev/null | tail -1)
          if [ -n "$REPORT" ]; then
            echo "=== Sync report ==="
            cat "$REPORT"
          fi

      - name: Commit report
        if: inputs.dry_run != 'true'
        run: |
          git config user.name "MySQL Sync Bot"
          git config user.email "mysql-sync@findtorontoevents.ca"
          git add reports/mysql_q001_sync_*.json 2>/dev/null || true
          git diff --staged --quiet || git commit -m "chore(mysql): Q-001 picks sync $(date -u +%Y-%m-%dT%H:%M:%SZ) [skip ci]"
          git pull --rebase origin main || true
          git push origin main || echo "Push failed — report is local"

# re-registered 2026-05-23 after stripped-history reset (4aaa6ff848f)
