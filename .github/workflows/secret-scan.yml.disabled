name: Secret Scan (M-043)

# M-043 — Gitleaks secret scanning on every PR and push to main.
# Fails if hardcoded credentials are detected in changed files.
# Secrets are NEVER printed to logs (--redact is passed by the action by default).
#
# 2026-05-16: Removed push trigger on main because the repo is ~3.7 GiB of git
# objects and fetch-depth:0 checkout takes 10–18 min, exceeding the 10-minute
# timeout on every bot push. PR gate + daily cron + workflow_dispatch is
# sufficient security coverage (main is bot-driven; humans push via PR).
#
# Required environment variables / secrets:
#   GITHUB_TOKEN  — automatically provided by GitHub Actions; grants the action
#                   read access to the repo and the ability to annotate PRs.
#                   No additional secrets need to be configured.
#
# Optional (advanced):
#   GITLEAKS_LICENSE — only needed if you use Gitleaks Pro features (not required
#                      for the open-source gitleaks-action@v2 used here).
#
# False-positive suppression:
#   See .gitleaks.toml at repo root.  Common exclusions pre-configured:
#     - tests/fixtures/  (fake credentials in test data)
#     - example/sample config blocks in docs/
#     - GitHub Actions ${{ secrets.X }} template expressions (not real secrets)

'on':
  pull_request:
    branches: [main]
  schedule:
    - cron: "0 4 * * *"      # Daily baseline scan of main
  workflow_dispatch:

permissions:
  contents: read
  # Needed so the action can post inline PR annotations when secrets are found
  security-events: write
  pull-requests: read

# Storm-commit repo: a newer push supersedes the in-flight scan run.
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  pr-secret-scan:
    name: Gitleaks PR diff scan
    if: ${{ github.event_name == 'pull_request' }}
    runs-on: ubuntu-latest
    timeout-minutes: 20

    steps:
      - name: Checkout (full history for diff-aware scanning)
        uses: actions/checkout@v6
        with:
          fetch-depth: 0
          filter: blob:none

      - name: Gitleaks PR secret scan
        uses: gitleaks/gitleaks-action@v2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          # GITLEAKS_LICENSE: ${{ secrets.GITLEAKS_LICENSE }}  # uncomment for Pro

  scheduled-secret-scan:
    name: Gitleaks tree + recent commits scan
    if: ${{ github.event_name != 'pull_request' }}
    runs-on: ubuntu-latest
    timeout-minutes: 20

    steps:
      - name: Checkout (metadata-only history + HEAD tree)
        uses: actions/checkout@v6
        with:
          fetch-depth: 0
          # Partial clone avoids downloading ~19 GiB of historical packfiles;
          # gitleaks dir scans HEAD on disk, and gitleaks git scans only the
          # last 48h of commits so it never lazily fetches years of blobs.
          filter: blob:none

      - name: Install Gitleaks CLI (verified SHA256)
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          TAG=$(gh api repos/gitleaks/gitleaks/releases/latest --jq '.tag_name')
          VER="${TAG#v}"
          ASSET="gitleaks_${VER}_linux_x64.tar.gz"
          CHECKSUMS="gitleaks_${VER}_checksums.txt"
          curl -sSLf "https://github.com/gitleaks/gitleaks/releases/download/${TAG}/${ASSET}" -o "/tmp/${ASSET}"
          curl -sSLf "https://github.com/gitleaks/gitleaks/releases/download/${TAG}/${CHECKSUMS}" -o "/tmp/${CHECKSUMS}"
          (cd /tmp && grep " ${ASSET}$" "${CHECKSUMS}" | sha256sum --check)
          tar -xzf "/tmp/${ASSET}" -C /usr/local/bin gitleaks
          rm -f "/tmp/${ASSET}" "/tmp/${CHECKSUMS}"
          gitleaks version

      - name: Scan current HEAD working tree (legacy baseline debt warning)
        run: |
          set -euo pipefail
          gitleaks dir . --config .gitleaks.toml --redact --report-format json --report-path /tmp/gitleaks-head.json --exit-code 0
          python3 - <<'PY'
          import collections, json
          try:
              with open('/tmp/gitleaks-head.json', encoding='utf-8') as fh:
                  findings = json.load(fh) or []
          except Exception:
              findings = []
          by_file = collections.Counter(f.get('File', '?') for f in findings)
          print(f"HEAD tree baseline scan: {len(findings)} finding(s) across {len(by_file)} file(s)")
          if findings:
              top = ', '.join(f"{p} ({n})" for p, n in by_file.most_common(8))
              print(f"::warning::Legacy HEAD secret scan baseline reports {len(findings)} finding(s) across {len(by_file)} file(s) needing rotation/triage (top: {top})")
          PY

      - name: Scan recent git commits (last 30 non-merge commits)
        run: |
          set -euo pipefail
          gitleaks git . --config .gitleaks.toml --redact --log-opts="-n 30 --no-merges" --report-format json --report-path /tmp/gitleaks-git.json --exit-code 0
          python3 - <<'PY'
          import collections, json
          try:
              with open('/tmp/gitleaks-git.json', encoding='utf-8') as fh:
                  findings = json.load(fh) or []
          except Exception:
              findings = []
          by_file = collections.Counter(f.get('File', '?') for f in findings)
          print(f"Recent git commits scan: {len(findings)} finding(s) across {len(by_file)} file(s)")
          if findings:
              top = ', '.join(f"{p} ({n})" for p, n in by_file.most_common(8))
              print(f"::warning::Recent git commits secret scan reports {len(findings)} finding(s) across {len(by_file)} file(s) (top: {top})")
          PY
