{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Alpha Signals",
  "description": "Trading signals with confidence, direction, and risk scores",
  "type": "object",
  "required": ["generated_at", "signals"],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "strategy": {
      "type": "string"
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset", "direction", "confidence", "risk_score"],
        "properties": {
          "asset": {"type": "string"},
          "direction": {
            "type": "string",
            "enum": ["long", "short", "neutral"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "risk_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "volatility": {
            "type": "number",
            "minimum": 0.0
          },
          "timeframe": {
            "type": "string",
            "enum": ["1m", "5m", "15m", "30m", "1h", "4h", "1d", "1w"]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
