diff --git a/audit_trail/dashboard_generator.py b/audit_trail/dashboard_generator.py
--- a/audit_trail/dashboard_generator.py
+++ b/audit_trail/dashboard_generator.py
@@ -6561,9 +6561,10 @@
 # QW1: unify STOCK/STOCKS -> EQUITY. Previously _NC_ASSET_CLASSES carried both
 # EQUITY and STOCK and _NC_ALIAS_MAP sent STOCKS->STOCK, producing a phantom
 # empty STOCK bucket in summary.non_crypto_performance (verified in live payload)
 # and silently missing _NON_CRYPTO_ASSET_CLASSES (line 5444) reservation.
 _NC_ASSET_CLASSES = frozenset(
-    {"FOREX", "EQUITY", "STOCK", "COMMODITY", "FUTURES", "ETF", "BOND"}
+    {"FOREX", "EQUITY", "COMMODITY", "FUTURES", "ETF", "BOND"}
 )
 _NC_ALIAS_MAP = {
     "FX": "FOREX",
     "EQUITIES": "EQUITY",
-    "STOCKS": "STOCK",
+    "STOCKS": "EQUITY",
+    "STOCK": "EQUITY",
     "COMMODITIES": "COMMODITY",
     "FUTURE": "FUTURES",
     "BONDS": "BOND",
 }
@@ -6693,7 +6694,7 @@
         if resolved == AssetClass.MICRO_FUTURES:
             return "FUTURES"
-        val = resolved.value
+        val = _NC_ALIAS_MAP.get(resolved.value, resolved.value)  # QW1: STOCK->EQUITY
         if val in _NC_ASSET_CLASSES:
             return val
@@ -4062,7 +4063,7 @@
-    ("orphan_emitter_etf",
-     "non_crypto_agent/data/etf_picks.json", None, "EQUITY"),
+    # QW2: was "EQUITY" — etf-agent.yml emits picks with no asset_class, so this
+    # stamp mislabeled orphan ETF rows into the EQUITY book.
+    ("orphan_emitter_etf",
+     "non_crypto_agent/data/etf_picks.json", None, "ETF"),
@@ -13935,7 +13936,7 @@
-    categories = ("FOREX", "EQUITY", "STOCK", "COMMODITY", "FUTURES", "BOND", "ETF")
+    categories = ("FOREX", "EQUITY", "COMMODITY", "FUTURES", "BOND", "ETF")  # QW1: drop phantom STOCK
@@ -13947,17 +13948,20 @@
     # QW1/QW3: defensive bucket creation — nc_asset_category_for_pick now
     # normalizes STOCK->EQUITY, but an un-mapped category must never KeyError
     # the build. Also track newest closed age for the template staleness badge.
+    _blank = lambda: {
+        "active": 0, "closed": 0, "wins": 0, "losses": 0, "flat": 0,
+        "resolved": 0, "win_rate": None, "total_pnl_pct": 0.0,
+        "newest_closed_age_hours": None,  # QW3
+    }
     stats = {
-        c: {
-            "active": 0,
-            "closed": 0,
-            "wins": 0,
-            "losses": 0,
-            "flat": 0,
-            "resolved": 0,
-            "win_rate": None,
-            "total_pnl_pct": 0.0,
-        }
+        c: _blank()
         for c in categories
     }
@@ (closed loop, ~13952)
     for pick in closed:
         cat = nc_asset_category_for_pick(pick)
         if not cat:
             continue
+        if cat not in stats:
+            stats[cat] = _blank()
         pnl = _float(pick.get("net_pnl_pct", pick.get("pnl_pct", 0)))
         capped = max(-500.0, min(500.0, pnl))
         bucket = stats[cat]
         bucket["closed"] += 1
+        _age = pick.get("age_hours")
+        if _age is None and pick.get("closed_at"):
+            try:
+                from datetime import datetime as _dt
+                _ca = str(pick["closed_at"]).replace("Z", "+00:00")
+                _age = (datetime.now(timezone.utc) - _dt.fromisoformat(_ca)).total_seconds() / 3600.0
+            except Exception:
+                _age = None
+        if _age is not None and (bucket["newest_closed_age_hours"] is None or _age < bucket["newest_closed_age_hours"]):
+            bucket["newest_closed_age_hours"] = round(float(_age), 1)
         bucket["total_pnl_pct"] += capped
@@ (active loop, ~13948)
     for pick in active:
         cat = nc_asset_category_for_pick(pick)
         if cat:
+            if cat not in stats:
+                stats[cat] = _blank()
             stats[cat]["active"] += 1

diff --git a/audit_dashboard/template.html b/audit_dashboard/template.html
--- a/audit_dashboard/template.html
+++ b/audit_dashboard/template.html
