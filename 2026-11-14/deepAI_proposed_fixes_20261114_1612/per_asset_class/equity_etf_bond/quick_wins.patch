-      fetch('./data/money_ready_verdict.json?' + Date.now())
+      fetch('./data/money_ready_verdict.json?' + Date.now())
         .then(function(r){ return r.ok ? r.json() : null; })
         .then(function(mv){
           if (!mv || !mv.classes) return;  // keep dated static spans
+          window._moneyReadyClasses = mv.classes;  // QW3/QW4: reuse in nc-card + divergence badge
@@ (~1010, inside the per-class span renderer, after gateBadges assembly)
+            // QW4: disclose daily-vs-intrabar divergence instead of silently
+            // quoting the (possibly poisoned) intrabar subset.
+            var _ivd = c.intrabar_daily_divergence;
+            if (_ivd && _ivd.flag === true) {
+              var _pfx = _ivd.pf_inflation_x != null ? Math.round(_ivd.pf_inflation_x * 10) / 10 : '?';
+              gateBadges += ' <span title="money_ready intrabar cohort diverges from daily-close cohort (daily PF ' + (_ivd.daily_pf != null ? Number(_ivd.daily_pf).toFixed(2) : '?') + ' vs intrabar PF ' + (_ivd.honest_pf != null ? Number(_ivd.honest_pf).toFixed(2) : '?') + ', inflation x' + _pfx + ') — see audit intrabar entry-anchor fix" style="background:rgba(251,146,60,0.15);color:#fb923c;border:1px solid rgba(251,146,60,0.4);padding:1px 5px;border-radius:6px;font-size:9px;font-weight:700">⚠ DIVERGENT x' + _pfx + '</span>';
+            }
@@ (~6323, nc-card render, right after "hasAnyData = true;")
     if (serverActiveCount === 0 && serverClosedCount === 0) continue;
     hasAnyData = true;
+    // QW3: staleness + frozen badges for BOND/ETF-style thin classes.
+    var _mrc = (window._moneyReadyClasses || {})[cat.key] || {};
+    var _newestClosed = serverCat.newest_closed_age_hours;
+    if (_mrc.policy_frozen === true) {
+      cardsHtml += '<div class="nc-row"><span class="nc-lbl">Class status</span><span class="nc-val" title="In BLOCKED_ASSET_CLASSES — operator-frozen; picks exist but are policy-excluded." style="color:#7dd3fc">🍦 FROZEN</span></div>';
+    }
+    if (_newestClosed != null && _newestClosed > 72) {
+      cardsHtml += '<div class="nc-row"><span class="nc-lbl">Freshness</span><span class="nc-val" style="color:var(--text-dim)">⏸ newest closed ' + fmt(_newestClosed, 1) + 'h ago</span></div>';
+    }

