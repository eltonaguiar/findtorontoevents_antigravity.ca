            "blending": "Equal-weight average of 3 lookback signals",
            "threshold": "If blend > 0.33 = LONG, < -0.33 = SHORT, else FLAT",
            "position_sizing": "Inversely proportional to 60-day realized volatility",
            "rebalance": "Monthly (1st trading day)",
            "holding_period": "1 month"
