      "title": "Demystifying Time-Series Momentum Strategies",
      "authors": "Nick Baltas, Robert Kosowski",
      "url": "https://papers.ssrn.com/sol3/papers.cfm?abstract_id=2140091",
      "key_finding": "More efficient volatility estimation reduces turnover. TREND rule (scaled positions by signal strength) outperforms binary approach. Post-2008 underperformance explained by increased pairwise correlations."
    },
    "fung_hsieh_2001": {
      "title": "The Risk in Hedge Fund Strategies: Theory and Evidence from Trend Followers",
      "authors": "William Fung, David Hsieh",
      "key_finding": "CTA returns replicated by lookback straddles on bonds, currencies, commodities, equities, and short-term interest rates."
    },
    "hamill_rattray_van_hemert_2016": {
      "title": "Trend Following: Equity and Bond Crisis Alpha",
      "key_finding": "Trend following provides crisis alpha (positive returns during equity bear markets), especially on short side."
    },
